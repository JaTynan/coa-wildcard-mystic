+// CoA.MysticEnchants.AllowWildcard: the client keeps no slot record for Wildcard characters
+// (it answers every slot as empty), so the active slots also go to the WildcardEnchants addon
+// as an addon whisper: "WCME", "S:<slot 0 spell>,<slot 1 spell>,...".
+constexpr char WILDCARD_SLOTS_PREFIX[] = "WCME";
+constexpr char WILDCARD_SLOTS_REQUEST[] = "WCME\tREQ";
+
+void SendWildcardSlots(Player* player, State& state)
+{
+    if (!sConfigMgr->GetOption<bool>("CoA.MysticEnchants.AllowWildcard", false) ||
+        !AscensionWildcard::IsWildcardHero(player))
+        return;
+    std::string message = std::string(WILDCARD_SLOTS_PREFIX) + "\tS";
+    Slots const& active = state.Active();
+    for (uint32 slot = 0; slot < SLOT_COUNT; ++slot)
+        message += (slot ? "," : ":") + std::to_string(active[slot]);
+    WorldPacket data;
+    ChatHandler::BuildChatPacket(data, CHAT_MSG_WHISPER, LANG_ADDON, player, player, message);
+    player->SendDirectMessage(&data);
+}
