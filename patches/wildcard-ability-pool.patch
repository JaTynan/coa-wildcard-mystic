     if (!advancement.Load(GetClientDBCPath("CharacterAdvancement.dbc"), ADVANCEMENT_MODES + 1) ||
         !essence.Load(GetClientDBCPath("CharacterAdvancementEssence.dbc"), ESSENCE_TE + 1) ||
         !cards.Load(GetClientDBCPath("SkillCard.dbc"), SKILL_CARD_STARTER + 1) ||
         !costs.Load(GetClientDBCPath("SealedCardCosts.dbc"), SEALED_CARD_TYPE_COUNT + 1))
         return;
 
+    // Wildcard.AbilityPool: class type -> class (CharacterAdvancementClassTypes.dbc), then every rank spell -> class.
+    std::unordered_map<uint32, uint32> classOfType;
+    if (classTypes.Load(GetClientDBCPath("CharacterAdvancementClassTypes.dbc"), CLASS_TYPES_CLASS + 1))
+        for (uint32 row = 0; row < classTypes.GetRecordCount(); ++row)
+            classOfType[classTypes.GetRecord(row).GetUInt32(0)] = classTypes.GetRecord(row).GetUInt32(CLASS_TYPES_CLASS);
+    SpellClasses.clear();
+    for (uint32 row = 0; row < advancement.GetRecordCount(); ++row)
+    {
+        ClientDBC::Record record = advancement.GetRecord(row);
+        auto const owner = classOfType.find(record.GetUInt32(ADVANCEMENT_CLASS_TYPE));
+        if (owner == classOfType.end())
+            continue;
+        for (uint32 field = ADVANCEMENT_SPELLS; field < ADVANCEMENT_SPELLS + ADVANCEMENT_RANK_COUNT; ++field)
+            if (uint32 const spellId = record.GetUInt32(field))
+                SpellClasses[spellId] = owner->second;
+    }
+
     Tables tables;
     for (uint32 row = 0; row < advancement.GetRecordCount(); ++row)
     {
@@ -1498,7 +1547,7 @@ char const* RerollStartingAbilities(Player* player, StarterPick const& pick = {}
