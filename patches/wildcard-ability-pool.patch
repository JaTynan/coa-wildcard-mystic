@@ -56,6 +56,37 @@ namespace
 {
 using StarterEntry = AscensionWildcardStarterData::Entry;
 
+// Wildcard.AbilityPool: which classes' abilities and talents Wildcard rolls draw from.
+// all = every entry the client data marks for Wildcard; classic = the original classes (and the Hero);
+// coa = the Conquest of Azeroth classes (and the Hero).
+enum class AbilityPool { All, Classic, CoA };
+AbilityPool Pool = AbilityPool::All;
+// Every rank spell of a Character Advancement entry -> the class its class type belongs to.
+constexpr uint32 CLASS_TYPES_CLASS = 2;  // CharacterAdvancementClassTypes.dbc: the class of a class type
+std::unordered_map<uint32, uint32> SpellClasses;
+
+AbilityPool ParseAbilityPool(std::string const& value)
+{
+    if (value == "classic")
+        return AbilityPool::Classic;
+    if (value == "coa")
+        return AbilityPool::CoA;
+    if (value != "all" && !value.empty())
+        LOG_ERROR("coa", "Wildcard.AbilityPool \"{}\" is not all, classic or coa; using all", value);
+    return AbilityPool::All;
+}
+
+bool InAbilityPool(uint32 spellId)
+{
+    if (Pool == AbilityPool::All)
+        return true;
+    auto const found = SpellClasses.find(spellId);
+    if (found == SpellClasses.end() || found->second == CLASS_HERO || !found->second)
+        return true;
+    bool const custom = IsAscensionCustomClassId(uint8(found->second));
+    return Pool == AbilityPool::CoA ? custom : !custom;
+}
+
 constexpr uint16 CMSG_WILDCARD_UNLEARN_ABILITY = 0x061D;
 constexpr uint16 SMSG_WILDCARD_UNLEARN_ABILITY_RESULT = 0x061E;
 constexpr uint16 SMSG_WILDCARD_ENTRY_LEARNED = 0x0621;
