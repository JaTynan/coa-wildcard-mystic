+// CoA.MysticEnchants.SkipMissingSpells and SkipDudSpells: keep enchants that cannot do anything out of
+// scroll rolls. Both are checked against what the server has at every startup, never a fixed list: an
+// enchant comes back into the rolls after the next restart once its spell is added (Spell.dbc or
+// spell_dbc) or given behaviour (a spell script, spell_linked_spell, coa_mystic_enchant_proc or
+// coa_mystic_enchant_aura_link). Only rolls are affected; owned and collected enchants stay as they are.
+//
+// SkipMissingSpells: the enchant's spell (or the spell it teaches) does not exist.
+// SkipDudSpells: the spell exists but is only a placeholder (dummy/script effects, or a trigger aura with
+// nothing to trigger) and nothing on the server gives it behaviour. Known limit: enchants that work only
+// through hard-coded checks in C++ look the same and are left out too (36 on a Wildcard realm when this was written); list them in
+// wcme_enchant_override to keep them in.
+bool SpellMissing(uint32 spellId)
+{
+    return !sSpellMgr->GetSpellInfo(spellId);
+}
+
+bool SpellIsPlaceholder(SpellInfo const* info)
+{
+    for (uint8 i = 0; i < MAX_SPELL_EFFECTS; ++i)
+    {
+        SpellEffectInfo const& effect = info->Effects[i];
+        if (!effect.Effect)
+            continue;
+        if (effect.Effect == SPELL_EFFECT_DUMMY || effect.Effect == SPELL_EFFECT_SCRIPT_EFFECT)
+            continue;
+        if (effect.IsAura())
+        {
+            AuraType const aura = effect.ApplyAuraName;
+            if (aura == SPELL_AURA_DUMMY || aura == SPELL_AURA_PERIODIC_DUMMY)
+                continue;
+            if ((aura == SPELL_AURA_PROC_TRIGGER_SPELL || aura == SPELL_AURA_PERIODIC_TRIGGER_SPELL ||
+                    aura == SPELL_AURA_ADD_TARGET_TRIGGER || aura == SPELL_AURA_PERIODIC_TRIGGER_SPELL_WITH_VALUE) &&
+                (!effect.TriggerSpell || SpellMissing(effect.TriggerSpell)))
+                continue;
+        }
+        return false;  // a real effect
+    }
+    return true;
+}
+
+bool SpellHasBehaviour(uint32 spellId, std::unordered_set<uint32> const& tableSpells)
+{
+    SpellScriptsBounds const scripts = sObjectMgr->GetSpellScriptsBounds(spellId);
+    if (scripts.first != scripts.second || tableSpells.count(spellId))
+        return true;
+    int32 const id = int32(spellId);
+    return sSpellMgr->GetSpellLinked(id) || sSpellMgr->GetSpellLinked(-id) || sSpellMgr->GetSpellLinked(id + SPELL_LINK_AURA);
+}
+
+bool WorldTableExists(char const* table)
+{
+    QueryResult result = WorldDatabase.Query("SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() "
+        "AND TABLE_NAME = '{}'", table);
+    return bool(result);
+}
+
+// wcme_enchant_teach (enchant_spell, taught_spell): extra spells an enchant teaches while it is active, on top
+// of the "Teaches you ... @s:NNN" read from the client's Spell.dbc, which SQL cannot change. Used to restore
+// broken enchants whose working twin teaches a spell. Read at every startup.
+void LoadExtraTeaches()
+{
+    if (!WorldTableExists("wcme_enchant_teach"))
+        return;
+    uint32 count = 0;
+    if (QueryResult result = WorldDatabase.Query("SELECT enchant_spell, taught_spell FROM wcme_enchant_teach"))
+        do
+        {
+            Field* fields = result->Fetch();
+            uint32 const spell = fields[0].Get<uint32>();
+            uint32 const taught = fields[1].Get<uint32>();
+            auto const itr = Loaded.BySpell.find(spell);
+            if (itr == Loaded.BySpell.end() || !sSpellMgr->GetSpellInfo(taught))
+            {
+                LOG_ERROR("sql.sql", "wcme_enchant_teach: enchant spell {} or taught spell {} does not exist", spell, taught);
+                continue;
+            }
+            Loaded.Rows[itr->second].Taught = taught;
+            ++count;
+        } while (result->NextRow());
+    LOG_INFO("coa", "Mystic enchants given an extra taught spell: {}", count);
+}
+
+// wcme_enchant_override (enchant_spell, roll): 1 = always in the scroll rolls (skips the checks below, for
+// enchants that work through C++ the checks cannot see), 0 = never (for enchants found broken in testing).
+std::unordered_map<uint32, bool> LoadRollOverrides()
+{
+    std::unordered_map<uint32, bool> overrides;
+    if (!WorldTableExists("wcme_enchant_override"))
+        return overrides;
+    if (QueryResult result = WorldDatabase.Query("SELECT enchant_spell, roll FROM wcme_enchant_override"))
+        do
+            overrides[result->Fetch()[0].Get<uint32>()] = result->Fetch()[1].Get<uint8>() != 0;
+        while (result->NextRow());
+    return overrides;
+}
+
+void SkipMissingSpells()
+{
+    bool const skipMissing = sConfigMgr->GetOption<bool>("CoA.MysticEnchants.SkipMissingSpells", true);
+    bool const skipDuds = sConfigMgr->GetOption<bool>("CoA.MysticEnchants.SkipDudSpells", true);
+    std::unordered_map<uint32, bool> const overrides = LoadRollOverrides();
+    uint32 forcedOut = 0;
+    for (Enchant& enchant : Loaded.Rows)
+        if (auto const itr = overrides.find(enchant.Spell); itr != overrides.end() && !itr->second && enchant.Weight > 0.0f)
+        {
+            enchant.Weight = 0.0f;
+            ++forcedOut;
+        }
+    if (forcedOut)
+        LOG_INFO("coa", "Mystic enchants kept out of rolls by wcme_enchant_override: {}", forcedOut);
+    if (!skipMissing && !skipDuds)
+        return;
+
+    // Enchant spells given behaviour by the CoA enchant tables.
+    std::unordered_set<uint32> tableSpells;
+    for (char const* query : { "SELECT DISTINCT enchant_spell FROM coa_mystic_enchant_proc",
+                               "SELECT DISTINCT enchant_spell FROM coa_mystic_enchant_aura_link" })
+        if (QueryResult result = WorldDatabase.Query(query))
+            do
+                tableSpells.insert(result->Fetch()[0].Get<uint32>());
+            while (result->NextRow());
+
+    uint32 missing = 0, duds = 0;
+    for (Enchant& enchant : Loaded.Rows)
+    {
+        if (!enchant.Spell || enchant.Weight <= 0.0f || overrides.contains(enchant.Spell))
+            continue;
+        // What the enchant does: the spell it teaches when it teaches one, else its own spell.
+        uint32 const effective = enchant.Taught ? enchant.Taught : enchant.Spell;
+        if (SpellMissing(enchant.Spell) || SpellMissing(effective))
+        {
+            if (skipMissing)
+            {
+                enchant.Weight = 0.0f;
+                ++missing;
+            }
+            continue;
+        }
+        if (skipDuds && SpellIsPlaceholder(sSpellMgr->GetSpellInfo(effective)) &&
+            !SpellHasBehaviour(effective, tableSpells) && !SpellHasBehaviour(enchant.Spell, tableSpells))
+        {
+            enchant.Weight = 0.0f;
+            ++duds;
+        }
+    }
+    LOG_INFO("coa", "Mystic enchants left out of rolls: {} whose spell does not exist, {} whose spell does nothing "
+        "on this server (both come back once fixed; see CoA.MysticEnchants.SkipMissingSpells/SkipDudSpells)",
+        missing, duds);
+}
+
+// An enchant put on with the GM command .aura (testing) also teaches its spell, as it does through the altar.
+class WcmeTaughtOnAura final : public UnitScript
+{
+public:
+    WcmeTaughtOnAura() : UnitScript("WcmeTaughtOnAura", true, { UNITHOOK_ON_AURA_APPLY }) { }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (!Ready || !unit || !aura || !unit->IsPlayer())
+            return;
+        Enchant const* enchant = Loaded.FindSpell(aura->GetId());
+        Player* player = unit->ToPlayer();
+        if (enchant && enchant->Taught && !player->HasSpell(enchant->Taught))
+            player->learnSpell(enchant->Taught, true);
+    }
+};
