+// CoA.MysticEnchants.SkipMissingSpells: an enchant whose spell the server does not have would be
+// applied and do nothing. Checked against the loaded spells at every startup (Spell.dbc and
+// spell_dbc), never a fixed list: an enchant whose spell is added later rolls again after the
+// next restart. Only rolls are affected; enchants already owned or collected stay as they are.
+void SkipMissingSpells()
+{
+    if (!sConfigMgr->GetOption<bool>("CoA.MysticEnchants.SkipMissingSpells", true))
+        return;
+    uint32 skipped = 0;
+    for (Enchant& enchant : Loaded.Rows)
+        if (enchant.Spell && enchant.Weight > 0.0f && !sSpellMgr->GetSpellInfo(enchant.Spell))
+        {
+            enchant.Weight = 0.0f;
+            ++skipped;
+        }
+    LOG_INFO("coa", "Mystic enchants: {} left out of rolls because their spell does not exist "
+        "(they roll again once the spell is added)", skipped);
+}
+
 class AscensionMysticEnchantWorld final : public WorldScript
 {
 public:
@@ -1015,7 +1034,10 @@ public:
     {
         Ready = LoadCatalog(Loaded);
         if (Ready)
+        {
             LoadLinks();
+            SkipMissingSpells();
+        }
         if (!Ready)
             LOG_ERROR("coa", "Mystic enchants are unavailable: MysticEnchant.dbc did not load");
     }
