+// Epic batch 2 hooks:
+// - I Have The High Ground (81090): 3% more damage when you are more than 5 yards above your target.
+// - Companions (81418-81422): your hunter pet's auto attacks deal 10% less while one is on (their own -10).
+// - Titanic Finale (954436): while the Enrage talent's buff is on you, you also have 954437 (+5% melee attack speed),
+//   for as long as Enrage lasts.
+class wcme_epic_batch2_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch2_hooks() : UnitScript("wcme_epic_batch2_hooks", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_MELEE_DAMAGE, UNITHOOK_ON_AURA_APPLY,
+        UNITHOOK_ON_AURA_REMOVE }) { }
+
+    static int64 HighGround(Unit* target, Unit* attacker, int64 value)
+    {
+        if (attacker->HasAura(81090) && attacker->GetPositionZ() > target->GetPositionZ() + 5.0f)
+            value = value * 103 / 100;
+        return value;
+    }
+
+    static bool EnrageTalentBuff(SpellInfo const* info)
+    {
+        return info->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeNamed(info, "Enrage") && info->GetDuration() > 0 &&
+            info->GetDuration() <= 30000;
+    }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (unit && aura && unit->HasAura(954436) && EnrageTalentBuff(aura->GetSpellInfo()))
+            if (Aura* speed = unit->AddAura(954437, unit))
+            {
+                speed->SetMaxDuration(aura->GetMaxDuration());
+                speed->SetDuration(aura->GetDuration());
+            }
+    }
+
+    void OnAuraRemove(Unit* unit, AuraApplication* aurApp, AuraRemoveMode /*mode*/) override
+    {
+        if (unit && aurApp && EnrageTalentBuff(aurApp->GetBase()->GetSpellInfo()))
+            unit->RemoveAurasDueToSpell(954437);
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        if (!target || !attacker || !damage || target == attacker)
+            return;
+        int64 value = HighGround(target, attacker, damage);
+        if (attacker->IsPet())
+            if (Unit* owner = attacker->GetOwner())
+                if (WcmeHasAnyAura(owner, { 81418, 81419, 81420, 81421, 81422 }))
+                    value = value * 90 / 100;
+        damage = uint32(std::min<int64>(UINT32_MAX, value));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* /*spellInfo*/) override
+    {
+        if (target && attacker && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, HighGround(target, attacker, damage)));
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* /*spellInfo*/) override
+    {
+        if (target && attacker && damage > 0 && target != attacker)
+            damage = int32(std::min<int64>(INT32_MAX, HighGround(target, attacker, damage)));
+    }
+};
