+// Unrelenting Wrath (965288): each damaging Hunter ability cast adds a stack of Unrelenting Assault (once per cast); 10
+// stacks give a charge of Unrelenting Wrath, which lets you cast Unrelenting Wrath (taught while the enchant is active).
+class spell_wcme_unrelenting_wrath : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_unrelenting_wrath);
+
+    static constexpr uint32 ASSAULT = 983870;
+    static constexpr uint32 CHARGE = 983873;
+    static constexpr uint8 MAX_CHARGES = 2;   // "a charge"; no limit survives, 2 assumed
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) && spell->SpellFamilyName == SPELLFAMILY_HUNTER &&
+            !spell->IsPositive() && WcmeDealsDamage(spell);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (!WcmeAddStacks(owner, ASSAULT, 1, 10))
+            return;
+        if (Aura* charges = owner->GetAura(CHARGE))
+        {
+            if (charges->GetStackAmount() < MAX_CHARGES)
+                charges->SetStackAmount(charges->GetStackAmount() + 1);
+            charges->RefreshDuration();
+        }
+        else
+            WcmeAddStacks(owner, CHARGE, 1, 0);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_unrelenting_wrath::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_unrelenting_wrath::HandleProc);
+    }
+};
