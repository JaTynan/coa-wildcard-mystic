+// Heavyweight (977700): every Warrior attack that deals weapon damage adds a stack of Heavyweight (977701: +4% Physical
+// damage, slower swings, up to 5); a plain auto attack clears them, so Heroic Strike keeps them going. At 5 stacks you
+// are Ready to Strike (977706): your next melee swing also Crushes enemies in front of you (977703, 630% unnormalized
+// weapon damage).
+class spell_wcme_heavyweight : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_heavyweight);
+
+    static constexpr uint32 HEAVYWEIGHT = 977701;
+    static constexpr uint32 READY = 977706;
+    static constexpr uint32 CRUSH = 977703;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || target == GetTarget() || !WcmeDealtDamage(eventInfo))
+            return false;
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell)
+            return eventInfo.GetTypeMask() & PROC_FLAG_DONE_MELEE_AUTO_ATTACK;
+        return spell->Id != CRUSH && spell->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeDealsAnyDamage(spell) &&
+            spell->DmgClass == SPELL_DAMAGE_CLASS_MELEE;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (owner->HasAura(READY))
+        {
+            owner->RemoveAurasDueToSpell(READY);
+            owner->CastSpell(target, CRUSH, true);
+        }
+        if (!eventInfo.GetSpellInfo())
+        {
+            owner->RemoveAurasDueToSpell(HEAVYWEIGHT);
+            return;
+        }
+        WcmeAddStacks(owner, HEAVYWEIGHT, 1, 0);
+        if (Aura* stacks = owner->GetAura(HEAVYWEIGHT); stacks && stacks->GetStackAmount() >= 5)
+        {
+            stacks->SetStackAmount(5);
+            owner->CastSpell(owner, READY, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_heavyweight::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_heavyweight::HandleProc);
+    }
+};
