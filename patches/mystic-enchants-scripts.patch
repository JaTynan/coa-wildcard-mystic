+
+    void CalcPlayer(AuraEffect const* /*aurEff*/, int32& amount, bool& /*canBeRecalculated*/)
+    {
+        if (GetUnitOwner() && !GetUnitOwner()->IsControlledByPlayer())
+            amount = 0;
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_wcme_necromancers_touch::CalcCreature, EFFECT_0, SPELL_AURA_MOD_DAMAGE_FROM_CASTER);
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_wcme_necromancers_touch::CalcPlayer, EFFECT_1, SPELL_AURA_MOD_DAMAGE_FROM_CASTER);
+    }
+};
