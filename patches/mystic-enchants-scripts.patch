+// Mana Fiend (977870): +25% Intellect (the enchant's unused second effect becomes that, in Validate) and Mana Fiend's
+// Mind Focus (990218) is taught. Arcane direct damage spells and damaging Arcane melee abilities make your next melee
+// auto attack a Manacharged Strike instead (wcme_kit5_hooks, WcmeManachargedStrike). While in Delirium (977876, its
+// own script): Arcane spells cost no mana (977873, cost effect set to -100%), you cannot gain mana
+// (wcme_mana_fiend_regen), and every second Delirium gains a stack (no limit) and drains 1% of your base mana per stack.
+// Falling below 20% mana ends it in Recovery (WcmeManaFiendRecover).
+class spell_wcme_mana_fiend : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_mana_fiend);
+
+    static constexpr std::array<uint32, 1> MIND_FOCUS = { 990218 };
+
+    bool Validate(SpellInfo const* spellInfo) override
+    {
+        SpellEffectInfo& intellect = const_cast<SpellInfo*>(spellInfo)->Effects[EFFECT_1];
+        if (intellect.Effect == SPELL_EFFECT_APPLY_AURA && intellect.ApplyAuraName == SPELL_AURA_ADD_FLAT_MODIFIER)
+        {
+            intellect.ApplyAuraName = SPELL_AURA_MOD_TOTAL_STAT_PERCENTAGE;
+            intellect.MiscValue = STAT_INTELLECT;
+            intellect.BasePoints = 24;
+            intellect.DieSides = 1;
+        }
+        return true;
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { WcmeSyncTaughtRank(GetTarget(), MIND_FOCUS, true); }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncTaughtRank(GetTarget(), MIND_FOCUS, false);
+        WcmeManaFiendArmed.erase(GetTarget()->GetGUID());
+        GetTarget()->RemoveAurasDueToSpell(DELIRIUM);
+        GetTarget()->RemoveAurasDueToSpell(DELIRIUM_COST);
+    }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        Aura* delirium = owner->GetAura(DELIRIUM);
+        if (!delirium)
+            return;
+        if (owner->GetPowerPct(POWER_MANA) < 20.0f)
+        {
+            WcmeManaFiendRecover(owner);
+            return;
+        }
+        if (delirium->GetStackAmount() < 255)
+            delirium->ModStackAmount(1);
+        delirium->RefreshDuration();
+        int32 const drain = std::min<int32>(int32(owner->GetCreateMana() * delirium->GetStackAmount() / 100), int32(owner->GetPower(POWER_MANA)));
+        owner->ModifyPower(POWER_MANA, -drain);
+        WcmeDeliriumDrained[owner->GetGUID()] += uint32(drain);
+        WcmeDeliriumMana[owner->GetGUID()] = owner->GetPower(POWER_MANA);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->Id != MANACHARGED_STRIKE && (spell->GetSchoolMask() & SPELL_SCHOOL_MASK_ARCANE) && eventInfo.GetActionTarget() &&
+            !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        WcmeManaFiendArmed.insert(GetTarget()->GetGUID());
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_mana_fiend::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_mana_fiend::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_mana_fiend::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_mana_fiend::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_mana_fiend::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_mana_fiend::HandleProc);
+    }
+};
