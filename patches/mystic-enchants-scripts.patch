+// Legacy of the Arcanist (984117): your Fire, Nature, Frost and Arcane spell hits summon an Arcanist's Meteor of that
+// element on the target (984118, 984130, 984122, 984126: damage split between the target and enemies within 8 yards,
+// and a stack of Potential, 984138), each element at most once every 8 sec; a spell of several schools uses the first
+// of Fire, Nature, Frost, Arcane. A Meteor also gives you the next Elemental Mote in the cycle Arcane, Fire, Frost,
+// Nature (984141, 984139, 984140, 984142) if you have none. At 4 Potential stacks they are spent with your Mote for
+// that element's Resonance (984408, 984406, 984407, 984409: school damage and 10% crit, 10 sec), which also lowers your
+// damage with the other three elements by 30% (9990022 to 9990025); when it ends, that element's Meteor is ready again.
+class spell_wcme_legacy_of_the_arcanist : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_legacy_of_the_arcanist);
+
+    struct Element
+    {
+        SpellSchoolMask School;
+        uint32 Meteor;
+        uint32 Mote;
+        uint32 Resonance;
+        uint32 Penalty;
+    };
+
+    static constexpr uint32 POTENTIAL = 984138;
+    static constexpr Seconds METEOR_COOLDOWN{8};
+    // trigger priority: Fire, Nature, Frost, Arcane
+    static constexpr std::array<Element, 4> ELEMENTS = { {
+        { SPELL_SCHOOL_MASK_FIRE, 984118, 984139, 984406, 9990023 },
+        { SPELL_SCHOOL_MASK_NATURE, 984130, 984142, 984409, 9990025 },
+        { SPELL_SCHOOL_MASK_FROST, 984122, 984140, 984407, 9990024 },
+        { SPELL_SCHOOL_MASK_ARCANE, 984126, 984141, 984408, 9990022 } } };
+    // mote cycle: Arcane, Fire, Frost, Nature (indexes into ELEMENTS)
+    static constexpr std::array<uint8, 4> MOTE_CYCLE = { 3, 0, 2, 1 };
+    std::array<TimePoint, 4> _ready{};
+    uint8 _nextMote = 0;
+
+    static bool IsMeteor(uint32 spellId)
+    {
+        for (Element const& element : ELEMENTS)
+            if (element.Meteor == spellId)
+                return true;
+        return false;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && !IsMeteor(spell->Id) && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) &&
+            !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            (spell->GetSchoolMask() & (SPELL_SCHOOL_MASK_FIRE | SPELL_SCHOOL_MASK_NATURE | SPELL_SCHOOL_MASK_FROST | SPELL_SCHOOL_MASK_ARCANE));
+    }
+
+    void Resonate(Unit* owner)
+    {
+        owner->RemoveAurasDueToSpell(POTENTIAL);
+        for (uint8 index = 0; index < ELEMENTS.size(); ++index)
+        {
+            Element const& element = ELEMENTS[index];
+            if (!owner->HasAura(element.Mote))
+                continue;
+            owner->RemoveAurasDueToSpell(element.Mote);
+            Aura* resonance = owner->AddAura(element.Resonance, owner);
+            int32 const duration = resonance ? resonance->GetDuration() : 10000;
+            if (Aura* penalty = owner->AddAura(element.Penalty, owner))
+            {
+                penalty->SetMaxDuration(duration);
+                penalty->SetDuration(duration);
+            }
+            _ready[index] = std::min(_ready[index], GameTime::Now() + Milliseconds(duration));
+            return;
+        }
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellSchoolMask const schools = eventInfo.GetSpellInfo()->GetSchoolMask();
+        for (uint8 index = 0; index < ELEMENTS.size(); ++index)
+        {
+            Element const& element = ELEMENTS[index];
+            if (!(schools & element.School))
+                continue;
+            if (GameTime::Now() < _ready[index])
+                return;
+            _ready[index] = GameTime::Now() + METEOR_COOLDOWN;
+            owner->CastSpell(eventInfo.GetActionTarget(), element.Meteor, true);
+            bool hasMote = false;
+            for (Element const& other : ELEMENTS)
+                hasMote = hasMote || owner->HasAura(other.Mote);
+            if (!hasMote)
+            {
+                owner->AddAura(ELEMENTS[MOTE_CYCLE[_nextMote]].Mote, owner);
+                _nextMote = uint8((_nextMote + 1) % MOTE_CYCLE.size());
+            }
+            if (Aura* potential = owner->GetAura(POTENTIAL))
+                if (potential->GetStackAmount() >= potential->GetSpellInfo()->StackAmount)
+                    Resonate(owner);
+            return;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_legacy_of_the_arcanist::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_legacy_of_the_arcanist::HandleProc);
+    }
+};
+
+// Lava Sweep (417700): teaches Lava Sweep (417699, two-handed weapons other than staves, from the data) while you know
+// Lava Lash. Lava Sweep deals 50% more to your current target when your main-hand weapon carries Flametongue. Damage
+// from Lava Sweep, Lava Lash or Fire Blast adds a stack of Eruption (417707, up to 3) if you know Sundering. A
+// Pyroblast cast with 3 stacks spends them: Lava Sundering (417696), Lava Sweep's cooldown finished and Sweeper
+// (417705: the next Lava Sweep deals 40% more). Flame Shock casts grant Doomhammer's Fury (417701, with its Fire Blast
+// and Flame Shock part 417708); its own proc stays in 015.
+class spell_wcme_lava_sweep : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_lava_sweep);
+
+    static constexpr uint32 SWEEP = 417699;
+    static constexpr uint32 ERUPTION = 417707;
+    static constexpr uint32 SUNDERING = 417696;
+    static constexpr uint32 SWEEPER = 417705;
+    static constexpr uint32 DOOMHAMMERS_FURY = 417701;
+    static constexpr uint32 DOOMHAMMERS_FURY_SHOCKS = 417708;
+    static constexpr std::array<uint32, 1> TAUGHT = { SWEEP };
+
+    static bool Knows(Player* player, char const* name)
+    {
+        for (auto const& [spellId, known] : player->GetSpellMap())
+            if (known->State != PLAYERSPELL_REMOVED && spellId != SWEEP && WcmeNamed(sSpellMgr->GetSpellInfo(spellId), name))
+                return true;
+        return false;
+    }
+
+    void Sync(bool keep)
+    {
+        Player* player = GetTarget()->ToPlayer();
+        WcmeSyncTaughtRank(GetTarget(), TAUGHT, keep && player && Knows(player, "Lava Lash"));
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    static bool Flametongue(Unit* owner)
+    {
+        Player* player = owner->ToPlayer();
+        Item* weapon = player ? player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND) : nullptr;
+        if (!weapon)
+            return false;
+        SpellItemEnchantmentEntry const* enchant = sSpellItemEnchantmentStore.LookupEntry(weapon->GetEnchantmentId(TEMP_ENCHANTMENT_SLOT));
+        return enchant && enchant->description[LOCALE_enUS] && std::strstr(enchant->description[LOCALE_enUS], "Flametongue");
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return (WcmeNamed(spell, "Flame Shock") && spell->SpellFamilyName == SPELLFAMILY_SHAMAN) ||
+                (WcmeNamed(spell, "Pyroblast") && GetTarget()->GetAuraCount(ERUPTION) >= 3);
+        return eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) &&
+            (spell->Id == SWEEP || WcmeNamedAny(spell, { "Lava Lash", "Fire Blast" }));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamed(spell, "Flame Shock"))
+            {
+                owner->CastSpell(owner, DOOMHAMMERS_FURY, true);
+                owner->CastSpell(owner, DOOMHAMMERS_FURY_SHOCKS, true);
+                return;
+            }
+            owner->RemoveAurasDueToSpell(ERUPTION);
+            if (Unit* target = eventInfo.GetProcTarget())
+                owner->CastSpell(target, SUNDERING, true);
+            WcmeCutCooldownByName(owner, "Lava Sweep", 3600000);
+            owner->AddAura(SWEEPER, owner);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (spell->Id == SWEEP)
+        {
+            Spell const* sweep = eventInfo.GetProcSpell();
+            if (sweep && target == sweep->m_targets.GetUnitTarget() && Flametongue(owner))
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) / 2);
+            }
+            owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(SWEEPER); }, 200ms);
+        }
+        Player* player = owner->ToPlayer();
+        if (!player || !Knows(player, "Sundering"))
+            return;
+        if (Aura* eruption = owner->GetAura(ERUPTION))
+        {
+            if (eruption->GetStackAmount() < eruption->GetSpellInfo()->StackAmount)
+                eruption->SetStackAmount(eruption->GetStackAmount() + 1);
+            eruption->RefreshDuration();
+        }
+        else
+            owner->AddAura(ERUPTION, owner);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_lava_sweep::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_lava_sweep::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_lava_sweep::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_lava_sweep::HandleProc);
+    }
