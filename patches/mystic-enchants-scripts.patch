+// Eldritch Knight (81116): melee abilities while Eldritch Weapon is up grant Eldritch Knight (Eldritch Wrath grants
+// it itself); Eldritch Wrath hits apply Eldritch Condemnation. While Eldritch Knight is up, melee abilities restore
+// mana and add a stack of Anomaly; full stacks become Eldritch Horror.
+class spell_wcme_eldritch_knight : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_eldritch_knight);
+
+    static constexpr uint32 KNIGHT = 983715;
+    static constexpr uint32 MANA = 983712;
+    static constexpr uint32 ANOMALY = 983723;
+    static constexpr uint32 HORROR = 983722;
+    static constexpr uint32 CONDEMNATION = 983710;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return eventInfo.GetSpellInfo() && target && target != GetTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Eldritch Wrath"))
+        {
+            owner->CastSpell(eventInfo.GetActionTarget(), CONDEMNATION, true);
+            return;
+        }
+        if (spell->DmgClass != SPELL_DAMAGE_CLASS_MELEE)
+            return;
+        if (owner->HasAura(KNIGHT))
+        {
+            // 983712 restores a share of missing mana; its effect type would use maximum mana, so do it here
+            if (SpellInfo const* mana = sSpellMgr->GetSpellInfo(MANA))
+                if (uint32 const missing = owner->GetMaxPower(POWER_MANA) - owner->GetPower(POWER_MANA))
+                    owner->ModifyPower(POWER_MANA, int32(missing * uint32(std::max(0, mana->Effects[EFFECT_0].CalcValue())) / 100));
+            owner->CastSpell(owner, ANOMALY, true);
+            if (Aura const* anomaly = owner->GetAura(ANOMALY))
+            {
+                uint32 const full = anomaly->GetSpellInfo()->StackAmount;
+                if (full && anomaly->GetStackAmount() >= full)
+                {
+                    owner->RemoveAurasDueToSpell(ANOMALY);
+                    owner->CastSpell(owner, HORROR, true);
+                }
+            }
+        }
+        if (WcmeHasAnyAura(owner, { 983701, 270032, 270033, 852191, 1566917, 1566937, 1590944 }))
+            owner->CastSpell(owner, KNIGHT, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_eldritch_knight::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_eldritch_knight::HandleProc);
+    }
+};
