+// Hoplite (978217): Shield Slam shows as Shield Strike (978533), Sinister Strike as Thrust (978569) and Heroic Strike
+// as Javelin (982250) (WcmeSyncSwap); Flurry of Spears (901200) is taught while you know Siegebreaker. Phalanx Stance
+// (997743) is kept on you while you are in Battle Stance (wcme_kit_target_mods follows stance changes) and the Hoplite
+// abilities need it (spell_wcme_hoplite_ability). Polearm with a shield is allowed by 67-hoplite-polearm-shield.ps1.
+// Thrust hits during Bloodrage add Phalanx Strike (978539 and 978537); casting Bloodrage resets them. Colossus Smash on
+// a target Impaled by you (982251) finishes Javelin's cooldown and rips the Javelin out (Impaled and Skewered end).
+class spell_wcme_hoplite : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_hoplite);
+
+    static constexpr uint32 SHIELD_STRIKE = 978533;
+    static constexpr uint32 THRUST = 978569;
+    static constexpr uint32 JAVELIN = 982250;
+    static constexpr uint32 PHALANX_STANCE = 997743;
+    static constexpr uint32 PHALANX_THRUST = 978539;
+    static constexpr uint32 PHALANX_SHIELD = 978537;
+    static constexpr uint32 IMPALED = 982251;
+    static constexpr uint32 SKEWERED = 982252;
+    static constexpr std::array<uint32, 1> FLURRY = { 901200 };
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Shield Slam", SPELLFAMILY_WARRIOR, SHIELD_STRIKE, active);
+        WcmeSyncSwap(owner, "Sinister Strike", SPELLFAMILY_ROGUE, THRUST, active);
+        WcmeSyncSwap(owner, "Heroic Strike", SPELLFAMILY_WARRIOR, JAVELIN, active);
+        WcmeSyncTaughtRank(owner, FLURRY, active && WcmeKnowsPassive(owner, "Siegebreaker", SPELLFAMILY_WARRIOR));
+        if (active && owner->GetShapeshiftForm() == FORM_BATTLESTANCE && !owner->HasAura(PHALANX_STANCE))
+            owner->AddAura(PHALANX_STANCE, owner);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(PHALANX_STANCE);
+            owner->RemoveAurasDueToSpell(PHALANX_THRUST);
+            owner->RemoveAurasDueToSpell(PHALANX_SHIELD);
+            if (Player* player = owner->ToPlayer())
+                player->AutoUnequipOffhandIfNeed();
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (spell->SpellFamilyName != SPELLFAMILY_WARRIOR && spell->Id != THRUST))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeNamed(spell, "Bloodrage");
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (spell->Id == THRUST)
+            return WcmeHasAuraNamed(GetTarget(), "Bloodrage", SPELLFAMILY_WARRIOR);
+        return WcmeNamed(spell, "Colossus Smash") && target->HasAura(IMPALED, GetTarget()->GetGUID());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            owner->RemoveAurasDueToSpell(PHALANX_THRUST);
+            owner->RemoveAurasDueToSpell(PHALANX_SHIELD);
+            return;
+        }
+        if (spell->Id == THRUST)
+        {
+            WcmeAddStackOn(owner, owner, PHALANX_THRUST);
+            WcmeAddStackOn(owner, owner, PHALANX_SHIELD);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        WcmeCutCooldownByName(owner, "Javelin", 3600000);
+        target->RemoveAurasDueToSpell(IMPALED, owner->GetGUID());
+        target->RemoveAurasDueToSpell(SKEWERED, owner->GetGUID());
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_hoplite::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_hoplite::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_hoplite::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_hoplite::HandleProc);
+    }
+};
+
+// Thrust (978569), Shield Strike (978533), Javelin (982250) and Flurry of Spears (901200): need Phalanx Stance (997743).
+// Shield Strike also takes 2 sec per combo point off Bloodrage and has a 15% chance to grant Spear Mastery (901203).
+// Flurry of Spears remembers its combo points for its strikes (spell_wcme_flurry_of_spears_strike).
+class spell_wcme_hoplite_ability : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_hoplite_ability);
+
+    uint8 _combo = 0;
+
+    SpellCastResult CheckCast()
+    {
+        Unit* caster = GetCaster();
+        return !caster->HasAura(978217) || caster->HasAura(997743) ? SPELL_CAST_OK : SPELL_FAILED_ONLY_SHAPESHIFT;
+    }
+
+    void HandleBeforeCast()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        _combo = player ? player->GetComboPoints() : 0;
+        if (GetSpellInfo()->Id == 901200)
+            WcmeFlurryCombo[GetCaster()->GetGUID()] = std::max<uint8>(1, _combo);
