+// Vampire Lord (997126), with the healing path or Spirit as primary stat: Holy Light shows as Unholy Light (300084),
+// Prayer of Healing as Unholy Prayer (92770) and Vampiric Embrace as Vampire Lord (92778); Beacon of Shadow (92779) is
+// taught. With the Vampire Lord buff on, single-target Shadow spell damage heals you and party members within 30 yards
+// for 5% (2% from damage over time), 125% more on allies with your Vampiric Bond (997780). Shadow Bolt damage heals your
+// Beacon of Shadow target for 25%.
+class spell_wcme_vampire_lord : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_vampire_lord);
+
+    static constexpr uint32 UNHOLY_LIGHT = 300084;
+    static constexpr uint32 UNHOLY_PRAYER = 92770;
+    static constexpr uint32 VAMPIRE_LORD = 92778;
+    static constexpr uint32 BEACON = 92779;
+    static constexpr uint32 BOND = 997780;
+    static constexpr std::array<uint32, 1> TAUGHT = { BEACON };
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        active = active && WcmePrimaryStatMet(owner, 84867, STAT_SPIRIT);
+        WcmeSyncSwap(owner, "Holy Light", SPELLFAMILY_PALADIN, UNHOLY_LIGHT, active);
+        WcmeSyncSwap(owner, "Prayer of Healing", SPELLFAMILY_PRIEST, UNHOLY_PRAYER, active);
+        WcmeSyncSwap(owner, "Vampiric Embrace", SPELLFAMILY_PRIEST, VAMPIRE_LORD, active);
+        WcmeSyncTaughtRank(owner, TAUGHT, active);
+        if (!active)
+            owner->RemoveAurasDueToSpell(VAMPIRE_LORD);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        return spell && target && target != GetTarget() && (spell->GetSchoolMask() & SPELL_SCHOOL_MASK_SHADOW) &&
+            WcmeDealtDamage(eventInfo) && !spell->IsAffectingArea();
+    }
+
+    static void Heal(Unit* owner, Unit* ally, SpellInfo const* spell, uint32 amount)
+    {
+        if (ally->HasAura(BOND, owner->GetGUID()))
+            amount = amount * 225 / 100;
+        if (!amount)
+            return;
+        HealInfo heal(owner, ally, amount, spell, spell->GetSchoolMask());
+        owner->HealBySpell(heal);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        uint32 const dealt = damage->GetDamage() + damage->GetAbsorb();
+        SpellInfo const* lord = sSpellMgr->GetSpellInfo(VAMPIRE_LORD);
+        if (owner->HasAura(VAMPIRE_LORD) && lord)
+        {
+            uint32 const share = dealt * ((eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) ? 2 : 5) / 100;
+            Heal(owner, owner, lord, share);
+            if (Player* player = owner->ToPlayer())
+                if (Group* group = player->GetGroup())
+                    for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                        if (Player* member = ref->GetSource())
+                            if (member != player && member->IsAlive() && member->IsInMap(player) && member->GetDistance(player) <= 30.0f)
+                                Heal(owner, member, lord, share);
+        }
+        if (!(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) && WcmeNamed(spell, "Shadow Bolt"))
+            if (auto beacon = WcmeShadowBeacon.find(owner->GetGUID()); beacon != WcmeShadowBeacon.end())
+                if (Unit* target = ObjectAccessor::GetUnit(*owner, beacon->second))
+                    if (target->IsAlive() && target->HasAura(BEACON, owner->GetGUID()))
+                        if (SpellInfo const* info = sSpellMgr->GetSpellInfo(BEACON))
+                        {
+                            HealInfo heal(owner, target, dealt * 25 / 100, info, info->GetSchoolMask());
+                            owner->HealBySpell(heal);
+                        }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_vampire_lord::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_vampire_lord::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_vampire_lord::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_vampire_lord::HandleProc);
+    }
+};
