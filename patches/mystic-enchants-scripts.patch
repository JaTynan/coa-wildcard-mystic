+// Deadly Bite (272353): Mongoose Bite, Counterattack or Savage Blade damage puts 40% of that hit into a bleed over
+// its duration; a new hit adds to what is left of the bleed and refreshes it.
+class spell_wcme_deadly_bite : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_deadly_bite);
+
+    static constexpr uint32 BLEED = 272355;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return target && target != GetTarget() && WcmeDealtDamage(eventInfo) &&
+            WcmeNamedAny(eventInfo.GetSpellInfo(), { "Mongoose Bite", "Counterattack", "Savage Blade" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* bleed = sSpellMgr->GetSpellInfo(BLEED);
+        AuraEffect const* share = GetEffect(EFFECT_0);
+        if (!bleed || !share || !bleed->Effects[EFFECT_1].Amplitude)
+            return;
+        int32 const ticks = std::max<int32>(1, bleed->GetMaxDuration() / bleed->Effects[EFFECT_1].Amplitude);
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        int64 total = int64(damage->GetDamage() + damage->GetAbsorb()) * share->GetAmount() / 100;
+        if (AuraEffect const* running = target->GetAuraEffect(BLEED, EFFECT_1, owner->GetGUID()))
+            total += int64(running->GetAmount()) * std::max<int32>(0, running->GetTotalTicks() - running->GetTickNumber());
+        int32 const perTick = int32(std::max<int64>(1, total / ticks));
+        target->RemoveAurasDueToSpell(BLEED, owner->GetGUID());
+        owner->CastCustomSpell(BLEED, SPELLVALUE_BASE_POINT1, perTick, target, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_deadly_bite::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_deadly_bite::HandleProc);
+    }
+};
