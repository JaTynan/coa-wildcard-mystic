+// Harbinger of Pestilence (990020): Insect Swarm becomes Insect Swarm (Plague) (the core's transform rule). Wrath and
+// Haunt hits give Harbinger of Pestilence (990022, up to 5; 2 stacks when the target is a player). Wrath has a 20%
+// chance to trigger Nightfall (Shadow Trance, 17941) if you know Nightfall. Haunt cast while you have stacks: Harbinger's
+// Bile (990024) on up to 5 enemies near the target, its damage times your stacks; each stack also takes 0.2 sec off
+// that Haunt's cooldown. The stacks' +22% disease damage (misc 38, "versus creatures") is applied in
+// wcme_kit_target_mods to diseases and Insect Swarm (Plague).
+class spell_wcme_harbinger_of_pestilence : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_harbinger_of_pestilence);
+
+    static constexpr uint32 STACKS = 990022;
+    static constexpr uint32 BILE = 990024;
+    static constexpr uint32 SHADOW_TRANCE = 17941;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || spell->Id == BILE)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeNamed(spell, "Haunt");
+        return WcmeNamedAny(spell, { "Wrath", "Haunt" }) && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            Aura const* stacks = owner->GetAura(STACKS);
+            Unit* target = eventInfo.GetActionTarget();
+            if (!stacks || !target)
+                return;
+            uint8 const count = stacks->GetStackAmount();
+            if (SpellInfo const* bile = sSpellMgr->GetSpellInfo(BILE))
+            {
+                int32 const damage = bile->Effects[EFFECT_0].CalcValue(owner) * count;
+                for (Unit* enemy : WcmeEnemiesNear(owner, target, 8.0f, 5))
+                    owner->CastCustomSpell(BILE, SPELLVALUE_BASE_POINT0, damage, enemy, true);
+            }
+            uint32 const haunt = spell->Id;
+            owner->m_Events.AddEventAtOffset([owner, haunt, count]()
+            {
+                if (Player* player = owner->ToPlayer())
+                    player->ModifySpellCooldown(haunt, -200 * int32(count));
+            }, 1ms);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        uint8 const add = target->IsControlledByPlayer() ? 2 : 1;
+        for (uint8 i = 0; i < add; ++i)
+            owner->CastSpell(owner, STACKS, true);
+        if (WcmeNamed(spell, "Wrath") && roll_chance_i(20) && owner->ToPlayer() &&
+            (owner->ToPlayer()->HasSpell(18094) || owner->ToPlayer()->HasSpell(18095)))
+            owner->CastSpell(owner, SHADOW_TRANCE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_harbinger_of_pestilence::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_harbinger_of_pestilence::HandleProc);
+    }
+};
