+// Lei Shen's Legacy (997129): Thunder Clap shows as Storm Smash (92806), Lightning Shield as Thunder Hide (92815) and
+// Stormstrike as Voltaic Bite (92826) (WcmeSyncSwap). Damaging Bear abilities in Bear Form add Volatile Discharge
+// (92832, up to 6). A Voltaic Bite hit at 3 or more stacks discharges Chain Lightning (if known, with the stacks' +10%)
+// at the target, then the stacks become charges of your Thunder Hide (if it is up) and end.
+class spell_wcme_lei_shens_legacy : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_lei_shens_legacy);
+
+    static constexpr uint32 STORM_SMASH = 92806;
+    static constexpr uint32 THUNDER_HIDE = 92815;
+    static constexpr uint32 VOLTAIC_BITE = 92826;
+    static constexpr uint32 VOLTAIC_BITE_HIT = 92830;
+    static constexpr uint32 DISCHARGE = 92832;
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Thunder Clap", SPELLFAMILY_WARRIOR, STORM_SMASH, active);
+        WcmeSyncSwap(owner, "Lightning Shield", SPELLFAMILY_SHAMAN, THUNDER_HIDE, active);
+        WcmeSyncSwap(owner, "Stormstrike", SPELLFAMILY_SHAMAN, VOLTAIC_BITE, active);
+        if (!active)
+            owner->RemoveAurasDueToSpell(DISCHARGE);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo) || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (spell->Id == VOLTAIC_BITE_HIT)
+            return GetTarget()->GetAuraCount(DISCHARGE) >= 3;
+        return spell->SpellFamilyName == SPELLFAMILY_DRUID && WcmeInBearForm(GetTarget());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetSpellInfo()->Id != VOLTAIC_BITE_HIT)
+        {
+            WcmeAddStackOn(owner, owner, DISCHARGE);
+            return;
+        }
+        uint8 const stacks = owner->GetAuraCount(DISCHARGE);
+        if (uint32 const chain = WcmeKnownByName(owner, "Chain Lightning", SPELLFAMILY_SHAMAN))
+            owner->CastSpell(eventInfo.GetActionTarget(), chain, true);
+        if (Aura* hide = owner->GetAura(THUNDER_HIDE))
+            hide->SetCharges(uint8(std::min<uint32>(255, hide->GetCharges() + stacks)));
+        owner->RemoveAurasDueToSpell(DISCHARGE);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_lei_shens_legacy::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_lei_shens_legacy::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_lei_shens_legacy::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_lei_shens_legacy::HandleProc);
+    }
+};
