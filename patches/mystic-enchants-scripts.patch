+// Forbidden Dance (986233): Ambush costs 30 less energy while it lasts (954338). When it ends you teleport back to
+// your Shadow (where the last Forbidden Technique shot was fired from), if it is on the same map and within 60 yards.
+class spell_wcme_forbidden_dance : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_forbidden_dance);
+
+    static constexpr uint32 AMBUSH_COST = 954338;
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        GetTarget()->AddAura(AMBUSH_COST, GetTarget());
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        owner->RemoveAurasDueToSpell(AMBUSH_COST);
+        auto spot = WcmeShadowSpot.find(owner->GetGUID());
+        if (spot == WcmeShadowSpot.end())
+            return;
+        WorldLocation const back = spot->second;
+        WcmeShadowSpot.erase(spot);
+        if (owner->IsAlive() && back.GetMapId() == owner->GetMapId() && owner->GetExactDist(&back) <= 60.0f)
+            owner->NearTeleportTo(back.GetPositionX(), back.GetPositionY(), back.GetPositionZ(), back.GetOrientation());
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_forbidden_dance::HandleApply, EFFECT_0, SPELL_AURA_EFFECT_IMMUNITY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_forbidden_dance::HandleRemove, EFFECT_0, SPELL_AURA_EFFECT_IMMUNITY, AURA_EFFECT_HANDLE_REAL);
+    }
+};
