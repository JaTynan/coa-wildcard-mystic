+// Holy Templar (1554908): Templar's Verdict (1554911) and Word of Glory (1554912) are taught. Holy Power (1554910) is
+// gained through the core's own proc rows; here the "3 Holy Power" marker (1554919, which both abilities need) is kept
+// on you only while you have 3 or more, checked every quarter second. spell_wcme_holy_power_spender spends 3.
+class spell_wcme_holy_templar : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_holy_templar);
+
+    static constexpr uint32 HOLY_POWER = 1554910;
+    static constexpr uint32 MARKER = 1554919;
+    static constexpr std::array<uint32, 1> VERDICT = { 1554911 };
+    static constexpr std::array<uint32, 1> GLORY = { 1554912 };
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 250;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncTaughtRank(owner, VERDICT, active);
+        WcmeSyncTaughtRank(owner, GLORY, active);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(HOLY_POWER);
+            owner->RemoveAurasDueToSpell(MARKER);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        bool const ready = owner->GetAuraCount(HOLY_POWER) >= 3;
+        if (ready && !owner->HasAura(MARKER))
+            owner->AddAura(MARKER, owner);
+        else if (!ready && owner->HasAura(MARKER))
+            owner->RemoveAurasDueToSpell(MARKER);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_holy_templar::CalcPeriod, EFFECT_0, SPELL_AURA_PERIODIC_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_holy_templar::HandleApply, EFFECT_0, SPELL_AURA_PERIODIC_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_holy_templar::HandleRemove, EFFECT_0, SPELL_AURA_PERIODIC_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_holy_templar::HandleTick, EFFECT_0, SPELL_AURA_PERIODIC_DUMMY);
+    }
+};
