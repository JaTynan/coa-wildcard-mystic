+// Defias Gunslinger (997047): Multi-Shot shows as Grape Shot (300191) and Sinister Strike as Pistol Shot (997048)
+// (WcmeSyncSwap), and Defias Tactics (997051: 0.5 sec less global cooldown, its data's Mongoose Bite and Raptor Strike
+// mask) is kept on you. Pistol Shot hits add Gunslinger's Strike (997050, up to 3). Pistol Shot and Grape Shot casts
+// take 1.5 sec off Raptor Strike and Mongoose Bite. A Mongoose Bite with Gunslinger's Strike adds Pirate's Flurry
+// (997429): 3 blows of 225% weapon damage over a second. Mongoose Bite or Raptor Strike spends Gunslinger's Strike.
+// Pistol Shot triggers Piercing Shots and Master Tactician as its description says. Against players Gunslinger's
+// Strike adds 5% per stack to Mongoose Bite (wcme_kit_damage_hooks). The single one-handed weapon rule and Grape Shot's
+// own cooldown are handled by spell_wcme_gunslinger_shot.
+class spell_wcme_defias_gunslinger : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_defias_gunslinger);
+
+    static constexpr uint32 GRAPE_SHOT = 300191;
+    static constexpr uint32 PISTOL_SHOT = 997048;
+    static constexpr uint32 STRIKE = 997050;
+    static constexpr uint32 TACTICS = 997051;
+    static constexpr uint32 FLURRY = 997429;
+
+    static AuraEffect const* Talent(Unit* owner, char const* name)
+    {
+        for (AuraEffect const* effect : owner->GetAuraEffectsByType(SPELL_AURA_PROC_TRIGGER_SPELL))
+            if (effect->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamed(effect->GetSpellInfo(), name))
+                return effect;
+        return nullptr;
+    }
+
+    // Pistol Shot's description says it can trigger Piercing Shots and Master Tactician (Expose Weakness already
+    // triggers from any critical strike); those talents only look at Hunter spells, so this does it for them.
+    static void PistolShotTalents(Unit* owner, ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        if (AuraEffect const* piercing = Talent(owner, "Piercing Shots"))
+            if ((eventInfo.GetHitMask() & PROC_HIT_CRITICAL) && damage->GetDamage())
+                if (SpellInfo const* bleed = sSpellMgr->GetSpellInfo(63468); bleed && bleed->GetMaxTicks() > 0)
+                    target->CastDelayedSpellWithPeriodicAmount(owner, bleed->Id, SPELL_AURA_PERIODIC_DAMAGE,
+                        CalculatePct(int32(damage->GetDamage()), piercing->GetAmount()) / int32(bleed->GetMaxTicks()));
+        if (AuraEffect const* tactician = Talent(owner, "Master Tactician"))
+            if (uint32 const trigger = tactician->GetSpellInfo()->Effects[tactician->GetEffIndex()].TriggerSpell)
+                if (roll_chance_i(int32(tactician->GetSpellInfo()->ProcChance)))
+                    owner->CastSpell(owner, trigger, true);
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Multi-Shot", SPELLFAMILY_HUNTER, GRAPE_SHOT, active);
+        WcmeSyncSwap(owner, "Sinister Strike", SPELLFAMILY_ROGUE, PISTOL_SHOT, active);
+        if (active && !owner->HasAura(TACTICS))
+            owner->AddAura(TACTICS, owner);
+        else if (!active)
+            owner->RemoveAurasDueToSpell(TACTICS);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell)
+            return false;
+        bool const shot = spell->Id == PISTOL_SHOT || spell->Id == GRAPE_SHOT;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return shot;
+        if (!eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo))
+            return false;
+        return spell->Id == PISTOL_SHOT ||
+            (spell->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamedAny(spell, { "Mongoose Bite", "Raptor Strike" }) &&
+                GetTarget()->HasAura(STRIKE));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            WcmeCutCooldownByName(owner, "Raptor Strike", 1500);
+            WcmeCutCooldownByName(owner, "Mongoose Bite", 1500);
+            return;
+        }
+        if (spell->Id == PISTOL_SHOT)
+        {
+            WcmeAddStackOn(owner, owner, STRIKE);
+            PistolShotTalents(owner, eventInfo);
+            return;
+        }
+        owner->RemoveAurasDueToSpell(STRIKE);
+        if (!WcmeNamed(spell, "Mongoose Bite"))
+            return;
+        ObjectGuid const targetGuid = eventInfo.GetActionTarget()->GetGUID();
+        for (uint8 blow = 0; blow < 3; ++blow)
+            owner->m_Events.AddEventAtOffset([owner, targetGuid]()
+            {
+                if (Unit* victim = ObjectAccessor::GetUnit(*owner, targetGuid))
+                    if (victim->IsAlive())
+                        owner->CastCustomSpell(FLURRY, SPELLVALUE_BASE_POINT0, 225, victim, true);
+            }, Milliseconds(blow * 333));
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_defias_gunslinger::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_defias_gunslinger::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_defias_gunslinger::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_defias_gunslinger::HandleProc);
+    }
+};
