+// Epic batch 1 hooks:
+// - Flash of Adrenaline (84453 / 282309): when Adrenaline Rush expires, Sprint's cooldown is finished.
+// - Blinding Dispersion (283428 / 954634): when Dispersion ends, a shadow nova disorients enemies around you for 2 sec
+//   (283429 / 954635, their own area and duration).
+// - Do The Stance Dance (81216): switching stances adds 6 sec to your Bloodrage, if it is running.
+// - Spectre (81186): your periodic damage deals 10% more while you are stealthed.
+// - Pestilent Opportunist (81188): your diseases deal 5% more to targets with one of your bleeds.
+// - Down For The Count: 81263, Killing Spree deals 10% more to a target with a bleed or poison (anyone's); 281649,
+//   Killing Spree hits on such a target strike again for 25% of the damage (15% against players).
+// - Duck Hunting (81110): your damage is 3% higher when the target is more than 5 yards above you, and your damaging
+//   spells remove Slow Fall from the target.
+// - Freedom by Death (954128 / 283360): taking damage from your own Shadow Word: Death while stunned, feared,
+//   disoriented, rooted, silenced or pacified gives 954129 / 283361 (+20% damage and healing, 6 sec). Its cooldown cut
+//   is its own data.
+// - Group Think (81453 / 282009 / 1581626): your pet (or charmed or tamed minion) deals 20% more while you have Berserk.
+// Elemental Torrent (1180420) used to be here; review 2026-11-18 found the core already does it (its
+// coa_mystic_enchant_minion_aura listener 1180421 on your minions), so ours gave two haste stacks per Waterbolt.
+class wcme_epic_batch1_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch1_hooks() : UnitScript("wcme_epic_batch1_hooks", true, { UNITHOOK_ON_AURA_REMOVE,
+        UNITHOOK_ON_UNIT_SET_SHAPESHIFT_FORM, UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN, UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK,
+        UNITHOOK_MODIFY_MELEE_DAMAGE }) { }
+
+    void OnAuraRemove(Unit* unit, AuraApplication* aurApp, AuraRemoveMode mode) override
+    {
+        if (!unit || !aurApp)
+            return;
+        SpellInfo const* info = aurApp->GetBase()->GetSpellInfo();
+        if (info->SpellFamilyName == SPELLFAMILY_ROGUE && WcmeNamed(info, "Adrenaline Rush") &&
+            mode == AURA_REMOVE_BY_EXPIRE && WcmeHasAnyAura(unit, { 84453, 282309 }))
+            WcmeCutCooldownByName(unit, "Sprint", 600000);
+        if (info->SpellFamilyName == SPELLFAMILY_PRIEST && WcmeNamed(info, "Dispersion") && mode != AURA_REMOVE_BY_DEATH)
+        {
+            uint32 const nova = unit->HasAura(283428) ? 283429 : unit->HasAura(954634) ? 954635 : 0;
+            if (nova)
+                unit->m_Events.AddEventAtOffset([unit, nova]() { if (unit->IsAlive()) unit->CastSpell(unit, nova, true); },
+                    1ms);
+        }
+    }
+
+    void OnUnitSetShapeshiftForm(Unit* unit, uint8 form) override
+    {
+        if (!unit || !unit->HasAura(81216) || (form != FORM_BATTLESTANCE && form != FORM_DEFENSIVESTANCE &&
+            form != FORM_BERSERKERSTANCE))
+            return;
+        for (auto const& [id, app] : unit->GetAppliedAuras())
+        {
+            Aura* aura = app->GetBase();
+            if (aura->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeNamed(aura->GetSpellInfo(), "Bloodrage") &&
+                aura->GetDuration() > 0)
+            {
+                aura->SetMaxDuration(aura->GetMaxDuration() + 6000);
+                aura->SetDuration(aura->GetDuration() + 6000);
+            }
+        }
+    }
+
+    static Player* TamingOwner(Unit* attacker)
+    {
+        if (attacker->IsPlayer())
+            return nullptr;
+        Unit* owner = attacker->GetCharmerOrOwner();
+        Player* player = owner ? owner->ToPlayer() : nullptr;
+        if (!player || !(attacker->IsPet() || attacker->IsCharmed() || attacker == player->GetPet()))
+            return nullptr;
+        return player;
+    }
+
+    static int64 Common(Unit* target, Unit* attacker, SpellInfo const* spell, int64 value, bool periodic)
+    {
+        if (Player* owner = TamingOwner(attacker))
+            if (WcmeHasAnyAura(owner, { 81453, 282009, 1581626 }) && WcmeHasAuraNamed(owner, "Berserk", SPELLFAMILY_DRUID))
+                value = value * 120 / 100;
+        if (attacker->HasAura(81110) && target->GetPositionZ() > attacker->GetPositionZ() + 5.0f)
+            value = value * 103 / 100;
+        if (periodic && spell)
+        {
+            if (attacker->HasAura(81186) && attacker->HasStealthAura())
+                value = value * 110 / 100;
+            if (attacker->HasAura(81188) && spell->Dispel == DISPEL_DISEASE && WcmeHasBleedFrom(target, attacker))
+                value = value * 105 / 100;
+        }
+        return value;
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        if (target && attacker && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, Common(target, attacker, nullptr, damage, false)));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, Common(target, attacker, spellInfo, damage, true)));
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0)
+            return;
+        if (target == attacker)
+        {
+            if (WcmeNamed(spellInfo, "Shadow Word: Death") && WcmeHasCrowdControl(target))
+            {
+                if (target->HasAura(954128))
+                    target->CastSpell(target, 954129, true);
+                else if (target->HasAura(283360))
+                    target->CastSpell(target, 283361, true);
+            }
+            return;
+        }
+        int64 value = Common(target, attacker, spellInfo, damage, false);
+        if (attacker->HasAura(81110) && target->HasAuraType(SPELL_AURA_FEATHER_FALL))
+        {
+            ObjectGuid const guid = target->GetGUID();
+            attacker->m_Events.AddEventAtOffset([attacker, guid]()
+            {
+                if (Unit* victim = ObjectAccessor::GetUnit(*attacker, guid))
+                    victim->RemoveAurasByType(SPELL_AURA_FEATHER_FALL);
+            }, 1ms);
+        }
+        if (WcmeNamed(spellInfo, "Killing Spree") && !WcmeInExtraStrike && (WcmeHasBleedFrom(target, nullptr) ||
+            WcmeHasPoison(target)))
+        {
+            if (attacker->HasAura(81263))
+                value = value * 110 / 100;
+            if (attacker->HasAura(281649))
+            {
+                int64 const share = value * (target->IsControlledByPlayer() ? 15 : 25) / 100;
+                ObjectGuid const guid = target->GetGUID();
+                uint32 const spellId = spellInfo->Id;
+                attacker->m_Events.AddEventAtOffset([attacker, guid, share, spellId]()
+                {
+                    Unit* victim = ObjectAccessor::GetUnit(*attacker, guid);
+                    SpellInfo const* strike = sSpellMgr->GetSpellInfo(spellId);
+                    if (!victim || !strike)
+                        return;
+                    WcmeInExtraStrike = true;
+                    WcmeExtraDamage(attacker, victim, strike, share);
+                    WcmeInExtraStrike = false;
+                }, 1ms);
+            }
+        }
+        damage = int32(std::min<int64>(INT32_MAX, value));
+    }
+};
+
+// ===== Epic batch 2 =====
+
+static bool WcmeSwashbuckling(Unit const* unit)
+{
+    Player const* player = unit->ToPlayer();
+    if (!player || player->GetShapeshiftForm() != FORM_NONE)
+        return false;
+    Item const* main = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND);
+    uint32 const type = main ? main->GetTemplate()->InventoryType : 0;
+    return (type == INVTYPE_WEAPON || type == INVTYPE_WEAPONMAINHAND) &&
+        !player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+}
+
+static bool WcmeCastKnownNamed(Unit* unit, char const* name, SpellFamilyNames family)
+{
+    Player* player = unit->ToPlayer();
+    if (!player)
+        return false;
+    for (auto const& [id, spell] : player->GetSpellMap())
+    {
+        if (spell->State == PLAYERSPELL_REMOVED || !spell->Active)
+            continue;
+        SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+        if (info && info->SpellFamilyName == family && WcmeNamed(info, name) && !info->IsPassive())
+        {
+            player->CastSpell(player, id, true);
+            return true;
+        }
+    }
+    return false;
+}
+
+// Finishing-move procs, 20% chance per combo point spent (10% for none here), checked at the cast while the combo
+// points are still on you:
+// - Cobra Combo (979106 / 284148): your pet gets 979105 (+15% critical strike chance).
+// - Double Team (275094): 275096 on you (your pet's special attacks hit harder; its own data).
+// - Deadly Combo (977856): needs Sudden Death; triggers Sudden Death (52437) and Deadly Combo (954353) through 977858.
+//   283833: Sudden Death only (283835), and needs Sudden Death unless you have 973827.
+// - Enraging Finale (283405): Bloodrage, if you know it (always with 973827), at most once every 20 sec and not while
+//   Bloodrage is up.
+// - Titanic Finale (954436): the same Bloodrage proc from Rogue finishers while you can use Titan's Grip.
+// - Adrenaline Junkie (1589466): 12 sec off Adrenaline Rush (its 1589467 value).
+// - Swashbuckler: Bloodsail (983110): damaging finishers while Swashbuckling give a stack of Bloodsail Swashbuckling
+//   (983112, up to 10, 18 sec, the duration is not refreshed by new stacks) and the same number of stacks of 983113
+//   (each main-hand auto attack gives 1 rage per stack, spell_wcme_bloodsail_rage). 285111: damaging finishers while
+//   Swashbuckling give 285115 (crit, up to 5).
+// - Poison Bomb (979113): Envenom and Eviscerate take 4 sec off Poison Bomb (the text's 4 sec; its helper 979165 says 2).
+// - Deadly Follow-up (979080): damaging finishers, 10% per combo point (the builder's number), give a charge of Poisoned
+//   Shiv (979082, up to 3), which Deadly Follow-up (979081) needs and spends.
+// - Party Recuperation (983475): 10% per combo point, a stack of Bubbling Tankard (983476, up to 4).
+class spell_wcme_finisher_combo : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_finisher_combo);
+
+    static bool Damaging(SpellInfo const* spell)
+    {
+        for (SpellEffectInfo const& effect : spell->GetEffects())
+            if (effect.IsEffect(SPELL_EFFECT_SCHOOL_DAMAGE) || effect.IsEffect(SPELL_EFFECT_WEAPON_DAMAGE) ||
+                effect.IsEffect(SPELL_EFFECT_WEAPON_PERCENT_DAMAGE) || effect.IsEffect(SPELL_EFFECT_NORMALIZED_WEAPON_DMG) ||
+                effect.IsEffect(SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL) || effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE)
+                return true;
+        return false;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !spell->NeedsComboPoints() || !(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) ||
+            !GetTarget()->GetComboPoints())
+            return false;
+        switch (GetId())
+        {
+            case 983110:
+            case 285111:
+                return Damaging(spell) && WcmeSwashbuckling(GetTarget());
+            case 954436:
+                return spell->SpellFamilyName == SPELLFAMILY_ROGUE && GetTarget()->ToPlayer() &&
+                    GetTarget()->ToPlayer()->CanTitanGrip();
+            case 979113:
+                return WcmeNamedAny(spell, { "Envenom", "Eviscerate" });
+            case 979080:
+                return Damaging(spell);
+            default:
+                return true;
+        }
+    }
+
+    bool BloodrageReady()
+    {
+        Unit* owner = GetTarget();
+        if (WcmeHasAuraNamed(owner, "Bloodrage", SPELLFAMILY_WARRIOR))
+            return false;
+        TimePoint const now = GameTime::Now();
+        if (now < _nextBloodrage)
+            return false;
+        _nextBloodrage = now + 20s;
+        return true;
+    }
+
+    void AddStackKeepingTimer(uint32 spellId)
+    {
+        Unit* owner = GetTarget();
+        if (Aura* aura = owner->GetAura(spellId))
+        {
+            int32 const left = aura->GetDuration();
+            if (aura->GetStackAmount() < aura->GetSpellInfo()->StackAmount)
+                aura->ModStackAmount(1);
+            aura->SetDuration(left);
+        }
+        else
+            owner->CastSpell(owner, spellId, true);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        uint8 const points = owner->GetComboPoints();
+        if (!roll_chance_i((GetId() == 979080 || GetId() == 983475 ? 10 : 20) * points))
+            return;
+        Player* player = owner->ToPlayer();
+        switch (GetId())
+        {
+            case 979113:
+                WcmeCutCooldownByName(owner, "Poison Bomb", 4000);
+                break;
+            case 979080:
+                if (Aura* charges = owner->GetAura(979082))
+                {
+                    charges->SetCharges(std::min<uint8>(3, charges->GetCharges() + 1));
+                    charges->RefreshDuration();
+                }
+                else if (Aura* first = owner->AddAura(979082, owner))
+                    first->SetCharges(1);
+                break;
+            case 979106:
+            case 284148:
+                if (player && player->GetPet())
+                    owner->CastSpell(owner, 979105, true);
+                break;
+            case 275094:
+                owner->CastSpell(owner, 275096, true);
+                break;
+            case 977856:
+                if (WcmeKnowsPassive(owner, "Sudden Death", SPELLFAMILY_WARRIOR))
+                    owner->CastSpell(owner, 977858, true);
+                break;
+            case 283833:
+                if (owner->HasAura(973827) || WcmeKnowsPassive(owner, "Sudden Death", SPELLFAMILY_WARRIOR))
+                    owner->CastSpell(owner, 283835, true);
+                break;
+            case 283405:
+                if (BloodrageReady() && !WcmeCastKnownNamed(owner, "Bloodrage", SPELLFAMILY_WARRIOR) &&
+                    owner->HasAura(973827))
+                    owner->CastSpell(owner, 29131, true);
+                break;
+            case 954436:
+                if (BloodrageReady())
+                    WcmeCastKnownNamed(owner, "Bloodrage", SPELLFAMILY_WARRIOR);
+                break;
+            case 1589466:
+                WcmeCutCooldownByName(owner, "Adrenaline Rush", 12000);
+                break;
+            case 983110:
+                AddStackKeepingTimer(983112);
+                if (Aura const* stacks = owner->GetAura(983112))
+                {
+                    Aura* rage = owner->GetAura(983113);
+                    if (!rage)
+                        rage = owner->AddAura(983113, owner);
+                    if (rage)
+                    {
+                        rage->SetStackAmount(stacks->GetStackAmount());
+                        rage->SetMaxDuration(stacks->GetDuration());
+                        rage->SetDuration(stacks->GetDuration());
+                    }
+                }
+                break;
+            case 285111:
+                owner->CastSpell(owner, 285115, true);
+                break;
+            case 983475:
+                if (Aura* tankard = owner->GetAura(983476))
+                {
+                    tankard->SetStackAmount(std::min<uint8>(4, tankard->GetStackAmount() + 1));
+                    tankard->RefreshDuration();
+                }
+                else
+                    owner->AddAura(983476, owner);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_finisher_combo::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_finisher_combo::HandleProc);
+    }
+
+private:
+    TimePoint _nextBloodrage{};
+};
+
+// Bloodsail Swashbuckler rage (983113, kept in step with Bloodsail Swashbuckling's stacks): each main-hand auto attack
+// that hits gives 1 rage per stack (983114, its own energize).
+class spell_wcme_bloodsail_rage : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_bloodsail_rage);
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        return damage && damage->GetAttackType() == BASE_ATTACK && !eventInfo.GetSpellInfo();
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        for (uint8 i = 0; i < GetStackAmount(); ++i)
+            GetTarget()->CastSpell(GetTarget(), 983114, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_bloodsail_rage::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_bloodsail_rage::HandleProc);
