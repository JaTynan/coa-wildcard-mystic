+{
+    PrepareAuraScript(spell_wcme_beast_and_blade);
+
+    static bool AwardsComboPoints(SpellInfo const* spell)
+    {
+        for (SpellEffectInfo const& effect : spell->GetEffects())
+            if (effect.Effect == SPELL_EFFECT_ADD_COMBO_POINTS)
+                return true;
+        return false;
+    }
+
+    Unit* Pet() const
+    {
+        Player* player = GetTarget()->ToPlayer();
+        Unit* pet = player ? player->GetGuardianPet() : nullptr;
+        return pet && pet->IsAlive() ? pet : nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || spell->SpellFamilyName != SPELLFAMILY_ROGUE || !Pet() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->NeedsComboPoints() && !spell->IsAffectingArea();
+        return AwardsComboPoints(spell) && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
