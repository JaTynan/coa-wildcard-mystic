+// Wraithweaver: Shadow Orbs (1544910). The orbs themselves are the core's: its rule (effect 2) casts 1544912 on 20% of
+// your Shadow Word: Pain, Devouring Plague and Vampiric Touch damage (the spell's own chance, through the core's proc row),
+// and 1544912 adds a Shadow Orb (1544913, up to 3: Mind Blast +10% per orb). Review 2026-11-18: this used to be a proc
+// script with its own proc row at 100%, which made the core's rule give an orb on every tick, with our own 20% on top;
+// the core's row is back. What the core lacks stays here, outside the proc (the 20% chance would gate it): a Mind Blast
+// hit with 3 orbs spends them and sends a Shadowy Apparition (1544915) that reaches the target 1 sec later and deals 320
+// (at level 60) + 32% SP Shadow damage to every enemy within 5 yards of it.
+class wcme_shadow_orbs_mind_blast : public UnitScript
+{
+public:
+    wcme_shadow_orbs_mind_blast() : UnitScript("wcme_shadow_orbs_mind_blast", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN }) { }
+
+    static constexpr uint32 ORB = 1544913;
+    static constexpr uint32 APPARITION = 1544915;
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || attacker == target || damage <= 0 || !attacker->IsPlayer() ||
+            !attacker->HasAura(1544910) || !WcmeNamed(spellInfo, "Mind Blast") || attacker->GetAuraCount(ORB) < 3)
+            return;
+        attacker->RemoveAurasDueToSpell(ORB);
+        Unit* owner = attacker;
+        ObjectGuid const targetGuid = target->GetGUID();
+        int64 const extra = int64(320.0f * owner->GetLevel() / 60.0f + 0.32f * WcmeSpellPower(owner));
+        owner->m_Events.AddEventAtOffset([owner, targetGuid, extra]()
+        {
+            SpellInfo const* apparition = sSpellMgr->GetSpellInfo(APPARITION);
+            Unit* victim = ObjectAccessor::GetUnit(*owner, targetGuid);
+            if (!apparition || !victim || !owner->IsInWorld())
+                return;
+            for (Unit* enemy : WcmeEnemiesNear(owner, victim, 5.0f, 50))
+                WcmeExtraDamage(owner, enemy, apparition, extra);
+        }, 1s);
+    }
+};
