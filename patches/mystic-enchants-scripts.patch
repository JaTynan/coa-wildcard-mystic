+// Martial Crescendo (84752) and Tools of War (84750): each different direct-damage Physical ability adds a stack
+// (not "on next swing" abilities); no refresh at full stacks; any non-Physical damage removes all stacks.
+class spell_wcme_unique_physical_stacks : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_unique_physical_stacks);
+
+    std::unordered_set<uint32> _used;
+
+    uint32 Buff() const { return GetId() == 84752 ? 84753 : 84751; }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        uint32 const buff = Buff();
+        if (!owner->HasAura(buff))
+            _used.clear();
+
+        if (eventInfo.GetDamageInfo()->GetSchoolMask() != SPELL_SCHOOL_MASK_NORMAL)
+        {
+            owner->RemoveAurasDueToSpell(buff);
+            _used.clear();
+            return;
+        }
+
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) ||
+            spell->HasAttribute(SPELL_ATTR0_ON_NEXT_SWING) || spell->HasAttribute(SPELL_ATTR0_ON_NEXT_SWING_NO_DAMAGE))
+            return;
+        if (!_used.insert(WcmeFirstRank(spell)).second)
+            return;
+        if (Aura const* stacks = owner->GetAura(buff))
+            if (stacks->GetSpellInfo()->StackAmount && stacks->GetStackAmount() >= stacks->GetSpellInfo()->StackAmount)
+                return;
+        owner->CastSpell(owner, buff, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_unique_physical_stacks::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_unique_physical_stacks::HandleProc);
+    }
+};
