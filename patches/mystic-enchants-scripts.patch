+// Batch 5 damage hooks: a target bound by Time-bind has part of each hit absorbed for its heal, and Mana Fiend's
+// armed auto attack is replaced by a Manacharged Strike (the auto attack itself deals nothing).
+class wcme_kit5_hooks : public UnitScript
+{
+public:
+    wcme_kit5_hooks() : UnitScript("wcme_kit5_hooks", true, { UNITHOOK_MODIFY_MELEE_DAMAGE, UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK }) { }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        TimeBindAbsorb(target, attacker, damage);
+        if (!target || !attacker || WcmeManaFiendArmed.erase(attacker->GetGUID()) == 0 || !attacker->HasAura(MANA_FIEND))
+            return;
+        damage = 0;
+        ObjectGuid const targetGuid = target->GetGUID();
+        attacker->m_Events.AddEventAtOffset([attacker, targetGuid]()
+        {
+            if (Unit* victim = ObjectAccessor::GetUnit(*attacker, targetGuid))
+                WcmeManachargedStrike(attacker, victim);
+        }, 1ms);
+    }
+
+    static void TimeBindAbsorb(Unit* victim, Unit* attacker, uint32& damage)
+    {
+        if (!victim || !damage)
+            return;
+        auto bound = WcmeTimeBindDamage.find(victim->GetGUID());
+        if (bound == WcmeTimeBindDamage.end() || !victim->HasAura(986164))
+            return;
+        uint32 const absorbed = damage * (attacker && attacker->IsControlledByPlayer() ? 15 : 30) / 100;
+        damage -= absorbed;
+        bound->second += absorbed;
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* /*spellInfo*/) override
+    {
+        if (damage <= 0)
+            return;
+        uint32 value = uint32(damage);
+        TimeBindAbsorb(target, attacker, value);
+        damage = int32(value);
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* /*spellInfo*/) override
+    {
+        TimeBindAbsorb(target, attacker, damage);
+    }
+};
