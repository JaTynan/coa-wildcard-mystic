+// Disciple of the Tides (274921, the buff): casting Penance spends every stack, adding the buff's bonus per stack
+// to that Penance (through its hidden modifier spells), then the buff is gone.
+class spell_wcme_disciple_of_the_tides : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_disciple_of_the_tides);
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return WcmeNamed(eventInfo.GetSpellInfo(), "Penance") && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        int32 const stacks = std::max<int32>(1, GetStackAmount());
+        for (uint8 i = 0; i < MAX_SPELL_EFFECTS; ++i)
+            if (AuraEffect const* effect = GetEffect(i))
+                if (uint32 const helper = GetSpellInfo()->Effects[i].TriggerSpell)
+                    owner->CastCustomSpell(helper, SPELLVALUE_BASE_POINT0, effect->GetAmount() * stacks, owner, true);
+    }
+
+    void SpendStacks(ProcEventInfo& /*eventInfo*/)
+    {
+        Remove();
+    }
+
+    void Register() override
+    {
