+// Growing Light (81520): Holy Light or Flash of Light healing your Beacon of Light target also heals up to 3 other
+// allies within 8 yards of it for 20% of the heal (270665), puts Growing Light (977990: 10% less physical damage taken
+// for 10 sec) on the Beacon target, extends its Beacon of Light by 30 sec, and gives you a stack of Growing Light
+// (986035, up to 3, 30 sec): your Beacon of Light heals transfer 20% more per stack.
+class spell_wcme_growing_light : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_growing_light);
+
+    static constexpr uint32 RADIATE = 270665;
+    static constexpr uint32 BEACON_BUFF = 977990;
+    static constexpr uint32 GROWING = 986035;
+    static constexpr uint32 BEACON = 53563;
+
+    static Aura* MyBeacon(Unit* target, Unit* owner)
+    {
+        for (auto const& [id, application] : target->GetAppliedAuras())
+            if (application->GetBase()->GetCasterGUID() == owner->GetGUID() &&
+                WcmeNamed(application->GetBase()->GetSpellInfo(), "Beacon of Light"))
+                return application->GetBase();
+        return nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!heal || !heal->GetHeal() || !spell || !target || spell->Id == RADIATE)
+            return false;
+        if (WcmeNamed(spell, "Beacon of Light"))
+            return GetTarget()->HasAura(GROWING);
+        return WcmeNamedAny(spell, { "Holy Light", "Flash of Light" }) && MyBeacon(target, GetTarget());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        uint32 const healed = heal->GetHeal();
+        if (WcmeNamed(eventInfo.GetSpellInfo(), "Beacon of Light"))
+        {
+            Aura* growing = owner->GetAura(GROWING);
+            HealInfo extra(owner, target, healed * 20 * growing->GetStackAmount() / 100, eventInfo.GetSpellInfo(),
+                eventInfo.GetSpellInfo()->GetSchoolMask());
+            owner->HealBySpell(extra);
+            return;
+        }
+        if (SpellInfo const* radiate = sSpellMgr->GetSpellInfo(RADIATE))
+            for (Unit* ally : WcmeAlliesNear(owner, target, 8.0f, 4))
+                if (ally != target)
+                {
+                    HealInfo extra(owner, ally, healed * 20 / 100, radiate, radiate->GetSchoolMask());
+                    owner->HealBySpell(extra);
+                }
+        owner->CastSpell(target, BEACON_BUFF, true);
+        if (Aura* beacon = MyBeacon(target, owner))
+            if (beacon->GetId() != BEACON)
+            {
+                int32 const duration = beacon->GetDuration() + 30000;
+                if (duration > beacon->GetMaxDuration())
+                    beacon->SetMaxDuration(duration);
+                beacon->SetDuration(duration);
+            }
+        if (Aura* growing = owner->GetAura(GROWING))
+        {
+            if (growing->GetStackAmount() < growing->GetSpellInfo()->StackAmount)
+                growing->SetStackAmount(growing->GetStackAmount() + 1);
+            growing->RefreshDuration();
+        }
+        else
+            owner->AddAura(GROWING, owner);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_growing_light::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_growing_light::HandleProc);
+    }
+};
