+// Soul Restoration: your heals shorten Weakened Soul on the ally you heal by 2 sec.
+// 84381 and 282213: Holy Light, Greater Heal, Healing Wave or Healing Touch (282213's data says 4 sec; 2 sec by James's
+// decision, so every copy matches). 1181290: Flash Heal or Greater Heal.
+class spell_wcme_soul_restoration : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_soul_restoration);
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (GetId() == 1181290)
+            return WcmeNamedAny(spell, { "Flash Heal", "Greater Heal" });
+        return WcmeNamedAny(spell, { "Holy Light", "Greater Heal", "Healing Wave", "Healing Touch" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* target = eventInfo.GetActionTarget();
+        for (auto const& [id, app] : target->GetAppliedAuras())
+        {
+            Aura* aura = app->GetBase();
+            if (std::strcmp(aura->GetSpellInfo()->SpellName[0], "Weakened Soul") != 0)
+                continue;
+            int32 const left = aura->GetDuration() - 2 * IN_MILLISECONDS;
+            if (left <= 0)
+                aura->SetDuration(1);
+            else
+                aura->SetDuration(left);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_soul_restoration::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_soul_restoration::HandleProc);
+    }
+};
