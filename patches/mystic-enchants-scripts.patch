+// Flurry of Spears strikes (901201): each deals the tooltip's per-point damage for the combo points Flurry of Spears
+// was cast with, ((level - 40) x 3 + 80 x points + (AP + SP) x (7% + 1.7% x points squared)), before modifiers.
+class spell_wcme_flurry_of_spears_strike : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_flurry_of_spears_strike);
+
+    void HandleDamage(SpellEffIndex /*effIndex*/)
+    {
+        Unit* caster = GetCaster();
+        auto combo = WcmeFlurryCombo.find(caster->GetGUID());
+        int32 const points = combo == WcmeFlurryCombo.end() ? 1 : combo->second;
+        float const power = caster->GetTotalAttackPowerValue(BASE_ATTACK) + float(caster->SpellBaseDamageBonusDone(SPELL_SCHOOL_MASK_ALL));
+        int32 const base = std::max(0, (int32(caster->GetLevel()) - 40) * 3) + 80 * points;
+        SetEffectValue(base + int32(power * (0.07f + 0.017f * points * points)));
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_wcme_flurry_of_spears_strike::HandleDamage, EFFECT_0, SPELL_EFFECT_SCHOOL_DAMAGE);
+    }
+};
