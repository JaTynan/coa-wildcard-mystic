+// Locust Ranger (954044), while you know Wild Quiver at rank 3: Steady Shot shows as Locust Shot (954052,
+// WcmeSyncSwap). Locust Shot or Toxic Surge (984674) hits on a target with your Serpent Sting take 2 sec off Chimera
+// Shot. Chimera Shot and Toxic Surge hits can trigger Wild Quiver (your rank's chance). Wild Quiver Shot hits on a
+// target with your Insect Swarm send Wild Locust Swarm (853254) into nearby enemies, 15% stronger if the target has your
+// Serpent Sting. Toxic Surge: Scorpid Sting or Rapid Fire grants Toxic Ammo (984673); while it lasts your Instant Poison
+// also applies Deadly Poison (your level's rank) and a Toxic Surge dose (984670); Viper Sting consumes them for Toxic
+// Surge damage, 80% more per dose (60% against players). Toxic Surge effects need you more than 5 yards from the target.
+class spell_wcme_locust_ranger : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_locust_ranger);
+
+    static constexpr uint32 LOCUST_SHOT = 954052;
+    static constexpr uint32 TOXIC_SURGE_HIT = 984674;
+    static constexpr uint32 TOXIC_AMMO = 984673;
+    static constexpr uint32 DOSE = 984670;
+    static constexpr uint32 WILD_QUIVER_SHOT = 53254;
+    static constexpr uint32 LOCUST_SWARM = 853254;
+    static constexpr std::array<uint32, 9> DEADLY_POISON = { 2818, 2819, 11353, 11354, 25349, 26968, 27187, 57969, 57970 };
+
+    static bool KnowsQuiver(Unit const* unit)
+    {
+        Player const* player = unit->ToPlayer();
+        return player && (player->HasSpell(53217) || player->HasSpell(1153217));
+    }
+
+    void Sync(bool active) { WcmeSyncSwap(GetTarget(), "Steady Shot", SPELLFAMILY_HUNTER, LOCUST_SHOT, active && KnowsQuiver(GetTarget())); }
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool Far(Unit const* target) const { return target && GetTarget()->GetDistance(target) > 5.0f; }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !KnowsQuiver(GetTarget()))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamedAny(spell, { "Scorpid Sting", "Rapid Fire" });
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || target == GetTarget() || !WcmeDealtDamage(eventInfo) || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (spell->Id == LOCUST_SHOT || spell->Id == TOXIC_SURGE_HIT || spell->Id == WILD_QUIVER_SHOT)
+            return true;
+        if (spell->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamedAny(spell, { "Chimera Shot", "Viper Sting" }))
+            return true;
+        return spell->SpellFamilyName == SPELLFAMILY_ROGUE && WcmeNamed(spell, "Instant Poison") && GetTarget()->HasAura(TOXIC_AMMO);
+    }
+
+    void WildQuiver(Unit* owner, Unit* target)
+    {
+        for (AuraEffect const* effect : owner->GetAuraEffectsByType(SPELL_AURA_PROC_TRIGGER_SPELL))
+            if (effect->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamed(effect->GetSpellInfo(), "Wild Quiver"))
+            {
+                if (roll_chance_i(int32(effect->GetSpellInfo()->ProcChance)))
+                    owner->CastSpell(target, WILD_QUIVER_SHOT, true);
+                return;
+            }
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            owner->CastSpell(owner, TOXIC_AMMO, true);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        bool const stung = WcmeHasAuraNamedFrom(target, owner, "Serpent Sting");
+        if (spell->Id == LOCUST_SHOT || spell->Id == TOXIC_SURGE_HIT)
+        {
+            if (stung)
+                WcmeCutCooldownByName(owner, "Chimera Shot", 2000);
+            if (spell->Id == TOXIC_SURGE_HIT)
+                WildQuiver(owner, target);
+            return;
+        }
+        if (WcmeNamed(spell, "Chimera Shot"))
+        {
+            WildQuiver(owner, target);
+            return;
+        }
+        if (spell->Id == WILD_QUIVER_SHOT)
+        {
+            if (!WcmeHasAuraNamedFrom(target, owner, "Insect Swarm"))
+                return;
+            SpellInfo const* swarm = sSpellMgr->GetSpellInfo(LOCUST_SWARM);
+            if (!swarm)
+                return;
+            int32 const pct = stung ? 115 : 100;
+            WcmeCastAtSpot(owner, target, LOCUST_SWARM, swarm->Effects[EFFECT_0].CalcValue(owner) * pct / 100,
+                swarm->Effects[EFFECT_1].CalcValue(owner) * pct / 100);
+            return;
+        }
+        if (!Far(target))
+            return;
+        if (WcmeNamed(spell, "Instant Poison"))
+        {
+            owner->CastSpell(target, WcmeRankFor(owner, DEADLY_POISON), true);
+            owner->CastSpell(target, DOSE, true);
+            return;
+        }
+        Aura const* dose = target->GetAura(DOSE, owner->GetGUID());
+        uint8 const doses = dose ? dose->GetStackAmount() : 0;
+        if (!doses)
+            return;
+        target->RemoveAurasDueToSpell(DOSE, owner->GetGUID());
+        for (uint32 rank : DEADLY_POISON)
+            target->RemoveAurasDueToSpell(rank, owner->GetGUID());
+        float const base = 16.0f + std::max(0, int32(owner->GetLevel()) - 20) + 0.4f * owner->GetTotalAttackPowerValue(RANGED_ATTACK) +
+            0.2f * WcmeSpellPower(owner);
+        float const perDose = target->IsControlledByPlayer() ? 0.6f : 0.8f;
+        owner->CastCustomSpell(TOXIC_SURGE_HIT, SPELLVALUE_BASE_POINT0, int32(base * (1.0f + perDose * doses)), target, true);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_locust_ranger::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_locust_ranger::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_locust_ranger::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_locust_ranger::HandleProc);
+    }
+};
