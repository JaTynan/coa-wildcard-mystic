+// Fury of the Titans (977810): 300 maximum rage (wcme_rage_cap) and Titanic Strike (977813) taught while you know
+// Titan's Grip. During Titanic Fury (977811) melee auto attacks add a combo point (984969). The next direct Warrior
+// ability on the global cooldown after Titanic Strike spends Titanic Power (986138, its +25% per stack is the data's;
+// +15% against players in wcme_kit_damage_hooks) and adds a combo point.
+class spell_wcme_fury_of_the_titans : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_fury_of_the_titans);
+
+    static constexpr uint32 TITANIC_STRIKE = 977813;
+    static constexpr uint32 TITANIC_STRIKE_OFF = 977812;
+    static constexpr uint32 FURY = 977811;
+    static constexpr uint32 POWER = 986138;
+    static constexpr uint32 COMBO_POINT = 984969;
+    static constexpr std::array<uint32, 1> TAUGHT = { TITANIC_STRIKE };
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncTaughtRank(owner, TAUGHT, active && WcmeKnowsPassive(owner, "Titan's Grip", SPELLFAMILY_WARRIOR));
+        if (Player* player = owner->ToPlayer())
+            player->UpdateMaxPower(POWER_RAGE);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        if (!eventInfo.GetActionTarget() || eventInfo.GetActionTarget() == owner)
+            return false;
+        if (eventInfo.GetTypeMask() & PROC_FLAG_DONE_MELEE_AUTO_ATTACK)
+            return owner->HasAura(FURY);
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->SpellFamilyName == SPELLFAMILY_WARRIOR && spell->Id != TITANIC_STRIKE &&
+            spell->Id != TITANIC_STRIKE_OFF && spell->StartRecoveryTime > 0 && WcmeDealsAnyDamage(spell) &&
+            WcmeDealtDamage(eventInfo) && owner->HasAura(POWER);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (!(eventInfo.GetTypeMask() & PROC_FLAG_DONE_MELEE_AUTO_ATTACK))
+            owner->RemoveAurasDueToSpell(POWER);
+        owner->CastSpell(eventInfo.GetActionTarget(), COMBO_POINT, true);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_fury_of_the_titans::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_fury_of_the_titans::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_fury_of_the_titans::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_fury_of_the_titans::HandleProc);
+    }
+};
