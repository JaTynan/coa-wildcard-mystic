+// Damage parts of the last legendaries. Explosive Charge (1568152) used to be here; review 2026-11-18 found the core
+// already does it (coa_mystic_enchant_proc rule on every Explosive Shot version, ticks included, run by
+// spell_ascension_mystic_enchant_proc), so ours made its splash happen twice and was removed.
+// - Flame Ascendance (1398169): when Lava Burst's critical chance on the target is above 100% (so it always crits), the
+//   excess is added to its critical damage bonus (+1% of the hit per 1% excess).
+// - Harbinger of Pestilence stacks (990022): +22% per stack to diseases and Insect Swarm (Plague) against creatures
+//   (its misc 38, which the core ignores).
+// - Hot Hands (979765 / 1575104): a Pyroblast cast with Hot Streak deals 35% more to monsters (the first hit within
+//   5 sec of the cast).
+// - Elemental Assassin (978229): Backstab +33% per unique Elemental Blade (12% against players); with all three blades,
+//   Backstab and Stormstrike hits also deal 40% as Elemental Blade damage (985319) to enemies within 5 yards of the
+//   target. Echoes of Earth (965977, from Reverberation) +40 and Booming Echoes' buff (863375) +10 while it is on.
+class wcme_last_legendary_hooks : public UnitScript
+{
+public:
+    wcme_last_legendary_hooks() : UnitScript("wcme_last_legendary_hooks", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_ON_AFTER_AURA_EFFECT_CALCULATE_AMOUNT }) { }
+
+    void OnAfterAuraEffectCalculateAmount(AuraEffect const* effect, Unit* caster, int32& amount) override
+    {
+        if (!caster || effect->GetEffIndex() != EFFECT_0 || !caster->HasAura(978229))
+            return;
+        if (effect->GetId() == 965977)
+            amount += 40;
+        else if (effect->GetId() == 863375)
+            amount += 10;
+    }
+
+    static uint8 Blades(Unit* unit)
+    {
+        uint8 count = 0;
+        for (uint32 blade : { 978644u, 978646u, 978648u })
+            if (unit->HasAura(blade))
+                ++count;
+        return count;
+    }
+
+    static void BladeBurst(Unit* attacker, Unit* target, int64 share)
+    {
+        if (share <= 0)
+            return;
+        ObjectGuid const targetGuid = target->GetGUID();
+        attacker->m_Events.AddEventAtOffset([attacker, targetGuid, share]()
+        {
+            SpellInfo const* burst = sSpellMgr->GetSpellInfo(985319);
+            Unit* center = ObjectAccessor::GetUnit(*attacker, targetGuid);
+            if (!burst || !center || !attacker->IsAlive())
+                return;
+            for (Unit* enemy : WcmeEnemiesNear(attacker, center, 5.0f, 20))
+                WcmeExtraDamage(attacker, enemy, burst, share);
+        }, 1ms);
+    }
+
+    static bool IsDisease(SpellInfo const* spell)
+    {
+        return spell->Dispel == DISPEL_DISEASE || spell->Id == 990021;
+    }
+
+    static int64 Harbinger(int64 damage, Unit* target, Unit* attacker, SpellInfo const* spell)
+    {
+        if (target->IsControlledByPlayer() || !IsDisease(spell))
+            return damage;
+        if (AuraEffect const* stacks = attacker->GetAuraEffect(990022, EFFECT_0))
+            damage = damage * (100 + stacks->GetAmount()) / 100;
+        return damage;
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0 || target == attacker)
+            return;
+        int64 value = Harbinger(damage, target, attacker, spellInfo);
+        if (WcmeNamed(spellInfo, "Pyroblast") && !target->IsControlledByPlayer())
+        {
+            auto streak = WcmeHotStreakPyroblast.find(attacker->GetGUID());
+            if (streak != WcmeHotStreakPyroblast.end())
+            {
+                if (GameTime::Now() <= streak->second && WcmeHasAnyAura(attacker, { 979765, 1575104 }))
+                    value = value * 135 / 100;
+                WcmeHotStreakPyroblast.erase(streak);
+            }
+        }
+        if (attacker->HasAura(978229) && WcmeNamedAny(spellInfo, { "Backstab", "Stormstrike" }))
+        {
+            uint8 const blades = Blades(attacker);
+            if (blades && WcmeNamed(spellInfo, "Backstab"))
+                value = value * (100 + (target->IsControlledByPlayer() ? 12 : 33) * blades) / 100;
+            if (blades == 3)
+                BladeBurst(attacker, target, value * 40 / 100);
+        }
+        if (WcmeNamed(spellInfo, "Lava Burst") && attacker->HasAura(1398169))
+        {
+            SpellSchoolMask const school = spellInfo->GetSchoolMask();
+            float const done = attacker->SpellDoneCritChance(target, spellInfo, school, BASE_ATTACK, true);
+            float const chance = target->SpellTakenCritChance(attacker, spellInfo, school, done, BASE_ATTACK, true);
+            if (chance > 100.0f)
+            {
+                int64 const multiplier = Unit::SpellCriticalDamageBonus(attacker, spellInfo, 100, target);
+                if (multiplier > 0)
+                    value = value * (multiplier + int64(chance - 100.0f)) / multiplier;
+            }
+        }
+        damage = int32(std::min<int64>(INT32_MAX, value));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && spellInfo && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, Harbinger(damage, target, attacker, spellInfo)));
+    }
+};
