+// Epic batch 5, spell side:
+// - Final Shield (81255 / 281638): Power Word: Shield on an ally (you included) below 20% health removes the harmful
+//   crowd control on them (stun, fear, charm, polymorph, sleep, root, silence and the like); at most once every 30 sec,
+//   counted only when something was removed.
+// - Blessed by the Elune (272253): after a Solar Eclipse your next Wrath or Starsurge also applies your highest known
+//   Insect Swarm; after a Lunar Eclipse your next Starfire or Starsurge also applies your highest known Moonfire. Each
+//   waits up to 30 sec.
+// - War Mage (281939): Blink casts your highest known Arcanist's Explosion or Arcane Explosion where you land; each enemy
+//   in its radius takes 1.5 sec off Blink, up to 6 (9 sec), matching its helper 281943 / 281941.
+// - Elemental Lord (276578): Elemental Blast or Lava Burst gives one of Elemental Earth (276579), Frost (276580) or Fire
+//   (276581) at random, replacing the last; each makes its shock deal 100% more direct damage (their data) and is used up
+//   by that shock:
+//   Earth Shock: Elemental Aftershock (276585) on up to 3 other enemies within 8 yards, 15% of the hit over 3 sec.
+//   Frost Shock: Elemental Solidification (276586): the next Lava Burst +55% (+20% against players).
+//   Flame Shock: Lava Burst's cooldown finishes, and for 12 sec (276587) each Flame Shock tick has a 20% chance to finish
+//   it again.
+// - Spellstorm (271709), the chance part: with Arcane Evoked (271710), your next Frost damage spell that chills has an
+//   extra 80% chance to give Brain Freeze (57761) if you know Brain Freeze; with Fire Evoked (271713), your next Arcane
+//   Blast, Arcane Barrage, Fireball, Frostbolt or Frostfire Bolt has an extra 80% chance to give Missile Barrage
+//   (44401) if you know Missile Barrage. Either way the Evoked buff is used up.
+// - Suffocating Roots (84378): when your Entangling Roots is dispelled, the dispeller gets the same roots from you.
+class wcme_epic_batch5_spells : public AllSpellScript
+{
+public:
+    wcme_epic_batch5_spells() : AllSpellScript("wcme_epic_batch5_spells", { ALLSPELLHOOK_ON_CAST, ALLSPELLHOOK_ON_HIT_RESULT,
+        ALLSPELLHOOK_ON_SUCCESSFUL_DISPEL }) { }
+
+    static bool CrowdControl(Aura const* aura)
+    {
+        constexpr uint64 mechanics = (1ULL << MECHANIC_CHARM) | (1ULL << MECHANIC_DISORIENTED) | (1ULL << MECHANIC_FEAR) |
+            (1ULL << MECHANIC_ROOT) | (1ULL << MECHANIC_SILENCE) | (1ULL << MECHANIC_SLEEP) | (1ULL << MECHANIC_STUN) |
+            (1ULL << MECHANIC_FREEZE) | (1ULL << MECHANIC_KNOCKOUT) | (1ULL << MECHANIC_POLYMORPH) |
+            (1ULL << MECHANIC_BANISH) | (1ULL << MECHANIC_SHACKLE) | (1ULL << MECHANIC_HORROR) | (1ULL << MECHANIC_SAPPED) |
+            (1ULL << MECHANIC_TURN);
+        SpellInfo const* info = aura->GetSpellInfo();
+        if ((info->Mechanic && ((1ULL << info->Mechanic) & mechanics)) || (info->GetAllEffectsMechanicMask() & mechanics))
+            return true;
+        for (AuraType type : { SPELL_AURA_MOD_STUN, SPELL_AURA_MOD_FEAR, SPELL_AURA_MOD_CONFUSE, SPELL_AURA_MOD_ROOT,
+                 SPELL_AURA_MOD_SILENCE, SPELL_AURA_MOD_PACIFY, SPELL_AURA_MOD_CHARM, SPELL_AURA_MOD_PACIFY_SILENCE })
+            if (info->HasAura(type))
+                return true;
+        return false;
+    }
+
+    static void FinalShield(Unit* caster, Unit* target)
+    {
+        if (!target || !target->IsAlive() || !caster->IsFriendlyTo(target) || !target->HealthBelowPct(20))
+            return;
+        auto ready = WcmeFinalShieldReady.find(caster->GetGUID());
+        if (ready != WcmeFinalShieldReady.end() && GameTime::Now() < ready->second)
+            return;
+        std::vector<std::pair<uint32, ObjectGuid>> removed;
+        for (auto const& [id, app] : target->GetAppliedAuras())
+            if (!app->IsPositive() && CrowdControl(app->GetBase()))
+                removed.emplace_back(id, app->GetBase()->GetCasterGUID());
+        if (removed.empty())
+            return;
+        for (auto const& [id, from] : removed)
+            target->RemoveAurasDueToSpell(id, from);
+        WcmeFinalShieldReady[caster->GetGUID()] = GameTime::Now() + 30s;
+    }
+
+    static void ApplyKnown(Player* player, Unit* target, char const* name, uint32 fallback)
+    {
+        uint32 spellId = WcmeHighestKnownNamed(player, name, SPELLFAMILY_DRUID);
+        if (!spellId)
+            spellId = fallback;
+        if (target && target->IsAlive() && player->IsValidAttackTarget(target))
+            player->CastSpell(target, spellId, true);
+    }
+
+    void OnSpellCast(Spell* spell, Unit* caster, SpellInfo const* info, bool /*skipCheck*/) override
+    {
+        if (!spell || !caster || !info)
+            return;
+        Unit* target = spell->m_targets.GetUnitTarget();
+        Player* player = caster->ToPlayer();
+
+        if (WcmeHasAnyAura(caster, { 81255, 281638 }) && WcmeNamed(info, "Power Word: Shield"))
+            FinalShield(caster, target ? target : caster);
+
+        if (player && caster->HasAura(272253) && info->SpellFamilyName == SPELLFAMILY_DRUID)
+        {
+            auto next = WcmeEclipseNext.find(caster->GetGUID());
+            auto until = WcmeEclipseUntil.find(caster->GetGUID());
+            if (next != WcmeEclipseNext.end() && until != WcmeEclipseUntil.end() && GameTime::Now() <= until->second)
+            {
+                bool const starsurge = WcmeNamed(info, "Starsurge");
+                if ((next->second & 1) && (starsurge || WcmeNamed(info, "Wrath")))
+                {
+                    next->second &= ~1;
+                    ApplyKnown(player, target, "Insect Swarm", 5570);
+                }
+                if ((next->second & 2) && (starsurge || WcmeNamed(info, "Starfire")))
+                {
+                    next->second &= ~2;
+                    ApplyKnown(player, target, "Moonfire", 8921);
+                }
+            }
+        }
+
+        if (player && caster->HasAura(281939) && info->SpellFamilyName == SPELLFAMILY_MAGE && WcmeNamed(info, "Blink"))
+            player->m_Events.AddEventAtOffset([player]()
+            {
+                if (!player->IsAlive())
+                    return;
+                uint32 explosion = WcmeHighestKnownNamed(player, "Arcanist's Explosion", SPELLFAMILY_MAGE);
+                if (!explosion)
+                    explosion = WcmeHighestKnownNamed(player, "Arcane Explosion", SPELLFAMILY_MAGE);
+                if (!explosion)
+                    explosion = 1449;
+                SpellInfo const* blast = sSpellMgr->GetSpellInfo(explosion);
+                float const radius = blast ? std::max(5.0f, blast->Effects[EFFECT_0].CalcRadius(player)) : 10.0f;
+                size_t const hit = WcmeEnemiesNear(player, player, radius, 6).size();
+                player->CastSpell(player, explosion, true);
+                if (hit)
+                    WcmeCutCooldownByName(player, "Blink", int32(hit) * 1500);
+            }, 100ms);
+
+        if (caster->HasAura(276578) && info->SpellFamilyName == SPELLFAMILY_SHAMAN &&
+            WcmeNamedAny(info, { "Elemental Blast", "Lava Burst" }))
+        {
+            static constexpr std::array<uint32, 3> empowerments = { 276579, 276580, 276581 };
+            for (uint32 id : empowerments)
+                caster->RemoveAurasDueToSpell(id);
+            caster->AddAura(empowerments[urand(0, 2)], caster);
+        }
+
+        if (player && caster->HasAura(271713) && info->SpellFamilyName == SPELLFAMILY_MAGE &&
+            WcmeNamedAny(info, { "Arcane Blast", "Arcane Barrage", "Fireball", "Frostbolt", "Frostfire Bolt" }) &&
+            WcmeKnowsPassive(player, "Missile Barrage", SPELLFAMILY_MAGE))
+        {
+            caster->RemoveAurasDueToSpell(271713);
+            if (roll_chance_i(80))
+                caster->AddAura(44401, caster);
+        }
+    }
+
+    void OnSpellHitResult(Spell* spell, Unit* target, uint8 missInfo, uint32 damage, uint32 /*healing*/, bool /*critical*/) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        if (!caster || !target || missInfo != SPELL_MISS_NONE)
+            return;
+        SpellInfo const* info = spell->GetSpellInfo();
+
+        if (caster->HasAura(271710) && info->SpellFamilyName == SPELLFAMILY_MAGE && damage &&
+            (info->SchoolMask & SPELL_SCHOOL_MASK_FROST) && info->HasAura(SPELL_AURA_MOD_DECREASE_SPEED) &&
+            WcmeKnowsPassive(caster, "Brain Freeze", SPELLFAMILY_MAGE))
+        {
+            caster->RemoveAurasDueToSpell(271710);
+            if (roll_chance_i(80))
+                caster->AddAura(57761, caster);
+        }
+
+        if (info->SpellFamilyName != SPELLFAMILY_SHAMAN)
+            return;
+        if (caster->HasAura(276579) && WcmeNamed(info, "Earth Shock"))
+        {
+            caster->RemoveAurasDueToSpell(276579);
+            int32 const tick = int32(damage * 15 / 100 / 3);
+            if (tick > 0)
+            {
+                WcmeNoSecondBonus(276585);
+                for (Unit* enemy : WcmeEnemiesNear(caster, target, 8.0f, 4))
+                    if (enemy != target)
+                        caster->CastCustomSpell(enemy, 276585, &tick, nullptr, nullptr, true);
+            }
+        }
+        else if (caster->HasAura(276580) && WcmeNamed(info, "Frost Shock"))
+        {
+            caster->RemoveAurasDueToSpell(276580);
+            caster->AddAura(276586, caster);
+        }
+        else if (caster->HasAura(276581) && WcmeNamed(info, "Flame Shock"))
+        {
+            caster->RemoveAurasDueToSpell(276581);
+            WcmeRestoreChargeByName(caster, "Lava Burst");
+            caster->AddAura(276587, caster);
+        }
+    }
+
+    void OnSpellSuccessfulDispel(Spell* spell, Unit* target, SpellEffIndex /*effect*/, uint32 /*count*/) override
+    {
+        if (WcmeRootsPending.empty())
+            return;
+        std::vector<WcmeRootsDispelled> pending;
+        pending.swap(WcmeRootsPending);
+        Unit* dispeller = spell ? spell->GetCaster() : nullptr;
+        if (!dispeller || !target || !dispeller->IsAlive())
+            return;
+        for (WcmeRootsDispelled const& roots : pending)
+        {
+            if (roots.target != target->GetGUID())
+                continue;
+            Unit* druid = ObjectAccessor::GetUnit(*dispeller, roots.caster);
+            if (druid && druid->IsAlive() && druid->HasAura(84378) && druid->IsValidAttackTarget(dispeller))
+                druid->AddAura(roots.spellId, dispeller);
+        }
+    }
+};
