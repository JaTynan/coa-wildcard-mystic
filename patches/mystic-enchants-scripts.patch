+// Growing Light (270661) for the Beacon of Light versions the core misses. The core's wildcard_growing_light only
+// finds your Beacon through GetAuraOfRankedSpellOrTwin(53563); on this server's "hero" class model that is the stock
+// Beacon alone, so a Beacon from 1153563, 1253563 or 1567798 never sets it off. This copies the core's rule (any Holy
+// heal of yours, before absorbs, on a target with your Beacon heals up to 3 other allies within 8 yards for 20%
+// through 270665) and runs only when the core's own test fails, so the two never both fire.
+class wcme_growing_light_versions : public UnitScript
+{
+public:
+    wcme_growing_light_versions() : UnitScript("wcme_growing_light_versions", true, { UNITHOOK_ON_BEFORE_HEAL_ABSORB }) { }
+
+    void OnBeforeHealAbsorb(HealInfo& heal) override
+    {
+        Unit* caster = heal.GetHealer();
+        Unit* target = heal.GetTarget();
+        SpellInfo const* info = heal.GetSpellInfo();
+        if (!caster || !caster->IsPlayer() || !target || !info || info->Id == 270665 || !heal.GetHeal() ||
+            !(info->GetSchoolMask() & SPELL_SCHOOL_MASK_HOLY) || !caster->HasAura(270661) ||
+            target->GetAuraOfRankedSpellOrTwin(53563, caster->GetGUID()) ||
+            !WcmeAuraFromNamed(target, caster, "Beacon of Light"))
+            return;
+        // The same pick as the core's ReconstructionAllies: friendly, assistable, in line of sight, most injured first.
+        std::list<Unit*> allies;
+        Acore::AnyFriendlyUnitInObjectRangeCheck check(target, caster, 8.0f);
+        Acore::UnitListSearcher<Acore::AnyFriendlyUnitInObjectRangeCheck> searcher(target, allies, check);
+        Cell::VisitObjects(target, searcher, 8.0f);
+        allies.remove_if([caster, target](Unit* ally)
+        {
+            return ally == target || !caster->IsValidAssistTarget(ally) || !caster->IsWithinLOSInMap(ally);
+        });
+        allies.sort([](Unit* a, Unit* b) { return a->GetHealthPct() < b->GetHealthPct(); });
+        int32 const amount = int32(CalculatePct(heal.GetHeal(), 20));
+        uint8 count = 0;
+        for (Unit* ally : allies)
+            if (count++ < 3)
+                caster->CastCustomSpell(270665, SPELLVALUE_BASE_POINT0, amount, ally, true);
+    }
+};
