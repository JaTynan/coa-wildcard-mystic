+    static constexpr uint32 WINTERS_FURY = 984936;
+    static constexpr uint32 ICE_SPEAR = 984935;
+    static constexpr uint32 ICE_LANCE = 984432;
+    static constexpr uint32 HOWL = 979053;
+    static constexpr std::array<uint32, 8> WINDS = { 978846, 978847, 978848, 978849, 978850, 978851, 978852, 978853 };
+    uint8 _combo = 0;
