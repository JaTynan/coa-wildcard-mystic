+// Righteous Flames (81298), as its in-game description says: Inner Fire gives 30% fewer charges (the data's own spell
+// mod). Each non-periodic Fire hit deals 1% more per Inner Fire charge (0.5% against players), spends 2 charges and
+// gives a stack of Righteous Flames (954069, up to 5: the next Holy Fire deals 40% more per stack, 10% against players).
+// A Holy Fire hit with 5 stacks also deals Radiant damage (270311 to 270321, the rank for your level, Holy and Fire)
+// to up to 5 enemies within 8 yards of its target, restores 15 Inner Fire charges per enemy hit, and makes your next 3
+// Fire spells extend your Holy Fire on their target by 1 sec. Holy Fire spends the stacks. Casting Inner Fire also
+// deals Radiant damage to enemies within 8 yards, at most once every 8.5 sec.
+class spell_wcme_righteous_flames : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_righteous_flames);
+
+    static constexpr uint32 FLAMES = 954069;
+    static constexpr std::array<uint32, 11> RADIANT = { 270311, 270313, 270314, 270315, 270316, 270317, 270318, 270312,
+        270319, 270320, 270321 };
+    static constexpr Milliseconds INNER_FIRE_RATE{8500};
+    TimePoint _innerFireReady{};
+    uint8 _extends = 0;
+
+    static bool IsHolyFire(SpellInfo const* spell)
+    {
+        return WcmeNamedAny(spell, { "Holy Fire", "Holy Fire (Righteous Flames)" });
+    }
+
+    static Aura* InnerFire(Unit* owner)
+    {
+        for (auto const& [id, application] : owner->GetAppliedAuras())
+            if (WcmeNamed(application->GetBase()->GetSpellInfo(), "Inner Fire") &&
+                application->GetBase()->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_PRIEST)
+                return application->GetBase();
+        return nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeNamed(spell, "Inner Fire") && spell->SpellFamilyName == SPELLFAMILY_PRIEST &&
+                GameTime::Now() >= _innerFireReady;
+        return (spell->GetSchoolMask() & SPELL_SCHOOL_MASK_FIRE) && eventInfo.GetActionTarget() &&
+            WcmeDealtDamage(eventInfo) && std::find(RADIANT.begin(), RADIANT.end(), spell->Id) == RADIANT.end();
+    }
+
+    uint32 Radiant(Unit* owner, Unit* center, float radius, size_t limit)
+    {
+        uint32 const rank = WcmeRankFor(owner, RADIANT);
+        uint32 hit = 0;
+        for (Unit* enemy : WcmeEnemiesNear(owner, center, radius, limit))
+        {
+            owner->CastSpell(enemy, rank, true);
+            ++hit;
+        }
+        return hit;
+    }
+
+    static bool ExtendHolyFire(Unit* owner, Unit* target)
+    {
+        for (AuraEffect const* dot : target->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+            if (dot->GetCasterGUID() == owner->GetGUID() && IsHolyFire(dot->GetSpellInfo()))
+            {
+                Aura* aura = dot->GetBase();
+                int32 const duration = aura->GetDuration() + 1000;
+                if (duration > aura->GetMaxDuration())
+                    aura->SetMaxDuration(duration);
+                aura->SetDuration(duration);
+                return true;
+            }
+        return false;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            _innerFireReady = GameTime::Now() + INNER_FIRE_RATE;
+            Radiant(owner, owner, 8.0f, 50);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Aura* innerFire = InnerFire(owner);
+        if (IsHolyFire(spell))
+        {
+            Aura* flames = owner->GetAura(FLAMES);
+            if (flames && flames->GetStackAmount() >= flames->GetSpellInfo()->StackAmount)
+            {
+                uint32 const hit = Radiant(owner, target, 8.0f, 5);
+                if (innerFire && hit)
+                    innerFire->SetCharges(uint8(std::min<uint32>(innerFire->GetCharges() + 15 * hit, innerFire->CalcMaxCharges())));
+                _extends = 3;
+            }
+            owner->RemoveAurasDueToSpell(FLAMES);
+        }
+        else if (_extends && ExtendHolyFire(owner, target))
+            --_extends;
+        if (!innerFire || !innerFire->GetCharges())
+            return;
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        int64 const dealt = int64(damage->GetDamage() + damage->GetAbsorb());
+        WcmeExtraDamage(owner, target, spell, dealt * innerFire->GetCharges() / (target->IsPlayer() ? 200 : 100));
+        innerFire->ModCharges(-2);
+        if (Aura* flames = owner->GetAura(FLAMES))
+        {
+            if (flames->GetStackAmount() < flames->GetSpellInfo()->StackAmount)
+                flames->SetStackAmount(flames->GetStackAmount() + 1);
+            flames->RefreshDuration();
+        }
+        else
+            owner->AddAura(FLAMES, owner);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_righteous_flames::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_righteous_flames::HandleProc);
+    }
+};
