+// You're a Solid Crate (982476) teaches "Stealth" (982477). In our data that spell only gives the Stealth form (so
+// stealth openers work) and summons the crate (creature 300099, which our world database has); the actual hiding and
+// the "no legs" slow are its two server-side helpers, which nothing applied: "Stealth" - SLS #1 (982478: stealth of
+// the same strength as Stealth, 5 + 5 per level) and SLS #2 (982479: -95% movement speed). They come and go with the
+// crate form; moving still breaks it (its data). The crate it summoned is removed when the form ends, so crates don't
+// pile up.
+class spell_wcme_solid_crate : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_solid_crate);
+
+    void Apply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        owner->AddAura(982478, owner);
+        owner->AddAura(982479, owner);
+    }
+
+    void Remove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        owner->RemoveAurasDueToSpell(982478);
+        owner->RemoveAurasDueToSpell(982479);
+        std::list<Creature*> crates;
+        owner->GetCreatureListWithEntryInGrid(crates, 300099, 100.0f);
+        for (Creature* crate : crates)
+            if (TempSummon* summon = crate->ToTempSummon(); summon && summon->GetSummonerGUID() == owner->GetGUID())
+                summon->DespawnOrUnsummon();
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_solid_crate::Apply, EFFECT_0, SPELL_AURA_MOD_SHAPESHIFT, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_solid_crate::Remove, EFFECT_0, SPELL_AURA_MOD_SHAPESHIFT, AURA_EFFECT_HANDLE_REAL);
+    }
+};
