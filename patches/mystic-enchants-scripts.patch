+// Dragon Warrior (954252): its own design instead of twin 271907 (004 no longer links them). Bloodthirst and Execute
+// hits give Draconic Slam (954261: the next Slam is instant, the data's own spell mod); that Slam deals 50% more as
+// extra damage and grants a stack of Dragon Fury (954253, up to 3, with its Dragon Fury Visual 954254): each stack takes
+// 5 sec off Dragon Roar and makes it deal 50% more (the data's own mod). Death Wish shows as Dragon Roar (954250) and
+// Intercept as Dragon Charge (954256) (WcmeSyncSwap: the core does not swap them, the names differ). Dragon Roar spends
+// the stacks and stuns (954255) only with 3 of them (spell_wcme_dragon_roar_stun).
+class spell_wcme_dragon_warrior : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_dragon_warrior);
+
+    static constexpr uint32 DRACONIC_SLAM = 954261;
+    static constexpr uint32 DRAGON_FURY = 954253;
+    static constexpr uint32 DRAGON_ROAR = 954250;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->Id == DRAGON_ROAR;
+        return WcmeDealtDamage(eventInfo) && (WcmeNamedAny(spell, { "Bloodthirst", "Execute" }) ||
+            (WcmeNamed(spell, "Slam") && GetTarget()->HasAura(DRACONIC_SLAM)));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(DRAGON_FURY); }, 500ms);
+            return;
+        }
+        if (!WcmeNamed(spell, "Slam"))
+        {
+            owner->AddAura(DRACONIC_SLAM, owner);
+            return;
+        }
+        owner->RemoveAurasDueToSpell(DRACONIC_SLAM);
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        WcmeExtraDamage(owner, eventInfo.GetActionTarget(), spell, int64(damage->GetDamage() + damage->GetAbsorb()) / 2);
+        Aura* fury = owner->GetAura(DRAGON_FURY);
+        if (fury && fury->GetStackAmount() >= fury->GetSpellInfo()->StackAmount)
+        {
+            fury->RefreshDuration();
+            return;
+        }
+        owner->CastSpell(owner, DRAGON_FURY, true);
+        WcmeCutCooldownByName(owner, "Dragon Roar", 5000);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncSwap(GetTarget(), "Death Wish", SPELLFAMILY_WARRIOR, DRAGON_ROAR, true);
+        WcmeSyncSwap(GetTarget(), "Intercept", SPELLFAMILY_WARRIOR, 954256, true);
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncSwap(GetTarget(), "Death Wish", SPELLFAMILY_WARRIOR, DRAGON_ROAR, false);
+        WcmeSyncSwap(GetTarget(), "Intercept", SPELLFAMILY_WARRIOR, 954256, false);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_dragon_warrior::CheckProc);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_dragon_warrior::HandleApply, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_dragon_warrior::HandleRemove, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnProc += AuraProcFn(spell_wcme_dragon_warrior::HandleProc);
+    }
+};
