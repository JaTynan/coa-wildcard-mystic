+// Temporal Shift (977972): teaches Temporal Blast (930451). Each Temporal Blast adds a charge of Temporal Haste
+// (954209: the next direct damage spell casts 40% faster), up to 3; reaching 3 triggers Eclipse (Lunar) (48518) if you
+// know Eclipse, lasting a third as long. While Eclipse (Lunar) is up, Starfire, Starsurge and Moonfire hits deal 45%
+// more (15% against players). A cancelled Temporal Blast stores its cast time (patches/66-enchant-core-hooks.ps1).
+class spell_wcme_temporal_shift : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_temporal_shift);
+
+    static constexpr uint32 HASTE = 954209;
+    static constexpr uint32 LUNAR = 48518;
+    uint8 _chargesBefore = 0;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (WcmeNamed(spell, "Temporal Blast"))
+            return true;
+        return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_HIT) && GetTarget()->HasAura(LUNAR) &&
+            eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) && WcmeNamedAny(spell, { "Starfire", "Starsurge", "Moonfire" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!WcmeNamed(spell, "Temporal Blast"))
+        {
+            Unit* target = eventInfo.GetActionTarget();
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            int64 const dealt = damage->GetDamage() + damage->GetAbsorb();
+            WcmeExtraDamage(owner, target, spell, dealt * (target->IsPlayer() ? 15 : 45) / 100);
+            return;
+        }
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            Aura const* haste = owner->GetAura(HASTE);
+            _chargesBefore = haste ? std::max<uint8>(1, haste->GetCharges()) : 0;
+            return;
+        }
+        Aura* haste = owner->GetAura(HASTE);
+        if (!haste)
+            haste = owner->AddAura(HASTE, owner);
+        if (!haste)
+            return;
+        uint8 const charges = std::min<uint8>(3, _chargesBefore + 1);
+        haste->SetCharges(charges);
+        _chargesBefore = charges;
+        if (charges == 3 && WcmeHasAnyAura(owner, { 48516, 48521, 48525 }))
+        {
+            owner->CastSpell(owner, LUNAR, true);
+            if (Aura* lunar = owner->GetAura(LUNAR))
+            {
+                lunar->SetMaxDuration(lunar->GetMaxDuration() / 3);
+                lunar->SetDuration(lunar->GetMaxDuration());
+            }
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_temporal_shift::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_temporal_shift::HandleProc);
+    }
+};
