+// Tidal Shield (978690): needs and spends a Tidal Swell charge. The target gets an absorb shield (847753) for 50% of
+// the health actually restored, or 10% of the heal when all of it is overhealing; further casts add to the shield,
+// up to 35% of the target's maximum health.
+class spell_wcme_tidal_shield : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_tidal_shield);
+
+    static constexpr uint32 TIDAL_SWELL = 978698;
+    static constexpr uint32 SHIELD = 847753;
+    uint32 _missing = 0;
+
+    SpellCastResult CheckCast()
+    {
+        return GetCaster()->HasAura(TIDAL_SWELL) ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void HandleBeforeHit(SpellMissInfo /*missInfo*/)
+    {
+        if (Unit* target = GetHitUnit())
+            _missing = target->GetMaxHealth() - target->GetHealth();
+    }
+
+    void HandleAfterHit()
+    {
+        Unit* caster = GetCaster();
+        Unit* target = GetHitUnit();
+        if (!target)
+            return;
+        uint32 const healed = uint32(std::max(0, GetHitHeal()));
+        uint32 const restored = std::min(healed, _missing);
+        int32 add = int32(restored ? restored / 2 : healed / 10);
+        int32 const cap = int32(target->CountPctFromMaxHealth(35));
+        if (Aura* shield = target->GetAura(SHIELD, caster->GetGUID()))
+        {
+            if (AuraEffect* absorb = shield->GetEffect(EFFECT_0))
+                absorb->SetAmount(std::min(cap, absorb->GetAmount() + add));
+            shield->RefreshDuration();
+        }
+        else if (add > 0)
+            caster->CastCustomSpell(SHIELD, SPELLVALUE_BASE_POINT0, std::min(cap, add), target, true);
+    }
+
+    void HandleAfterCast()
+    {
+        if (Aura* swell = GetCaster()->GetAura(TIDAL_SWELL))
+            swell->DropCharge();
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_tidal_shield::CheckCast);
+        BeforeHit += BeforeSpellHitFn(spell_wcme_tidal_shield::HandleBeforeHit);
+        AfterHit += SpellHitFn(spell_wcme_tidal_shield::HandleAfterHit);
+        AfterCast += SpellCastFn(spell_wcme_tidal_shield::HandleAfterCast);
+    }
+};
