+// Pistol Shot (997048) and Grape Shot (300191): need a single one-handed weapon and an empty off-hand slot.
+class spell_wcme_gunslinger_shot : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_gunslinger_shot);
+
+    SpellCastResult CheckCast()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        if (!player)
+            return SPELL_CAST_OK;
+        Item const* main = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND);
+        uint32 const type = main ? main->GetTemplate()->InventoryType : 0;
+        bool const oneHanded = type == INVTYPE_WEAPON || type == INVTYPE_WEAPONMAINHAND;
+        if (!oneHanded || player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND))
+            return SPELL_FAILED_EQUIPPED_ITEM_CLASS;
+        return SPELL_CAST_OK;
+    }
+
+    // Grape Shot's description says Multi-Shot cooldown modifiers do not apply to it (it shares Multi-Shot's family
+    // flag), so its cooldown is put back to its own after each cast.
+    void HandleAfterCast()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        SpellInfo const* spell = GetSpellInfo();
+        if (!player || spell->Id != 300191 || !spell->RecoveryTime)
+            return;
+        int32 const remaining = int32(player->GetSpellCooldownDelay(spell->Id));
+        if (remaining > 0 && remaining != int32(spell->RecoveryTime))
+            player->ModifySpellCooldown(spell->Id, int32(spell->RecoveryTime) - remaining);
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_gunslinger_shot::CheckCast);
+        AfterCast += SpellCastFn(spell_wcme_gunslinger_shot::HandleAfterCast);
+    }
+};
