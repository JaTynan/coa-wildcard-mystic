+        Unit* caster = GetCaster();
+        if (!WcmeKeepRiptide.erase(caster->GetGUID()))
+            return;
+        if (AuraEffect const* riptide = GetHitUnit()->GetAuraEffect(SPELL_AURA_PERIODIC_HEAL, SPELLFAMILY_SHAMAN, 0, 0, 0x10, caster->GetGUID()))
+        {
+            _riptide = riptide->GetId();
+            _remaining = riptide->GetBase()->GetDuration();
+        }
+    }
+
+    void Restore()
+    {
+        if (!_riptide)
+            return;
+        Unit* target = GetHitUnit();
+        if (!target->HasAura(_riptide, GetCaster()->GetGUID()))
+            if (Aura* riptide = GetCaster()->AddAura(_riptide, target))
+                riptide->SetDuration(_remaining);
+        _riptide = 0;
+    }
+
+    void Register() override
+    {
+        BeforeHit += BeforeSpellHitFn(spell_wcme_chain_heal_keep_riptide::Remember);
+        AfterHit += SpellHitFn(spell_wcme_chain_heal_keep_riptide::Restore);
+    }
