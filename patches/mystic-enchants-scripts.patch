+// Words of Healing (81470): effective direct heals add a stack of Premonition; at full stacks it becomes
+// Clairvoyant. (Its heal crit bonus while Borrowed Time is up is an aura link, sql/enchants/016.)
+class spell_wcme_words_of_healing : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_words_of_healing);
+
+    static constexpr uint32 PREMONITION = 985341;
+    static constexpr uint32 CLAIRVOYANT = 985342;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return heal && heal->GetEffectiveHeal() > 0 && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        owner->CastSpell(owner, PREMONITION, true);
+        if (Aura const* premonition = owner->GetAura(PREMONITION))
+        {
+            uint32 const full = premonition->GetSpellInfo()->StackAmount;
+            if (full && premonition->GetStackAmount() >= full)
+            {
+                owner->RemoveAurasDueToSpell(PREMONITION);
+                owner->CastSpell(owner, CLAIRVOYANT, true);
+            }
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_words_of_healing::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_words_of_healing::HandleProc);
+    }
+};
