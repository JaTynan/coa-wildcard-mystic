+// Overflow (enchant 1571951, whose Regrowth and Nourish casts already give Overflow stacks 1571954 through the core's
+// enchant procs): your next Healing Touch spends the stacks. It always plants Living Seed (48504: 30% of the heal) if
+// you know Living Seed, and heals one more ally within 12 yards per stack for 30% of the amount healed (1571952), the
+// most injured first. The stacks' cast time and mana cut is the data's own spell mod.
+class spell_wcme_overflow_stacks : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_overflow_stacks);
+
+    static constexpr uint32 OVERFLOW_HEAL = 1571952;
+    static constexpr uint32 SEED = 48504;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return heal && heal->GetHeal() && eventInfo.GetActionTarget() && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeNamed(eventInfo.GetSpellInfo(), "Healing Touch");
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        uint32 const healed = eventInfo.GetHealInfo()->GetHeal();
+        uint8 const stacks = GetStackAmount();
+        if (WcmeHasAnyAura(owner, { 48496, 48499, 48500 }))
+            owner->CastCustomSpell(SEED, SPELLVALUE_BASE_POINT0, int32(healed * 30 / 100), target, true);
+        if (SpellInfo const* overflow = sSpellMgr->GetSpellInfo(OVERFLOW_HEAL))
+        {
+            std::list<Unit*> allies = WcmeAlliesNear(owner, target, 12.0f, 40);
+            allies.remove_if([owner, target](Unit* ally) { return ally == target || (!ally->IsInRaidWith(owner) && ally != owner); });
+            allies.sort([](Unit* first, Unit* second) { return first->GetHealthPct() < second->GetHealthPct(); });
+            uint8 healedAllies = 0;
+            for (Unit* ally : allies)
+            {
+                if (healedAllies++ >= stacks)
+                    break;
+                HealInfo extra(owner, ally, healed * 30 / 100, overflow, overflow->GetSchoolMask());
+                owner->HealBySpell(extra);
+            }
+        }
+        Remove();
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_overflow_stacks::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_overflow_stacks::HandleProc);
+    }
