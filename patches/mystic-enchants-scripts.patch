+// Epic batch 5, unit side:
+// - Blessed by the Elune (272253): notes the Eclipse for the spell side.
+// - Deter and Punish (977988 / 283979): while Deterrence lasts you also reflect spells (Spell Reflection 11818 set to
+//   100%) and counterattack melee attacks from the front (Retaliation 20230, up to its 20 counterattacks); both end with
+//   Deterrence.
+// - Spellstorm (271709): Missile Barrage used by Arcane Missiles gives Arcane Evoked (271710); Brain Freeze (57761)
+//   used by Fireball or Frostfire Bolt gives Fire Evoked (271713). Given just after, so the spell that used the proc
+//   doesn't use the new buff.
+// - Predatory Nature (979050): each Predator's Swiftness you use restores 10 energy and adds a stack of 979051 (up to 2,
+//   12 sec, its own data). Using it with 2 stacks instead uses them up for 979055: 5 combo points on your target (2 if
+//   the target is a player) and a 100% critical strike chance on the next Predator's Swiftness spell, which is removed
+//   once that spell is cast.
+// - Suffocating Roots (84378): notes a dispelled Entangling Roots of yours for the spell side.
+// - Soul Siphoner (81398): Haunt heals you for half, and heals the 3 lowest-health members of your party or raid within
+//   40 yards for that half too.
+// - Blood Shield (288804): in Frost Presence, Death Strike's heal also shields you (288805) for 100% of it, adding to
+//   what is left of the shield, capped at 20% of your maximum health (10% when your target is a player).
+// - Tidecaller's Boon (271813): Healing Wave heals 50% more, less 4% for each stack of your Tidecaller's Boon (271814)
+//   on the target, then adds 3 stacks (up to 15, 10 sec). Each of your periodic heals on the target takes a stack off.
+// - Twilight (84471): with Vampiric Embrace up, your bleeds heal through it like Shadow damage (you for its percentage
+//   of the tick, your party for a fifth of that), as the core's Vampiric Embrace does.
+// - Elemental Lord (276578): Lava Burst +55% (+20% against players) with Elemental Solidification, which it uses up;
+//   Flame Shock ticks with Elemental Lava (276587) have a 20% chance to finish Lava Burst's cooldown.
+class wcme_epic_batch5_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch5_hooks() : UnitScript("wcme_epic_batch5_hooks", true, { UNITHOOK_ON_AURA_APPLY, UNITHOOK_ON_AURA_REMOVE,
+        UNITHOOK_MODIFY_HEAL_RECEIVED, UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN }) { }
+
+    static bool Deterrence(Aura const* aura)
+    {
+        SpellInfo const* info = aura->GetSpellInfo();
+        return info->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamed(info, "Deterrence") &&
+            info->HasAura(SPELL_AURA_MOD_PARRY_PERCENT);
+    }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (!unit || !aura || aura->GetOwner() != unit)
+            return;
+        SpellInfo const* info = aura->GetSpellInfo();
+        if (unit->HasAura(272253) && info->SpellFamilyName == SPELLFAMILY_DRUID)
+        {
+            uint8 const kind = WcmeNamed(info, "Eclipse (Solar)") ? 1 : WcmeNamed(info, "Eclipse (Lunar)") ? 2 : 0;
+            if (kind)
+            {
+                WcmeEclipseNext[unit->GetGUID()] |= kind;
+                WcmeEclipseUntil[unit->GetGUID()] = GameTime::Now() + 30s;
+            }
+        }
+        if (WcmeHasAnyAura(unit, { 977988, 283979 }) && Deterrence(aura))
+        {
+            int32 const duration = aura->GetDuration();
+            if (Aura* reflect = unit->AddAura(11818, unit))
+            {
+                if (AuraEffect* effect = reflect->GetEffect(EFFECT_0))
+                    effect->ChangeAmount(100);
+                reflect->SetMaxDuration(duration);
+                reflect->SetDuration(duration);
+            }
+            if (Aura* retaliate = unit->AddAura(20230, unit))
+            {
+                retaliate->SetMaxDuration(duration);
+                retaliate->SetDuration(duration);
+            }
+        }
+    }
+
+    void OnAuraRemove(Unit* unit, AuraApplication* aurApp, AuraRemoveMode mode) override
+    {
+        if (!unit || !aurApp)
+            return;
+        Aura* aura = aurApp->GetBase();
+        SpellInfo const* info = aura->GetSpellInfo();
+        uint32 const id = aura->GetId();
+
+        if (WcmeHasAnyAura(unit, { 977988, 283979 }) && Deterrence(aura))
+        {
+            unit->RemoveAurasDueToSpell(11818, unit->GetGUID());
+            unit->RemoveAurasDueToSpell(20230, unit->GetGUID());
+        }
+
+        if ((id == 44401 || id == 57761) && unit->HasAura(271709) && WcmeConsumed(aurApp, mode))
+        {
+            uint32 const evoked = id == 44401 ? 271710 : 271713;
+            unit->m_Events.AddEventAtOffset([unit, evoked]() { unit->AddAura(evoked, unit); }, 1ms);
+        }
+
+        if (unit->HasAura(979050) && info->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(info, "Predator's Swiftness") &&
+            WcmeConsumed(aurApp, mode))
+        {
+            bool const hadCrit = unit->HasAura(979055);
+            unit->m_Events.AddEventAtOffset([unit, hadCrit]()
+            {
+                if (hadCrit)
+                    unit->RemoveAurasDueToSpell(979055);
+                Aura const* stacks = unit->GetAura(979051);
+                if (!stacks || stacks->GetStackAmount() < 2)
+                {
+                    unit->CastSpell(unit, 979051, true);
+                    return;
+                }
+                Player* player = unit->ToPlayer();
+                Unit* target = player ? player->GetSelectedUnit() : nullptr;
+                if (target && target->IsAlive() && unit->IsValidAttackTarget(target))
+                {
+                    int32 const points = target->IsControlledByPlayer() ? 2 : 5;
+                    unit->CastCustomSpell(target, 979055, &points, nullptr, nullptr, true);
+                }
+                else
+                    unit->AddAura(979055, unit);
+                unit->RemoveAurasDueToSpell(979051);
+                unit->EnergizeBySpell(unit, 979051, 10, POWER_ENERGY);
+            }, 1ms);
+        }
+
+        if (mode == AURA_REMOVE_BY_ENEMY_SPELL && info->SpellFamilyName == SPELLFAMILY_DRUID &&
+            WcmeNamed(info, "Entangling Roots"))
+            if (Unit* druid = aura->GetCaster(); druid && druid->HasAura(84378))
+            {
+                if (WcmeRootsPending.size() > 16)
+                    WcmeRootsPending.clear();
+                WcmeRootsPending.push_back({ unit->GetGUID(), druid->GetGUID(), id });
+            }
+    }
+
+    static std::vector<Player*> LowestMembers(Player* player, uint32 count)
+    {
+        std::vector<Player*> members;
+        if (Group* group = player->GetGroup())
+            for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+                if (Player* member = ref->GetSource(); member && member != player && member->IsInWorld() &&
+                    member->IsAlive() && member->IsInMap(player) && member->IsWithinDistInMap(player, 40.0f))
+                    members.push_back(member);
+        std::sort(members.begin(), members.end(), [](Player* a, Player* b) { return a->GetHealthPct() < b->GetHealthPct(); });
+        if (members.size() > count)
+            members.resize(count);
+        return members;
+    }
+
+    void ModifyHealReceived(Unit* target, Unit* healer, uint32& heal, SpellInfo const* spellInfo) override
+    {
+        if (!target || !healer || !spellInfo || !heal || _inner)
+            return;
+        WcmeHealParties(target, healer, heal, spellInfo);
+        Player* player = healer->ToPlayer();
+        if (!player)
+            return;
+        bool const periodic = spellInfo->HasAura(SPELL_AURA_PERIODIC_HEAL) && WcmeLastHealTick.amount == &heal;
+
+        if (target == player && player->HasAura(81398) && WcmeNamedAny(spellInfo, { "Haunt (Heal)", "Haunt" }))
+        {
+            heal /= 2;
+            std::vector<ObjectGuid> allies;
+            for (Player* member : LowestMembers(player, 3))
+                allies.push_back(member->GetGUID());
+            uint32 const amount = heal;
+            uint32 const id = spellInfo->Id;
+            if (!allies.empty() && amount)
+                player->m_Events.AddEventAtOffset([player, allies, amount, id]()
+                {
+                    SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+                    _inner = true;
+                    for (ObjectGuid const& guid : allies)
+                        if (Player* ally = ObjectAccessor::GetPlayer(*player, guid); ally && ally->IsAlive())
+                        {
+                            HealInfo healInfo(player, ally, amount, info, info ? info->GetSchoolMask() : SPELL_SCHOOL_MASK_SHADOW);
+                            player->HealBySpell(healInfo);
+                        }
+                    _inner = false;
+                }, 1ms);
+        }
+
+        if (target == player && player->HasAura(288804) && spellInfo->SpellFamilyName == SPELLFAMILY_DEATHKNIGHT &&
+            WcmeNamed(spellInfo, "Death Strike") && WcmeHasAuraNamed(player, "Frost Presence", SPELLFAMILY_DEATHKNIGHT))
+        {
+            AuraEffect const* rule = player->GetAuraEffect(288804, EFFECT_0);
+            int32 const add = int32(uint64(heal) * uint32(rule ? std::max(0, rule->GetAmount()) : 100) / 100);
+            Unit* victim = player->GetVictim();
+            int32 const cap = int32(player->CountPctFromMaxHealth(victim && victim->IsControlledByPlayer() ? 10 : 20));
+            if (add > 0)
+                player->m_Events.AddEventAtOffset([player, add, cap]()
+                {
+                    AuraEffect* shield = player->GetAuraEffect(288805, EFFECT_0);
+                    int32 const total = std::min(cap, (shield ? shield->GetAmount() : 0) + add);
+                    if (shield)
+                    {
+                        shield->ChangeAmount(total);
+                        shield->GetBase()->RefreshDuration();
+                    }
+                    else
+                        player->CastCustomSpell(player, 288805, &total, nullptr, nullptr, true);
+                }, 1ms);
+        }
+
+        if (player->HasAura(271813) && spellInfo->SpellFamilyName == SPELLFAMILY_SHAMAN)
+        {
+            if (!periodic && WcmeNamed(spellInfo, "Healing Wave"))
+            {
+                Aura const* boon = target->GetAura(271814, player->GetGUID());
+                uint32 const stacks = boon ? boon->GetStackAmount() : 0;
+                heal = uint32(uint64(heal) * (150 - std::min<uint32>(stacks, 15) * 4) / 100);
+                ObjectGuid const guid = target->GetGUID();
+                player->m_Events.AddEventAtOffset([player, guid]()
+                {
+                    if (Unit* ally = ObjectAccessor::GetUnit(*player, guid); ally && ally->IsAlive())
+                        for (uint8 i = 0; i < 3; ++i)
+                            WcmeAddStack(ally, 271814, player);
+                }, 1ms);
+            }
+            else if (periodic && target->HasAura(271814, player->GetGUID()))
+                {
+                    ObjectGuid const guid = target->GetGUID();
+                    player->m_Events.AddEventAtOffset([player, guid]()
+                    {
+                        if (Unit* ally = ObjectAccessor::GetUnit(*player, guid))
+                            if (Aura* stack = ally->GetAura(271814, player->GetGUID()))
+                                stack->ModStackAmount(-1);
+                    }, 1ms);
+                }
+        }
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || !damage || target == attacker ||
+            spellInfo->HasAura(SPELL_AURA_PERIODIC_HEAL) || spellInfo->HasAura(SPELL_AURA_OBS_MOD_HEALTH))
+            return;
+        if (attacker->HasAura(84471) && WcmeIsBleed(spellInfo))
+            for (AuraEffect const* effect : attacker->GetAuraEffectsByType(SPELL_AURA_DUMMY))
+                if (effect->GetCasterGUID() == attacker->GetGUID() && effect->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_PRIEST &&
+                    WcmeNamed(effect->GetSpellInfo(), "Vampiric Embrace"))
+                {
+                    int32 const self = CalculatePct(int32(damage), effect->GetAmount());
+                    int32 const party = self / 5;
+                    if (self > 0)
+                        attacker->m_Events.AddEventAtOffset([attacker, self, party]()
+                        {
+                            if (attacker->IsAlive())
+                                attacker->CastCustomSpell(attacker, 15290, &party, &self, nullptr, true);
+                        }, 1ms);
+                    break;
+                }
+        if (attacker->HasAura(276587) && spellInfo->SpellFamilyName == SPELLFAMILY_SHAMAN &&
+            WcmeNamed(spellInfo, "Flame Shock") && roll_chance_i(20))
+            attacker->m_Events.AddEventAtOffset([attacker]() { WcmeRestoreChargeByName(attacker, "Lava Burst"); }, 1ms);
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0 || target == attacker || !attacker->HasAura(276586) ||
+            spellInfo->SpellFamilyName != SPELLFAMILY_SHAMAN || !WcmeNamed(spellInfo, "Lava Burst"))
+            return;
+        damage = int32(std::min<int64>(INT32_MAX, int64(damage) * (target->IsControlledByPlayer() ? 120 : 155) / 100));
+        attacker->m_Events.AddEventAtOffset([attacker]() { attacker->RemoveAurasDueToSpell(276586); }, 1ms);
+    }
+
+private:
+    static inline thread_local bool _inner = false;
+};
