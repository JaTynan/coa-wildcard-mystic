+// Time Warp (965245): Blink grants Time Distortion (965246, 8 sec) and marks where you blinked from for 3 sec (848019).
+// Damaging spells with a cast time extend Time Distortion by 1 sec and take 2 sec off Blink. The taught Time Warp
+// (1570042, spell_wcme_time_warp_return) takes you back to the marked spot and extends Time Distortion by 3 sec.
+std::unordered_map<ObjectGuid, WorldLocation> WcmeTimeWarpPoints;
+
+void WcmeExtendAura(Unit* unit, uint32 spellId, int32 ms)
+{
+    if (Aura* aura = unit->GetAura(spellId))
+    {
+        int32 const duration = aura->GetDuration() + ms;
+        if (duration > aura->GetMaxDuration())
+            aura->SetMaxDuration(duration);
+        aura->SetDuration(duration);
+    }
+}
