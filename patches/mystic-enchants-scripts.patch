+// Demolisher (977864): its own design instead of twin 273786 (003 no longer links them). Mortal Strike shows as
+// Demolishing Strike (947486, WcmeSyncSwap: the core does not swap it, the names differ), which puts Demolish on the target (273795: 2% more Physical damage
+// taken from you per stack, 6 stacks). Each of your melee critical strikes on it adds a stack; at 6 stacks Demolish is
+// spent and your next of these abilities is empowered: Expose Armor gives you Demolishing Strikes (954090: 35% armor
+// penetration for 20 sec); Riposte awards 2 more combo points and slows the target's attack speed by 10% more;
+// Mongoose Bite triggers no cooldown and deals as much as a critical strike with 100% more damage (50% against
+// players).
+class spell_wcme_demolisher : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_demolisher);
+
+    static constexpr uint32 DEMOLISH = 273795;
+    static constexpr uint32 DEMOLISHING_STRIKES = 954090;
+    bool _empowered = false;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+            return false;
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return _empowered && WcmeNamedAny(spell, { "Expose Armor", "Mongoose Bite" });
+        if (!target || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (spell && (WcmeNamed(spell, "Demolishing Strike") || (_empowered && WcmeNamedAny(spell, { "Riposte", "Mongoose Bite" }))))
+            return true;
+        return (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) && target->HasAura(DEMOLISH, GetTarget()->GetGUID());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamed(spell, "Mongoose Bite"))
+            {
+                WcmeCutCooldownByName(owner, "Mongoose Bite", 3600000);
+                return;
+            }
+            _empowered = false;
+            if (Aura* strikes = owner->AddAura(DEMOLISHING_STRIKES, owner))
+                if (AuraEffect* pen = strikes->GetEffect(EFFECT_0))
+                    pen->ChangeAmount(35);
+            return;
+        }
+        if (_empowered && WcmeNamed(spell, "Riposte"))
+        {
+            _empowered = false;
+            owner->AddComboPoints(target, 2);
+            for (AuraEffect* slow : target->GetAuraEffectsByType(SPELL_AURA_MOD_MELEE_HASTE))
+                if (slow->GetCasterGUID() == owner->GetGUID() && slow->GetId() == spell->Id)
+                    slow->ChangeAmount(slow->GetAmount() - 10);
+            return;
+        }
+        if (_empowered && WcmeNamed(spell, "Mongoose Bite"))
+        {
+            _empowered = false;
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            int64 const dealt = int64(damage->GetDamage() + damage->GetAbsorb());
+            bool const crit = eventInfo.GetHitMask() & PROC_HIT_CRITICAL;
+            int64 const normal = crit ? dealt / 2 : dealt;
+            int64 const wanted = normal * 2 * (target->IsPlayer() ? 150 : 200) / 100;
+            WcmeExtraDamage(owner, target, spell, wanted - dealt);
+            return;
+        }
+        if (WcmeNamed(spell, "Demolishing Strike") && !target->HasAura(DEMOLISH, owner->GetGUID()))
+        {
+            owner->AddAura(DEMOLISH, target);
+            return;
+        }
+        Aura* demolish = target->GetAura(DEMOLISH, owner->GetGUID());
+        if (!demolish || !(eventInfo.GetHitMask() & PROC_HIT_CRITICAL))
+        {
+            if (demolish)
+                demolish->RefreshDuration();
+            return;
+        }
+        if (uint32(demolish->GetStackAmount()) + 1 >= demolish->GetSpellInfo()->StackAmount)
+        {
+            demolish->Remove();
+            _empowered = true;
+            return;
+        }
+        demolish->SetStackAmount(demolish->GetStackAmount() + 1);
+        demolish->RefreshDuration();
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncSwap(GetTarget(), "Mortal Strike", SPELLFAMILY_WARRIOR, 947486, true);
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncSwap(GetTarget(), "Mortal Strike", SPELLFAMILY_WARRIOR, 947486, false);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_demolisher::CheckProc);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_demolisher::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_demolisher::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnProc += AuraProcFn(spell_wcme_demolisher::HandleProc);
+    }
+};
