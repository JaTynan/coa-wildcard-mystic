+// Nature's Fervor (965283): fully stacking Lacerate on a target empowers the next Feral ability.
+class spell_wcme_natures_fervor : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_natures_fervor);
+
+    static constexpr uint32 EMPOWERED = 965284;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return WcmeNamed(eventInfo.GetSpellInfo(), "Lacerate") && eventInfo.GetActionTarget();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (Aura const* lacerate = eventInfo.GetActionTarget()->GetAura(spell->Id, owner->GetGUID()))
+        {
+            uint32 const full = std::max<uint32>(1, lacerate->GetSpellInfo()->StackAmount);
+            if (lacerate->GetStackAmount() >= full)
+                owner->CastSpell(owner, EMPOWERED, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_natures_fervor::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_natures_fervor::HandleProc);
+    }
+};
