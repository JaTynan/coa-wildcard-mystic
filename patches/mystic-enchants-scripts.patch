+// Hot Hands (979765 / 1575104): Pyroblast counts toward Hot Streak (patches/66-enchant-core-hooks.ps1 and sql 026), and a
+// Pyroblast cast with Hot Streak up costs no mana. Your spells crit 8% more often on targets with your Living Bomb
+// (Hot Hands mark 9990019, kept as long as the bomb). Fireball or Fire Blast hits on a Living Bomb target add a stack of
+// Living Fire (979848: +8% damage and crit for your next Pyroblast, up to 5), used up by that Pyroblast. Instant
+// Pyroblasts add a stack of Superheated (984658: +3% Fire damage and haste, up to 8) without refreshing its duration.
+class spell_wcme_hot_hands : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_hot_hands);
+
+    static constexpr uint32 HOT_STREAK = 48108;
+    static constexpr uint32 MARK = 9990019;
+    static constexpr uint32 LIVING_FIRE = 979848;
+    static constexpr uint32 SUPERHEATED = 984658;
+    bool _streakAtCast = false;
+
+    static AuraEffect const* LivingBomb(Unit* target, Unit* owner)
+    {
+        return target->GetAuraEffect(SPELL_AURA_PERIODIC_DAMAGE, SPELLFAMILY_MAGE, 0, 0x20000, 0, owner->GetGUID());
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeNamedAny(spell, { "Pyroblast", "Fireball", "Fire Blast", "Living Bomb" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Spell const* cast = eventInfo.GetProcSpell();
+        Unit* target = eventInfo.GetActionTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (!WcmeNamed(spell, "Pyroblast"))
+                return;
+            _streakAtCast = owner->HasAura(HOT_STREAK);
+            if (_streakAtCast && cast)
+                owner->ModifyPower(POWER_MANA, cast->GetPowerCost());
+            if (cast && cast->GetCastTime() <= 0)
+            {
+                Aura* superheated = owner->GetAura(SUPERHEATED);
+                int32 const left = superheated ? superheated->GetDuration() : 0;
+                owner->CastSpell(owner, SUPERHEATED, true);
+                if (superheated && (superheated = owner->GetAura(SUPERHEATED)))
