+// Shadow Visions (965299: 9 fragments; 1570700: 6 fragments): Mind Flay damage adds a Soul Fragment; enough of them
+// become Shadow Visions (15 sec), which empowers your next Vampiric Touch, Devouring Plague or Mind Blast.
+// 965299, as its tooltip says: Vampiric Touch puts Engulfing Shadows on the target (12% more Shadow damage and 15% more
+// Vampiric Touch damage from you, 15 sec). Devouring Plague lasts 6 sec longer and ticks twice as fast (the buff's own
+// spell modifiers, which the core applies), explodes for Shadow damage on enemies around the target, and goes on a 12
+// sec cooldown. Mind Blast deals 65% more damage (25% against players), and your next Mind Flay deals 25% more damage,
+// 1% less for each tick (Mind Sear is above this server's level cap).
+// 1570700, as its own data says: Devouring Plague lasts 12 sec longer; Mind Blast deals 50% more damage and your next
+// Mind Flay deals 30% more; Vampiric Touch marks the target to take 20% more periodic damage from you.
+class spell_wcme_shadow_visions : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_shadow_visions);
+
+    int32 _flayPending = 0;   // bonus % for the next Mind Flay
+    int32 _flayBonus = 0;     // bonus % for the Mind Flay being channelled
+    int32 _flayDecay = 0;
+
+    bool Original() const { return GetId() == 965299; }
+    uint32 Buff() const { return Original() ? 965900 : 1570702; }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Mind Flay"))
+            return true;
+        return !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) && eventInfo.GetActionTarget() &&
+            WcmeNamedAny(spell, { "Vampiric Touch", "Devouring Plague", "Mind Blast" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const original = Original();
+
+        if (WcmeNamed(spell, "Mind Flay"))
+        {
+            if (!(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            {
+                // A new channel: the pending Mind Blast bonus, if any, belongs to it.
+                _flayBonus = _flayPending;
+                _flayDecay = original ? 1 : 0;
+                _flayPending = 0;
+                return;
+            }
+            if (!WcmeDealtDamage(eventInfo))
+                return;
+            if (_flayBonus > 0 && target)
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * _flayBonus / 100);
+                _flayBonus -= _flayDecay;
+            }
+            if (WcmeAddStacks(owner, original ? 965899 : 1570701, 1, original ? 9 : 6))
+                owner->CastSpell(owner, Buff(), true);
+            return;
+        }
+
+        if (WcmeNamed(spell, "Devouring Plague"))
+        {
+            Aura* plague = target->GetAura(spell->Id, owner->GetGUID());
+            if (!plague)
+                return;
+            if (original)
+            {
+                // The buff's modifiers already doubled the tick rate and spent the buff when this Plague was cast.
+                AuraEffect const* periodic = plague->GetEffect(EFFECT_0);
+                if (!periodic || !periodic->GetAmplitude() || periodic->GetAmplitude() >= int32(spell->GetEffect(EFFECT_0).Amplitude))
+                    return;
+                owner->CastSpell(target, 986286, true);   // Devouring Shadows
+                if (Player* player = owner->ToPlayer())
+                    player->AddSpellCooldown(spell->Id, 0, 12000, true);
+                return;
+            }
+            if (!owner->HasAura(Buff()))
+                return;
+            owner->RemoveAurasDueToSpell(Buff());
+            plague->SetMaxDuration(plague->GetMaxDuration() + 12000);
+            plague->SetDuration(plague->GetDuration() + 12000);
+            return;
+        }
+
+        bool const touch = WcmeNamed(spell, "Vampiric Touch");
+        if (!owner->HasAura(Buff()) || (!touch && !WcmeDealtDamage(eventInfo)))   // a Mind Blast that missed keeps it
+            return;
+        owner->RemoveAurasDueToSpell(Buff());
+        if (touch)
+            owner->CastSpell(target, original ? 965901 : 1570706, true);
+        else   // Mind Blast
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            int32 const pct = original ? (target->GetTypeId() == TYPEID_PLAYER ? 25 : 65) : 50;
+            WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * pct / 100);
+            _flayPending = original ? 25 : 30;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_shadow_visions::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_shadow_visions::HandleProc);
+    }
+};
