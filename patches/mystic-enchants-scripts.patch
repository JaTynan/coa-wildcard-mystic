+// Prayer of Preservation (986033): the core turns Prayer of Healing into Prayer of Preservation (888571). Each of its
+// heals gives the ally Preservation (888593: +20% chance to be critically healed by you); a Prayer of Preservation
+// cast while you have Divine Favor also gives each ally it heals Shield of Preservation (888591: 30% less area damage).
+// Your next other heal on an ally with your Preservation spends it: Shield of Preservation, an extra Preservation heal
+// (888592: 69 + 5% SP + 1% AP, like one Prayer of Preservation tick) on the ally and up to 4 allies within 10 yards,
+// and 3 sec off Prayer of Preservation's cooldown (888569). Its last tick heals 70% more (888594,
+// spell_wcme_prayer_of_preservation_hot).
+std::unordered_map<ObjectGuid, TimePoint> WcmePreservationFavor;
+
+class spell_wcme_prayer_of_preservation : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_prayer_of_preservation);
+
+    static constexpr uint32 PRESERVATION = 888593;
+    static constexpr uint32 SHIELD = 888591;
+    static constexpr uint32 EXTRA_HEAL = 888592;
+    static constexpr uint32 COOLDOWN_CUT = 888569;
+
+    static bool IsPrayer(SpellInfo const* spell)
+    {
+        return WcmeNamed(spell, "Prayer of Preservation");
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!heal || !heal->GetHeal() || !spell || !target || spell->Id == EXTRA_HEAL)
+            return false;
+        return IsPrayer(spell) || target->HasAura(PRESERVATION, GetTarget()->GetGUID());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (IsPrayer(eventInfo.GetSpellInfo()))
+        {
+            owner->AddAura(PRESERVATION, target);
+            auto favor = WcmePreservationFavor.find(owner->GetGUID());
+            if (favor != WcmePreservationFavor.end() && GameTime::Now() <= favor->second)
+                owner->CastSpell(target, SHIELD, true);
+            return;
+        }
+        target->RemoveAura(PRESERVATION, owner->GetGUID());
+        owner->CastSpell(target, SHIELD, true);
+        owner->CastSpell(owner, COOLDOWN_CUT, true);
+        SpellInfo const* extra = sSpellMgr->GetSpellInfo(EXTRA_HEAL);
+        if (!extra)
+            return;
+        uint32 const base = uint32(69 + 0.05f * owner->SpellBaseHealingBonusDone(SPELL_SCHOOL_MASK_ALL) + 0.01f * WcmeAttackPower(owner));
+        for (Unit* ally : WcmeAlliesNear(owner, target, 10.0f, 5))
+        {
+            uint32 amount = owner->SpellHealingBonusDone(ally, extra, base, ::HEAL, EFFECT_0);
+            amount = ally->SpellHealingBonusTaken(owner, extra, amount, ::HEAL);
+            HealInfo healInfo(owner, ally, amount, extra, extra->GetSchoolMask());
+            owner->HealBySpell(healInfo);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_prayer_of_preservation::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_prayer_of_preservation::HandleProc);
+    }
+};
