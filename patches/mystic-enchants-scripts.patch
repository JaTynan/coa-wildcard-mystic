+static void WcmeAddStack(Unit* owner, uint32 spellId, Unit* caster = nullptr)
+{
+    if (!caster)
+        caster = owner;
+    if (Aura* aura = owner->GetAura(spellId, caster->GetGUID()))
+    {
+        aura->ModStackAmount(1);
+        aura->RefreshDuration();
+    }
+    else
+        caster->AddAura(spellId, owner);
+}
+
+// For a helper cast with an amount already worked out from a finished hit or heal: the core would otherwise add the
+// caster's spell power and percentage bonuses to it a second time when the aura is applied. Damage helpers skip the
+// caster's modifiers entirely; heal helpers lose their spell power coefficient (the core has no "skip" for heals).
+static void WcmeNoSecondBonus(uint32 spellId)
+{
+    SpellInfo* info = const_cast<SpellInfo*>(sSpellMgr->GetSpellInfo(spellId));
+    if (!info)
+        return;
+    info->AttributesEx3 |= SPELL_ATTR3_IGNORE_CASTER_MODIFIERS;
+    for (SpellEffectInfo& effect : info->Effects)
+        effect.BonusMultiplier = 0.0f;
+}
+
+static bool WcmeIsBleed(SpellInfo const* info)
+{
+    return info && (info->Mechanic == MECHANIC_BLEED || (info->GetAllEffectsMechanicMask() & (1ULL << MECHANIC_BLEED)));
+}
+
+// An aura that was used up by a spell rather than running out: spell modifier charges drop with the "expire" mode, so
+// an aura removed that way with time still left on it was consumed.
+static bool WcmeConsumed(AuraApplication const* aurApp, AuraRemoveMode mode)
+{
+    Aura const* aura = aurApp->GetBase();
+    return mode == AURA_REMOVE_BY_DEFAULT || (mode == AURA_REMOVE_BY_EXPIRE && (aura->GetDuration() > 0 || aura->GetMaxDuration() < 0));
+}
