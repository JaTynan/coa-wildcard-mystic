+    static constexpr uint32 SHARPENED_BLADE = 983798;
+    static constexpr uint32 SAVAGE_BLADE = 983797;
+    static constexpr uint32 GLAIVE_TOSS = 954821;
+    static constexpr int32 SHARPEN_CHANCE = 20;
