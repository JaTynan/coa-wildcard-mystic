+// Curse of Arugal (982806): Cat finishing moves have a 20% chance per combo point to grant Goldrinn's Guile;
+// while Goldrinn's Fury is up, Cat ability damage applies a stack of Arugal's Gift.
+class spell_wcme_curse_of_arugal : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_curse_of_arugal);
+
+    static constexpr uint32 GOLDRINNS_GUILE = 982816;
+    static constexpr uint32 GOLDRINNS_FURY = 982811;
+    static constexpr uint32 ARUGALS_GIFT = 982812;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() && GetTarget()->GetShapeshiftForm() == FORM_CAT;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            // combo points are still on the caster during the cast phase; they are spent in the finish phase
+            if (spell->NeedsComboPoints())
+                if (uint8 const points = owner->GetComboPoints())
+                    if (roll_chance_i(20 * points))
+                        owner->CastSpell(owner, GOLDRINNS_GUILE, true);
+            return;
+        }
+        if (owner->HasAura(GOLDRINNS_FURY) && WcmeDealtDamage(eventInfo))
+            if (Unit* target = eventInfo.GetActionTarget())
+                if (target != owner)
+                    owner->CastSpell(target, ARUGALS_GIFT, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_curse_of_arugal::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_curse_of_arugal::HandleProc);
+    }
+};
+
+// Primordial Fury (977717): during Shamanistic Rage, non-periodic spell and ability critical hits spend 50 rage
+// to deal Elemental damage and grant a stack of Elemental Rage. Nothing happens without the rage.
+class spell_wcme_primordial_fury : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_primordial_fury);
+
+    static constexpr uint32 ELEMENTAL_DAMAGE = 977718;
+    static constexpr uint32 ELEMENTAL_RAGE = 985349;
+    static constexpr int32 RAGE_COST = 500;   // 50 rage, stored as tenths
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        return eventInfo.GetSpellInfo() && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) &&
+            !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeHasAnyAura(owner, { 30823, 1130823, 1230823 }) && int32(owner->GetPower(POWER_RAGE)) >= RAGE_COST;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        owner->ModifyPower(POWER_RAGE, -RAGE_COST);
+        if (Unit* target = eventInfo.GetActionTarget())
+            if (target != owner)
+                owner->CastSpell(target, ELEMENTAL_DAMAGE, true);
+        owner->CastSpell(owner, ELEMENTAL_RAGE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_primordial_fury::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_primordial_fury::HandleProc);
+    }
+};
+
+// Ice Lash (977764): Ice Lash grants Solid Ice when the off-hand weapon carries Frostbrand; consuming Fingers of
+// Frost has a 33% chance to trigger Ice Crash (Ice Lash's cooldown reset, more damage and targets).
+class spell_wcme_ice_lash : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_ice_lash);
+
+    static constexpr uint32 SOLID_ICE = 977765;
+    static constexpr uint32 ICE_CRASH = 860105;
+    static constexpr int32 ICE_CRASH_CHANCE = 33;
+
+    static bool OffhandFrostbrand(Player* player)
+    {
+        Item* offhand = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+        if (!offhand)
+            return false;
+        uint32 const enchant = offhand->GetEnchantmentId(TEMP_ENCHANTMENT_SLOT);
+        SpellItemEnchantmentEntry const* entry = enchant ? sSpellItemEnchantmentStore.LookupEntry(enchant) : nullptr;
+        return entry && entry->description[0] && std::strstr(entry->description[0], "Frostbrand");
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() != nullptr;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            // Fingers of Frost is spent by the spell being cast now
+            if (!WcmeNamed(spell, "Ice Lash") && WcmeHasAnyAura(owner, { 74396, 1174396, 271943, 997633 }) &&
+                roll_chance_i(ICE_CRASH_CHANCE))
+                owner->CastSpell(owner, ICE_CRASH, true);
+            return;
+        }
+        if (WcmeNamed(spell, "Ice Lash") && WcmeDealtDamage(eventInfo))
+            if (Player* player = owner->ToPlayer())
+                if (OffhandFrostbrand(player))
+                    owner->CastSpell(owner, SOLID_ICE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_ice_lash::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_ice_lash::HandleProc);
+    }
+};
+
+// Words of Healing (81470): effective direct heals add a stack of Premonition; at full stacks it becomes
+// Clairvoyant. (Its heal crit bonus while Borrowed Time is up is an aura link, sql/enchants/016.)
+class spell_wcme_words_of_healing : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_words_of_healing);
+
+    static constexpr uint32 PREMONITION = 985341;
+    static constexpr uint32 CLAIRVOYANT = 985342;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return heal && heal->GetEffectiveHeal() > 0 && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        owner->CastSpell(owner, PREMONITION, true);
+        if (Aura const* premonition = owner->GetAura(PREMONITION))
+        {
+            uint32 const full = premonition->GetSpellInfo()->StackAmount;
+            if (full && premonition->GetStackAmount() >= full)
+            {
+                owner->RemoveAurasDueToSpell(PREMONITION);
+                owner->CastSpell(owner, CLAIRVOYANT, true);
+            }
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_words_of_healing::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_words_of_healing::HandleProc);
+    }
+};
+
+// Borrowed Time (the buff): with Words of Healing active, casting spells no longer uses it up; it lasts its
+// full duration instead.
+class spell_wcme_borrowed_time_kept : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_borrowed_time_kept);
+
+    static constexpr uint32 WORDS_OF_HEALING = 81470;
+
+    void PrepareProc(ProcEventInfo& /*eventInfo*/)
+    {
+        if (Unit* owner = GetUnitOwner())
+            if (owner->HasAura(WORDS_OF_HEALING))
+                PreventDefaultAction();   // the charge is not taken
+    }
+
+    void Register() override
+    {
+        DoPrepareProc += AuraProcFn(spell_wcme_borrowed_time_kept::PrepareProc);
+    }
+};
+
+// Ambidextrous (977771): with Single-Minded Fury, off-hand auto attacks trigger Dominant Strike (main hand);
+// Bloodthirst, Execute and Rend trigger Southpaw Strike (off hand). Each has its own 16 sec cooldown.
+class spell_wcme_ambidextrous : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_ambidextrous);
+
+    static constexpr uint32 DOMINANT_STRIKE = 977774;
+    static constexpr uint32 SOUTHPAW_STRIKE = 977775;
+    static constexpr Seconds COOLDOWN{16};
+    TimePoint _mainReady{};
+    TimePoint _offReady{};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return target && target != GetTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        TimePoint const now = GameTime::Now();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell)
+        {
+            if (eventInfo.GetDamageInfo()->GetAttackType() == OFF_ATTACK && WcmeHasAnyAura(owner, { 988256, 1988256 }) &&
+                now >= _mainReady)
+            {
+                _mainReady = now + COOLDOWN;
+                owner->CastSpell(target, DOMINANT_STRIKE, true);
+            }
+            return;
+        }
+        if (WcmeNamedAny(spell, { "Bloodthirst", "Execute", "Rend" }) && now >= _offReady)
+        {
+            _offReady = now + COOLDOWN;
+            owner->CastSpell(target, SOUTHPAW_STRIKE, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_ambidextrous::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_ambidextrous::HandleProc);
+    }
+};
+
+// Nature's Fervor (965283): fully stacking Lacerate on a target empowers the next Feral ability.
+class spell_wcme_natures_fervor : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_natures_fervor);
+
+    static constexpr uint32 EMPOWERED = 965284;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return WcmeNamed(eventInfo.GetSpellInfo(), "Lacerate") && eventInfo.GetActionTarget();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (Aura const* lacerate = eventInfo.GetActionTarget()->GetAura(spell->Id, owner->GetGUID()))
+        {
+            uint32 const full = std::max<uint32>(1, lacerate->GetSpellInfo()->StackAmount);
+            if (lacerate->GetStackAmount() >= full)
+                owner->CastSpell(owner, EMPOWERED, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_natures_fervor::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_natures_fervor::HandleProc);
+    }
+};
+
+void AddSC_WcmeEnchantScripts()
+{
+    RegisterSpellScript(spell_wcme_rush_of_blood);
+    RegisterSpellScript(spell_wcme_unique_physical_stacks);
+    RegisterSpellScript(spell_wcme_curse_of_arugal);
+    RegisterSpellScript(spell_wcme_primordial_fury);
+    RegisterSpellScript(spell_wcme_ice_lash);
+    RegisterSpellScript(spell_wcme_words_of_healing);
+    RegisterSpellScript(spell_wcme_borrowed_time_kept);
+    RegisterSpellScript(spell_wcme_ambidextrous);
+    RegisterSpellScript(spell_wcme_natures_fervor);
+}
