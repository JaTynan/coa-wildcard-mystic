+        if ((eventInfo.GetHitMask() & PROC_HIT_CRITICAL) && WcmeNamedAny(spell, { "Sinister Strike", "Gloomblade" }))
+        {
+            WcmeAddStacks(owner, APPRENTICE, 1, 0);
