+// Gurubashi Berserker (983135): Raging Blow, Slam and Execute critical strikes add a stack of Gurubashi Berserker
+// (983141: shorter global cooldown, higher rage costs; 983151: its PvP part; up to 10). Raging Blow has a 25% chance
+// on hit, 50% on a critical, to take 10 sec off Siegebreaker and 4 sec off Gurubashi Rage. Siegebreaker extends Gurubashi
+// Rage (983136) by 4 sec, or activates it for 4 sec. Colossus Smash grants Onslaught (984415: 3 charges, Execute usable
+// at any target health, used up as Executes finish), and Executes while it is up deal 25% more damage. Siegebreaker also
+// gives back a Raging Blow charge, and Raging Blow used with 6 or more stacks has a 10% chance to refund its charge.
+class spell_wcme_gurubashi_berserker : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_gurubashi_berserker);
+
+    static constexpr uint32 RAGE = 983136;
+    static constexpr uint32 ONSLAUGHT = 984415;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeNamedAny(spell, { "Raging Blow", "Slam", "Execute", "Siegebreaker", "Colossus Smash" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const cast = eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST;
+        bool const crit = eventInfo.GetHitMask() & PROC_HIT_CRITICAL;
+        if (cast)
+        {
+            if (WcmeNamed(spell, "Colossus Smash"))
+                owner->CastSpell(owner, ONSLAUGHT, true);
+            else if (WcmeNamed(spell, "Raging Blow"))
+            {
+                Aura const* stacks = owner->GetAura(983141);
+                if (stacks && stacks->GetStackAmount() >= 6 && roll_chance_i(10))
+                    WcmeRestoreChargeByName(owner, "Raging Blow");
+            }
+            else if (WcmeNamed(spell, "Siegebreaker"))
+            {
+                WcmeRestoreChargeByName(owner, "Raging Blow");
+                if (Aura* rage = owner->GetAura(RAGE))
+                {
+                    rage->SetMaxDuration(rage->GetMaxDuration() + 4000);
+                    rage->SetDuration(rage->GetDuration() + 4000);
+                }
+                else
+                {
+                    owner->CastSpell(owner, RAGE, true);
+                    if (Aura* fresh = owner->GetAura(RAGE))
+                    {
+                        fresh->SetMaxDuration(4000);
+                        fresh->SetDuration(4000);
+                    }
+                }
+            }
+            return;
+        }
+        if (!WcmeDealtDamage(eventInfo))
+            return;
+        Unit* target = eventInfo.GetActionTarget();
+        if (WcmeNamed(spell, "Execute") && target && owner->HasAura(ONSLAUGHT))
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * 25 / 100);
+        }
+        if (crit && WcmeNamedAny(spell, { "Raging Blow", "Slam", "Execute" }))
+        {
+            for (uint32 stacks : { 983141u, 983151u })
+            {
+                WcmeAddStacks(owner, stacks, 1, 0);
+                if (Aura* aura = owner->GetAura(stacks); aura && aura->GetStackAmount() > 10)
+                    aura->SetStackAmount(10);
+            }
+        }
+        if (WcmeNamed(spell, "Raging Blow") && roll_chance_i(crit ? 50 : 25))
+        {
+            WcmeCutCooldownByName(owner, "Siegebreaker", 10000);
+            WcmeCutCooldownByName(owner, "Gurubashi Rage", 4000);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_gurubashi_berserker::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_gurubashi_berserker::HandleProc);
+    }
+};
