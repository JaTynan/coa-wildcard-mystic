+// Unrelenting Wrath (965288): each damaging Hunter ability cast (shots included) adds a stack of Unrelenting Assault
+// (once per cast); 10 stacks give a charge of Unrelenting Wrath (12 sec, one at a time: the data does not stack it),
+// which lets you cast Unrelenting Wrath (taught while the enchant is active; needs Bestial Wrath known).
+// Sic 'em: Kill Shot sends your pet's next attack in for extra Physical damage. Frenzy Shot lets your next Kill Shot
+// ignore the target's health (10 sec), and resets Kill Shot's cooldown if the target is below 20% health.
+class spell_wcme_unrelenting_wrath : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_unrelenting_wrath);
+
+    static constexpr uint32 ASSAULT = 983870;
+    static constexpr uint32 CHARGE = 983873;
+    static constexpr uint32 SIC_EM = 984837;
+    static constexpr uint32 ANY_HEALTH_KILL_SHOT = 984811;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) && spell->SpellFamilyName == SPELLFAMILY_HUNTER &&
+            !spell->IsPositive() && WcmeDealsAnyDamage(spell);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Kill Shot"))
+        {
+            owner->RemoveAurasDueToSpell(ANY_HEALTH_KILL_SHOT);
+            if (Player* player = owner->ToPlayer())
+                if (player->GetPet())
+                    owner->CastSpell(owner, SIC_EM, true);
+        }
+        else if (WcmeNamed(spell, "Frenzy Shot"))
+        {
+            owner->CastSpell(owner, ANY_HEALTH_KILL_SHOT, true);
+            if (Aura* anyHealth = owner->GetAura(ANY_HEALTH_KILL_SHOT))
+                anyHealth->SetCharges(1);
+            Spell const* cast = eventInfo.GetProcSpell();
+            Unit* target = cast ? cast->m_targets.GetUnitTarget() : nullptr;
+            if (Player* player = owner->ToPlayer(); player && target && target->HealthBelowPct(20))
+                for (uint32 rank : KILL_SHOT_RANKS)
+                    if (player->HasSpellCooldown(rank))
+                        player->RemoveSpellCooldown(rank, true);
+        }
+
+        if (!WcmeAddStacks(owner, ASSAULT, 1, 10))
+            return;
+        if (Aura* charge = owner->GetAura(CHARGE))
+            charge->RefreshDuration();
+        else
+            owner->CastSpell(owner, CHARGE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_unrelenting_wrath::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_unrelenting_wrath::HandleProc);
+    }
+};
