+bool WcmeNamed(SpellInfo const* spell, char const* name)
+{
+    return spell && spell->SpellName[0] && std::strcmp(spell->SpellName[0], name) == 0;
+}
+
+bool WcmeNamedAny(SpellInfo const* spell, std::initializer_list<char const*> names)
+{
+    for (char const* name : names)
+        if (WcmeNamed(spell, name))
+            return true;
+    return false;
+}
+
+bool WcmeHasAnyAura(Unit const* unit, std::initializer_list<uint32> auras)
+{
+    for (uint32 aura : auras)
+        if (unit->HasAura(aura))
+            return true;
+    return false;
+}
+
+uint32 WcmeFirstRank(SpellInfo const* spell)
+{
+    SpellInfo const* first = spell->GetFirstRankSpell();
+    return first ? first->Id : spell->Id;
+}
+
+bool WcmeDealtDamage(ProcEventInfo& eventInfo)
+{
+    DamageInfo const* damage = eventInfo.GetDamageInfo();
+    return damage && damage->GetDamage() + damage->GetAbsorb() > 0;
+}
+
+bool WcmeHasAnyAuraFrom(Unit const* unit, Unit const* caster, std::initializer_list<uint32> auras)
+{
+    for (uint32 aura : auras)
+        if (unit->HasAura(aura, caster->GetGUID()))
+            return true;
+    return false;
+}
+
+// Extra damage of the triggering spell's school, shown in the combat log as that spell (absorbs and resists apply).
+void WcmeExtraDamage(Unit* attacker, Unit* victim, SpellInfo const* spell, int64 amount)
+{
+    if (amount <= 0 || !victim->IsAlive())
+        return;
+    SpellNonMeleeDamage log(attacker, victim, spell, spell->GetSchoolMask());
+    attacker->CalculateSpellDamageTaken(&log, int32(std::min<int64>(amount, INT32_MAX)), spell);
+    attacker->SendSpellNonMeleeDamageLog(&log);
+    attacker->DealSpellDamage(&log, false);
+}
+
+// Adds stacks to a counter aura (its stack number shown on the buff). Returns true when the threshold is reached;
+// the counter is then removed.
+bool WcmeAddStacks(Unit* owner, uint32 counter, uint8 add, uint8 threshold)
+{
+    Aura* aura = owner->GetAura(counter);
+    uint32 const now = (aura ? aura->GetStackAmount() : 0) + add;
+    if (threshold && now >= threshold)
+    {
+        owner->RemoveAurasDueToSpell(counter);
+        return true;
+    }
+    if (!aura)
+    {
+        owner->CastSpell(owner, counter, true);
+        if (!(aura = owner->GetAura(counter)))
+            return false;
+    }
+    aura->SetStackAmount(uint8(std::min<uint32>(now, 255)));
+    aura->RefreshDuration();
+    return false;
+}
+
+bool WcmeDealsDamage(SpellInfo const* spell)
+{
+    for (SpellEffectInfo const& effect : spell->GetEffects())
+        if (effect.Effect == SPELL_EFFECT_SCHOOL_DAMAGE ||
+            (effect.Effect == SPELL_EFFECT_APPLY_AURA && effect.ApplyAuraName == SPELL_AURA_PERIODIC_DAMAGE))
+            return true;
+    return false;
+}
+
+bool WcmeCostsPower(SpellInfo const* spell)
+{
+    return spell && (spell->ManaCost || spell->ManaCostPercentage || spell->ManaCostPerlevel);
+}
+
+// Like WcmeDealsDamage, but also counts weapon strikes (Kill Shot, Aimed Shot, Multi-Shot and the like).
+bool WcmeDealsAnyDamage(SpellInfo const* spell)
+{
+    if (WcmeDealsDamage(spell))
+        return true;
+    for (SpellEffectInfo const& effect : spell->GetEffects())
+        if (effect.Effect == SPELL_EFFECT_WEAPON_DAMAGE || effect.Effect == SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL ||
+            effect.Effect == SPELL_EFFECT_WEAPON_PERCENT_DAMAGE || effect.Effect == SPELL_EFFECT_NORMALIZED_WEAPON_DMG)
+            return true;
+    return false;
+}
+
+// The highest of these ranks the unit's level allows (the first rank below that).
+template <typename Ranks>
+uint32 WcmeRankFor(Unit const* unit, Ranks const& ranks)
+{
+    uint32 best = *std::begin(ranks);
+    for (uint32 rank : ranks)
+        if (SpellInfo const* info = sSpellMgr->GetSpellInfo(rank))
+            if (info->SpellLevel <= unit->GetLevel())
+                best = rank;
+    return best;
+}
+
+// Keeps exactly the level-appropriate rank of a spell an enchant teaches (learned for the session, like the core's
+// own enchant teaching), or none when keep is false.
+template <typename Ranks>
+void WcmeSyncTaughtRank(Unit* unit, Ranks const& ranks, bool keep)
+{
+    Player* player = unit->ToPlayer();
+    if (!player)
+        return;
+    uint32 const wanted = keep ? WcmeRankFor(player, ranks) : 0;
+    for (uint32 rank : ranks)
+        if (rank != wanted && player->HasSpell(rank))
+            player->removeSpell(rank, SPEC_MASK_ALL, true);
+    if (wanted && !player->HasSpell(wanted))
+        player->learnSpell(wanted, true);
+}
+
+// Shows an enchant's replacement ability in place of every known rank of the named ability while active (learned for
+// the session, like the core's own enchant replacements), and takes it away again. The core only does this itself when
+// the replacement's name contains the original's, or the enchant's description says "transform". When the replacement
+// has later ranks in the core's rank chain, the highest one the unit's level allows is shown, and every rank is taken
+// away on removal.
+void WcmeSyncSwap(Unit* unit, char const* originalName, uint32 family, uint32 replacement, bool active)
+{
+    Player* player = unit->ToPlayer();
+    SpellInfo const* info = sSpellMgr->GetSpellInfo(replacement);
+    if (!player || !info)
+        return;
+    std::vector<uint32> chain;
+    for (SpellInfo const* rank = info; rank; rank = rank->GetNextRankSpell())
+        chain.push_back(rank->Id);
+    uint32 wanted = replacement;
+    for (uint32 rank : chain)
+        if (sSpellMgr->GetSpellInfo(rank)->SpellLevel <= player->GetLevel())
+            wanted = rank;
+    auto inChain = [&chain](uint32 id) { return std::find(chain.begin(), chain.end(), id) != chain.end(); };
+    std::vector<uint32> originals;
+    for (auto const& [spellId, known] : player->GetSpellMap())
+        if (known->State != PLAYERSPELL_REMOVED && known->Active && !inChain(spellId))
+            if (SpellInfo const* spell = sSpellMgr->GetSpellInfo(spellId))
+                if (spell->SpellFamilyName == family && !spell->IsPassive() && WcmeNamed(spell, originalName))
+                    originals.push_back(spellId);
+    for (uint32 original : originals)
+        if (inChain(player->GetTemporarySpellReplacement(original)) &&
+            (!active || player->GetTemporarySpellReplacement(original) != wanted))
+            player->SetTemporarySpellReplacement(original, 0);
+    for (uint32 rank : chain)
+        if ((!active || rank != wanted || originals.empty()) && player->HasSpell(rank))
+            player->removeSpell(rank, SPEC_MASK_ALL, true);
+    if (!active || originals.empty())
+        return;
+    if (!player->HasSpell(wanted))
+        player->learnSpell(wanted, true);
+    for (uint32 original : originals)
+        player->SetTemporarySpellReplacement(original, wanted);
+}
+
+// WcmeSyncSwap with a ranked replacement: the level-appropriate rank is shown, and every other rank taken away.
+template <typename Ranks>
+void WcmeSyncSwapRanked(Unit* unit, char const* originalName, uint32 family, Ranks const& ranks, bool active)
+{
+    uint32 const wanted = active ? WcmeRankFor(unit, ranks) : 0;
+    for (uint32 rank : ranks)
+        if (rank != wanted)
+            WcmeSyncSwap(unit, originalName, family, rank, false);
+    if (wanted)
+        WcmeSyncSwap(unit, originalName, family, wanted, true);
+}
+
+float WcmeAttackPower(Unit* unit)
+{
+    return std::max(unit->GetTotalAttackPowerValue(BASE_ATTACK), unit->GetTotalAttackPowerValue(RANGED_ATTACK));
+}
+
+float WcmeSpellPower(Unit* unit)
+{
+    return float(unit->SpellBaseDamageBonusDone(SPELL_SCHOOL_MASK_MAGIC));
+}
