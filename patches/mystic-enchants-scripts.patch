+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_aegis_overdrive::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_aegis_overdrive::HandleProc);
