+// Verdant Convergence (902122): Starsurge shows as Sunburst (301097) and Insect Swarm can no longer be cast
+// (spell_wcme_no_insect_swarm). Earth Shock triggers Solar Eclipse (48517, once every 30 sec). Lightning Bolt and Chain
+// Lightning lengthen Solar Eclipse and shorten Lunar Eclipse by 0.75 sec (902123, its data). Wrath while in Solar
+// Eclipse with Lightning Mastery known applies Earthpulse Agony (902129, up to 3 stacks). In Solar Eclipse Wrath has
+// +30% critical strike chance (902136). While Nature's Grace is up, Druidic Overload (902127) adds 30% Lightning Bolt and
+// Chain Lightning damage (5% against players) and Lightning Bolt / Chain Lightning hits have an extra 20% chance to
+// overload (repeat at half damage) if you know Lightning Overload. While in Lunar Eclipse you gain a Dawn charge every 4
+// sec (902132, up to 3): your next Sunburst is instant and has no cooldown. A Sunburst hit on a player removes Dawn and
+// stops it until the next Lunar Eclipse.
+class spell_wcme_verdant_convergence : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_verdant_convergence);
+
+    static constexpr uint32 SOLAR = 48517;
+    static constexpr uint32 LUNAR = 48518;
+    static constexpr uint32 SUNBURST = 301097;
+    static constexpr uint32 EARTHPULSE = 902129;
+    static constexpr uint32 DAWN = 902132;
+    static constexpr uint32 OVERLOAD = 902127;
+    static constexpr uint32 SOLAR_CRIT = 902136;
+    static constexpr uint32 DURATIONS = 902123;
+    TimePoint _nextSolar{};
+    bool _dawnBlocked = false;
+    uint8 _dawnTimer = 0;
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        if (SpellInfo const* overload = sSpellMgr->GetSpellInfo(OVERLOAD))
+            for (uint8 i : { 1, 2 })
+                const_cast<SpellInfo*>(overload)->Effects[i].SpellClassMask = flag96(0x3, 0, 0);
+        if (SpellInfo const* crit = sSpellMgr->GetSpellInfo(SOLAR_CRIT))
+            const_cast<SpellInfo*>(crit)->Effects[EFFECT_0].SpellClassMask = flag96(0x1, 0, 0);
+        return true;
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Starsurge", SPELLFAMILY_DRUID, SUNBURST, active);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(DAWN);
+            owner->RemoveAurasDueToSpell(OVERLOAD);
+            owner->RemoveAurasDueToSpell(SOLAR_CRIT);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        bool const solar = owner->HasAura(SOLAR);
+        if (solar && !owner->HasAura(SOLAR_CRIT))
+            owner->AddAura(SOLAR_CRIT, owner);
+        else if (!solar)
+            owner->RemoveAurasDueToSpell(SOLAR_CRIT);
+        bool const grace = owner->HasAura(16886);
+        if (grace && !owner->HasAura(OVERLOAD))
+            owner->AddAura(OVERLOAD, owner);
+        else if (!grace)
+            owner->RemoveAurasDueToSpell(OVERLOAD);
+        if (!owner->HasAura(LUNAR))
+        {
+            _dawnBlocked = false;
+            _dawnTimer = 0;
+            return;
+        }
+        if (_dawnBlocked || ++_dawnTimer < 4)
+            return;
+        _dawnTimer = 0;
+        if (Aura* dawn = owner->GetAura(DAWN))
+        {
+            dawn->SetCharges(std::min<uint8>(3, dawn->GetCharges() + 1));
+            dawn->RefreshDuration();
+        }
+        else if (Aura* added = owner->AddAura(DAWN, owner))
+            added->SetCharges(1);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return (spell->SpellFamilyName == SPELLFAMILY_SHAMAN && WcmeNamedAny(spell, { "Earth Shock", "Lightning Bolt", "Chain Lightning" })) ||
+                (spell->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(spell, "Wrath"));
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (spell->Id == SUNBURST)
+            return target->IsControlledByPlayer();
+        return spell->SpellFamilyName == SPELLFAMILY_SHAMAN && WcmeNamedAny(spell, { "Lightning Bolt", "Chain Lightning" }) &&
+            GetTarget()->HasAura(16886) && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamed(spell, "Earth Shock"))
+            {
+                if (GameTime::Now() >= _nextSolar)
+                {
+                    _nextSolar = GameTime::Now() + 30s;
+                    owner->RemoveAurasDueToSpell(LUNAR);
+                    owner->CastSpell(owner, SOLAR, true);
+                }
+                return;
+            }
+            if (WcmeNamed(spell, "Wrath"))
+            {
+                if (owner->HasAura(SOLAR) && WcmeKnowsPassive(owner, "Lightning Mastery", SPELLFAMILY_SHAMAN))
+                    if (Unit* target = owner->GetVictim() ? owner->GetVictim() : ObjectAccessor::GetUnit(*owner, owner->GetTarget()))
+                        if (target->IsAlive() && owner->IsValidAttackTarget(target))
+                            owner->CastSpell(target, EARTHPULSE, true);
+                return;
+            }
+            owner->CastSpell(owner, DURATIONS, true);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (spell->Id == SUNBURST)
+        {
+            owner->RemoveAurasDueToSpell(DAWN);
+            _dawnBlocked = true;
+            return;
+        }
+        if (!WcmeKnowsPassive(owner, "Lightning Overload", SPELLFAMILY_SHAMAN) || !roll_chance_i(20))
+            return;
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        WcmeExtraDamage(owner, target, spell, (damage->GetDamage() + damage->GetAbsorb()) / 2);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_verdant_convergence::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_verdant_convergence::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_verdant_convergence::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_verdant_convergence::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_verdant_convergence::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_verdant_convergence::HandleProc);
+    }
+};
