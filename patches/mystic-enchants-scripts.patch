+// Zandalari Windreaver (902137): Slam shows as Loa's Assault (902138) and Glaive Toss as Zandalari Glaive (902151).
+// Each Loa's Assault drops a Shard of Gonk 4-7 yards from you for 15 sec (shown with its "gonk visual", 902156);
+// walking over it (within 2 yards, checked every quarter second) gives 10 rage, Embrace of Gonk (902159: faster for 3
+// sec) and a stack of Embrace of Bwonsamdi (902154). At 3 stacks they are spent for Embrace of Kimbul (902146: Zandalari
+// Glaive's cooldown resets, the next Loa's Assault costs no rage). Loa's Assault's off-hand throw deals 20% weapon
+// damage, 130% if you know Single-Minded Fury (spell_wcme_loas_assault_offhand). Zandalari Glaive hits get Strength of
+// Arms' bonus if you know it (902143, its data).
+class spell_wcme_zandalari_windreaver : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_zandalari_windreaver);
+
+    static constexpr uint32 LOAS_ASSAULT = 902138;
+    static constexpr uint32 GLAIVE = 902151;
+    static constexpr uint32 BWONSAMDI = 902154;
+    static constexpr uint32 KIMBUL = 902146;
+    static constexpr uint32 GONK_SPEED = 902159;
+    static constexpr uint32 GONK_VISUAL = 902156;
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 250;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Slam", SPELLFAMILY_WARRIOR, LOAS_ASSAULT, active);
+        WcmeSyncSwap(owner, "Glaive Toss", SPELLFAMILY_HUNTER, GLAIVE, active);
+        if (!active)
+        {
+            WcmeGonkShards.erase(owner->GetGUID());
+            owner->RemoveAurasDueToSpell(BWONSAMDI);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        auto shards = WcmeGonkShards.find(owner->GetGUID());
+        if (shards == WcmeGonkShards.end())
+            return;
+        TimePoint const now = GameTime::Now();
+        auto& list = shards->second;
+        for (auto shard = list.begin(); shard != list.end();)
+        {
+            if (now >= shard->until || shard->map != owner->GetMapId())
+            {
+                shard = list.erase(shard);
+                continue;
+            }
+            if (!owner->IsAlive() || owner->GetExactDist2d(&shard->spot) > 2.0f)
+            {
+                ++shard;
+                continue;
+            }
+            shard = list.erase(shard);
+            owner->EnergizeBySpell(owner, GONK_SPEED, 100, POWER_RAGE);
+            owner->CastSpell(owner, GONK_SPEED, true);
+            WcmeAddStackOn(owner, owner, BWONSAMDI);
+            if (owner->GetAuraCount(BWONSAMDI) >= 3)
+            {
+                owner->RemoveAurasDueToSpell(BWONSAMDI);
+                owner->CastSpell(owner, KIMBUL, true);
+            }
+        }
+        if (list.empty())
+            WcmeGonkShards.erase(shards);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->Id == LOAS_ASSAULT;
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        float const angle = frand(0.0f, 2.0f * float(M_PI));
+        float const distance = frand(4.0f, 7.0f);
+        Position spot = owner->GetPosition();
+        owner->MovePositionToFirstCollision(spot, distance, angle);
+        WcmeGonkShards[owner->GetGUID()].push_back({ owner->GetMapId(), spot, GameTime::Now() + 15s });
+        if (SpellInfo const* visual = sSpellMgr->GetSpellInfo(GONK_VISUAL))
+        {
+            SpellCastTargets targets;
+            targets.SetDst(spot);
+            owner->CastSpell(targets, visual, nullptr, TRIGGERED_FULL_MASK);
+        }
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_zandalari_windreaver::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_zandalari_windreaver::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_zandalari_windreaver::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_zandalari_windreaver::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_zandalari_windreaver::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_zandalari_windreaver::HandleProc);
+    }
+};
