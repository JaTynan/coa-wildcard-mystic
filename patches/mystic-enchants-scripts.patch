+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        bool const slice = owner->HasAura(SLICE_AND_ICE);
+        if (slice && !owner->HasAura(CRIT_HELPER))
+            owner->AddAura(CRIT_HELPER, owner);
+        else if (!slice && owner->HasAura(CRIT_HELPER))
+            owner->RemoveAurasDueToSpell(CRIT_HELPER);
+    }
+
+    static bool FrozenBlade(Unit const* owner)
+    {
+        Player const* player = owner->ToPlayer();
+        return player && (player->HasSpell(44545) || player->HasSpell(1144545));
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || spell->Id == ICE_LANCE)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return true;
+        return eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const slice = owner->HasAura(SLICE_AND_ICE);
