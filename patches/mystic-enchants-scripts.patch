+// Energy Surge (1180750): every second, while a creature (not a player) has your Gouge, you get 10 more energy, doubling
+// the normal regeneration. Its Gouge cost cut is its data; the damage bonus is in wcme_epic_batch67_hooks.
+class spell_wcme_energy_surge : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_energy_surge);
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Tick(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        for (Unit* enemy : WcmeEnemiesNear(owner, owner, 40.0f, 20))
+            if (!enemy->IsControlledByPlayer() && WcmeAuraFromNamed(enemy, owner, "Gouge"))
+            {
+                owner->EnergizeBySpell(owner, GetId(), 10, POWER_ENERGY);
+                return;
+            }
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_energy_surge::CalcPeriod, EFFECT_0, SPELL_AURA_ANY);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_energy_surge::Tick, EFFECT_0, SPELL_AURA_ANY);
+    }
+};
