+// Assuaging Shadows (965334): Shadow Dance casts Shadow Nova (832712: enemies within 8 yards slowed by 80% for 3 sec)
+// and puts Shadow Mark (832713, 8 sec) with 5 charges (3 on players) on every enemy within 8 yards. Ambush or Ravage on
+// your marked target spends a charge to finish Shadowstep's cooldown, give a stack of Shadow's Embrace (832717, up to 5)
+// and trigger Shadow of Death (986229): 30% of the strike's damage as Shadow to every monster within 8 yards of the
+// target, less when more than 3 are hit. Shadowstep's speed and threat buffs last 2 sec longer. While Shadow's Embrace
+// is up, damaging Rogue and Feral finishing moves take 2 sec off Shadow Dance and restore 10 energy (832718) and deal
+// Last Gasp (832719: 2 + 10% SP + 10% AP Shadow damage per combo point), at most once every 5 sec.
+class spell_wcme_assuaging_shadows : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_assuaging_shadows);
+
+    static constexpr uint32 NOVA = 832712;
+    static constexpr uint32 MARK = 832713;
+    static constexpr uint32 EMBRACE = 832717;
+    static constexpr uint32 DANCE_CDR = 832718;
+    static constexpr uint32 LAST_GASP = 832719;
+    static constexpr uint32 SHADOW_OF_DEATH = 986229;
+    static constexpr uint32 SHADOWSTEP_SPEED = 36554;
+    static constexpr uint32 SHADOWSTEP_THREAT = 44373;
+    static constexpr Seconds GASP_RATE{5};
+    TimePoint _gaspReady{};
+
+    static bool IsFinisher(SpellInfo const* spell)
+    {
+        return (spell->SpellFamilyName == SPELLFAMILY_ROGUE || spell->SpellFamilyName == SPELLFAMILY_DRUID) &&
+            spell->NeedsComboPoints() && WcmeDealsAnyDamage(spell);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        uint32 const phase = eventInfo.GetSpellPhaseMask();
+        if (phase & PROC_SPELL_PHASE_CAST)
+            return WcmeNamed(spell, "Shadow Dance") || (IsFinisher(spell) && GetTarget()->HasAura(EMBRACE));
+        if (phase & PROC_SPELL_PHASE_FINISH)
+            return WcmeNamed(spell, "Shadowstep");
+        Unit* target = eventInfo.GetActionTarget();
+        return WcmeNamedAny(spell, { "Ambush", "Ravage" }) && target && WcmeDealtDamage(eventInfo) &&
+            target->HasAura(MARK, GetTarget()->GetGUID());
+    }
+
+    void ShadowOfDeath(Unit* owner, Unit* target, int64 damage)
+    {
+        SpellInfo const* shadow = sSpellMgr->GetSpellInfo(SHADOW_OF_DEATH);
+        if (!shadow)
+            return;
+        std::list<Unit*> monsters = WcmeEnemiesNear(owner, target, 8.0f, 50);
+        monsters.remove_if([](Unit* enemy) { return enemy->IsPlayer() || enemy->IsCharmedOwnedByPlayerOrPlayer(); });
+        if (monsters.empty())
+            return;
+        int64 share = damage * 30 / 100;
+        if (monsters.size() > 3)
+            share = share * 3 / int64(monsters.size());
+        for (Unit* monster : monsters)
+            WcmeExtraDamage(owner, monster, shadow, share);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        uint32 const phase = eventInfo.GetSpellPhaseMask();
+        if (phase & PROC_SPELL_PHASE_FINISH)
+        {
+            WcmeExtendAura(owner, SHADOWSTEP_SPEED, 2000);
+            WcmeExtendAura(owner, SHADOWSTEP_THREAT, 2000);
+            return;
+        }
+        if (phase & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamed(spell, "Shadow Dance"))
+            {
+                owner->CastSpell(owner, NOVA, true);
+                for (Unit* enemy : WcmeEnemiesNear(owner, owner, 8.0f, 50))
+                    if (Aura* mark = owner->AddAura(MARK, enemy))
+                        mark->SetCharges(enemy->IsPlayer() ? 3 : 5);
+                return;
+            }
+            // combo points are still on the caster during the cast phase
+            uint8 const points = owner->GetComboPoints();
+            Unit* target = eventInfo.GetProcTarget();
+            if (!points || GameTime::Now() < _gaspReady)
+                return;
+            _gaspReady = GameTime::Now() + GASP_RATE;
+            owner->CastSpell(owner, DANCE_CDR, true);
+            SpellInfo const* gasp = sSpellMgr->GetSpellInfo(LAST_GASP);
+            if (gasp && target && owner->IsValidAttackTarget(target))
+                WcmeExtraDamage(owner, target, gasp,
+                    int64((2 + 0.1f * WcmeSpellPower(owner) + 0.1f * WcmeAttackPower(owner)) * points));
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (Aura* mark = target->GetAura(MARK, owner->GetGUID()))
+            mark->DropCharge();
+        WcmeCutCooldownByName(owner, "Shadowstep", 3600000);
+        if (Aura* embrace = owner->GetAura(EMBRACE))
+        {
+            if (embrace->GetStackAmount() < embrace->GetSpellInfo()->StackAmount)
+                embrace->SetStackAmount(embrace->GetStackAmount() + 1);
+            embrace->RefreshDuration();
+        }
+        else
+            owner->AddAura(EMBRACE, owner);
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        ShadowOfDeath(owner, target, int64(damage->GetDamage() + damage->GetAbsorb()));
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_assuaging_shadows::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_assuaging_shadows::HandleProc);
+    }
+};
+
+// Corrupted Bear Form (99634): in Bear or Dire Bear Form you carry Corrupted Bear (954340: Physical damage done -30%;
+// spell_wcme_corrupted_bear_shape keeps it in step with the form). Melee auto attacks then deal Corrupted Paw (99638):
+// Shadow damage equal to 40% of the hit, with double threat. Maul and Mangle (Bear) have a 30% chance to apply your
+// highest Corruption, if you know it; Swipe (Bear) drains 30% of its damage from each target with your Corruption as
+// Corrupted Hunger (99636), healing you for it. A Shadow Bolt made instant (Nightfall, Backlash) keeps you in the form
+// and hits up to 2 more enemies within 8 yards of the target for half its damage; any other Shadow Bolt cast in the
+// form takes you out of it.
+class spell_wcme_corrupted_bear_form : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_corrupted_bear_form);
+
+    static constexpr uint32 CORRUPTED = 954340;
+    static constexpr uint32 PAW = 99638;
+    static constexpr uint32 HUNGER = 99636;
+
+    static bool InBearForm(Unit const* unit)
+    {
+        return unit->GetShapeshiftForm() == FORM_BEAR || unit->GetShapeshiftForm() == FORM_DIREBEAR;
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (InBearForm(GetTarget()) && !GetTarget()->HasAura(CORRUPTED))
+            GetTarget()->AddAura(CORRUPTED, GetTarget());
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        GetTarget()->RemoveAurasDueToSpell(CORRUPTED);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        if (!InBearForm(GetTarget()) || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetTypeMask() & PROC_FLAG_DONE_MELEE_AUTO_ATTACK)
+            return eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+        if (!spell)
+            return false;
+        if (WcmeNamed(spell, "Shadow Bolt"))
+            return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) ||
+                (eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) && eventInfo.GetProcSpell() &&
+                 eventInfo.GetProcSpell()->GetCastTime() == 0 &&
+                 eventInfo.GetActionTarget() == eventInfo.GetProcSpell()->m_targets.GetUnitTarget());
+        return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_HIT) && eventInfo.GetActionTarget() &&
+            WcmeDealtDamage(eventInfo) && WcmeNamedAny(spell, { "Maul", "Mangle (Bear)", "Swipe (Bear)" });
+    }
+
+    static uint32 HighestCorruption(Player* player)
+    {
+        uint32 best = 0;
+        uint32 bestLevel = 0;
+        for (auto const& [spellId, known] : player->GetSpellMap())
+        {
+            SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId);
+            if (known->State == PLAYERSPELL_REMOVED || !known->Active || !WcmeNamed(info, "Corruption") ||
+                info->SpellFamilyName != SPELLFAMILY_WARLOCK || !info->HasAura(SPELL_AURA_PERIODIC_DAMAGE))
+                continue;
+            if (!best || info->SpellLevel > bestLevel)
+            {
+                best = spellId;
+                bestLevel = info->SpellLevel;
+            }
+        }
+        return best;
+    }
+
+    static bool HasMyCorruption(Unit* target, Unit* owner)
+    {
+        for (AuraEffect const* dot : target->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+            if (dot->GetCasterGUID() == owner->GetGUID() && WcmeNamed(dot->GetSpellInfo(), "Corruption"))
+                return true;
+        return false;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        int64 const dealt = damage ? int64(damage->GetDamage() + damage->GetAbsorb()) : 0;
+        if (eventInfo.GetTypeMask() & PROC_FLAG_DONE_MELEE_AUTO_ATTACK)
+        {
+            if (SpellInfo const* paw = sSpellMgr->GetSpellInfo(PAW))
+            {
+                int64 const shadow = dealt * 40 / 100;
+                WcmeExtraDamage(owner, target, paw, shadow);
+                if (target->IsAlive() && target->CanHaveThreatList())
+                    target->AddThreat(owner, float(shadow), SPELL_SCHOOL_MASK_SHADOW, paw);
+            }
+            return;
+        }
+        if (WcmeNamed(spell, "Shadow Bolt"))
+        {
+            if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            {
+                if (eventInfo.GetProcSpell() && eventInfo.GetProcSpell()->GetCastTime() > 0)
+                    owner->RemoveAurasByType(SPELL_AURA_MOD_SHAPESHIFT);
+                return;
+            }
+            uint8 hits = 0;
+            for (Unit* enemy : WcmeEnemiesNear(owner, target, 8.0f, 3))
+                if (enemy != target && hits < 2)
+                {
+                    ++hits;
+                    WcmeExtraDamage(owner, enemy, spell, dealt / 2);
+                }
+            return;
+        }
+        if (WcmeNamed(spell, "Swipe (Bear)"))
+        {
+            SpellInfo const* hunger = sSpellMgr->GetSpellInfo(HUNGER);
+            if (!hunger || !HasMyCorruption(target, owner))
+                return;
+            SpellNonMeleeDamage log(owner, target, hunger, hunger->GetSchoolMask());
+            owner->CalculateSpellDamageTaken(&log, int32(std::min<int64>(dealt * 30 / 100, INT32_MAX)), hunger);
+            uint32 const drained = log.damage;
+            owner->SendSpellNonMeleeDamageLog(&log);
+            owner->DealSpellDamage(&log, false);
+            if (drained)
+            {
+                HealInfo heal(owner, owner, drained, hunger, hunger->GetSchoolMask());
+                owner->HealBySpell(heal);
+            }
+            return;
+        }
+        Player* player = owner->ToPlayer();
+        if (!player || !roll_chance_i(30))
+            return;
+        if (uint32 const corruption = HighestCorruption(player))
+            owner->CastSpell(target, corruption, true);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_corrupted_bear_form::HandleApply, EFFECT_0, SPELL_AURA_PROC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_corrupted_bear_form::HandleRemove, EFFECT_0, SPELL_AURA_PROC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_corrupted_bear_form::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_corrupted_bear_form::HandleProc);
+    }
+};
