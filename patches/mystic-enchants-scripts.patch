+// Spell Shredder (978233): Frostbolt, Fireball and Lightning Bolt each grant their own Elemental Shredder (978800 Frost,
+// 978801 Fire, 978802 Nature); all three can be up at once. Mortal Strike also strikes once more as each active
+// element (978827/978828/978829). Rend applies Elemental Rend for each active element (978693 Frost, 978694 Fire,
+// 978695 Nature: a bleed of that school, +12% damage of that school taken from you); all three can be on one target.
+class spell_wcme_spell_shredder : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_spell_shredder);
+
+    struct Shredder
+    {
+        uint32 buff;
+        uint32 strike;
+        uint32 rend;
+    };
+    static constexpr std::array<Shredder, 3> SHREDDERS = { { { 978800, 978827, 978693 }, { 978801, 978828, 978694 },
+        { 978802, 978829, 978695 } } };
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeNamedAny(spell, { "Frostbolt", "Fireball", "Lightning Bolt", "Rend" });
+        return WcmeNamed(spell, "Mortal Strike") && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamed(spell, "Frostbolt"))
+                owner->CastSpell(owner, 978800, true);
+            else if (WcmeNamed(spell, "Fireball"))
+                owner->CastSpell(owner, 978801, true);
+            else if (WcmeNamed(spell, "Lightning Bolt"))
+                owner->CastSpell(owner, 978802, true);
+            else if (Spell const* cast = eventInfo.GetProcSpell())
+                if (Unit* rendTarget = cast->m_targets.GetUnitTarget())
+                    for (Shredder const& shredder : SHREDDERS)
+                        if (owner->HasAura(shredder.buff))
+                            owner->CastSpell(rendTarget, shredder.rend, true);
+            return;
+        }
+        if (!target)
+            return;
+        for (Shredder const& shredder : SHREDDERS)
+            if (owner->HasAura(shredder.buff))
+                owner->CastSpell(target, shredder.strike, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_spell_shredder::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_spell_shredder::HandleProc);
+    }
+};
