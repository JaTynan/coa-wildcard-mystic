+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncSwap(GetTarget(), "Fireball", SPELLFAMILY_MAGE, CAUTERIZING_FIRE, false);
+        for (uint32 spellId : { APOSTATE, APOSTATE_COH, APOSTATE_FLAMESTRIKE, HOLY_FIRE_HIT })
+            GetTarget()->RemoveAurasDueToSpell(spellId);
+    }
+
+    static void AddStack(Unit* caster, Unit* target, uint32 spellId)
+    {
+        Aura* aura = target->GetAura(spellId, caster->GetGUID());
+        if (!aura)
+        {
+            caster->AddAura(spellId, target);
+            return;
+        }
+        if (aura->GetStackAmount() < aura->GetSpellInfo()->StackAmount)
+            aura->SetStackAmount(aura->GetStackAmount() + 1);
+        aura->RefreshDuration();
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!spell || !target || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || spell->Id == CIRCLE_OF_FIRE)
+            return false;
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        if (spell->Id == FIRE_HEAL)
+            return heal && heal->GetEffectiveHeal();
+        if (WcmeNamed(spell, "Circle of Healing"))
+            return heal && heal->GetHeal() && GetTarget()->HasAura(APOSTATE);
+        return WcmeDealtDamage(eventInfo) && (spell->Id == FIRE_DAMAGE || WcmeNamedAny(spell, { "Holy Fire", "Flamestrike" }));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (spell->Id == FIRE_DAMAGE || spell->Id == FIRE_HEAL)
+        {
+            for (uint32 spellId : { APOSTATE, APOSTATE_COH, APOSTATE_FLAMESTRIKE })
+                AddStack(owner, owner, spellId);
+            if (Aura* apostate = owner->GetAura(APOSTATE))
+                if (Aura* hit = owner->GetAura(HOLY_FIRE_HIT) ? owner->GetAura(HOLY_FIRE_HIT) : owner->AddAura(HOLY_FIRE_HIT, owner))
+                {
+                    hit->SetMaxDuration(apostate->GetMaxDuration());
+                    hit->SetDuration(apostate->GetDuration());
+                }
+            return;
+        }
+        if (WcmeNamed(spell, "Circle of Healing"))
+        {
+            for (Unit* enemy : WcmeEnemiesNear(owner, target, 10.0f, 3))
+            {
+                owner->CastSpell(enemy, CIRCLE_OF_FIRE, true);
+                enemy->RemoveAura(KINDLING, owner->GetGUID());
+            }
+            return;
+        }
+        AddStack(owner, target, KINDLING);
+        if (WcmeNamed(spell, "Holy Fire") && owner->HasAura(APOSTATE))
+            for (Unit* ally : WcmeAlliesNear(owner, owner, 10.0f, 5))
+                owner->AddAura(RADIANT_FLAMES, ally);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_cauterizing_flames::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_cauterizing_flames::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_cauterizing_flames::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_cauterizing_flames::HandleProc);
+    }
+};
