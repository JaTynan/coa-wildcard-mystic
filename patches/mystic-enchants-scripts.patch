+// ===== Epic batch 1: low-effort epics =====
+
+static bool WcmeHasBleedFrom(Unit* target, Unit* caster)
+{
+    for (auto const& [id, app] : target->GetAppliedAuras())
+    {
+        Aura const* aura = app->GetBase();
+        if (caster && aura->GetCasterGUID() != caster->GetGUID())
+            continue;
+        SpellInfo const* info = aura->GetSpellInfo();
+        if (info->Mechanic == MECHANIC_BLEED || (info->GetAllEffectsMechanicMask() & (1ULL << MECHANIC_BLEED)))
+            return true;
+    }
+    return false;
+}
+
+static bool WcmeHasPoison(Unit* target)
+{
+    for (auto const& [id, app] : target->GetAppliedAuras())
+        if (app->GetBase()->GetSpellInfo()->Dispel == DISPEL_POISON)
+            return true;
+    return false;
+}
+
+static bool WcmeHasCrowdControl(Unit* unit)
+{
+    return unit->HasAuraType(SPELL_AURA_MOD_STUN) || unit->HasAuraType(SPELL_AURA_MOD_FEAR) ||
+        unit->HasAuraType(SPELL_AURA_MOD_CONFUSE) || unit->HasAuraType(SPELL_AURA_MOD_ROOT) ||
+        unit->HasAuraType(SPELL_AURA_MOD_SILENCE) || unit->HasAuraType(SPELL_AURA_MOD_PACIFY);
+}
