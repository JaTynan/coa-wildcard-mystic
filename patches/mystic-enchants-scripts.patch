+// Disciple of the Tides (978234): its own design instead of twin 274918 (004 no longer links it). Chain Heal shows as
+// Blessed Waves (847749, WcmeSyncSwap). Each Blessed Waves bolt (847750, counted on its first target) adds a charge
+// of Tidal Swell (978698, up to 5). Single-target Shaman critical heals take 1 sec off Blessed Waves.
+class spell_wcme_tidal_disciple : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_tidal_disciple);
+
+    static constexpr uint32 BLESSED_WAVES = 847749;
+    static constexpr uint32 BLESSED_BOLT = 847750;
+    static constexpr uint32 TIDAL_SWELL = 978698;
+
+    void Sync(bool active) { WcmeSyncSwap(GetTarget(), "Chain Heal", SPELLFAMILY_SHAMAN, BLESSED_WAVES, active); }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Sync(false);
+        GetTarget()->RemoveAurasDueToSpell(TIDAL_SWELL);
+    }
+
+    static bool SingleTarget(SpellInfo const* spell)
+    {
+        if (spell->IsAffectingArea())
+            return false;
+        for (SpellEffectInfo const& effect : spell->GetEffects())
+            if (effect.ChainTarget > 1)
+                return false;
+        return true;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!spell || !heal || !target)
+            return false;
+        if (spell->Id == BLESSED_BOLT)
+        {
+            Spell const* bolt = eventInfo.GetProcSpell();
+            return bolt && bolt->m_targets.GetUnitTargetGUID() == target->GetGUID();
+        }
+        return spell->SpellFamilyName == SPELLFAMILY_SHAMAN && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) &&
+            heal->GetHeal() > 0 && SingleTarget(spell);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetSpellInfo()->Id != BLESSED_BOLT)
+        {
+            WcmeCutCooldownByName(owner, "Blessed Waves", 1000);
+            return;
+        }
+        if (Aura* swell = owner->GetAura(TIDAL_SWELL))
+        {
+            swell->SetCharges(std::min<uint8>(5, swell->GetCharges() + 1));
+            swell->RefreshDuration();
+        }
+        else if (Aura* added = owner->AddAura(TIDAL_SWELL, owner))
+            added->SetCharges(1);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_tidal_disciple::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_tidal_disciple::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_tidal_disciple::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_tidal_disciple::HandleProc);
+    }
+};
