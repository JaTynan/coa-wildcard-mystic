+// Spells an enchant lets you cast only while it has granted the right buff, which the cast spends: Fel Meteor (all
+// ranks) needs Fel Meteor!, Fel Strike (all ranks) needs Fel Strike!, and Unrelenting Wrath (965289) needs a charge of
+// Unrelenting Wrath and Bestial Wrath known. Unrelenting Wrath also gives your pet's special attacks 100% more damage for
+// 12 sec, and with The Beast Within (834692) known your pet lashes out with Bloodshed.
+class spell_wcme_reactive_spell : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_reactive_spell);
+
+    bool FelMeteor() { return WcmeNamed(GetSpellInfo(), "Fel Meteor"); }
+    bool FelStrike() { return WcmeNamed(GetSpellInfo(), "Fel Strike"); }
+
+    Aura* Requirement()
+    {
+        Unit* caster = GetCaster();
+        if (FelMeteor())
+        {
+            Aura* aura = caster->GetAura(300231);
+            return aura ? aura : caster->GetAura(271452);
+        }
+        return caster->GetAura(FelStrike() ? 983899 : 983873);
+    }
+
+    SpellCastResult CheckCast()
+    {
+        if (!FelMeteor() && !FelStrike())
+            if (Player* player = GetCaster()->ToPlayer(); player && !player->HasSpell(19574))
+                return SPELL_FAILED_NOT_KNOWN;
+        return Requirement() ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void Spend()
+    {
+        Unit* caster = GetCaster();
+        if (Aura* aura = Requirement())
+            aura->Remove();
+        if (FelMeteor() || FelStrike())
+            return;
+        caster->CastSpell(caster, 983874, true);   // pet special attacks +100%
+        if (Player* player = caster->ToPlayer())
+            if (Pet* pet = player->GetPet(); pet && pet->IsAlive() && (player->HasSpell(834692) || player->HasAura(834692)))
+                pet->CastSpell(pet, 984818, true);   // Bloodshed
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_reactive_spell::CheckCast);
+        AfterCast += SpellCastFn(spell_wcme_reactive_spell::Spend);
+    }
+};
