+// Swashbuckler: Flurry of Blows (81221, +20% melee haste) and Swashbuckler: Matched Blows (81219, +5% parry) while
+// Swashbuckling (one one-handed weapon, empty off hand, not shapeshifted). The enchant's own effect becomes that bonus
+// in Validate and is switched on or off every second. Swashbuckler: Shocktrooper 281944 keeps 281945 (its own -2 sec
+// on Shaman Shocks) on you the same way.
+class spell_wcme_swashbuckling_bonus : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_swashbuckling_bonus);
+
+    bool Validate(SpellInfo const* spellInfo) override
+    {
+        SpellEffectInfo& effect = const_cast<SpellInfo*>(spellInfo)->Effects[EFFECT_0];
+        if (spellInfo->Id == 81221)
+            effect.ApplyAuraName = SPELL_AURA_MOD_MELEE_HASTE;
+        else if (spellInfo->Id == 81219)
+            effect.ApplyAuraName = SPELL_AURA_MOD_PARRY_PERCENT;
+        else
+            return true;
+        effect.BasePoints = -1;
+        effect.DieSides = 1;
+        return true;
+    }
+
+    int32 Wanted() const
+    {
+        return GetId() == 81221 ? 20 : 5;
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Tick(AuraEffect const* aurEff)
+    {
+        Unit* owner = GetTarget();
+        bool const on = WcmeSwashbuckling(owner);
+        if (GetId() == 281944)
+        {
+            if (on && !owner->HasAura(281945))
+                owner->AddAura(281945, owner);
+            else if (!on)
+                owner->RemoveAurasDueToSpell(281945);
+            return;
+        }
+        int32 const amount = on ? Wanted() : 0;
+        if (aurEff->GetAmount() != amount)
+            const_cast<AuraEffect*>(aurEff)->ChangeAmount(amount);
+    }
+
+    void Remove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (GetId() == 281944)
+            GetTarget()->RemoveAurasDueToSpell(281945);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_swashbuckling_bonus::CalcPeriod, EFFECT_0, SPELL_AURA_ANY);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_swashbuckling_bonus::Tick, EFFECT_0, SPELL_AURA_ANY);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_swashbuckling_bonus::Remove, EFFECT_0, SPELL_AURA_ANY,
+            AURA_EFFECT_HANDLE_REAL);
+    }
+};
