+// Blind Revenge (986240): with Edge of Fury, usable only after a Backstab (986237); casting it spends that, finishes
+// Spiteful Strike's cooldown and adds an Edge of Fury stack.
+class spell_wcme_blind_revenge : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_blind_revenge);
+
+    static constexpr uint32 ENCHANT = 986234;
+    static constexpr uint32 HUNGRY = 986237;
+    static constexpr uint32 EDGE = 986235;
+
+    SpellCastResult CheckCast()
+    {
+        Unit* caster = GetCaster();
+        return !caster->HasAura(ENCHANT) || caster->HasAura(HUNGRY) ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void HandleAfterCast()
+    {
+        Unit* caster = GetCaster();
+        if (!caster->HasAura(ENCHANT))
