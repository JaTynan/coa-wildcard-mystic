+// Tree of Wrath (86438), with the healing path or Spirit as primary stat: Tree of Life shows as Tree of Wrath (86435)
+// and Chain Heal as Living Lightning (86441) (006 no longer teaches twin spell 1568396). In the form (spell_wcme_tree_of_
+// wrath_form): Lightning Bolt and Chain Lightning cannot miss, Lightning Bolt is instant with a 6 sec cooldown (986438,
+// the kit's own modifier), Lightning Bolt hits put Lightning Rod (86439) on the target (one at a time), direct Nature
+// heal criticals strike that target with Lightning Bolt, Living Lightning's damage hits it a second time, and critical
+// Lesser Healing Wave, Healing Wave and Chain Heal / Living Lightning heals take 2 sec off Living Lightning.
+class spell_wcme_tree_of_wrath : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_tree_of_wrath);
+
+    static constexpr uint32 FORM = 86435;
+    static constexpr uint32 LIVING_LIGHTNING = 86441;
+    static constexpr uint32 LIVING_LIGHTNING_DAMAGE = 86449;
+    static constexpr uint32 ROD = 86439;
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        if (SpellInfo const* aim = sSpellMgr->GetSpellInfo(86436))
+            if (aim->Effects[EFFECT_0].ApplyAuraName == SPELL_AURA_DUMMY)
+            {
+                SpellEffectInfo& hit = const_cast<SpellInfo*>(aim)->Effects[EFFECT_0];
+                hit.ApplyAuraName = SPELL_AURA_MOD_INCREASES_SPELL_PCT_TO_HIT;
+                hit.MiscValue = SPELL_SCHOOL_MASK_NATURE;
+                hit.BasePoints = 99;
+                hit.DieSides = 1;
+            }
+        return true;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        active = active && WcmePrimaryStatMet(owner, 84867, STAT_SPIRIT);
+        WcmeSyncSwap(owner, "Tree of Life", SPELLFAMILY_DRUID, FORM, active);
+        WcmeSyncSwap(owner, "Chain Heal", SPELLFAMILY_SHAMAN, LIVING_LIGHTNING, active);
+        if (!active)
+            owner->RemoveAurasDueToSpell(FORM);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!spell || !target || !owner->HasAura(FORM))
+            return false;
+        if (spell->Id == LIVING_LIGHTNING_DAMAGE)
+            return WcmeDealtDamage(eventInfo) && target->HasAura(ROD, owner->GetGUID());
+        if (WcmeNamed(spell, "Lightning Bolt") && spell->SpellFamilyName == SPELLFAMILY_SHAMAN)
+            return WcmeDealtDamage(eventInfo);
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return heal && heal->GetHeal() && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) && WcmeIsShamanDirectNatureHeal(spell);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (spell->Id == LIVING_LIGHTNING_DAMAGE)
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            WcmeExtraDamage(owner, target, spell, damage->GetDamage() + damage->GetAbsorb());
+            return;
+        }
+        if (WcmeNamed(spell, "Lightning Bolt"))
+        {
+            auto previous = WcmeLightningRod.find(owner->GetGUID());
+            if (previous != WcmeLightningRod.end() && previous->second != target->GetGUID())
+                if (Unit* old = ObjectAccessor::GetUnit(*owner, previous->second))
+                    old->RemoveAurasDueToSpell(ROD, owner->GetGUID());
+            owner->CastSpell(target, ROD, true);
+            WcmeLightningRod[owner->GetGUID()] = target->GetGUID();
+            return;
+        }
+        if (WcmeNamedAny(spell, { "Lesser Healing Wave", "Healing Wave", "Chain Heal", "Living Lightning" }))
+            WcmeCutCooldownByName(owner, "Living Lightning", 2000);
+        auto rod = WcmeLightningRod.find(owner->GetGUID());
+        if (rod == WcmeLightningRod.end())
+            return;
+        Unit* struck = ObjectAccessor::GetUnit(*owner, rod->second);
+        uint32 const bolt = WcmeKnownByName(owner, "Lightning Bolt", SPELLFAMILY_SHAMAN);
+        if (struck && bolt && struck->IsAlive() && struck->HasAura(ROD, owner->GetGUID()))
+            owner->CastSpell(struck, bolt, TriggerCastFlags(TRIGGERED_FULL_MASK & ~TRIGGERED_DISALLOW_PROC_EVENTS));
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_tree_of_wrath::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_tree_of_wrath::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_tree_of_wrath::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_tree_of_wrath::HandleProc);
+    }
+};
