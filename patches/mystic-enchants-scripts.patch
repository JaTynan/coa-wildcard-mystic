+        if (Player* player = GetTarget()->ToPlayer())
+            if (Unit* pet = player->GetGuardianPet())
+                pet->RemoveAurasDueToSpell(Buff());
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_pet_mastery::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_pet_mastery::HandleProc);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_pet_mastery::HandleRemove, EFFECT_0, SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);
