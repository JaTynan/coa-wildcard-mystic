+// Gift of Light (1277670): Light's Grace is renewed every 15 sec with a stronger cast time cut (the data's own periodic
+// effect). Each renewal also gives a stack of Gift of Light (1277671, up to 3) and finishes Divine Favor's cooldown.
+// Divine Favor spends a stack and has no cooldown while stacks are left; spending the last stack leaves it on cooldown
+// until the next renewal. The data's own no-cooldown buff (1277674) is not used: it would ignore the stacks.
+class spell_wcme_gift_of_light : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_gift_of_light);
+
+    static constexpr uint32 GIFT = 1277671;
+    static constexpr uint8 MAX_GIFTS = 3;
+
+    void Renew(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Aura* gift = owner->GetAura(GIFT);
+        if (!gift)
+        {
+            owner->AddAura(GIFT, owner);
+            gift = owner->GetAura(GIFT);
+        }
+        else if (gift->GetStackAmount() < MAX_GIFTS)
+            gift->SetStackAmount(gift->GetStackAmount() + 1);
+        if (gift)
+            gift->RefreshDuration();
+        WcmeCutCooldownByName(owner, "Divine Favor", 3600000);
+    }
+
+    void Skip(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return WcmeNamed(eventInfo.GetSpellInfo(), "Divine Favor") && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        Unit* owner = GetTarget();
+        Aura* gift = owner->GetAura(GIFT);
+        if (!gift)
+            return;
+        if (gift->ModStackAmount(-1, AURA_REMOVE_BY_EXPIRE))
+            return;
+        if (owner->HasAura(GIFT))
+            WcmeCutCooldownByName(owner, "Divine Favor", 3600000);
+    }
+
+    void Register() override
+    {
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_gift_of_light::Renew, EFFECT_1, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_gift_of_light::Skip, EFFECT_2, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_gift_of_light::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_gift_of_light::HandleProc);
+    }
+};
