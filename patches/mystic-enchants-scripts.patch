+// Ice Lash (977764): Ice Lash grants Solid Ice when the off-hand weapon carries Frostbrand; consuming Fingers of
+// Frost has a 33% chance to trigger Ice Crash (Ice Lash's cooldown reset, more damage and targets).
+class spell_wcme_ice_lash : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_ice_lash);
+
+    static constexpr uint32 SOLID_ICE = 977765;
+    static constexpr uint32 ICE_CRASH = 860105;
+    static constexpr int32 ICE_CRASH_CHANCE = 33;
+
+    static bool OffhandFrostbrand(Player* player)
+    {
+        Item* offhand = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+        if (!offhand)
+            return false;
+        uint32 const enchant = offhand->GetEnchantmentId(TEMP_ENCHANTMENT_SLOT);
+        SpellItemEnchantmentEntry const* entry = enchant ? sSpellItemEnchantmentStore.LookupEntry(enchant) : nullptr;
+        return entry && entry->description[0] && std::strstr(entry->description[0], "Frostbrand");
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() != nullptr;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            // Fingers of Frost is spent by the spell being cast now
+            if (!WcmeNamed(spell, "Ice Lash") && WcmeHasAnyAura(owner, { 74396, 1174396, 271943, 997633 }) &&
+                roll_chance_i(ICE_CRASH_CHANCE))
+                owner->CastSpell(owner, ICE_CRASH, true);
+            return;
+        }
+        if (WcmeNamed(spell, "Ice Lash") && WcmeDealtDamage(eventInfo))
+            if (Player* player = owner->ToPlayer())
+                if (OffhandFrostbrand(player))
+                    owner->CastSpell(owner, SOLID_ICE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_ice_lash::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_ice_lash::HandleProc);
+    }
+};
