+// Felborne (101086): direct damage from an ability or spell adds a stack of Meteoric Impact, at most once a second, up to
+// 5. At 5 stacks you can cast Fel Meteor (taught while the enchant is active), which spends them.
+// Abiding Fel Energy (84805): direct damage or healing adds Fel Energy, at most once a second; 5 stacks become Abiding
+// Fel Energy, during which direct damage also deals Unleash Fel Energy to the target.
+// Fel Strike (84806): direct damage or healing adds Fel Energy, at most once a second; 4 stacks reset the cooldown of
+// Fel Strike (the version this enchant teaches says "Fel Energy resets this cooldown").
+class spell_wcme_fel_energy : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_fel_energy);
+
+    static constexpr Seconds RATE{1};
+    TimePoint _ready{};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        if (!eventInfo.GetSpellInfo() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return WcmeDealtDamage(eventInfo) || (GetId() != 101086 && heal && heal->GetHeal() > 0);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (GetId() == 84805 && owner->HasAura(84810) && WcmeDealtDamage(eventInfo) && target && target != owner)
+            owner->CastSpell(target, 84808, true);   // Unleash Fel Energy
+
+        TimePoint const now = GameTime::Now();
+        if (now < _ready)
+            return;
+        _ready = now + RATE;
+        switch (GetId())
+        {
+            case 101086:
+                WcmeAddStacks(owner, 300230, 1, 0);   // Meteoric Impact, capped at 5 by its own stack limit
+                if (Aura* impact = owner->GetAura(300230))
+                    if (impact->GetStackAmount() > 5)
+                        impact->SetStackAmount(5);
+                break;
+            case 84805:
+                if (WcmeAddStacks(owner, 983900, 1, 5))
+                    owner->CastSpell(owner, 84810, true);
+                break;
+            default:   // 84806
+                if (WcmeAddStacks(owner, 983897, 1, 4))
+                    if (Player* player = owner->ToPlayer())
+                        player->RemoveSpellCooldown(1568346, true);
+                break;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_fel_energy::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_fel_energy::HandleProc);
+    }
+};
+
+// Overloaded Froststorm (81122) and Astral Tempest (81479): direct Nature or Frost (Froststorm) / Nature or Arcane
+// (Tempest) damage adds a stack of Overloaded, once per cast however many targets it hits, 2 against players. At 10 the
+// stacks are spent on the storm at the target's location, which also grants Overloaded Mind / Astral Power. While
+// Overloaded Mind is up, Nature and Frost spells deal 20% of their damage again as Froststorm.
+class spell_wcme_overloaded : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_overloaded);
+
+    Spell const* _lastCast = nullptr;
+
+    bool Froststorm() const { return GetId() == 81122; }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        if (!eventInfo.GetSpellInfo() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || !target ||
+            target == GetTarget() || !WcmeDealtDamage(eventInfo))
+            return false;
+        uint32 const schools = SPELL_SCHOOL_MASK_NATURE | (Froststorm() ? SPELL_SCHOOL_MASK_FROST : SPELL_SCHOOL_MASK_ARCANE);
+        return (eventInfo.GetDamageInfo()->GetSchoolMask() & schools) != 0;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (Froststorm() && owner->HasAura(954046))
+            if (SpellInfo const* storm = sSpellMgr->GetSpellInfo(954048))
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, storm, int64(damage->GetDamage() + damage->GetAbsorb()) * 20 / 100);
+            }
+        if (eventInfo.GetProcSpell() && eventInfo.GetProcSpell() == _lastCast)
+            return;
+        _lastCast = eventInfo.GetProcSpell();
+        uint8 const add = target->GetTypeId() == TYPEID_PLAYER ? 2 : 1;
+        if (WcmeAddStacks(owner, Froststorm() ? 81123 : 982220, add, 10))
+            owner->CastSpell(target, Froststorm() ? 81124 : 81125, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_overloaded::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_overloaded::HandleProc);
+    }
+};
