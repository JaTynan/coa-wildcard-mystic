+// Controlled Burn (81407): Chaos Bolt refreshes Immolate; Chaos Bolt, Incinerate, Searing Pain and Scorch grant
+// Controlled Burn, which keeps Immolate on the target through the next Conflagrate; Conflagrate applies Heating Up!;
+// Scorch deals 20% more to targets with your Conflagrate on them.
+class spell_wcme_controlled_burn : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_controlled_burn);
+
+    static constexpr uint32 IMMOLATE_REFRESH = 981407;
+    static constexpr uint32 CONTROLLED_BURN = 954675;
+    static constexpr uint32 HEATING_UP = 954715;
+    static constexpr int32 SCORCH_BONUS_PCT = 20;   // no number survives; James chose 20%
+    ObjectGuid _keptOn;
+    uint32 _keptSpell = 0;
+    int32 _keptDuration = 0;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() != nullptr;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeNamedAny(spell, { "Chaos Bolt", "Incinerate", "Searing Pain", "Scorch" }))
+                owner->CastSpell(owner, CONTROLLED_BURN, true);
+            // remember the Immolate that Conflagrate is about to consume
+            _keptSpell = 0;
+            if (WcmeNamed(spell, "Conflagrate") && owner->HasAura(CONTROLLED_BURN))
+                if (Spell const* cast = eventInfo.GetProcSpell())
+                    if (Unit* target = cast->m_targets.GetUnitTarget())
+                        for (AuraEffect const* periodic : target->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+                            if (periodic->GetCasterGUID() == owner->GetGUID() &&
+                                periodic->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_WARLOCK &&
+                                (periodic->GetSpellInfo()->SpellFamilyFlags[0] & 0x4))
+                            {
+                                _keptOn = target->GetGUID();
+                                _keptSpell = periodic->GetId();
+                                _keptDuration = periodic->GetBase()->GetDuration();
+                                break;
+                            }
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || target == owner || !WcmeDealtDamage(eventInfo))
+            return;
+        if (WcmeNamed(spell, "Chaos Bolt"))
+            owner->CastSpell(target, IMMOLATE_REFRESH, true);
+        else if (WcmeNamed(spell, "Scorch") && WcmeHasAnyAuraFrom(target, owner, { 17962, 17964, 254085, 1117962, 1117964, 1217962 }))
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * SCORCH_BONUS_PCT / 100);
+        }
+        else if (WcmeNamed(spell, "Conflagrate"))
+        {
+            owner->CastSpell(target, HEATING_UP, true);
+            if (_keptSpell && target->GetGUID() == _keptOn)
+            {
+                if (!target->HasAura(_keptSpell, owner->GetGUID()))
+                    if (Aura* immolate = owner->AddAura(_keptSpell, target))
+                        immolate->SetDuration(_keptDuration);
+                owner->RemoveAurasDueToSpell(CONTROLLED_BURN);
+            }
+            _keptSpell = 0;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_controlled_burn::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_controlled_burn::HandleProc);
+    }
+};
