+// Benevolent Crusader (81251): direct heals grant a stack of Benevolent Crusader; Smite, Holy Fire, Penance or
+// Exorcism damage triggers a Holy Nova at the target, at most once every 3 sec.
+class spell_wcme_benevolent_crusader : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_benevolent_crusader);
+
+    static constexpr uint32 STACK = 81252;
+    static constexpr uint32 HOLY_NOVA = 944810;
+    static constexpr Seconds NOVA_COOLDOWN{3};
+    TimePoint _novaReady{};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (WcmeDealtDamage(eventInfo))
+        {
+            TimePoint const now = GameTime::Now();
+            if (target && target != owner && now >= _novaReady &&
+                WcmeNamedAny(eventInfo.GetSpellInfo(), { "Smite", "Holy Fire", "Penance", "Exorcism" }))
+            {
+                _novaReady = now + NOVA_COOLDOWN;
+                owner->CastSpell(target, HOLY_NOVA, true);
+            }
+            return;
+        }
+        if (HealInfo const* heal = eventInfo.GetHealInfo(); heal && heal->GetHeal() > 0 && target && target != owner)
+            owner->CastSpell(owner, STACK, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_benevolent_crusader::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_benevolent_crusader::HandleProc);
+    }
+};
