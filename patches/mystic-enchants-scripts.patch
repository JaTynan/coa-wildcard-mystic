+// Social Distancing (81102): 20% resistance to diseases (the chance a disease fails to land) while no other player is
+// within 6 yards. Its only effect (a proc with nothing to trigger) becomes that resistance in Validate; it is checked
+// every second.
+class spell_wcme_social_distancing : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_social_distancing);
+
+    static constexpr int32 RESIST = 20;
+    static constexpr float RANGE = 6.0f;
+
+    bool Validate(SpellInfo const* spellInfo) override
+    {
+        SpellEffectInfo& effect = const_cast<SpellInfo*>(spellInfo)->Effects[EFFECT_0];
+        effect.ApplyAuraName = SPELL_AURA_MOD_DEBUFF_RESISTANCE;
+        effect.MiscValue = DISPEL_DISEASE;
+        effect.BasePoints = -1;
+        effect.DieSides = 1;
+        effect.TriggerSpell = 0;
+        const_cast<SpellInfo*>(spellInfo)->ProcFlags = 0;
+        return true;
+    }
+
+    static bool Alone(Unit* owner)
+    {
+        std::list<Player*> players;
+        Acore::AnyPlayerInObjectRangeCheck check(owner, RANGE);
+        Acore::PlayerListSearcher<Acore::AnyPlayerInObjectRangeCheck> searcher(owner, players, check);
+        Cell::VisitObjects(owner, searcher, RANGE);
+        for (Player* player : players)
+            if (player != owner)
+                return false;
+        return true;
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Check(AuraEffect const* aurEff)
+    {
+        int32 const wanted = Alone(GetTarget()) ? RESIST : 0;
+        if (aurEff->GetAmount() != wanted)
+            const_cast<AuraEffect*>(aurEff)->ChangeAmount(wanted);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_social_distancing::CalcPeriod, EFFECT_0,
+            SPELL_AURA_MOD_DEBUFF_RESISTANCE);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_social_distancing::Check, EFFECT_0,
+            SPELL_AURA_MOD_DEBUFF_RESISTANCE);
+    }
+};
