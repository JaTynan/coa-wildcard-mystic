+// Prayer of Preservation (888571): notes whether it was cast with Divine Favor up (for Shield of Preservation), and
+// makes its last heal 70% stronger (888594 for that tick only; the cast is self-targeted, so the caster is the target).
+class spell_wcme_prayer_of_preservation_hot : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_prayer_of_preservation_hot);
+
+    static constexpr uint32 FINAL_TICK = 888594;
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* caster = GetCaster();
+        if (!caster)
+            return;
+        bool favored = false;
+        for (auto const& [id, application] : caster->GetAppliedAuras())
+            if (WcmeNamed(application->GetBase()->GetSpellInfo(), "Divine Favor"))
