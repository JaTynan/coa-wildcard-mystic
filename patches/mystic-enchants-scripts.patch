+// Batch 4 damage rules no aura script can reach:
+// - Ascension's "against monsters" (modifier type 38) and "against players" (36) bonuses, which our core does not
+//   know, for the kit buffs that use them: Phalanx Strike (978539 Thrust +20% / +7% vs players, 978537 Shield Strike
+//   +10%) and Locust Ranger's Wild Quiver Shot (-10% against players).
+// - Skewered (982252): Colossus Smash +5% per stack against players instead of the data's 20%.
+// - Spear Mastery (901203): Flurry of Spears +50% only against monsters.
+// - Thunder Hide (92815): its 5% damage reduction only against creatures.
+// - Hoplite's Phalanx Stance follows Battle Stance.
+class wcme_kit_target_mods : public UnitScript
+{
+public:
+    wcme_kit_target_mods() : UnitScript("wcme_kit_target_mods", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_MELEE_DAMAGE, UNITHOOK_ON_UNIT_SET_SHAPESHIFT_FORM }) { }
+
+    static int64 Scaled(int64 damage, Unit* target, Unit* attacker, SpellInfo const* spellInfo)
+    {
+        bool const versusPlayer = target->IsControlledByPlayer();
+        if (spellInfo)
+        {
+            for (AuraEffect const* effect : attacker->GetAuraEffectsByType(SPELL_AURA_ADD_PCT_MODIFIER))
+            {
+                uint32 const id = effect->GetId();
+                if ((id == 978539 || id == 978537 || id == 954044) &&
+                    effect->GetMiscValue() == (versusPlayer ? 36 : 38) && effect->IsAffectedOnSpell(spellInfo))
+                    damage = damage * (100 + effect->GetAmount()) / 100;
+            }
+            if (versusPlayer && WcmeNamed(spellInfo, "Colossus Smash"))
+                if (Aura const* skewered = target->GetAura(982252, attacker->GetGUID()))
+                    damage = damage * (100 + 5 * skewered->GetStackAmount()) / (100 + 20 * skewered->GetStackAmount());
+            if (versusPlayer && spellInfo->Id == 901201 && attacker->HasAura(901203))
+                damage = damage * 100 / 150;
+        }
+        if (attacker->IsControlledByPlayer() && target->HasAura(92815))
+            damage = damage * 100 / 95;
+        return damage;
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && damage > 0 && target != attacker)
+            damage = int32(std::min<int64>(INT32_MAX, Scaled(damage, target, attacker, spellInfo)));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, Scaled(damage, target, attacker, spellInfo)));
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        if (target && attacker && damage && attacker->IsControlledByPlayer() && target->HasAura(92815))
+            damage = damage * 100 / 95;
+    }
+
+    void OnUnitSetShapeshiftForm(Unit* unit, uint8 form) override
+    {
+        if (!unit || !unit->IsPlayer() || !unit->HasAura(978217))
+            return;
+        if (form == FORM_BATTLESTANCE && !unit->HasAura(997743))
+            unit->AddAura(997743, unit);
+        else if (form != FORM_BATTLESTANCE)
+            unit->RemoveAurasDueToSpell(997743);
+    }
+};
