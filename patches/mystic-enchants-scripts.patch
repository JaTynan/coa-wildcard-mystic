+//   on this server's "hero" class model the core has no other Living Bomb versions to match). Review 2026-11-18: ours
+//   added it again (+69%); now ours only covers the cases the core skips: another Living Bomb version, or an Explosive
+//   Shot from outside the Hunter family.
+// - Blood-Soaked Mutilation (1590974): (Mutilate +6% per bleed of yours is the core's bonus table; ours doubled it and
+//   was removed in review 2026-11-18.) The out-of-Stealth Garrote's
+//   silence is removed.
+// - Growing Light (270661) used to be here; review 2026-11-18 found the core already does it (wildcard_growing_light in
+//   AscensionWildcardReconstruction: 3 allies within 8 yards for 20% through 270665), so ours doubled the splash.
+//   wcme_growing_light_versions covers only the Beacon of Light versions the core can't see.
+// - Holy Ground (81315 / 281788): your direct heals on an ally inside your Consecration also heal 5 allies within 8
+//   yards for 5%.
+class wcme_epic_batch4_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch4_hooks() : UnitScript("wcme_epic_batch4_hooks", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_HEAL_RECEIVED, UNITHOOK_ON_AURA_APPLY }) { }
+
+    static int64 Damage(Unit* target, Unit* attacker, SpellInfo const* spell, int64 value)
+    {
+        if (attacker->HasAura(271125) && WcmeNamed(spell, "Explosive Shot") && WcmeAuraFromNamed(target, attacker, "Living Bomb") &&
+            !(spell->SpellFamilyName == SPELLFAMILY_HUNTER && target->GetAuraOfRankedSpellOrTwin(44457, attacker->GetGUID())))
+            value = value * (target->IsPlayer() ? 120 : 130) / 100;
+        return value;
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && spellInfo && damage > 0 && target != attacker)
+            damage = int32(std::min<int64>(INT32_MAX, Damage(target, attacker, spellInfo, damage)));
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (target && attacker && spellInfo && damage && target != attacker)
+            damage = uint32(std::min<int64>(UINT32_MAX, Damage(target, attacker, spellInfo, damage)));
+    }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (!unit || !aura || !WcmeNamed(aura->GetSpellInfo(), "Garrote - Silence"))
+            return;
+        Unit* caster = aura->GetCaster();
+        if (caster && caster->HasAura(1590974) && wcme_epic_batch4_spells::QuietGarrote(caster))
+        {
+            ObjectGuid const guid = unit->GetGUID();
+            uint32 const id = aura->GetId();
+            caster->m_Events.AddEventAtOffset([caster, guid, id]()
+            {
+                if (Unit* victim = ObjectAccessor::GetUnit(*caster, guid))
+                    victim->RemoveAurasDueToSpell(id, caster->GetGUID());
+            }, 1ms);
+        }
+    }
+
+    void ModifyHealReceived(Unit* target, Unit* healer, uint32& heal, SpellInfo const* spellInfo) override
+    {
+        if (!target || !healer || !spellInfo || !heal || _splashing || spellInfo->HasAura(SPELL_AURA_PERIODIC_HEAL))
+            return;
+        WcmeHealParties(target, healer, heal, spellInfo);
+        Player* player = healer->ToPlayer();
+        if (!player)
+            return;
+        std::vector<std::pair<Unit*, uint32>> splashes;
+        if (WcmeHasAnyAura(player, { 81315, 281788 }))
+            for (DynamicObject* consecration : WcmeDynObjectsNamed(player, "Consecration", SPELLFAMILY_PALADIN))
+                if (target->IsWithinDist(consecration, consecration->GetRadius()))
+                {
+                    for (Unit* ally : WcmeAlliesNear(player, target, 8.0f, 6))
+                        if (ally != target)
+                            splashes.emplace_back(ally, heal * 5 / 100);
+                    break;
+                }
+        if (splashes.empty())
+            return;
+        uint32 const id = spellInfo->Id;
+        player->m_Events.AddEventAtOffset([player, splashes, id]()
+        {
+            SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+            _splashing = true;
+            uint8 growing = 0;
+            for (auto const& [ally, amount] : splashes)
+                if (ally->IsInWorld() && ally->IsAlive() && amount && growing++ < 9)
+                {
+                    HealInfo healInfo(player, ally, amount, info, info ? info->GetSchoolMask() : SPELL_SCHOOL_MASK_HOLY);
+                    player->HealBySpell(healInfo);
+                }
+            _splashing = false;
+        }, 1ms);
+    }
+
+private:
+    static inline thread_local bool _splashing = false;
+};
