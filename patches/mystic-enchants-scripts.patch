+        Unit* target = eventInfo.GetActionTarget();
+        bool const crit = eventInfo.GetHitMask() & PROC_HIT_CRITICAL;
+        bool const strike = WcmeNamedAny(spell, { "Sinister Strike", "Eviscerate" }) && spell->SpellFamilyName == SPELLFAMILY_ROGUE;
+        if (strike)
