+namespace
+{
+// Adds one stack of an aura the caster keeps on a target (applied on the first one), refreshing it.
+void WcmeAddStackOn(Unit* caster, Unit* target, uint32 spellId)
+{
+    if (Aura* aura = target->GetAura(spellId, caster->GetGUID()))
+    {
+        aura->ModStackAmount(1);
+        aura->RefreshDuration();
+    }
+    else
+        caster->AddAura(spellId, target);
+}
+
+// The charmed demon or undead of a Darkmaster (Enslave Demon, Dominate Undead and the like).
+Unit* WcmeDarkmasterMinion(Unit* owner)
+{
+    Unit* charm = owner->GetCharm();
+    if (!charm || !charm->IsAlive() || !charm->IsCreature())
+        return nullptr;
+    uint32 const type = charm->GetCreatureType();
+    return (type == CREATURE_TYPE_DEMON || type == CREATURE_TYPE_UNDEAD) ? charm : nullptr;
+}
+
+bool WcmeIsDrainSoul(SpellInfo const* spell)
+{
+    return spell && spell->SpellFamilyName == SPELLFAMILY_WARLOCK && (spell->SpellFamilyFlags[0] & 0x00004000);
+}
+
+bool WcmeIsDrainLife(SpellInfo const* spell)
+{
+    return spell && spell->SpellFamilyName == SPELLFAMILY_WARLOCK && (spell->SpellFamilyFlags[0] & 0x00000008);
+}
+}
+
+// Darkmaster (983180). Shadow Bolt and Haunt hits give Harvested Essence (983186, 2 against players). A Drain Soul cast
+// at 5 Essence makes its ticks add Afflicted Soul (983192) to the target, and Ruptured Soul (983193) at 15 (none while
+// Ruptured Soul is on). Drain Life and Drain Soul casts spend the Essence once the channel has started. Drain Life ticks
+// heal your charmed demon or undead for the same 20% the enchant's own modifier leaves you, and a Drain Life channel
+// that runs to its last tick spends Necromancer's Touch. The rest is in wcme_kit_damage_hooks: Drain Life crits,
+// Drain Soul at 3 times instead of 4, and Necromancer's Touch from your minion's abilities.
+class spell_wcme_darkmaster : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_darkmaster);
+
+    static constexpr uint32 ESSENCE = 983186;
+    static constexpr uint32 AFFLICTED = 983192;
+    static constexpr uint32 RUPTURED = 983193;
+    static constexpr uint32 TOUCH = 983181;
+    static constexpr uint32 TOUCH_SHOWN = 983190;
+    bool _empoweredDrainSoul = false;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || spell->SpellFamilyName != SPELLFAMILY_WARLOCK)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeIsDrainSoul(spell) || WcmeIsDrainLife(spell);
+        if (!eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+            return WcmeIsDrainLife(spell) || (WcmeIsDrainSoul(spell) && _empoweredDrainSoul);
+        return WcmeNamedAny(spell, { "Shadow Bolt", "Haunt" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (WcmeIsDrainSoul(spell))
+                _empoweredDrainSoul = owner->GetAuraCount(ESSENCE) >= 5;
+            if (owner->HasAura(ESSENCE))
+                owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(ESSENCE); }, 500ms);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        if (!(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+        {
+            for (uint8 i = target->IsControlledByPlayer() ? 2 : 1; i; --i)
+                WcmeAddStackOn(owner, owner, ESSENCE);
+            return;
+        }
+        if (WcmeIsDrainSoul(spell))
+        {
+            if (target->HasAura(RUPTURED, owner->GetGUID()))
+                return;
+            WcmeAddStackOn(owner, target, AFFLICTED);
+            if (target->GetAuraCount(AFFLICTED) >= 15)
+                owner->CastSpell(target, RUPTURED, true);
+            return;
+        }
+        if (Unit* minion = WcmeDarkmasterMinion(owner))
+            if (uint32 const heal = uint32(int64(damage->GetDamage() + damage->GetAbsorb()) * 20 / 100))
+            {
+                HealInfo minionHeal(owner, minion, heal, spell, spell->GetSchoolMask());
+                owner->HealBySpell(minionHeal);
+            }
+        if (Aura const* drain = target->GetAura(spell->Id, owner->GetGUID()))
+            for (uint8 i = 0; i < MAX_SPELL_EFFECTS; ++i)
+                if (AuraEffect const* effect = drain->GetEffect(i))
+                    if (effect->GetAuraType() == SPELL_AURA_PERIODIC_LEECH && effect->GetTotalTicks() &&
+                        effect->GetTickNumber() >= uint32(effect->GetTotalTicks()))
+                    {
+                        target->RemoveAurasDueToSpell(TOUCH, owner->GetGUID());
+                        target->RemoveAurasDueToSpell(TOUCH_SHOWN, owner->GetGUID());
+                    }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_darkmaster::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_darkmaster::HandleProc);
+    }
+};
