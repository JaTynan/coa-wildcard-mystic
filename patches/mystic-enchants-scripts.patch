+        });
+        if (targets.size() > 6)
+            targets.resize(6);
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_wcme_dark_transfusion_heal::LimitTargets, EFFECT_0, TARGET_UNIT_CASTER_AREA_RAID);
