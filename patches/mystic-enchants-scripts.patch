+// Epic batches 6 and 7, spell side. Not here because the core already does them (review 2026-11-17): Electrical
+// Discharge (277082, hard-coded in AuraEffect::HandleAscensionPercentEventProc), Pious Strikes (1581647) and Holy
+// Servitude (1584997) (both coa_mystic_enchant_proc rules run by spell_ascension_mystic_enchant_proc), Trauma Care
+// (274205, aura_wildcard_trauma_care) and Physics in Practice (277460, in AscensionMysticEnchantScripts).
+// - Saber Fangs (984696): every third Swipe (Cat) hit on an enemy (counter 984697) applies Saber Fangs (984698: a bleed
+//   of your level plus 6% of your spell power and attack power every 3 sec), unless it already has yours (it can't be
+//   refreshed). Ferocious Bite deals 50% of its damage (984701) as Saber Thrash (984700) to up to 5 other enemies within
+//   8 yards that have your Saber Fangs.
+// - Bestial Assault (272317): each Hunter ability you cast that deals direct damage (not Auto Shot) adds a stack of 272319; at 5 the
+//   stacks go and a charge of Unrelenting Wrath comes back. Its own data procs are switched off (051's SQL).
+// - Eternity (276362): an Align, Synchronize or Time-bind cast that leaves you at 0 energy gives Eternity (276347).
+// - Arngrim's Greeting (997188): landing a Heroic Leap (its damage spell 86359) starts its Blizzard (997194: 215 Frost
+//   damage every 2 sec for 6 sec, its data) where you land and Icy Veins (997193: +20% casting speed, 6 sec).
+// - Void Teleportation (954626): your (Priest) Void Shift also swaps your position with the target's, as they were when
+//   you cast it; skipped if either of you is on a transport, in a vehicle or on a flight path.
+// - Overflowing Cultivation (273422): a Chain Heal cast with Overflowing (273420 from Flowing, or 1571973 from Overflow
+//   1571951; Overflow 977710's own Overflowing 986113 already does this) up also puts Living Seed (48504) on
+//   each ally it heals, for 30% of the heal (its own value).
+// - Shadow Word: Gore (983020): teaches Shadow Word: Gore (983021, wcme_enchant_teach); its damage is 8% higher for each
+//   other bleed of yours on the target when cast, up to 40%, for its whole duration.
+// - Searing Flames (1180640): your Immolate can only be on one target; a new one takes the last one off. Your pet's
+//   Firebolt crit uses up its crit stacks (1180644).
+// - Ol' Bloodsurge (983600): Mongoose Bite, Counterattack, Glaive Toss, Mortal Strike, Execute, Raging Blow, Whirlwind
+//   and Bloodthirst hits give Bloodsurge (983604: next Slam instant, free and ignoring armour, its data), at most once
+//   every 4 sec.
+// - Lingering Death (81506): Shadow Word: Death's damage is also taken off the next heals the target receives within
+//   3 sec, and for 6 sec enemies within 7 yards of where it hit are slowed by 40% (Earthbind 3600, renewed every sec).
+// - Party Recuperation (983475): Party Recuperate (983478, taught) needs a stack of Bubbling Tankard (983476) and uses
+//   one.
+// - Void Teleportation, Eternity and the rest above are cast-time rules; damage and heal rules are on the unit side.
+class wcme_epic_batch67_spells : public AllSpellScript
+{
+public:
+    wcme_epic_batch67_spells() : AllSpellScript("wcme_epic_batch67_spells", { ALLSPELLHOOK_ON_PREPARE, ALLSPELLHOOK_ON_CAST,
+        ALLSPELLHOOK_ON_HIT_RESULT, ALLSPELLHOOK_ON_SPELL_CHECK_CAST }) { }
+
+    void OnSpellCheckCast(Spell* spell, bool /*strict*/, SpellCastResult& res) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        if (caster && res == SPELL_CAST_OK && spell->GetSpellInfo()->Id == 983478 && !caster->HasAura(983476))
+            res = SPELL_FAILED_CASTER_AURASTATE;
+        // Unbounded Mind Flay (81370) teaches 81371 outright; it is only usable if you know Mind Flay, as its text says.
+        if (caster && res == SPELL_CAST_OK && spell->GetSpellInfo()->Id == 81371 &&
+            !WcmeKnownByName(caster, "Mind Flay", SPELLFAMILY_PRIEST))
+            res = SPELL_FAILED_NOT_KNOWN;
+        // Likewise Unbounded Drain Mana (81362 -> 81383) needs Drain Mana, and You're a Solid Crate (982476 -> 982477)
+        // needs Stealth.
+        if (caster && res == SPELL_CAST_OK && spell->GetSpellInfo()->Id == 81383 &&
+            !WcmeKnownByName(caster, "Drain Mana", SPELLFAMILY_WARLOCK))
+            res = SPELL_FAILED_NOT_KNOWN;
+        if (caster && res == SPELL_CAST_OK && spell->GetSpellInfo()->Id == 982477 &&
+            !WcmeKnownByName(caster, "Stealth", SPELLFAMILY_ROGUE))
+            res = SPELL_FAILED_NOT_KNOWN;
+    }
+
+    void OnSpellPrepare(Spell* spell, Unit* caster, SpellInfo const* info) override
+    {
+        if (!spell || !caster || !info)
+            return;
+        if (caster->HasAura(81439) && info->SpellFamilyName == SPELLFAMILY_ROGUE && WcmeNamed(info, "Ambush"))
+        {
+            Unit* target = spell->m_targets.GetUnitTarget();
+            if (target && target->HasAuraType(SPELL_AURA_MOD_STEALTH))
+                WcmeAmbushStealthed[caster->GetGUID()] = { target->GetGUID(), GameTime::Now() + 5s };
+            else
+                WcmeAmbushStealthed.erase(caster->GetGUID());
+        }
+        if (caster->HasAura(273422) && WcmeNamed(info, "Chain Heal"))
+        {
+            WcmeMarkedCast.erase(caster->GetGUID());
+            if (WcmeHasAnyAura(caster, { 273420, 1571973 }))
+                WcmeMarkCast(caster, info->Id);
+        }
+    }
+
+    // Arngrim's Greeting: the Heroic Leap damage spell (86359) lands with the leap's missile, which can be a moment ahead
+    // of the warrior. Blizzard (997194) is placed at the caster, so wait (up to 2 sec) until they are on the ground near
+    // the landing point, then start Blizzard and Icy Veins (997193).
+    static void ArngrimLanding(Unit* caster, Position landing, uint8 tries)
+    {
+        bool const landed = !caster->IsFalling() && caster->GetExactDist2d(landing.GetPositionX(), landing.GetPositionY()) <= 4.0f;
+        if (landed || tries >= 20)
+        {
+            if (!caster->IsAlive())
+                return;
+            caster->CastSpell(caster, 997194, true);
+            caster->CastSpell(caster, 997193, true);
+            return;
+        }
+        caster->m_Events.AddEventAtOffset([caster, landing, tries]() { ArngrimLanding(caster, landing, tries + 1); }, 100ms);
+    }
+
+    static bool DirectDamage(SpellInfo const* info)
+    {
+        for (SpellEffectInfo const& effect : info->GetEffects())
+            if (effect.IsEffect(SPELL_EFFECT_SCHOOL_DAMAGE) || effect.IsEffect(SPELL_EFFECT_WEAPON_DAMAGE) ||
+                effect.IsEffect(SPELL_EFFECT_WEAPON_PERCENT_DAMAGE) || effect.IsEffect(SPELL_EFFECT_NORMALIZED_WEAPON_DMG) ||
+                effect.IsEffect(SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL))
+                return true;
+        return false;
+    }
+
+    void OnSpellCast(Spell* spell, Unit* caster, SpellInfo const* info, bool /*skipCheck*/) override
+    {
+        if (!spell || !caster || !info)
+            return;
+        Unit* target = spell->m_targets.GetUnitTarget();
+
+        if (info->Id == 983478)
+            if (Aura* tankard = caster->GetAura(983476))
+            {
+                if (tankard->GetStackAmount() > 1)
+                    tankard->SetStackAmount(tankard->GetStackAmount() - 1);
+                else
+                    tankard->Remove();
+            }
+
+        // Flowing (273418): the core's own Mystic Enchant rule (spell_ascension_mystic_enchant_proc) already adds a stack of
+        // Flowing (273419) for each Healing Touch cast, but nothing turned the stacks into Overflowing. Just after the
+        // cast, three stacks (the enchant's text; the buff's own text says 2) become Overflowing (273420).
+        if (caster->HasAura(273418) && info->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(info, "Healing Touch"))
+            caster->m_Events.AddEventAtOffset([caster]()
+            {
+                if (Aura const* flowing = caster->GetAura(273419); flowing && flowing->GetStackAmount() >= 3)
+                {
+                    caster->RemoveAurasDueToSpell(273419);
+                    caster->AddAura(273420, caster);
+                }
+            }, 1ms);
+
+        // Overflowing (273420, from Flowing): its data never removes it (its "removal delay" helper has nothing to set it
+        // off), so the Chain Heal it empowers takes it off once all its jumps have landed.
+        if (caster->HasAura(273420) && info->SpellFamilyName == SPELLFAMILY_SHAMAN && WcmeNamed(info, "Chain Heal"))
+            caster->m_Events.AddEventAtOffset([caster]() { caster->RemoveAurasDueToSpell(273420); }, 500ms);
+
+        if (caster->HasAura(272317) && info->SpellFamilyName == SPELLFAMILY_HUNTER && !spell->IsTriggered() &&
+            !info->IsAutoRepeatRangedSpell() && DirectDamage(info))
+        {
+            WcmeAddStack(caster, 272319);
+            if (Aura const* stacks = caster->GetAura(272319); stacks && stacks->GetStackAmount() >= 5)
+            {
+                caster->RemoveAurasDueToSpell(272319);
+                WcmeRestoreChargeByName(caster, "Unrelenting Wrath");
+            }
+        }
+
+        if (caster->HasAura(276362) && WcmeNamedAny(info, { "Align", "Synchronize", "Time-bind" }))
+            caster->m_Events.AddEventAtOffset([caster]()
+            {
+                if (caster->IsAlive() && caster->GetPower(POWER_ENERGY) == 0)
+                    caster->CastSpell(caster, 276347, true);
+            }, 1ms);
+
+        if (caster->HasAura(997188) && info->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeNamed(info, "Heroic Leap") &&
+            DirectDamage(info))
+        {
+            Position const landing = spell->m_targets.HasDst() ? spell->m_targets.GetDstPos()->GetPosition() : caster->GetPosition();
+            ArngrimLanding(caster, landing, 0);
+        }
+
+        if (caster->HasAura(954626) && target && target != caster && info->SpellFamilyName == SPELLFAMILY_PRIEST &&
+            WcmeNamed(info, "Void Shift"))
+        {
+            Position const mine = caster->GetPosition();
+            Position const theirs = target->GetPosition();
+            ObjectGuid const guid = target->GetGUID();
+            caster->m_Events.AddEventAtOffset([caster, guid, mine, theirs]()
+            {
+                Unit* ally = ObjectAccessor::GetUnit(*caster, guid);
+                if (!ally || !ally->IsAlive() || !caster->IsAlive() || ally->GetMapId() != caster->GetMapId())
+                    return;
+                // Not on a boat or zeppelin, in a vehicle or on a flight path: a teleport there could strand someone.
+                for (Unit* who : { caster, ally })
+                    if (who->GetTransport() || who->GetVehicle() || who->IsInFlight())
+                        return;
+                caster->NearTeleportTo(theirs.GetPositionX(), theirs.GetPositionY(), theirs.GetPositionZ(), caster->GetOrientation());
+                ally->NearTeleportTo(mine.GetPositionX(), mine.GetPositionY(), mine.GetPositionZ(), ally->GetOrientation());
+            }, 1ms);
+        }
+
+        if (target && caster->HasAura(983020) && info->Id == 983021)
+        {
+            int32 bleeds = 0;
+            for (auto const& [id, app] : target->GetAppliedAuras())
+                if (id != 983021 && app->GetBase()->GetCasterGUID() == caster->GetGUID() && WcmeIsBleed(app->GetBase()->GetSpellInfo()))
+                    ++bleeds;
+            WcmeGoreBonus[{ target->GetGUID(), caster->GetGUID() }] = std::min(40, 8 * bleeds);
+        }
+
+        if (target && caster->HasAura(1180640) && info->SpellFamilyName == SPELLFAMILY_WARLOCK && WcmeNamed(info, "Immolate"))
+        {
+            ObjectGuid& last = WcmeSearingFlamesTarget[caster->GetGUID()];
+            if (!last.IsEmpty() && last != target->GetGUID())
+                if (Unit* old = ObjectAccessor::GetUnit(*caster, last))
+                {
+                    std::vector<uint32> immolates;
+                    for (auto const& [id, app] : old->GetAppliedAuras())
+                        if (app->GetBase()->GetCasterGUID() == caster->GetGUID() && WcmeNamed(app->GetBase()->GetSpellInfo(), "Immolate"))
+                            immolates.push_back(id);
+                    for (uint32 id : immolates)
+                        old->RemoveAurasDueToSpell(id, caster->GetGUID());
+                }
+            last = target->GetGUID();
+        }
+    }
+
+    void OnSpellHitResult(Spell* spell, Unit* target, uint8 missInfo, uint32 damage, uint32 healing, bool critical) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        if (!caster || !target || missInfo != SPELL_MISS_NONE)
+            return;
+        SpellInfo const* info = spell->GetSpellInfo();
+
+        if (critical && caster->HasAura(1180644) && WcmeNamed(info, "Firebolt"))
+            caster->RemoveAurasDueToSpell(1180644);
+
+        if (damage && info->SpellFamilyName == SPELLFAMILY_DEATHKNIGHT && WcmeNamed(info, "Grave Coil") &&
+            target->HasAura(288824, caster->GetGUID()))
+            target->RemoveAurasDueToSpell(288824, caster->GetGUID());
+
+        if (healing && caster->HasAura(273422) && WcmeNamed(info, "Chain Heal"))
+        {
+            auto mark = WcmeMarkedCast.find(caster->GetGUID());
+            if (mark != WcmeMarkedCast.end() && mark->second.first == info->Id && GameTime::Now() <= mark->second.second)
+            {
+                AuraEffect const* rule = caster->GetAuraEffect(273422, EFFECT_0);
+                int32 const seed = int32(healing * uint32(rule ? std::max(0, rule->GetAmount()) : 30) / 100);
+                if (seed > 0)
+                    caster->CastCustomSpell(target, 48504, &seed, nullptr, nullptr, true);
+            }
+        }
+
+        if (!damage)
+            return;
+
+        if (caster->HasAura(984696) && WcmeNamed(info, "Swipe (Cat)") && !target->HasAura(984698, caster->GetGUID()))
+        {
+            Aura const* counter = target->GetAura(984697, caster->GetGUID());
+            if (counter && counter->GetStackAmount() >= 2)
+            {
+                target->RemoveAurasDueToSpell(984697, caster->GetGUID());
+                int32 const tick = int32(caster->GetLevel() +
+                    (caster->SpellBaseDamageBonusDone(SPELL_SCHOOL_MASK_MAGIC) + caster->GetTotalAttackPowerValue(BASE_ATTACK)) * 0.06f);
+                WcmeNoSecondBonus(984698);
+                caster->CastCustomSpell(target, 984698, &tick, nullptr, nullptr, true);
+            }
+            else
+                WcmeAddStack(target, 984697, caster);
+        }
+
+        if (caster->HasAura(984696) && WcmeNamed(info, "Ferocious Bite"))
+            if (SpellInfo const* thrash = sSpellMgr->GetSpellInfo(984700))
+            {
+                uint8 hits = 0;
+                for (Unit* enemy : WcmeEnemiesNear(caster, target, 8.0f, 20))
+                    if (enemy != target && enemy->HasAura(984698, caster->GetGUID()) && hits++ < 5)
+                        WcmeExtraDamage(caster, enemy, thrash, int64(damage) * 50 / 100);
+            }
+
+        if (caster->HasAura(983600) && WcmeNamedAny(info, { "Mongoose Bite", "Counterattack", "Glaive Toss", "Mortal Strike",
+                "Execute", "Raging Blow", "Whirlwind", "Bloodthirst" }))
+        {
+            auto ready = WcmeBloodsurgeReady.find(caster->GetGUID());
+            if (ready == WcmeBloodsurgeReady.end() || GameTime::Now() >= ready->second)
+            {
+                WcmeBloodsurgeReady[caster->GetGUID()] = GameTime::Now() + 4s;
+                caster->AddAura(983604, caster);
+            }
+        }
+
+        if (caster->HasAura(81506) && info->SpellFamilyName == SPELLFAMILY_PRIEST && WcmeNamed(info, "Shadow Word: Death"))
+        {
+            WcmeLingeringDeath[target->GetGUID()] = { int64(damage), GameTime::Now() + 3s };
+            Position const spot = target->GetPosition();
+            for (uint8 second = 0; second < 6; ++second)
+                caster->m_Events.AddEventAtOffset([caster, spot]()
+                {
+                    if (!caster->IsAlive())
+                        return;
+                    std::list<Unit*> enemies;
+                    Acore::AnyUnfriendlyUnitInObjectRangeCheck check(caster, caster, 60.0f);
+                    Acore::UnitListSearcher<Acore::AnyUnfriendlyUnitInObjectRangeCheck> searcher(caster, enemies, check);
+                    Cell::VisitObjects(caster, searcher, 60.0f);
+                    for (Unit* enemy : enemies)
+                        if (enemy->IsAlive() && caster->IsValidAttackTarget(enemy) && enemy->GetExactDist(&spot) <= 7.0f)
+                            caster->AddAura(3600, enemy);
+                }, Milliseconds(1000 * second + 1));
+        }
+    }
+};
+
+// Epic batches 6 and 7, unit side:
+// - Double Agent (81439): Ambush deals double damage to a target that was stealthed when the Ambush started (the core
+//   takes the target's stealth off before the damage is worked out). Its stealth detection is its data.
+// - Shadow Word: Gore (983020): its ticks get the bonus worked out when it was cast.
+// - Energy Surge (1180750): your damaging Rogue ability that hits a target with your Gouge deals 30% more (its own
+//   value); the Gouge then breaks as usual.
+// - Ol' Bloodsurge (983600): using Bloodsurge makes your next Hunter or Warrior direct damage ability deal 20% more
+//   (within 15 sec).
+// - Consumed By Shadows (997217): with Master of Subtlety (31665) up, your Shadow damage gets its bonus too (its value,
+//   12% at rank 3); leaving Stealth puts you in Shadowform if you know it, unless you left Stealth by shifting into
+//   another form, are mounted, or are stealthed again.
+// - Necromancer's Touch (275963): melee and spell hits from your Dominate Undead or Enslave Demon pet, or your ghoul, add
+//   a stack of Necromancer's Touch (275966) and of its Grave Coil part (288824) from you on the target (see
+//   NecromancerPet). Your next Grave Coil on the target uses up the Grave Coil stacks.
+// - Searing Flames (1180640): each Immolate tick also hits every other enemy within 8 yards of the target for the same
+//   damage (1180643). The pet's crit stacks (1180644) per tick are the core's own enchant rule (effect 1); the core has
+//   no rule for this splash (effect 0), so it is done here.
+// - Lingering Death (81506): heals on the target take off what Shadow Word: Death dealt, until used up or 3 sec pass.
+// - Downpour (983523): teaches Downpour (983524, wcme_enchant_teach). Each injured ally it heals gives you a stack of
+//   Torrential Riptide (983519, up to 5); when Riptide uses them, Downpour's cooldown drops 3 sec per stack.
+// - Photosynthesis (287852): while your Lifebloom is on an ally (not you), each of your Nature heal-over-time ticks on
+//   them has a 20% chance to make it bloom (33778, worked out as the core's Lifebloom does) without using it up.
+// - Vampirism (277003): Vampiric Embrace no longer heals you or your party; the part it would have healed you for goes
+//   instead to the lowest-health ally within 40 yards (you included), with your healing power added, up to 5% of your
+//   maximum health per heal.
+// - Ursoc's Blessing (81446 / 282004): leaving Bear or Dire Bear Form keeps the armour and Stamina parts of the form's
+//   passive (Bear Form (Passive) / Dire Bear Form (Passive), effects 0 and 1, not its attack power) on you for 3 more sec.
+// Shadow Funnel (1180900) used to be here; review 2026-11-18 found the core already does it (the Voidwalker gets
+// 1180901 while Health Funnelled, which sets off Void Nova on its auto attacks), so ours doubled Void Nova.
+// - Aegis Overdrive (299160): Mana Shield going up sets off Aegis Explosion (299163) unless its activation lockout
+//   (299161) is on you; Mana Shield running out or breaking sets it off again.
+// - Party Recuperation (983475): finisher proc in spell_wcme_finisher_combo.
+class wcme_epic_batch67_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch67_hooks() : UnitScript("wcme_epic_batch67_hooks", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_MELEE_DAMAGE, UNITHOOK_MODIFY_HEAL_RECEIVED,
+        UNITHOOK_ON_AURA_APPLY, UNITHOOK_ON_AURA_REMOVE, UNITHOOK_ON_UNIT_SET_SHAPESHIFT_FORM }) { }
+
+    // Ursoc's Blessing: going back into a bear form drops the 3 sec copies first, so the form's own passives (applied
+    // just after this) are fresh and don't inherit the 3 sec timer.
+    void OnUnitSetShapeshiftForm(Unit* unit, uint8 form) override
+    {
+        if (!unit || (form != FORM_BEAR && form != FORM_DIREBEAR) || !WcmeHasAnyAura(unit, { 81446, 282004 }))
+            return;
+        for (uint32 id : { 1178u, 1101178u, 9635u, 1109635u })
+            if (Aura* kept = unit->GetAura(id, unit->GetGUID()); kept && kept->GetMaxDuration() == 3000)
+                kept->Remove();
+    }
+
+    static int64 Direct(Unit* target, Unit* attacker, SpellInfo const* spell, int64 value)
+    {
+        if (attacker->HasAura(81439) && spell->SpellFamilyName == SPELLFAMILY_ROGUE && WcmeNamed(spell, "Ambush"))
+        {
+            auto stealthed = WcmeAmbushStealthed.find(attacker->GetGUID());
+            if (stealthed != WcmeAmbushStealthed.end())
+            {
+                if (stealthed->second.first == target->GetGUID() && GameTime::Now() <= stealthed->second.second)
+                    value *= 2;
+                WcmeAmbushStealthed.erase(stealthed);
+            }
+        }
+        if (attacker->HasAura(1180750) && spell->SpellFamilyName == SPELLFAMILY_ROGUE && !WcmeNamed(spell, "Gouge") &&
+            WcmeAuraFromNamed(target, attacker, "Gouge"))
+        {
+            AuraEffect const* rule = attacker->GetAuraEffect(1180750, EFFECT_1);
+            value = value * (100 + (rule ? rule->GetAmount() : 30)) / 100;
+        }
+        if ((spell->SpellFamilyName == SPELLFAMILY_HUNTER || spell->SpellFamilyName == SPELLFAMILY_WARRIOR))
+        {
+            auto bonus = WcmeBloodsurgeBonus.find(attacker->GetGUID());
+            if (bonus != WcmeBloodsurgeBonus.end())
+            {
+                if (GameTime::Now() <= bonus->second)
+                    value = value * 120 / 100;
+                WcmeBloodsurgeBonus.erase(bonus);
+            }
+        }
+        return value;
+    }
+
+    static int64 Any(Unit* /*target*/, Unit* attacker, SpellInfo const* spell, int64 value)
+    {
+        // Master of Subtlety's damage buff is 31665 or a twin of it (the core picks the twin of the talent you have).
+        if (attacker->HasAura(997217) && (spell->SchoolMask & SPELL_SCHOOL_MASK_SHADOW))
+            for (AuraEffect const* subtlety : attacker->GetAuraEffectsByType(SPELL_AURA_MOD_DAMAGE_PERCENT_DONE))
+                if (subtlety->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_ROGUE &&
+                    WcmeNamed(subtlety->GetSpellInfo(), "Master of Subtlety") && !(subtlety->GetMiscValue() & SPELL_SCHOOL_MASK_SHADOW))
+                {
+                    value = value * (100 + std::max(0, subtlety->GetAmount())) / 100;
+                    break;
+                }
+        return value;
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0 || target == attacker)
+            return;
+        damage = int32(std::min<int64>(INT32_MAX, Any(target, attacker, spellInfo, Direct(target, attacker, spellInfo, damage))));
+        if (!attacker->IsPlayer())
+            NecromancersTouch(attacker->GetCharmerOrOwner(), attacker, target);
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || !damage || target == attacker ||
+            spellInfo->HasAura(SPELL_AURA_PERIODIC_HEAL) || spellInfo->HasAura(SPELL_AURA_OBS_MOD_HEALTH))
+            return;
+        int64 value = Any(target, attacker, spellInfo, damage);
+        if (spellInfo->Id == 983021)
+        {
+            auto bonus = WcmeGoreBonus.find({ target->GetGUID(), attacker->GetGUID() });
+            if (bonus != WcmeGoreBonus.end())
+                value = value * (100 + bonus->second) / 100;
+        }
+        damage = uint32(std::min<int64>(UINT32_MAX, value));
+
+        if (attacker->HasAura(1180640) && spellInfo->SpellFamilyName == SPELLFAMILY_WARLOCK && WcmeNamed(spellInfo, "Immolate"))
+        {
+            ObjectGuid const guid = target->GetGUID();
+            uint32 const amount = damage;
+            attacker->m_Events.AddEventAtOffset([attacker, guid, amount]()
+            {
+                Unit* center = ObjectAccessor::GetUnit(*attacker, guid);
+                SpellInfo const* splash = sSpellMgr->GetSpellInfo(1180643);
+                if (center && splash && attacker->IsAlive())
+                    for (Unit* enemy : WcmeEnemiesNear(attacker, center, 8.0f, 11))
+                        if (enemy != center)
+                            WcmeExtraDamage(attacker, enemy, splash, amount);
+            }, 1ms);
+        }
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        if (!target || !attacker || !damage || attacker->IsPlayer())
+            return;
+        Unit* owner = attacker->GetCharmerOrOwner();
+        Creature* creature = attacker->ToCreature();
+        if (!owner || !creature)
+            return;
+        NecromancersTouch(owner, attacker, target);
+    }
+
+    // Necromancer's Touch (275963): a pet made by Dominate Undead or Enslave Demon (in our data these tame the creature,
+    // so it is a pet, not a charm), a ghoul from Raise Dead or Summon Ghoul, or a demon or undead you are charming.
+    static bool NecromancerPet(Unit* owner, Unit* attacker)
+    {
+        Creature* creature = attacker->ToCreature();
+        if (!creature || attacker->GetCharmerOrOwner() != owner)
+            return false;
+        if (SpellInfo const* made = sSpellMgr->GetSpellInfo(attacker->GetUInt32Value(UNIT_CREATED_BY_SPELL)))
+            if (WcmeNamedAny(made, { "Dominate Undead", "Enslave Demon", "Raise Dead", "Summon Ghoul" }))
+                return true;
+        if (creature->GetEntry() == 26125)
+            return true;
+        uint32 const type = creature->GetCreatureType();
+        return attacker->IsCharmed() && attacker->GetCharmerGUID() == owner->GetGUID() &&
+            (type == CREATURE_TYPE_DEMON || type == CREATURE_TYPE_UNDEAD);
+    }
+
+    // Each hit from such a pet adds a stack of Necromancer's Touch (275966: +5% damage per stack from your Drain Life and
+    // Drain Soul, up to 10, 8 sec) and of its Grave Coil part (288824: +5% from your next Grave Coil per stack, up to 10).
+    static void NecromancersTouch(Unit* owner, Unit* attacker, Unit* target)
+    {
+        if (!owner || !target || !owner->HasAura(275963) || !NecromancerPet(owner, attacker))
+            return;
+        ObjectGuid const guid = target->GetGUID();
+        owner->m_Events.AddEventAtOffset([owner, guid]()
+        {
+            if (Unit* victim = ObjectAccessor::GetUnit(*owner, guid); victim && victim->IsAlive())
+            {
+                WcmeAddStack(victim, 275966, owner);
+                WcmeAddStack(victim, 288824, owner);
+            }
+        }, 1ms);
+    }
+
+    void ModifyHealReceived(Unit* target, Unit* healer, uint32& heal, SpellInfo const* spellInfo) override
+    {
+        if (!target || !healer || !spellInfo || _inner)
+            return;
+        WcmeHealParties(target, healer, heal, spellInfo);
+        bool const periodic = WcmeLastHealTick.amount == &heal && spellInfo->HasAura(SPELL_AURA_PERIODIC_HEAL);
+
+        auto blocked = WcmeLingeringDeath.find(target->GetGUID());
+        if (blocked != WcmeLingeringDeath.end() && heal)
+        {
+            if (GameTime::Now() > blocked->second.second)
+                WcmeLingeringDeath.erase(blocked);
+            else
+            {
+                int64 const taken = std::min<int64>(heal, blocked->second.first);
+                heal -= uint32(taken);
+                blocked->second.first -= taken;
+                if (blocked->second.first <= 0)
+                    WcmeLingeringDeath.erase(blocked);
+            }
+        }
+
+        Player* player = healer->ToPlayer();
+        if (!player || !heal)
+            return;
+
+        if (spellInfo->Id == 15290 && player->HasAura(277003))
+        {
+            uint32 const amount = heal;
+            heal = 0;
+            if (target != player)
+                return;
+            player->m_Events.AddEventAtOffset([player, amount]()
+            {
+                Unit* ally = WcmeLowestAlly(player, nullptr, 40.0f);
+                if (!ally && player->GetHealth() < player->GetMaxHealth())
+                    ally = player;
+                SpellInfo const* info = sSpellMgr->GetSpellInfo(15290);
+                if (!ally || !info)
+                    return;
+                uint32 value = player->SpellHealingBonusDone(ally, info, amount, HEAL, EFFECT_1);
+                value = std::min<uint32>(value, player->CountPctFromMaxHealth(5));
+                _inner = true;
+                HealInfo healInfo(player, ally, value, info, info->GetSchoolMask());
+                player->HealBySpell(healInfo);
+                _inner = false;
+            }, 1ms);
+            return;
+        }
+
+        if (!periodic && spellInfo->Id == 983524 && player->HasAura(983523) && target->GetHealth() < target->GetMaxHealth())
+            player->m_Events.AddEventAtOffset([player]() { WcmeAddStack(player, 983519); }, 1ms);
+
+        if (periodic && target != player && player->HasAura(287852) && spellInfo->SpellFamilyName == SPELLFAMILY_DRUID &&
+            (spellInfo->SchoolMask & SPELL_SCHOOL_MASK_NATURE) && roll_chance_i(20))
+            for (auto const& [id, app] : target->GetAppliedAuras())
+            {
+                Aura const* aura = app->GetBase();
+                if (aura->GetCasterGUID() != player->GetGUID() || !WcmeNamed(aura->GetSpellInfo(), "Lifebloom"))
+                    continue;
+                AuraEffect const* bloom = aura->GetEffect(EFFECT_1);
+                SpellInfo const* finalHeal = sSpellMgr->GetSpellInfo(33778);
+                if (!bloom || !finalHeal)
+                    break;
+                uint8 const stacks = aura->GetStackAmount();
+                int32 amount = int32(player->SpellHealingBonusDone(target, finalHeal, bloom->GetAmount(), HEAL, EFFECT_1, 0.0f, stacks));
+                amount = int32(target->SpellHealingBonusTaken(player, finalHeal, amount, HEAL, stacks));
+                ObjectGuid const guid = target->GetGUID();
+                ObjectGuid const from = player->GetGUID();
+                player->m_Events.AddEventAtOffset([player, guid, from, amount]()
+                {
+                    if (Unit* ally = ObjectAccessor::GetUnit(*player, guid); ally && ally->IsAlive())
+                        ally->CastCustomSpell(ally, 33778, &amount, nullptr, nullptr, true, nullptr, nullptr, from);
+                }, 1ms);
+                break;
+            }
+    }
+
+    static bool BearStats(SpellInfo const* info)
+    {
+        return info->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamedAny(info, { "Bear Form (Passive)", "Dire Bear Form (Passive)" });
+    }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (!unit || !aura || aura->GetOwner() != unit)
+            return;
+        if (unit->HasAura(299160) && aura->GetCasterGUID() == unit->GetGUID() &&
+            WcmeNamed(aura->GetSpellInfo(), "Mana Shield") && !unit->HasAura(299161))
+        {
+            unit->CastSpell(unit, 299161, true);
+            unit->CastSpell(unit, 299163, true);
+        }
+    }
+
+    void OnAuraRemove(Unit* unit, AuraApplication* aurApp, AuraRemoveMode mode) override
+    {
+        if (!unit || !aurApp)
+            return;
+        Aura* aura = aurApp->GetBase();
+        SpellInfo const* info = aura->GetSpellInfo();
+        uint32 const id = aura->GetId();
+
+        if (id == 983604 && unit->HasAura(983600) && WcmeConsumed(aurApp, mode))
+            unit->m_Events.AddEventAtOffset([unit]() { WcmeBloodsurgeBonus[unit->GetGUID()] = GameTime::Now() + 15s; }, 1ms);
+
+        if (id == 983519 && unit->HasAura(983523) && WcmeConsumed(aurApp, mode))
+            WcmeCutCooldownByName(unit, "Downpour", 3000 * aura->GetStackAmount());
+
+        if (unit->HasAura(997217) && info->SpellFamilyName == SPELLFAMILY_ROGUE && WcmeNamed(info, "Stealth") &&
+            mode != AURA_REMOVE_BY_DEATH && unit->IsAlive())
+            if (uint32 shadowform = WcmeKnownByName(unit, "Shadowform", SPELLFAMILY_PRIEST); shadowform &&
+                !WcmeHasAuraNamed(unit, "Shadowform", SPELLFAMILY_PRIEST))
+                unit->m_Events.AddEventAtOffset([unit, shadowform]()
+                {
+                    // Only out of every form: not if Stealth ended because you shifted into another form (cat, bear),
+                    // not when mounted, and not if Stealth came straight back (Vanish).
+                    if (unit->IsAlive() && unit->GetShapeshiftForm() == FORM_NONE && !unit->IsMounted() &&
+                        !unit->HasAuraType(SPELL_AURA_MOD_STEALTH) && !WcmeHasAuraNamed(unit, "Shadowform", SPELLFAMILY_PRIEST))
+                        unit->CastSpell(unit, shadowform, true);
+                }, 1ms);
+
+        if (WcmeHasAnyAura(unit, { 81446, 282004 }) && BearStats(info) && mode == AURA_REMOVE_BY_DEFAULT && unit->IsAlive())
+            unit->m_Events.AddEventAtOffset([unit, id]()
+            {
+                ShapeshiftForm const form = unit->GetShapeshiftForm();
+                SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+                if (!info || !unit->IsAlive() || unit->HasAura(id) || form == FORM_BEAR || form == FORM_DIREBEAR)
+                    return;
+                // Effects 0 and 1 only: armour and Stamina, not the form's attack power.
+                if (Aura* kept = unit->AddAura(info, (1 << EFFECT_0) | (1 << EFFECT_1), unit))
+                {
+                    kept->SetMaxDuration(3000);
+                    kept->SetDuration(3000);
+                }
+            }, 1ms);
+
+        if (unit->HasAura(299160) && aura->GetCasterGUID() == unit->GetGUID() && WcmeNamed(info, "Mana Shield") &&
+            (mode == AURA_REMOVE_BY_EXPIRE || mode == AURA_REMOVE_BY_ENEMY_SPELL) && unit->IsAlive())
+            unit->m_Events.AddEventAtOffset([unit]() { if (unit->IsAlive()) unit->CastSpell(unit, 299163, true); }, 1ms);
+    }
+
+private:
+    static inline thread_local bool _inner = false;
+};
