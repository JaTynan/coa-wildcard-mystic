+// Fel Meteor and Fel Strike (all ranks) deal the damage their tooltips give, which the core does not scale by itself:
+// Fel Meteor base + 0.44 x (AP + SP) to each enemy hit; Fel Strike base + 1.43 x AP + 1.43 x SP, shared between the
+// targets it hits (at most 3).
+class spell_wcme_fel_damage : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_fel_damage);
+
+    uint32 _targets = 1;
+
+    bool FelStrike() { return WcmeNamed(GetSpellInfo(), "Fel Strike"); }
+
+    void CountTargets(std::list<WorldObject*>& targets)
+    {
+        uint32 count = uint32(targets.size());
+        if (GetSpellInfo()->MaxAffectedTargets)
+            count = std::min(count, GetSpellInfo()->MaxAffectedTargets);
+        _targets = std::max<uint32>(1, count);
+    }
+
+    void HandleDamage()
+    {
+        Unit* caster = GetCaster();
+        float const ap = WcmeAttackPower(caster), sp = WcmeSpellPower(caster);
+        float const extra = FelStrike() ? 1.43f * ap + 1.43f * sp : 0.44f * (ap + sp);
+        int32 const base = GetSpellInfo()->GetEffect(EFFECT_0).CalcValue(caster);
+        SetHitDamage(int32((base + extra) / (FelStrike() ? _targets : 1)));
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_wcme_fel_damage::CountTargets, EFFECT_0, TARGET_UNIT_DEST_AREA_ENEMY);
+        OnHit += SpellHitFn(spell_wcme_fel_damage::HandleDamage);
+    }
+};
