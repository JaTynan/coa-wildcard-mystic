+// Astral Storm (832617): its data procs on every damaging spell (the core builds a proc from the spell's own flags),
+// which would send any target into the Astral Realm. Only Astral Storm hits count now: on a monster they restore 10% of
+// your maximum mana; on a player with your Unrelenting Storm (412000) they send the target and you into the Astral
+// Realm (832618) for 8 sec.
+class spell_wcme_astral_storm : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_astral_storm);
+
+    static constexpr uint32 ASTRAL_REALM = 832618;
+    static constexpr uint32 UNRELENTING_STORM = 412000;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeNamed(eventInfo.GetSpellInfo(), "Astral Storm");
+    }
+
+    void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target->IsPlayer())
+        {
+            owner->ModifyPower(POWER_MANA, int32(owner->GetMaxPower(POWER_MANA) / 10));
+            return;
+        }
