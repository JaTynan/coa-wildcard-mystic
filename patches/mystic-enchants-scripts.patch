+// Rush of Blood (1587050): Hemorrhage twice in a row makes the next Ambush usable outside Stealth; a third
+// Hemorrhage restores energy. Any other ability starts the count again.
+class spell_wcme_rush_of_blood : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_rush_of_blood);
+
+    static constexpr uint32 AMBUSH_ANYWHERE = 1587051;
+    static constexpr uint32 ENERGY = 1587057;
+    uint8 _hemorrhages = 0;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && !spell->IsPassive();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (!WcmeNamed(eventInfo.GetSpellInfo(), "Hemorrhage"))
+        {
+            _hemorrhages = 0;
+            return;
+        }
+        if (++_hemorrhages == 2)
+            owner->CastSpell(owner, AMBUSH_ANYWHERE, true);
+        else if (_hemorrhages >= 3)
+        {
+            owner->CastSpell(owner, ENERGY, true);
+            _hemorrhages = 0;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_rush_of_blood::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_rush_of_blood::HandleProc);
+    }
+};
