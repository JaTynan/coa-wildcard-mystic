+// Weapon Command (954057 / 283338): while you wield a single two-handed weapon, are not in Cat or Bear Form and cannot
+// use Titan's Grip, you have 954058 (+10% Physical damage and +4% melee critical strike chance, the client data). Checked
+// every second.
+class spell_wcme_weapon_command : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_weapon_command);
+
+    static constexpr uint32 BUFF = 954058;
+
+    static bool Eligible(Unit* unit)
+    {
+        Player* player = unit->ToPlayer();
+        if (!player || player->CanTitanGrip())
+            return false;
+        ShapeshiftForm const form = player->GetShapeshiftForm();
+        if (form == FORM_CAT || form == FORM_BEAR || form == FORM_DIREBEAR)
+            return false;
+        Item const* main = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND);
+        return main && main->GetTemplate()->InventoryType == INVTYPE_2HWEAPON &&
+            !player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Tick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        bool const wanted = Eligible(owner);
+        if (wanted && !owner->HasAura(BUFF))
+            owner->AddAura(BUFF, owner);
+        else if (!wanted)
+            owner->RemoveAurasDueToSpell(BUFF);
+    }
+
+    void Remove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        GetTarget()->RemoveAurasDueToSpell(BUFF);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_weapon_command::CalcPeriod, EFFECT_2, SPELL_AURA_DUMMY);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_weapon_command::Tick, EFFECT_2, SPELL_AURA_DUMMY);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_weapon_command::Remove, EFFECT_2, SPELL_AURA_DUMMY,
+            AURA_EFFECT_HANDLE_REAL);
+    }
+};
