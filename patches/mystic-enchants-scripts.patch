+// Forbidden Technique (954326): Shadow Dance shows as the Forbidden Technique shot (954327, WcmeSyncSwap; it grants
+// Shadow Dance itself through its data). Each shot that hits grants Forbidden Dance (986233). During the Dance, Ambush
+// costs 30 less energy (954338, the kit's own modifier, kept on you for the Dance) and its hits throw a Dusk Dagger (954330) and add Dusk Shot (901110: Hunter shots +7%, up to 5). Shadow
+// Powers (with a dagger in your main hand): Hunter shots have a 75% chance to throw a Shadow Dagger (954336), take 3 sec
+// (1 vs players) off Forbidden Technique (954339 / 954344) and add Dusk Blade (901111). Ambush deals 6% more per Dusk
+// Blade stack (2% vs players; done here, its data's modifier types are Ascension-only).
+class spell_wcme_forbidden_technique : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_forbidden_technique);
+
+    static constexpr uint32 SHOT = 954327;
+    static constexpr uint32 DANCE = 986233;
+    static constexpr uint32 DUSK_DAGGER = 954330;
+    static constexpr uint32 DUSK_SHOT = 901110;
+    static constexpr uint32 SHADOW_DAGGER = 954336;
+    static constexpr uint32 CDR = 954339;
+    static constexpr uint32 CDR_PVP = 954344;
+    static constexpr uint32 DUSK_BLADE = 901111;
+
+    void Sync(bool active) { WcmeSyncSwap(GetTarget(), "Shadow Dance", SPELLFAMILY_ROGUE, SHOT, active); }
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo) || spell->Id == SHADOW_DAGGER || spell->Id == DUSK_DAGGER)
+            return false;
+        if (spell->Id == SHOT || WcmeNamed(spell, "Ambush"))
+            return true;
+        return WcmeIsHunterShot(spell) && WcmeMainHandDagger(GetTarget()) && roll_chance_i(75);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (spell->Id == SHOT)
+        {
+            owner->CastSpell(owner, DANCE, true);
+            return;
+        }
+        if (WcmeNamed(spell, "Ambush"))
+        {
+            if (uint8 const blades = owner->GetAuraCount(DUSK_BLADE))
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) *
+                    (target->IsControlledByPlayer() ? 2 : 6) * blades / 100);
+            }
+            if (owner->HasAura(DANCE))
+            {
+                owner->CastSpell(target, DUSK_DAGGER, true);
+                WcmeAddStackOn(owner, owner, DUSK_SHOT);
+            }
+            return;
+        }
+        owner->CastSpell(target, SHADOW_DAGGER, true);
+        owner->CastSpell(owner, target->IsControlledByPlayer() ? CDR_PVP : CDR, true);
+        WcmeAddStackOn(owner, owner, DUSK_BLADE);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_forbidden_technique::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_forbidden_technique::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_forbidden_technique::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_forbidden_technique::HandleProc);
+    }
+};
