+// The id of the highest known, active, non-passive spell of that name and family, or 0.
+uint32 WcmeKnownByName(Unit const* unit, char const* name, uint32 family)
+{
+    Player const* player = unit->ToPlayer();
+    uint32 best = 0;
+    if (!player)
+        return 0;
+    for (auto const& [spellId, known] : player->GetSpellMap())
+        if (known->State != PLAYERSPELL_REMOVED && known->Active)
+            if (SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId))
+                if (info->SpellFamilyName == family && WcmeNamed(info, name) && (!best || info->SpellLevel >= sSpellMgr->GetSpellInfo(best)->SpellLevel))
+                    best = spellId;
+    return best;
+}
+
+bool WcmeKnowsPassive(Unit const* unit, char const* name, uint32 family)
+{
+    Player const* player = unit->ToPlayer();
+    if (!player)
+        return false;
+    for (auto const& [spellId, known] : player->GetSpellMap())
+        if (known->State != PLAYERSPELL_REMOVED)
+            if (SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId))
+                if (info->SpellFamilyName == family && WcmeNamed(info, name))
+                    return true;
+    return false;
+}
