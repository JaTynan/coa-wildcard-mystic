+// Blurred Blade's helper (92802): a dodge or parry (once every 0.5 sec, spell_proc) answers with an immediate
+// follow-up attack (92804), gives 5 energy and takes 1 sec off Blurred Blade.
+class spell_wcme_blurred_blade_counter : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_blurred_blade_counter);
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (Unit* attacker = eventInfo.GetActor())
+            if (attacker != owner && attacker->IsAlive())
+                owner->CastSpell(attacker, 92804, true);
+        owner->EnergizeBySpell(owner, 92802, 5, POWER_ENERGY);
+        for (auto const& [id, application] : owner->GetAppliedAuras())
+        {
+            Aura* aura = application->GetBase();
+            if (WcmeNamed(aura->GetSpellInfo(), "Blurred Blade") && aura->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_ROGUE &&
+                aura->GetDuration() > 0)
+            {
+                aura->SetDuration(std::max(1, aura->GetDuration() - 1000));
+                return;
+            }
+        }
+    }
+
+    void Register() override
+    {
+        OnProc += AuraProcFn(spell_wcme_blurred_blade_counter::HandleProc);
+    }
+};
