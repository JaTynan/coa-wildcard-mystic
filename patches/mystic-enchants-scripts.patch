+// Delirium: "you cannot gain mana". Any mana gained between player updates while in Delirium is taken back.
+class wcme_mana_fiend_regen : public PlayerScript
+{
+public:
+    wcme_mana_fiend_regen() : PlayerScript("wcme_mana_fiend_regen", { PLAYERHOOK_ON_UPDATE }) { }
+
+    void OnPlayerUpdate(Player* player, uint32 /*diff*/) override
+    {
+        auto entry = WcmeDeliriumMana.find(player->GetGUID());
+        if (entry == WcmeDeliriumMana.end())
+            return;
+        if (!player->HasAura(DELIRIUM))
+        {
+            WcmeDeliriumMana.erase(entry);
+            return;
+        }
+        if (player->GetPower(POWER_MANA) > entry->second)
+            player->SetPower(POWER_MANA, entry->second);
+        entry->second = player->GetPower(POWER_MANA);
+    }
