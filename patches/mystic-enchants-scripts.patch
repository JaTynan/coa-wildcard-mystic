+// Standing still, checked every half second:
+// - Sniper (81166): every 3 sec standing still adds a stack of 81167 (Aimed Shot and Kill Shot +1 yard range and +2%
+//   damage per stack, up to 10, its own data); moving removes the stacks.
+// - Ready, Set, Go! (81128): in combat, every 3 sec standing still adds a stack of 81129 (+7% movement speed per stack,
+//   up to 5, its own data). The stacks are kept fresh while you stand still and last their 3 sec once you move, so the
+//   speed is there when you set off.
+class spell_wcme_stand_still : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_stand_still);
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 500;
+    }
+
+    void Tick(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Player* player = GetTarget()->ToPlayer();
+        if (!player)
+            return;
+        bool const sniper = GetId() == 81166;
+        uint32 const buff = sniper ? 81167 : 81129;
+        bool const moving = player->isMoving() || player->IsFalling();
+        if (moving || (!sniper && !player->IsInCombat()))
+        {
+            _stillMs = 0;
+            if (sniper)
+                player->RemoveAurasDueToSpell(buff);
+            return;
+        }
+        if (Aura* stacks = player->GetAura(buff))
+            stacks->RefreshDuration();
+        _stillMs += 500;
+        if (_stillMs >= 3000)
+        {
+            _stillMs = 0;
+            WcmeAddStack(player, buff);
+        }
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_stand_still::CalcPeriod, EFFECT_0, SPELL_AURA_ANY);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_stand_still::Tick, EFFECT_0, SPELL_AURA_ANY);
+    }
+
+    uint32 _stillMs = 0;
+};
