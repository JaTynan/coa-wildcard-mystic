+// Edge of Fury (986234): Heroic Strike shows as Spiteful Strike (986236) and Revenge as Blind Revenge (986240)
+// (WcmeSyncSwap). Blind Rage: 500 maximum rage (wcme_rage_cap), and Backstab hits give 100 rage and make Blind Revenge
+// usable (986237, spell_wcme_blind_revenge). While you have Edge of Fury stacks (986235), Killing Spree hits deal 12%
+// more per stack to monsters (its data's own modifiers use Ascension modifier types our core does not have);
+// spell_wcme_edge_killing_spree spends the stacks when the spree ends.
+class spell_wcme_edge_of_fury : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_edge_of_fury);
+
+    static constexpr uint32 SPITEFUL_STRIKE = 986236;
+    static constexpr uint32 BLIND_REVENGE = 986240;
+    static constexpr uint32 HUNGRY = 986237;
+    static constexpr uint32 EDGE = 986235;
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Heroic Strike", SPELLFAMILY_WARRIOR, SPITEFUL_STRIKE, active);
+        WcmeSyncSwap(owner, "Revenge", SPELLFAMILY_WARRIOR, BLIND_REVENGE, active);
+        if (Player* player = owner->ToPlayer())
+            player->UpdateMaxPower(POWER_RAGE);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!spell || !target || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (WcmeNamed(spell, "Backstab"))
+            return true;
+        return WcmeNamed(spell, "Killing Spree") && spell->SpellFamilyName == SPELLFAMILY_ROGUE && !target->IsControlledByPlayer() &&
+            GetTarget()->HasAura(EDGE);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Backstab"))
+        {
+            owner->EnergizeBySpell(owner, GetId(), 1000, POWER_RAGE);
+            owner->AddAura(HUNGRY, owner);
+            return;
+        }
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        WcmeExtraDamage(owner, eventInfo.GetActionTarget(), spell,
+            int64(damage->GetDamage() + damage->GetAbsorb()) * 12 * owner->GetAuraCount(EDGE) / 100);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_edge_of_fury::HandleApply, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_edge_of_fury::HandleRemove, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_edge_of_fury::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_edge_of_fury::HandleProc);
+    }
+};
