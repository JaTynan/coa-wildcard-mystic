+// Blood and Guts (977906; its Execute explosion comes from twin 273885 through the core's enchant procs): Mutilate hits
+// on a target bleeding from your Disembowel also deal Mutilating Disembowel (977907). Execute on a Disemboweled target
+// consumes Disembowel (just after the twin's explosion has seen it), and the Remorseless buff the explosion grants is
+// taken away again unless you know Remorseless Attacks.
+class spell_wcme_blood_and_guts : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_blood_and_guts);
+
+    static constexpr uint32 MUTILATING = 977907;
+
+    static Aura* MyDisembowel(Unit* target, Unit* owner)
+    {
+        for (AuraEffect const* dot : target->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+            if (dot->GetCasterGUID() == owner->GetGUID() && WcmeNamed(dot->GetSpellInfo(), "Disembowel"))
+                return dot->GetBase();
+        return nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return target && WcmeDealtDamage(eventInfo) && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeNamedAny(eventInfo.GetSpellInfo(), { "Mutilate", "Execute" }) && MyDisembowel(target, GetTarget());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (WcmeNamed(eventInfo.GetSpellInfo(), "Mutilate"))
+        {
+            owner->CastSpell(target, MUTILATING, true);
+            return;
+        }
+        ObjectGuid const targetGuid = target->GetGUID();
+        owner->m_Events.AddEventAtOffset([owner, targetGuid]()
+        {
+            if (Unit* bleeding = ObjectAccessor::GetUnit(*owner, targetGuid))
+                if (Aura* disembowel = MyDisembowel(bleeding, owner))
+                    disembowel->Remove();
+            if (!WcmeHasAnyAura(owner, { 14144, 14148, 914144, 914148, 1114144, 1114148, 1214144, 1214148, 1314148 }))
+            {
+                owner->RemoveAurasDueToSpell(14143);
+                owner->RemoveAurasDueToSpell(14149);
+            }
+        }, 200ms);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_blood_and_guts::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_blood_and_guts::HandleProc);
+    }
+};
