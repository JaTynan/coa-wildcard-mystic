+// Snowblind (990055): teaches Ice Prism (990056: a Frost DoT that makes your Holy spells crit and hit 10% harder on
+// the target). Cone of Cold or Frostbolt damage on a target with your Ice Prism refreshes it and spreads it to 5
+// enemies within 8 yards. Holy critical strikes on a target with your Ice Prism shatter it: Ice Prism Shatter (990057)
+// hits up to 5 enemies within 8 yards for your Cone of Cold's damage, with a 50% chance to grant Surge of Light (33151)
+// if you know it, at most once every 2 sec.
+class spell_wcme_snowblind : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_snowblind);
+
+    static constexpr uint32 PRISM = 990056;
+    static constexpr uint32 SHATTER = 990057;
+    static constexpr uint32 SURGE = 33151;
+    static constexpr std::array<uint32, 8> CONE_OF_COLD = { 42931, 42930, 27087, 10161, 10160, 10159, 8492, 120 };
+    uint32 _nextSurge = 0;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!spell || !target || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || !WcmeDealtDamage(eventInfo) ||
+            !target->GetAura(PRISM, GetTarget()->GetGUID()))
+            return false;
+        if (WcmeNamedAny(spell, { "Cone of Cold", "Frostbolt" }))
+            return true;
+        return spell->Id != SHATTER && (spell->GetSchoolMask() & SPELL_SCHOOL_MASK_HOLY) && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL);
+    }
+
+    int32 ConeOfColdDamage(Unit* owner, Unit* target) const
+    {
+        Player* player = owner->ToPlayer();
+        for (uint32 rank : CONE_OF_COLD)
+            if (player && player->HasSpell(rank))
+                if (SpellInfo const* cone = sSpellMgr->GetSpellInfo(rank))
+                    return int32(owner->SpellDamageBonusDone(target, cone, uint32(std::max(0, cone->Effects[EFFECT_0].CalcValue(owner))),
+                        SPELL_DIRECT_DAMAGE, EFFECT_0));
+        return 0;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (WcmeNamedAny(eventInfo.GetSpellInfo(), { "Cone of Cold", "Frostbolt" }))
+        {
+            if (Aura* prism = target->GetAura(PRISM, owner->GetGUID()))
+                prism->RefreshDuration();
+            for (Unit* enemy : WcmeEnemiesNear(owner, target, 8.0f, 6))
+                if (enemy != target)
+                    owner->CastSpell(enemy, PRISM, true);
+            return;
+        }
+        target->RemoveAura(PRISM, owner->GetGUID());
+        int32 const damage = ConeOfColdDamage(owner, target);
+        if (damage > 0)
+            for (Unit* enemy : WcmeEnemiesNear(owner, target, 8.0f, 5))
+                owner->CastCustomSpell(enemy, SHATTER, &damage, nullptr, nullptr, true);
+        uint32 const now = GameTime::GetGameTimeMS().count();
+        if (now >= _nextSurge && WcmeHasAnyAura(owner, { 33150, 33154, 233150, 233154, 281302 }) && roll_chance_i(50))
+        {
+            owner->CastSpell(owner, SURGE, true);
+            _nextSurge = now + 2000;
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_snowblind::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_snowblind::HandleProc);
+    }
+};
