+// Titanic Mutilate (954067): dealing damage with Whirlwind triggers Bloodrage if you know it, once per Whirlwind;
+// that Enrage does not grant a rage charge (Raging Blow).
+class spell_wcme_titanic_mutilate : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_titanic_mutilate);
+
+    static constexpr uint32 BLOODRAGE = 2687;
+    static constexpr uint32 RAGE_CHARGE = 954881;
+    Spell const* _lastWhirlwind = nullptr;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Player* player = GetTarget()->ToPlayer();
+        if (!player || !WcmeNamed(eventInfo.GetSpellInfo(), "Whirlwind") || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (!player->HasSpell(2687) && !player->HasSpell(1102687) && !player->HasSpell(1569252) && !player->HasSpell(1569254))
+            return false;
+        return eventInfo.GetProcSpell() != _lastWhirlwind;   // one Bloodrage per Whirlwind, not per target hit
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        _lastWhirlwind = eventInfo.GetProcSpell();
+        Unit* owner = GetTarget();
+        Aura* charges = owner->GetAura(RAGE_CHARGE);
+        uint8 const before = charges ? charges->GetStackAmount() : 0;
+        owner->CastSpell(owner, BLOODRAGE, true);
+        if (Aura* after = owner->GetAura(RAGE_CHARGE))
+            if (after->GetStackAmount() > before)
+            {
+                if (before)
+                    after->SetStackAmount(before);
+                else
+                    owner->RemoveAura(after);
+            }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_titanic_mutilate::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_titanic_mutilate::HandleProc);
+    }
+};
