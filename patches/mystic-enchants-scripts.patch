+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        if (SpellInfo const* helper = sSpellMgr->GetSpellInfo(CRIT_HELPER))
+        {
+            SpellEffectInfo& rating = const_cast<SpellInfo*>(helper)->Effects[EFFECT_0];
+            if (rating.ApplyAuraName == SPELL_AURA_MOD_RATING_FROM_STAT)
+            {
+                rating.BasePoints = 49;
+                rating.DieSides = 1;
+                rating.MiscValueB = STAT_INTELLECT;
+            }
+        }
+        return true;
+    }
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
