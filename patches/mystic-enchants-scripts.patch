+// Ambidextrous (977771): with Single-Minded Fury, off-hand auto attacks trigger Dominant Strike (main hand);
+// Bloodthirst, Execute and Rend trigger Southpaw Strike (off hand). Each has its own 16 sec cooldown.
+class spell_wcme_ambidextrous : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_ambidextrous);
+
+    static constexpr uint32 DOMINANT_STRIKE = 977774;
+    static constexpr uint32 SOUTHPAW_STRIKE = 977775;
+    static constexpr Seconds COOLDOWN{16};
+    TimePoint _mainReady{};
+    TimePoint _offReady{};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return target && target != GetTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        TimePoint const now = GameTime::Now();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell)
+        {
+            if (eventInfo.GetDamageInfo()->GetAttackType() == OFF_ATTACK && WcmeHasAnyAura(owner, { 988256, 1988256 }) &&
+                now >= _mainReady)
+            {
+                _mainReady = now + COOLDOWN;
+                owner->CastSpell(target, DOMINANT_STRIKE, true);
+            }
+            return;
+        }
+        if (WcmeNamedAny(spell, { "Bloodthirst", "Execute", "Rend" }) && now >= _offReady)
+        {
+            _offReady = now + COOLDOWN;
+            owner->CastSpell(target, SOUTHPAW_STRIKE, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_ambidextrous::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_ambidextrous::HandleProc);
+    }
+};
