+// Panache (92789 ranks): shortens your active Stagger by 0.6 sec per combo point spent (its data's trigger is not used).
+class spell_wcme_panache : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_panache);
+
+    uint8 _combo = 0;
+
+    void HandleBeforeCast()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        _combo = player ? player->GetComboPoints() : 0;
+    }
+
+    void PreventTrigger(SpellEffIndex effIndex) { PreventHitDefaultEffect(effIndex); }
+
+    void HandleAfterCast()
+    {
+        Unit* caster = GetCaster();
+        if (!_combo)
+            return;
+        for (auto const& [id, application] : caster->GetAppliedAuras())
+        {
+            Aura* aura = application->GetBase();
+            if (WcmeNamed(aura->GetSpellInfo(), "Stagger") && aura->GetDuration() > 0)
+                aura->SetDuration(std::max(1, aura->GetDuration() - 600 * _combo));
+        }
+    }
+
+    void Register() override
+    {
+        BeforeCast += SpellCastFn(spell_wcme_panache::HandleBeforeCast);
+        OnEffectHit += SpellEffectFn(spell_wcme_panache::PreventTrigger, EFFECT_2, SPELL_EFFECT_TRIGGER_SPELL_WITH_VALUE);
+        OnEffectHitTarget += SpellEffectFn(spell_wcme_panache::PreventTrigger, EFFECT_2, SPELL_EFFECT_TRIGGER_SPELL_WITH_VALUE);
+        AfterCast += SpellCastFn(spell_wcme_panache::HandleAfterCast);
+    }
+};
