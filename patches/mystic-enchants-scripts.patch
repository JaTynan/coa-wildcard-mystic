+            if (auto charges = WcmeFrozenBladeCharges.find(owner->GetGUID()); charges != WcmeFrozenBladeCharges.end() && charges->second)
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * 125 / 100);
+                if (--charges->second == 0)
+                    WcmeFrozenBladeCharges.erase(charges);
+            }
+            if (crit && slice)
+                owner->CastSpell(target, ICE_LANCE, true);
+            if (WcmeNamed(spell, "Eviscerate") && FrozenBlade(owner) && roll_chance_i(20 * _combo))
+            {
+                WcmeFingersAllowedUntil[owner->GetGUID()] = GameTime::Now() + 500ms;
+                owner->CastSpell(owner, 74396, true);
+                owner->CastSpell(owner, 44544, true);
+            }
+            return;
+        }
+        if (spell->Id == ICE_SPEAR || std::find(WINDS.begin(), WINDS.end(), spell->Id) != WINDS.end())
+        {
+            WcmeAddStackOn(owner, owner, HOWL);
+            if (spell->Id != ICE_SPEAR && FrozenBlade(owner) && roll_chance_i(20 * _combo))
+                WcmeFrozenBladeCharges[owner->GetGUID()] = 5;
+            return;
+        }
+        if (crit && WcmeNamed(spell, "Ice Lance") && spell->SpellFamilyName == SPELLFAMILY_MAGE)
+            owner->EnergizeBySpell(owner, GetId(), 10, POWER_ENERGY);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_white_walker::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_white_walker::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_white_walker::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_white_walker::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_white_walker::CheckProc);
