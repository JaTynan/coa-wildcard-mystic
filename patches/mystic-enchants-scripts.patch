+// Aegis Overdrive (299160): dodging, parrying or blocking with Mana Shield up has a 20% chance (its helper 299162) to
+// set off Aegis Explosion (299163), at most once every 5 sec. The explosions on Mana Shield going up and ending are in
+// wcme_epic_batch67_hooks.
+class spell_wcme_aegis_overdrive : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_aegis_overdrive);
+
+    bool CheckProc(ProcEventInfo& /*eventInfo*/)
+    {
+        Unit* owner = GetTarget();
+        if (!WcmeHasAuraNamed(owner, "Mana Shield", SPELLFAMILY_MAGE))
+            return false;
+        auto ready = WcmeAegisReady.find(owner->GetGUID());
