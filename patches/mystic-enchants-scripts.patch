+        Unit* owner = GetTarget();
+        Unit* pet = Pet();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            // combo points are still on the caster during the cast phase
+            if (uint8 const points = owner->GetComboPoints(); points && roll_chance_i(20 * points))
+            {
