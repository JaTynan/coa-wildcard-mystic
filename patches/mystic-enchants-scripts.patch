+// Low Tide (81404): a critical Healing Wave on an ally spreads your Riptide (the highest rank you know) to another hurt
+// party or raid member within 20 yards who doesn't have it. The +20% crit on Riptide targets and Riptide's periodic
+// crits are in the spell data.
+class spell_wcme_low_tide : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_low_tide);
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return heal && heal->GetHeal() > 0 && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) && eventInfo.GetActionTarget() &&
+            WcmeNamed(eventInfo.GetSpellInfo(), "Healing Wave");
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Player* player = GetTarget()->ToPlayer();
+        Unit* healed = eventInfo.GetActionTarget();
+        if (!player)
+            return;
+        uint32 riptide = 0;
+        for (auto const& [spellId, known] : player->GetSpellMap())
+            if (known->State != PLAYERSPELL_REMOVED && known->Active)
+                if (SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId); WcmeNamed(info, "Riptide") && !info->IsPassive())
+                    if (!riptide || info->SpellLevel > sSpellMgr->GetSpellInfo(riptide)->SpellLevel)
+                        riptide = spellId;
+        if (!riptide)
+            return;
+        std::list<Unit*> party;
+        player->GetPartyMembers(party);
+        Unit* best = nullptr;
+        for (Unit* ally : party)
+            if (ally != healed && ally->IsAlive() && ally->IsWithinDistInMap(healed, 20.0f) && !ally->HasAura(riptide, player->GetGUID()) &&
+                (!best || ally->GetHealthPct() < best->GetHealthPct()))
+                best = ally;
+        if (best)
+            player->CastSpell(best, riptide, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_low_tide::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_low_tide::HandleProc);
+    }
+};
