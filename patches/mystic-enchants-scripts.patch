+// Stormborn (977991): while Elemental Mastery or Shamanistic Rage is active, Stormstrike also sends a cone of Nature
+// damage (977992) ahead of you. Lightning Shield damage takes 10 sec off Elemental Mastery's cooldown, and Lightning
+// Bolt or Chain Lightning cast with 3 or more Maelstrom Weapon stacks takes 6 more off. (Stormstrike's cooldown cut and
+// Lightning Shield's damage bonus are already in the spell data.)
+class spell_wcme_stormborn : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_stormborn);
+
+    static constexpr uint32 CONE = 977992;
+
+    static bool Empowered(Unit const* unit)
+    {
+        return WcmeHasAnyAura(unit, { 16166, 64701, 1116166, 1164701, 1216166, 1264701, 30823, 1130823, 1230823 });
+    }
+
+    static uint8 Maelstrom(Unit const* unit)
+    {
+        uint8 best = 0;
+        for (uint32 id : { 53817u, 853817u, 853818u })
+            if (Aura const* aura = unit->GetAura(id))
+                best = std::max(best, aura->GetStackAmount());
+        return best;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) && spell->Id != CONE &&
+            WcmeNamedAny(spell, { "Stormstrike", "Lightning Shield", "Lightning Bolt", "Chain Lightning" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const cast = eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST;
+        if (WcmeNamed(spell, "Stormstrike"))
+        {
+            Spell const* procSpell = eventInfo.GetProcSpell();
+            if (cast && Empowered(owner) && procSpell && !procSpell->IsTriggered())
+                owner->CastSpell(owner, CONE, true);
+            return;
+        }
+        if (WcmeNamed(spell, "Lightning Shield"))
+        {
+            if (!cast && WcmeDealtDamage(eventInfo))
+                WcmeCutCooldownByName(owner, "Elemental Mastery", 10000);
+            return;
+        }
+        if (cast && Maelstrom(owner) >= 3 && eventInfo.GetProcSpell() && !eventInfo.GetProcSpell()->IsTriggered())
+            WcmeCutCooldownByName(owner, "Elemental Mastery", 6000);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_stormborn::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_stormborn::HandleProc);
+    }
+};
