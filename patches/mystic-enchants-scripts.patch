+// Hydromancer: Water Bolt (1569697): Lightning Bolt or Chain Lightning damage on a target you Doused (954376) causes
+// Electrocute: 169 + 12% SP + 7.8% AP Nature damage (the builder tooltip's numbers) and a 2 sec incapacitate (954387),
+// which the same target can only suffer once every 6 sec.
+class spell_wcme_doused : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_doused);
+
+    static constexpr uint32 DOUSED = 954376;
+    static constexpr uint32 ELECTROCUTE = 954385;
+    static constexpr uint32 INCAPACITATE = 954387;
+    std::unordered_map<ObjectGuid, TimePoint> _incapReady;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* target = eventInfo.GetActionTarget();
+        return target && target != GetTarget() && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) && WcmeDealtDamage(eventInfo) &&
+            WcmeNamedAny(eventInfo.GetSpellInfo(), { "Lightning Bolt", "Chain Lightning" }) && target->HasAura(DOUSED, GetTarget()->GetGUID());
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (SpellInfo const* shock = sSpellMgr->GetSpellInfo(ELECTROCUTE))
+            WcmeExtraDamage(owner, target, shock, int64(169 + 0.12f * WcmeSpellPower(owner) + 0.078f * WcmeAttackPower(owner)));
+        TimePoint const now = GameTime::Now();
+        TimePoint& ready = _incapReady[target->GetGUID()];
+        if (now < ready || !target->IsAlive())
+            return;
+        ready = now + Seconds(6);
+        owner->CastSpell(target, INCAPACITATE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_doused::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_doused::HandleProc);
+    }
+};
