+
+    bool _fast = false;
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& /*isPeriodic*/, int32& amplitude)
+    {
+        if (Unit* caster = GetCaster())
+            if (WcmeFastSpree.count(caster->GetGUID()))
+            {
+                _fast = true;
+                amplitude = std::max(100, amplitude / 2);
+            }
