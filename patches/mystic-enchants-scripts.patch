+// Blademaster (965862): parrying an attack, or a melee ability critical strike (at most once every 8 sec), adds a stack
+// of Study the Blade; 3 stacks become Blademaster.
+class spell_wcme_blademaster : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_blademaster);
+
+    static constexpr Seconds CRIT_RATE{8};
+    TimePoint _critReady{};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        if (eventInfo.GetActionTarget() == owner)
+            return (eventInfo.GetHitMask() & PROC_HIT_PARRY) != 0;
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->DmgClass == SPELL_DAMAGE_CLASS_MELEE && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) &&
+            GameTime::Now() >= _critReady;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetActionTarget() != owner)
+            _critReady = GameTime::Now() + CRIT_RATE;
+        if (WcmeAddStacks(owner, 990042, 1, 3))
+            owner->CastSpell(owner, 965863, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_blademaster::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_blademaster::HandleProc);
+    }
+};
