+// Blood and Guts (977906; its Execute explosion comes from twin 273885 through the core's enchant procs): Mutilate hits
+// on a target bleeding from your Disembowel also deal Mutilating Disembowel (977907). Execute on a Disemboweled target
+// consumes Disembowel (just after the twin's explosion has seen it), and the Remorseless buff the explosion grants is
+// taken away again unless you know Remorseless Attacks.
+class spell_wcme_blood_and_guts : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_blood_and_guts);
+
+    static constexpr uint32 MUTILATING = 977907;
+
+    static Aura* MyDisembowel(Unit* target, Unit* owner)
+    {
+        for (AuraEffect const* dot : target->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+            if (dot->GetCasterGUID() == owner->GetGUID() && WcmeNamed(dot->GetSpellInfo(), "Disembowel"))
+                return dot->GetBase();
+        return nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
