+bool WcmeHasAuraNamed(Unit const* unit, char const* name, uint32 family)
+{
+    for (auto const& [id, application] : unit->GetAppliedAuras())
+        if (SpellInfo const* info = application->GetBase()->GetSpellInfo())
+            if (info->SpellFamilyName == family && WcmeNamed(info, name))
+                return true;
+    return false;
+}
+
+bool WcmeHasAuraNamedFrom(Unit const* unit, Unit const* caster, char const* name)
+{
+    for (auto const& [id, application] : unit->GetAppliedAuras())
+        if (application->GetBase()->GetCasterGUID() == caster->GetGUID() && WcmeNamed(application->GetBase()->GetSpellInfo(), name))
+            return true;
+    return false;
+}
+
+bool WcmeInBearForm(Unit const* unit)
+{
+    return unit->GetShapeshiftForm() == FORM_BEAR || unit->GetShapeshiftForm() == FORM_DIREBEAR;
+}
