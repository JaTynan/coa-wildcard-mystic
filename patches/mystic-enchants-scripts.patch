+// Disciple of Arugal (982980): Arcane Missiles shows as Shadow Missiles (982981, WcmeSyncSwap); its ticks taint the
+// target through their own data. Shadow Bolt hits taint the target (983007) and give Arugal's Fury (997422, 10
+// charges), and, if you know Missile Barrage at rank 3 or higher, have a 30% chance (+4% per Lessons in Shadow stack)
+// to trigger Missile Barrage (44401), which spends the Lessons. Unstable Affliction, Curse of Agony and Shadow Bolt
+// damage has a 40% chance (the buff's own data) to add a Lessons in Shadow stack (997417, up to 25). Tainted charges are
+// spent by wcme_kit_damage_hooks, which also keeps Arugal's Fury at +10% against players; Curse of Agony haste by
+// spell_wcme_arugal_curse_haste.
+class spell_wcme_disciple_of_arugal : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_disciple_of_arugal);
+
+    static constexpr uint32 SHADOW_MISSILES = 982981;
+    static constexpr uint32 TAINTED = 983007;
+    static constexpr uint32 FURY = 997422;
+    static constexpr uint32 LESSONS = 997417;
+    static constexpr uint32 BARRAGE = 44401;
+
+    void Sync(bool active) { WcmeSyncSwap(GetTarget(), "Arcane Missiles", SPELLFAMILY_MAGE, SHADOW_MISSILES, active); }
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    static bool KnowsBarrage(Unit const* unit)
+    {
+        Player const* player = unit->ToPlayer();
+        if (!player)
+            return false;
+        for (uint32 rank : { 54488u, 54489u, 54490u, 1154488u, 1154489u, 1154490u })
+            if (player->HasSpell(rank))
+                return true;
+        return false;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->SpellFamilyName == SPELLFAMILY_WARLOCK && eventInfo.GetActionTarget() &&
+            WcmeDealtDamage(eventInfo) && WcmeNamedAny(spell, { "Shadow Bolt", "Unstable Affliction", "Curse of Agony" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const shadowBolt = WcmeNamed(spell, "Shadow Bolt") && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK);
+        if (shadowBolt)
+        {
+            owner->CastSpell(target, TAINTED, true);
+            owner->CastSpell(owner, FURY, true);
+            if (KnowsBarrage(owner) && roll_chance_i(30 + 4 * int32(owner->GetAuraCount(LESSONS))))
+            {
+                owner->CastSpell(owner, BARRAGE, true);
+                owner->RemoveAurasDueToSpell(LESSONS);
+                return;
+            }
+        }
+        if (roll_chance_i(40))
+            WcmeAddStackOn(owner, owner, LESSONS);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_disciple_of_arugal::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_disciple_of_arugal::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_disciple_of_arugal::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_disciple_of_arugal::HandleProc);
+    }
+};
