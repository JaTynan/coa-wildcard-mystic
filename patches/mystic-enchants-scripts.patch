+// Astral Bomber (978235): Starfire shows as Astral Flare (908945) and Starsurge as Astral Plasma (983758) (WcmeSyncSwap:
+// the core does not swap them, the names differ). With Eclipse at rank 3, your Fireball and Fire Blast hits trigger
+// Eclipse (Lunar) (48518) when no Eclipse is up, at most once every 30 sec. Astral Flare crits give Astral Fusion
+// (983769, up to 3); a crit while you have it also finishes Astral Plasma's cooldown and adds a stack of Astral Strike
+// (300146, up to 3: the next Astral Plasma is instant and deals 50% more per stack, the data's own mods), which that
+// Astral Plasma spends. Fireball and Pyroblast casts during Eclipse (Solar) give Lunar Bomber (978874, up to 3); Astral
+// Flare and Astral Plasma casts during Eclipse (Lunar) give Solar Bomber (978858, up to 3). With Lunar Bomber, Astral
+// Flare and Astral Plasma hits add Lunar Flames (978875, up to 3: those two deal 8% more per Flames stack per Lunar
+// Bomber stack, 72% at 3 and 3); with Solar Bomber, Fireball and Pyroblast hits add Solar Flames (978860: 9% per stack
+// of each, 81% at 3 and 3).
+class spell_wcme_astral_bomber : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_astral_bomber);
+
+    static constexpr uint32 ASTRAL_FLARE = 908945;
+    static constexpr uint32 ASTRAL_PLASMA = 983758;
+    static constexpr uint32 ECLIPSE_SOLAR = 48517;
+    static constexpr uint32 ECLIPSE_LUNAR = 48518;
+    static constexpr uint32 FUSION = 983769;
+    static constexpr uint32 ASTRAL_STRIKE = 300146;
+    static constexpr uint32 LUNAR_BOMBER = 978874;
+    static constexpr uint32 LUNAR_FLAMES = 978875;
+    static constexpr uint32 SOLAR_BOMBER = 978858;
+    static constexpr uint32 SOLAR_FLAMES = 978860;
+    static constexpr Seconds LUNAR_COOLDOWN{30};
+    TimePoint _lunarReady{};
+
+    void Sync(bool active)
+    {
+        WcmeSyncSwap(GetTarget(), "Starfire", SPELLFAMILY_DRUID, ASTRAL_FLARE, active);
+        WcmeSyncSwap(GetTarget(), "Starsurge", SPELLFAMILY_DRUID, ASTRAL_PLASMA, active);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    static void AddStack(Unit* owner, uint32 spellId)
+    {
+        Aura* aura = owner->GetAura(spellId);
+        if (!aura)
+        {
+            owner->AddAura(spellId, owner);
+            return;
+        }
+        if (aura->GetStackAmount() < aura->GetSpellInfo()->StackAmount)
+            aura->SetStackAmount(aura->GetStackAmount() + 1);
+        aura->RefreshDuration();
+    }
+
+    static void Flames(Unit* owner, uint32 flamesId, uint32 bomberId, int32 perStack)
+    {
+        AddStack(owner, flamesId);
+        if (Aura* flames = owner->GetAura(flamesId))
+            if (AuraEffect* bonus = flames->GetEffect(EFFECT_0))
+                bonus->ChangeAmount(perStack * int32(owner->GetAuraCount(bomberId)) * flames->GetStackAmount());
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        bool const astral = spell->Id == ASTRAL_FLARE || spell->Id == ASTRAL_PLASMA;
+        bool const fire = WcmeNamedAny(spell, { "Fireball", "Pyroblast", "Fire Blast" }) && spell->SpellFamilyName == SPELLFAMILY_MAGE;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return astral || fire;
+        return (astral || fire) && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const astral = spell->Id == ASTRAL_FLARE || spell->Id == ASTRAL_PLASMA;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (spell->Id == ASTRAL_PLASMA)
+                owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(ASTRAL_STRIKE); }, 500ms);
+            if (astral && owner->HasAura(ECLIPSE_LUNAR))
+                AddStack(owner, SOLAR_BOMBER);
+            else if (!astral && !WcmeNamed(spell, "Fire Blast") && owner->HasAura(ECLIPSE_SOLAR))
+                AddStack(owner, LUNAR_BOMBER);
+            return;
+        }
+        bool const crit = eventInfo.GetHitMask() & PROC_HIT_CRITICAL;
+        if (astral)
+        {
+            if (owner->HasAura(LUNAR_BOMBER))
+                Flames(owner, LUNAR_FLAMES, LUNAR_BOMBER, 8);
+            if (spell->Id == ASTRAL_FLARE && crit)
+            {
+                if (owner->HasAura(FUSION))
+                {
+                    WcmeCutCooldownByName(owner, "Astral Plasma", 3600000);
+                    AddStack(owner, ASTRAL_STRIKE);
+                }
+                AddStack(owner, FUSION);
+            }
+            return;
+        }
+        if (!WcmeNamed(spell, "Fire Blast") && owner->HasAura(SOLAR_BOMBER))
+            Flames(owner, SOLAR_FLAMES, SOLAR_BOMBER, 9);
+        if (WcmeNamedAny(spell, { "Fireball", "Fire Blast" }) && WcmeHasAnyAura(owner, { 48525, 1148525, 1248525 }) &&
+            !owner->HasAura(ECLIPSE_SOLAR) && !owner->HasAura(ECLIPSE_LUNAR) && GameTime::Now() >= _lunarReady)
+        {
+            _lunarReady = GameTime::Now() + LUNAR_COOLDOWN;
+            owner->CastSpell(owner, ECLIPSE_LUNAR, true);
+        }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_astral_bomber::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_astral_bomber::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_astral_bomber::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_astral_bomber::HandleProc);
+    }
+};
