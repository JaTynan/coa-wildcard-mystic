+// Crusader Strike shows as Crusader's Justice (985972) only while Righteous Justice is up (the core does not swap it:
+// the names differ).
+void WcmeSyncCrusadersJustice(Unit* unit)
+{
+    WcmeSyncSwap(unit, "Crusader Strike", SPELLFAMILY_PALADIN, 985972, unit->HasAura(985957) && unit->HasAura(986000));
+}
