+    static constexpr std::array<uint32, 9> HAMMER = { 92786, 93929, 93930, 93931, 93932, 93933, 93934, 93935, 93936 };
+    static constexpr std::array<uint32, 12> PANACHE = { 92789, 92790, 92791, 92792, 92793, 92794, 92795, 92796, 92797, 92798, 92799, 92800 };
+    static constexpr std::array<uint32, 2> BLURRED = { 92787, 92788 };
+    static constexpr uint32 RESOLVE = 300110;
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 250;
+    }
+
+    static bool Swashbuckling(Unit const* unit)
+    {
+        Player const* player = unit->ToPlayer();
+        if (!player)
+            return false;
+        Item const* main = player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND);
+        uint32 const type = main ? main->GetTemplate()->InventoryType : 0;
+        return (type == INVTYPE_WEAPON || type == INVTYPE_WEAPONMAINHAND) && !player->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_OFFHAND);
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwapRanked(owner, "Devastate", SPELLFAMILY_WARRIOR, HAMMER, active);
+        WcmeSyncSwapRanked(owner, "Eviscerate", SPELLFAMILY_ROGUE, PANACHE, active);
+        WcmeSyncSwapRanked(owner, "Slice and Dice", SPELLFAMILY_ROGUE, BLURRED, active);
+        if (!active)
+            owner->RemoveAurasDueToSpell(RESOLVE);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        if (auto end = WcmeBlurredBladeEnd.find(owner->GetGUID()); end != WcmeBlurredBladeEnd.end())
+        {
+            Aura* blade = nullptr;
+            for (uint32 rank : BLURRED)
+                if ((blade = owner->GetAura(rank)))
+                    break;
+            if (!blade)
+                WcmeBlurredBladeEnd.erase(end);
+            else
+            {
+                int32 const left = int32(std::chrono::duration_cast<Milliseconds>(end->second - GameTime::Now()).count());
+                if (blade->GetDuration() > left + 300)
+                    blade->SetDuration(std::max(1, left));
+            }
+        }
+        bool const wanted = Swashbuckling(owner) && owner->GetShapeshiftForm() == FORM_DEFENSIVESTANCE;
+        if (wanted && !owner->HasAura(RESOLVE))
+            owner->AddAura(RESOLVE, owner);
+        else if (!wanted && owner->HasAura(RESOLVE))
+            owner->RemoveAurasDueToSpell(RESOLVE);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && spell->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeNamed(spell, "Mocking Blow");
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        GetTarget()->CastSpell(GetTarget(), 92785, true);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_swashbuckler::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_swashbuckler::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_swashbuckler::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_swashbuckler::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_swashbuckler::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_swashbuckler::HandleProc);
+    }
+};
