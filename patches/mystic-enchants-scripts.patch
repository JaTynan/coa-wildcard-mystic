+// Wraithweaver: Shadow Orbs (1544910; its own orb effects use effect 188, which the core does not handle): each tick of
+// your Shadow Word: Pain, Devouring Plague or Vampiric Touch has a 20% chance to give a Shadow Orb (1544913, up to 3:
+// Mind Blast +10% per orb, the data's own spell mod). A Mind Blast hit with 3 orbs spends them and sends a Shadowy
+// Apparition (1544915) that reaches the target 1 sec later and deals 320 (at level 60) + 32% SP Shadow damage to every
+// enemy within 5 yards of it.
+class spell_wcme_shadow_orbs : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_shadow_orbs);
+
+    static constexpr uint32 ORB = 1544913;
+    static constexpr uint32 APPARITION = 1544915;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo))
+            return false;
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+            return WcmeNamedAny(spell, { "Shadow Word: Pain", "Devouring Plague", "Vampiric Touch" });
+        return WcmeNamed(spell, "Mind Blast") && GetTarget()->GetAuraCount(ORB) >= 3;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+        {
+            if (!roll_chance_i(20))
+                return;
+            if (Aura* orb = owner->GetAura(ORB))
+            {
+                if (orb->GetStackAmount() < orb->GetSpellInfo()->StackAmount)
+                    orb->SetStackAmount(orb->GetStackAmount() + 1);
+                orb->RefreshDuration();
+            }
+            else
+                owner->AddAura(ORB, owner);
+            return;
+        }
+        owner->RemoveAurasDueToSpell(ORB);
+        ObjectGuid const targetGuid = eventInfo.GetActionTarget()->GetGUID();
+        int64 const damage = int64(320.0f * owner->GetLevel() / 60.0f + 0.32f * WcmeSpellPower(owner));
+        owner->m_Events.AddEventAtOffset([owner, targetGuid, damage]()
+        {
+            SpellInfo const* apparition = sSpellMgr->GetSpellInfo(APPARITION);
+            Unit* target = ObjectAccessor::GetUnit(*owner, targetGuid);
+            if (!apparition || !target || !owner->IsInWorld())
+                return;
+            for (Unit* enemy : WcmeEnemiesNear(owner, target, 5.0f, 50))
+                WcmeExtraDamage(owner, enemy, apparition, damage);
+        }, 1s);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_shadow_orbs::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_shadow_orbs::HandleProc);
+    }
+};
