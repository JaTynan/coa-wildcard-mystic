+        if (!WcmeAddStacks(owner, 990042, 1, 3))
+            return;
+        owner->CastCustomSpell(965863, SPELLVALUE_BASE_POINT0, 25, owner, true);
+        for (uint32 empowered : { 965864u, 965866u, 965868u })   // Devastate, Divine Storm, Riposte
+            owner->CastSpell(owner, empowered, true);
+    }
+
+    void Register() override
+    {
