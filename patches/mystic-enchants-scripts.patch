+// Warden of Demonreach (997113): you cannot get Hot Streak (wcme_kit6_hooks). Pyroblast shows as Fuego (997700); each
+// cast turns it into the other element (Fuego <-> Arctis 997701), whose data grants the opposite boon (Gathering Will
+// 997403 for Fuego, Winter's Mantle 997401 for Arctis). Fireball and Fire Blast also add Gathering Will, Frostbolt and Ice
+// Lance Winter's Mantle. At 4 stacks the boon's next Fuego / Arctis has 60% less cast time and fires a barrage at nearby
+// enemies (997404 / 997405 and Unleashed Fuego / Arctis). Casting Fuego or Arctis spends its boon. Mage Fire and Frost
+// casts have a 30% chance to grant Duality of Winter and Summer (984342): the next Ice Lance or Fire Blast deals 75% more
+// and adds 3 boon stacks. Combustion shows as Starborn (302019): max stacks of both boons (its data) and Fuego / Arctis
+// ready again.
+class spell_wcme_warden_of_demonreach : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_warden_of_demonreach);
+
+    static constexpr uint32 FUEGO = 997700;
+    static constexpr uint32 ARCTIS = 997701;
+    static constexpr uint32 GATHERING_WILL = 997403;
+    static constexpr uint32 WINTERS_MANTLE = 997401;
+    static constexpr uint32 SOUL_FLAMES = 997404;
+    static constexpr uint32 HEART_OF_WINTER = 997405;
+    static constexpr uint32 DUALITY = 984342;
+    static constexpr uint32 STARBORN = 302019;
+    bool _fuegoNext = true;
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Pyroblast", SPELLFAMILY_MAGE, ARCTIS, false);
+        WcmeSyncSwap(owner, "Pyroblast", SPELLFAMILY_MAGE, FUEGO, active);
+        _fuegoNext = true;
+        WcmeSyncSwap(owner, "Combustion", SPELLFAMILY_MAGE, STARBORN, active);
+        if (!active)
+            for (uint32 aura : { GATHERING_WILL, WINTERS_MANTLE, SOUL_FLAMES, HEART_OF_WINTER, DUALITY })
+                owner->RemoveAurasDueToSpell(aura);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    static void AddBoon(Unit* owner, uint32 boon, uint8 count)
+    {
+        for (uint8 i = 0; i < count; ++i)
+            WcmeAddStackOn(owner, owner, boon);
+        uint32 const empowered = boon == GATHERING_WILL ? SOUL_FLAMES : HEART_OF_WINTER;
+        if (owner->GetAuraCount(boon) >= 4 && !owner->HasAura(empowered))
+            owner->AddAura(empowered, owner);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || spell->SpellFamilyName != SPELLFAMILY_MAGE)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return true;
+        return (spell->Id == FUEGO || spell->Id == ARCTIS) && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST))
+        {
+            bool const fuego = spell->Id == FUEGO;
+            uint32 const empowered = fuego ? SOUL_FLAMES : HEART_OF_WINTER;
+            if (!owner->HasAura(empowered))
+                return;
+            owner->RemoveAurasDueToSpell(empowered);
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            int32 const share = int32((damage->GetDamage() + damage->GetAbsorb()) * 20 / 100);
+            for (Unit* enemy : WcmeEnemiesNear(owner, eventInfo.GetActionTarget(), 8.0f, 5))
+                owner->CastCustomSpell(fuego ? 302048 : 302049, SPELLVALUE_BASE_POINT0, std::max(1, share), enemy, true);
+            return;
+        }
+        if (spell->Id == FUEGO || spell->Id == ARCTIS)
+        {
+            bool const fuego = spell->Id == FUEGO;
+            owner->RemoveAurasDueToSpell(fuego ? GATHERING_WILL : WINTERS_MANTLE);
+            _fuegoNext = !fuego;
+            owner->m_Events.AddEventAtOffset([owner, fuego]()
+            {
+                if (!owner->HasAura(997113))
+                    return;
+                WcmeSyncSwap(owner, "Pyroblast", SPELLFAMILY_MAGE, fuego ? FUEGO : ARCTIS, false);
+                WcmeSyncSwap(owner, "Pyroblast", SPELLFAMILY_MAGE, fuego ? ARCTIS : FUEGO, true);
+            }, 100ms);
+            if (owner->GetAuraCount(fuego ? WINTERS_MANTLE : GATHERING_WILL) >= 4)
+                owner->AddAura(fuego ? HEART_OF_WINTER : SOUL_FLAMES, owner);
+            return;
+        }
+        if (spell->Id == STARBORN)
+        {
+            WcmeCutCooldownByName(owner, "Fuego", 3600000);
+            WcmeCutCooldownByName(owner, "Arctis", 3600000);
+            owner->m_Events.AddEventAtOffset([owner]()
+            {
+                for (uint32 boon : { GATHERING_WILL, WINTERS_MANTLE })
+                    AddBoon(owner, boon, 0);
+            }, 200ms);
+            return;
+        }
+        bool const fireBlast = WcmeNamed(spell, "Fire Blast");
+        bool const iceLance = WcmeNamed(spell, "Ice Lance");
+        if (owner->HasAura(DUALITY) && (fireBlast || iceLance))
+        {
+            AddBoon(owner, fireBlast ? GATHERING_WILL : WINTERS_MANTLE, 3);
+            owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(DUALITY); }, 1s);
+        }
+        else if (WcmeNamedAny(spell, { "Fireball", "Fire Blast" }))
+            AddBoon(owner, GATHERING_WILL, 1);
+        else if (WcmeNamedAny(spell, { "Frostbolt", "Ice Lance" }))
+            AddBoon(owner, WINTERS_MANTLE, 1);
+        if ((spell->GetSchoolMask() & (SPELL_SCHOOL_MASK_FIRE | SPELL_SCHOOL_MASK_FROST)) && !owner->HasAura(DUALITY) && roll_chance_i(30))
+            owner->AddAura(DUALITY, owner);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_warden_of_demonreach::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_warden_of_demonreach::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_warden_of_demonreach::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_warden_of_demonreach::HandleProc);
+    }
+};
+
+// White Walker (978202): Slice and Dice shows as Slice and Ice (978302) and Cone of Cold as Winds of Winter (978846
+// ranks). Slice and Ice needs a single two-handed weapon (spell_wcme_white_walker_spell). While Slice and Ice lasts:
+// its crit-rating helper (300159: 50% of Intellect as melee critical strike rating) is on you, spell and ability casts
+// have a 20% chance to grant Winter's Fury (984936: Ice Lance becomes Ice Spear, which always crits), critical Sinister
+// Strikes and Eviscerates cast Ice Lance (984432) at the target, and Winds of Winter can be used. Ice Spear and Winds
+// of Winter add Howl of Winter (979053, +50% on the next Deep Freeze, which spends it). Manual Ice Lance criticals
+// restore 10 energy. Frozen Blade, if you know Fingers of Frost at rank 2 or more: Eviscerate has a 20% chance per combo
+// point to grant Fingers of Frost, and Winds of Winter a 20% chance per combo point to make the next 5 Sinister Strikes
+// or Eviscerates deal 125% more. Fingers of Frost can then only come from Eviscerate (wcme_kit6_hooks removes it from
+// any other source).
+class spell_wcme_white_walker : public AuraScript
