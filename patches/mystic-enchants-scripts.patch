+// Elemental Assassin (978229): Backstab grants Elemental Assassin (978642, up to 2 stacks; its bonus is a dummy in the
+// data). A stack makes your next Flame Shock or Earth Shock deal 110% more direct damage, or Ice Shock 70% more (the
+// builder tooltip's numbers), and spending it takes 5 sec off Stormstrike's cooldown. (The Elemental Blades the
+// tooltip also lists have no usable spells in our client, so they are left out.)
+class spell_wcme_elemental_assassin : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_elemental_assassin);
+
+    static constexpr uint32 ASSASSIN = 978642;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (WcmeNamed(spell, "Backstab"))
+            return eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST;
+        return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_HIT) && WcmeDealtDamage(eventInfo) && GetTarget()->HasAura(ASSASSIN) &&
+            WcmeNamedAny(spell, { "Flame Shock", "Earth Shock", "Ice Shock" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Backstab"))
+        {
+            owner->CastSpell(owner, ASSASSIN, true);
+            if (Aura* stacks = owner->GetAura(ASSASSIN); stacks && stacks->GetStackAmount() > 2)
+                stacks->SetStackAmount(2);
+            return;
+        }
+        if (Aura* stacks = owner->GetAura(ASSASSIN))
+        {
+            if (stacks->GetStackAmount() > 1)
+                stacks->SetStackAmount(stacks->GetStackAmount() - 1);
+            else
+                stacks->Remove();
+        }
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        int32 const pct = WcmeNamed(spell, "Ice Shock") ? 70 : 110;
+        if (Unit* target = eventInfo.GetActionTarget())
+            WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * pct / 100);
+        WcmeCutCooldownByName(owner, "Stormstrike", 5000);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_elemental_assassin::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_elemental_assassin::HandleProc);
+    }
+};
