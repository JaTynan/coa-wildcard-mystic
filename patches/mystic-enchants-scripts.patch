+// Blessing of the Divines (965476): Holy or Nature heals have its 35% chance to cast one of its five blessings at
+// random. Titan (+10% health, -20% damage taken) and Time (+5% haste for you and the ally) work from their own spell
+// data. The other three carry level-1 numbers, so (James: base them on level 60 class abilities) they become:
+// Creation: 5 mana per level, 20 energy and 10 rage for you and your party. Mending: Circle of Healing on the ally (up
+// to 5 party or raid members). The Divines: Renew on the ally and up to 4 of the most hurt party or raid members
+// within 30 yards of them. Spell ranks follow your level, and they heal with your own spell power.
+class spell_wcme_blessing_of_the_divines_random : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_blessing_of_the_divines_random);
+
+    static constexpr std::array<uint32, 8> CIRCLE_OF_HEALING = { 34861, 34862, 34863, 34864, 34865, 34866, 48088, 48089 };
+    static constexpr std::array<uint32, 14> RENEW = { 139, 6074, 6075, 6076, 6077, 6078, 10927, 10928, 10929, 25315, 25221, 25222, 48067, 48068 };
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return heal && heal->GetHeal() > 0 && spell && (spell->GetSchoolMask() & (SPELL_SCHOOL_MASK_HOLY | SPELL_SCHOOL_MASK_NATURE));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || !target->IsAlive())
+            target = owner;
+        switch (urand(0, 4))
+        {
+            case 0: owner->CastSpell(target, 965478, true); break;   // Titan
+            case 1:                                                 // Creation
+            {
+                int32 const mana = 5 * owner->GetLevel(), energy = 20, rage = 100;
+                owner->CastCustomSpell(owner, 965479, &mana, &energy, &rage, true);
+                break;
+            }
+            case 2: owner->CastSpell(target, 965480, true); break;   // Time
+            case 3: owner->CastSpell(target, WcmeRankFor(owner, CIRCLE_OF_HEALING), true); break;   // Mending
+            default:                                                                               // the Divines
+            {
+                std::list<Unit*> party;
+                owner->GetPartyMembers(party);
+                std::vector<Unit*> others;
+                for (Unit* member : party)
+                    if (member != target && member->IsAlive() && member->IsWithinDistInMap(target, 30.0f))
+                        others.push_back(member);
+                std::sort(others.begin(), others.end(), [](Unit* a, Unit* b) { return a->GetHealthPct() < b->GetHealthPct(); });
+                if (others.size() > 4)
+                    others.resize(4);
+                others.push_back(target);
+                uint32 const renew = WcmeRankFor(owner, RENEW);
+                for (Unit* ally : others)
+                    owner->CastSpell(ally, renew, true);
+                break;
+            }
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_blessing_of_the_divines_random::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_blessing_of_the_divines_random::HandleProc);
+    }
+};
