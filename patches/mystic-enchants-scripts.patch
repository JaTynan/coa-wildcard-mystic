+// Spiteful Strike (986236): its data always triggered Killing Spree; now it does so only at 5 Edge of Fury stacks and
+// only if you know Killing Spree (that spree runs twice as fast, spell_wcme_edge_killing_spree); otherwise it adds a
+// stack.
+class spell_wcme_spiteful_strike : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_spiteful_strike);
+
+    static constexpr uint32 EDGE = 986235;
+
+    void PreventSpree(SpellEffIndex effIndex)
+    {
+        PreventHitDefaultEffect(effIndex);
+    }
+
+    void HandleAfterHit()
+    {
+        Unit* caster = GetCaster();
+        Unit* target = GetHitUnit();
+        if (!target)
+            return;
+        Aura const* edge = caster->GetAura(EDGE);
+        uint32 const spree = WcmeKnownByName(caster, "Killing Spree", SPELLFAMILY_ROGUE);
+        if (edge && edge->GetStackAmount() >= edge->GetSpellInfo()->StackAmount && spree)
+        {
