+// Mystic Enchants whose behaviour needs memory or checks that the wcme_enchant_action table cannot express
+// (coa-wildcard-mystic). Each script is bound to the enchant's spell in spell_script_names, and a spell_proc row
+// on that spell says which events reach it (sql/enchants/017-enchant-scripts.sql). Every handler prevents the
+// enchant's own (blanked) trigger effects and does exactly what the tooltip says instead.
+
+#include "DBCStores.h"
+#include "GameTime.h"
+#include "Item.h"
+#include "Player.h"
+#include "Random.h"
+#include "ScriptMgr.h"
+#include "SpellAuras.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "SpellScript.h"
+#include "Unit.h"
+#include <algorithm>
+#include <cstring>
+#include <initializer_list>
+#include <unordered_set>
+
+namespace
+{
+bool WcmeNamed(SpellInfo const* spell, char const* name)
+{
+    return spell && spell->SpellName[0] && std::strcmp(spell->SpellName[0], name) == 0;
+}
+
+bool WcmeNamedAny(SpellInfo const* spell, std::initializer_list<char const*> names)
+{
+    for (char const* name : names)
+        if (WcmeNamed(spell, name))
+            return true;
+    return false;
+}
+
+bool WcmeHasAnyAura(Unit const* unit, std::initializer_list<uint32> auras)
+{
+    for (uint32 aura : auras)
+        if (unit->HasAura(aura))
+            return true;
+    return false;
+}
+
+uint32 WcmeFirstRank(SpellInfo const* spell)
+{
+    SpellInfo const* first = spell->GetFirstRankSpell();
+    return first ? first->Id : spell->Id;
+}
+
+bool WcmeDealtDamage(ProcEventInfo& eventInfo)
+{
+    DamageInfo const* damage = eventInfo.GetDamageInfo();
+    return damage && damage->GetDamage() + damage->GetAbsorb() > 0;
+}
+}
