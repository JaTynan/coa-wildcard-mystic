+    static constexpr uint32 DRAGON_FURY = 954253;
+    static constexpr uint32 DRAGON_ROAR = 954250;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->Id == DRAGON_ROAR;
+        return WcmeDealtDamage(eventInfo) && (WcmeNamedAny(spell, { "Bloodthirst", "Execute" }) ||
+            (WcmeNamed(spell, "Slam") && GetTarget()->HasAura(DRACONIC_SLAM)));
