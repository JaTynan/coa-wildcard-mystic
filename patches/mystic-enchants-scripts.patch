+// Curse of Arugal (982806): Cat finishing moves have a 20% chance per combo point to grant Goldrinn's Guile: your next
+// Mind Blast or Vampiric Touch is instant and deals 20% more damage (the builder tooltip's number; the client data has
+// 40%), awards 2 combo points and a stack of Goldrinn's Focus, and spends it. While Goldrinn's Fury is up, Cat ability
+// damage applies a stack of Arugal's Gift. Darkness (no Ascension data survives;
+// James's design): bleed or Shadow periodic damage, and combo point generators in Cat Form, build Darkness, at most one
+// stack every 2.5 sec, up to 5, lasting 15 sec after the last gain. Mind Blast spends it all for 4% more damage per
+// stack (20% at 5, on par with Goldrinn's Guile's 20%; James chose it), as extra Shadow damage.
+class spell_wcme_curse_of_arugal : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_curse_of_arugal);
+
+    static constexpr uint32 GOLDRINNS_GUILE = 982816;
+    static constexpr uint32 GOLDRINNS_FURY = 982811;
+    static constexpr uint32 ARUGALS_GIFT = 982812;
+    static constexpr uint32 DARKNESS = 982815;
+    static constexpr uint32 GOLDRINNS_FOCUS = 982810;
+    static constexpr int32 GUILE_BONUS_PCT = 20;
+    static constexpr Milliseconds DARKNESS_EVERY{2500};
+    static constexpr int32 DARKNESS_LASTS_MS = 15000;
+    static constexpr uint8 DARKNESS_MAX = 5;
+    static constexpr int32 DARKNESS_BONUS_PCT = 4;
+    TimePoint _darknessReady{};
+
+    void GainDarkness(Unit* owner)
+    {
+        TimePoint const now = GameTime::Now();
+        if (now < _darknessReady)
+            return;
+        _darknessReady = now + DARKNESS_EVERY;
+        Aura* darkness = owner->GetAura(DARKNESS);
+        if (!darkness)
+        {
+            owner->CastSpell(owner, DARKNESS, true);
+            if (!(darkness = owner->GetAura(DARKNESS)))
+                return;
+            darkness->SetStackAmount(1);
+        }
+        else if (darkness->GetStackAmount() < DARKNESS_MAX)
+            darkness->SetStackAmount(darkness->GetStackAmount() + 1);
+        darkness->SetMaxDuration(DARKNESS_LASTS_MS);
+        darkness->SetDuration(DARKNESS_LASTS_MS);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() != nullptr;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        bool const cat = owner->GetShapeshiftForm() == FORM_CAT;
+
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+        {
+            if (WcmeDealtDamage(eventInfo) && ((spell->GetAllEffectsMechanicMask() & (1 << MECHANIC_BLEED)) ||
+                    (eventInfo.GetDamageInfo()->GetSchoolMask() & SPELL_SCHOOL_MASK_SHADOW)))
+                GainDarkness(owner);
+            return;
+        }
+
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (cat && spell->NeedsComboPoints())
+            {
+                // combo points are still on the caster during the cast phase; they are spent in the finish phase
+                if (uint8 const points = owner->GetComboPoints())
+                    if (roll_chance_i(20 * points))
+                        owner->CastCustomSpell(owner, GOLDRINNS_GUILE, nullptr, &GUILE_BONUS_PCT, &GUILE_BONUS_PCT, true);
+            }
+            else if (cat && spell->HasEffect(SPELL_EFFECT_ADD_COMBO_POINTS))
+                GainDarkness(owner);
+            return;
+        }
+
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || target == owner)
+            return;
+        if (WcmeNamedAny(spell, { "Mind Blast", "Vampiric Touch" }) && owner->HasAura(GOLDRINNS_GUILE))
+        {
+            owner->RemoveAurasDueToSpell(GOLDRINNS_GUILE);
+            owner->AddComboPoints(target, 2);
+            WcmeAddStacks(owner, GOLDRINNS_FOCUS, 1, 0);
+            if (Aura* focus = owner->GetAura(GOLDRINNS_FOCUS); focus && focus->GetStackAmount() > 3)
+                focus->SetStackAmount(3);
+        }
+        if (!WcmeDealtDamage(eventInfo))
+            return;
+        if (WcmeNamed(spell, "Mind Blast"))
+        {
+            if (Aura const* darkness = owner->GetAura(DARKNESS))
+            {
+                int64 const stacks = std::max<uint8>(1, darkness->GetStackAmount());
+                owner->RemoveAurasDueToSpell(DARKNESS);
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * DARKNESS_BONUS_PCT * stacks / 100);
+            }
+            return;
+        }
+        if (cat && owner->HasAura(GOLDRINNS_FURY))
+            owner->CastSpell(target, ARUGALS_GIFT, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_curse_of_arugal::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_curse_of_arugal::HandleProc);
+    }
+};
