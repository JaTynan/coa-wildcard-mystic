+// Felborne (101086): direct damage from an ability or spell adds a stack of Meteoric Impact, at most once a second; 5
+// stacks are spent on Fel Meteor! (12 sec), which lets you cast Fel Meteor once.
+// Abiding Fel Energy (84805): direct damage or healing adds Fel Energy, at most once a second; 5 stacks become Abiding
+// Fel Energy (8 sec), during which direct damage also deals 87 + 20% AP + 30% SP Magic damage, at most once a second.
+// Fel Strike (84806): direct damage or healing adds Fel Energy, at most once a second; 4 stacks are spent on Fel Strike!
+// (20 sec), which lets you cast Fel Strike once.
+// Felborne and Fel Strike teach their spell while the enchant is active, at the rank for your level (checked again
+// every time you earn a cast, so it keeps up as you level).
+class spell_wcme_fel_energy : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_fel_energy);
+
+    static constexpr Seconds RATE{1};
+    TimePoint _ready{};
+    TimePoint _unleashReady{};
+
+    void SyncRank(bool keep)
+    {
+        if (GetId() == 101086)
+            WcmeSyncTaughtRank(GetTarget(), FEL_METEOR_RANKS, keep);
+        else if (GetId() == 84806)
+            WcmeSyncTaughtRank(GetTarget(), FEL_STRIKE_RANKS, keep);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { SyncRank(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { SyncRank(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        if (!eventInfo.GetSpellInfo() || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        return WcmeDealtDamage(eventInfo) || (GetId() != 101086 && heal && heal->GetHeal() > 0);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        TimePoint const now = GameTime::Now();
+        if (GetId() == 84805 && owner->HasAura(84810) && WcmeDealtDamage(eventInfo) && target && target != owner &&
+            now >= _unleashReady)
+            if (SpellInfo const* unleash = sSpellMgr->GetSpellInfo(84808))
+            {
+                _unleashReady = now + RATE;
+                WcmeExtraDamage(owner, target, unleash, int64(87 + 0.2f * WcmeAttackPower(owner) + 0.3f * WcmeSpellPower(owner)));
+            }
+
+        if (now < _ready)
+            return;
+        _ready = now + RATE;
+        switch (GetId())
+        {
+            case 101086:
+                if (WcmeAddStacks(owner, 300230, 1, 5))   // Meteoric Impact
+                {
+                    SyncRank(true);
+                    owner->CastSpell(owner, 300231, true);   // Fel Meteor!
+                }
+                break;
+            case 84805:
+                if (WcmeAddStacks(owner, 983900, 1, 5))
+                    owner->CastSpell(owner, 84810, true);
+                break;
+            default:   // 84806
+                if (WcmeAddStacks(owner, 983897, 1, 4))
+                {
+                    SyncRank(true);
+                    owner->CastSpell(owner, 983899, true);   // Fel Strike!
+                }
+                break;
+        }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_fel_energy::HandleApply, EFFECT_0, SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_fel_energy::HandleRemove, EFFECT_0, SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_fel_energy::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_fel_energy::HandleProc);
+    }
+};
