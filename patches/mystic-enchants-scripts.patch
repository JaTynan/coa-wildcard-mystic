+// Crimson Defense (1572131): blocking an attack adds a stack of Crimson Defender (1572103, up to 6). Shield of
+// Righteousness or Avenger's Shield with 3 or more stacks spends 3: Shield of Righteousness also slams nearby enemies for
+// Holy damage (Champion's Wrath, 1572107), Avenger's Shield gives Champion's Courage (1572109: +15% block value and
+// threat). The +10% block chance is in the spell data.
+class spell_wcme_crimson_defense : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_crimson_defense);
+
+    static constexpr uint32 DEFENDER = 1572103;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        if (eventInfo.GetActionTarget() == owner)
+            return eventInfo.GetHitMask() & (PROC_HIT_BLOCK | PROC_HIT_FULL_BLOCK);
+        Aura const* stacks = owner->GetAura(DEFENDER);
+        return stacks && stacks->GetStackAmount() >= 3 && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) &&
+            WcmeNamedAny(eventInfo.GetSpellInfo(), { "Shield of Righteousness", "Avenger's Shield" });
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetActionTarget() == owner)
+        {
+            owner->CastSpell(owner, DEFENDER, true);
+            if (Aura* stacks = owner->GetAura(DEFENDER); stacks && stacks->GetStackAmount() > 6)
+                stacks->SetStackAmount(6);
+            return;
+        }
+        if (Aura* stacks = owner->GetAura(DEFENDER))
+        {
+            if (stacks->GetStackAmount() > 3)
+                stacks->SetStackAmount(stacks->GetStackAmount() - 3);
+            else
+                stacks->Remove();
+        }
+        if (WcmeNamed(eventInfo.GetSpellInfo(), "Shield of Righteousness"))
+            owner->CastSpell(owner, 1572107, true);
+        else
+            owner->CastSpell(owner, 1572109, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_crimson_defense::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_crimson_defense::HandleProc);
+    }
+};
