+// Lone Wolf (1180030): its own data already gives 1180031 (+10% damage and armour penetration) every second; that is
+// now held back while you have a living pet out (the same test as the core's no_pet condition). The +10% damage itself
+// is the core's own enchant bonus (coa_mystic_enchant_bonus, no_pet), so spell_wcme_lone_wolf_buff zeroes 1180031's
+// damage effect and it gives only the armour penetration (review 2026-11-18: before, no pet meant +21% damage). Every second, each enemy in combat with you within 8 yards adds a stack of
+// 1101498 (+3% damage and attack speed, up to 5, its own data).
+class spell_wcme_lone_wolf : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_lone_wolf);
+
+    void Grant(AuraEffect const* /*aurEff*/)
+    {
+        Player* player = GetTarget()->ToPlayer();
+        if (player && player->GetPet() && player->GetPet()->IsAlive())
+        {
+            PreventDefaultAction();
+            player->RemoveAurasDueToSpell(1180031);
+        }
+    }
+
+    void Surrounded(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Player* player = GetTarget()->ToPlayer();
+        if (!player)
+            return;
+        uint8 count = 0;
+        if (player->IsInCombat())
+            for (Unit* enemy : WcmeEnemiesNear(player, player, 8.0f, 10))
+                if (enemy->IsInCombatWith(player) && count < 5)
+                    ++count;
+        if (!count)
+        {
+            player->RemoveAurasDueToSpell(1101498);
+            return;
+        }
+        Aura* stacks = player->GetAura(1101498);
+        if (!stacks)
+            stacks = player->AddAura(1101498, player);
+        if (stacks)
+        {
+            stacks->SetStackAmount(count);
+            stacks->RefreshDuration();
+        }
+    }
+
+    void Remove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        GetTarget()->RemoveAurasDueToSpell(1180031);
+        GetTarget()->RemoveAurasDueToSpell(1101498);
+    }
+
+    void Register() override
+    {
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_lone_wolf::Grant, EFFECT_1, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_lone_wolf::Surrounded, EFFECT_2, SPELL_AURA_ANY);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_lone_wolf::Remove, EFFECT_2, SPELL_AURA_ANY, AURA_EFFECT_HANDLE_REAL);
+    }
+};
