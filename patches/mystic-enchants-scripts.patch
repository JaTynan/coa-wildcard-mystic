+// Allies of `caster` within `radius` yards of `center` (center first, then nearest), at most `limit`.
+std::list<Unit*> WcmeAlliesNear(Unit* caster, Unit* center, float radius, size_t limit)
+{
+    std::list<Unit*> allies;
+    Acore::AnyFriendlyUnitInObjectRangeCheck check(center, caster, radius);
+    Acore::UnitListSearcher<Acore::AnyFriendlyUnitInObjectRangeCheck> searcher(center, allies, check);
+    Cell::VisitObjects(center, searcher, radius);
+    allies.remove_if([center](Unit* ally) { return !ally->IsAlive() || ally == center; });
+    allies.sort([center](Unit* first, Unit* second) { return center->GetDistance(first) < center->GetDistance(second); });
+    allies.push_front(center);
+    if (allies.size() > limit)
+        allies.resize(limit);
+    return allies;
+}
