+constexpr uint32 MANA_FIEND = 977870;
+constexpr uint32 DELIRIUM = 977876;
+constexpr uint32 DELIRIUM_COST = 977873;
+constexpr uint32 MANA_RECOVERY = 977874;
+constexpr uint32 MANACHARGED_STRIKE = 977871;
+
+std::unordered_map<ObjectGuid, uint32> WcmeDeliriumMana;                 // mana before each player update in Delirium
+std::unordered_map<ObjectGuid, uint32> WcmeDeliriumDrained;              // mana Delirium has drained so far
+std::unordered_set<ObjectGuid> WcmeManaFiendArmed;                       // the next auto attack is a Manacharged Strike
+std::unordered_map<ObjectGuid, uint64> WcmeTimeBindDamage;               // damage each Time-bind has absorbed
+constexpr std::array<uint32, 8> HATEFUL_STRIKE_RANKS = { 984226, 984649, 984650, 984651, 984652, 984653, 984654, 984655 };
+constexpr std::array<uint32, 5> GROUND_SLAM_RANKS = { 984201, 984456, 984457, 984458, 984459 };
+constexpr std::array<uint32, 8> UPHEAVAL_RANKS = { 984202, 984232, 984233, 984234, 984235, 984236, 984237, 984238 };
+
+// Ends Delirium (if running) and starts Recovery: the mana Delirium drained comes back over 12 sec (4 ticks).
+void WcmeManaFiendRecover(Unit* owner)
+{
+    bool const delirious = owner->HasAura(DELIRIUM);
+    owner->RemoveAurasDueToSpell(DELIRIUM);
+    owner->RemoveAurasDueToSpell(DELIRIUM_COST);
+    uint32 drained = 0;
+    if (auto entry = WcmeDeliriumDrained.find(owner->GetGUID()); entry != WcmeDeliriumDrained.end())
+    {
+        drained = entry->second;
+        WcmeDeliriumDrained.erase(entry);
+    }
+    if (!delirious)
+        return;
+    owner->AddAura(MANA_RECOVERY, owner);
+    int32 const restore = int32(drained / 4);
+    if (restore <= 0)
+        return;
+    for (uint8 tick = 1; tick <= 4; ++tick)
+        owner->m_Events.AddEventAtOffset([owner, restore]()
+        {
+            if (owner->IsAlive())
+                owner->EnergizeBySpell(owner, MANA_RECOVERY, restore, POWER_MANA);
+        }, Seconds(3 * tick));
+}
+
+// The replaced auto attack: drains 3% of base mana and deals that much Arcane damage (Manacharged Strike), with a 50%
+// chance to start Delirium.
+void WcmeManachargedStrike(Unit* owner, Unit* target)
+{
+    int32 const drain = std::min<int32>(int32(owner->GetCreateMana() * 3 / 100), int32(owner->GetPower(POWER_MANA)));
+    if (drain <= 0 || !target->IsAlive())
+        return;
+    owner->ModifyPower(POWER_MANA, -drain);
+    owner->CastCustomSpell(MANACHARGED_STRIKE, SPELLVALUE_BASE_POINT0, drain, target, true);
+    if (owner->HasAura(DELIRIUM) || !roll_chance_i(50))
+        return;
+    owner->AddAura(DELIRIUM, owner);
+    if (Aura* cost = owner->AddAura(DELIRIUM_COST, owner))
+    {
+        cost->SetMaxDuration(-1);
+        cost->SetDuration(-1);
+    }
+    WcmeDeliriumMana[owner->GetGUID()] = owner->GetPower(POWER_MANA);
+    WcmeDeliriumDrained[owner->GetGUID()] = 0;
+}
+}
