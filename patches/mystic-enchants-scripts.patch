+// Grove Ranger (997124), with the healing path or Spirit as your primary stat (WcmePrimaryStatMet), as the in-game
+// description has it: Arcane Shot shows as Blooming Shot (92726-92736) and
+// Serpent Sting as Medicinal Sting (92737-92748), each at the rank your level allows (WcmeSyncSwapRanked); Grover's Touch
+// (985610) and Grove Shot (985601, 985625-985632, by level) are taught; Grove
+// Ranger's Agility (997563) is kept on you (its healing-power effect named no stat; Validate makes it Agility). Hunter
+// shots add a Grove Ranger stack (997542, up to 3); Blooming: each Blooming Shot cast (and putting the enchant on) starts
+// Blooming (997562, growing, 5 sec) and spends Nature's Power; when Blooming runs out you get Nature's Power (276927:
+// next Blooming Shot +400% damage and healing, -40% cost; wcme_blooming_mods lets it affect the enchant's ranks); Wild Growth spends them, Healing Touch and Regrowth spend up to 2.
+// Steady Shot casts have a 20% chance to give back a charge of Blooming Shot and of Medicinal Sting.
+class spell_wcme_grove_ranger : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_grove_ranger);
+
+    static constexpr std::array<uint32, 11> BLOOMING_SHOT = { 92726, 92727, 92728, 92729, 92730, 92731, 92732, 92733, 92734, 92735, 92736 };
+    static constexpr std::array<uint32, 12> MEDICINAL_STING = { 92737, 92738, 92739, 92740, 92741, 92742, 92743, 92744, 92745, 92746, 92747, 92748 };
+    static constexpr std::array<uint32, 9> GROVE_SHOT = { 985601, 985625, 985626, 985627, 985628, 985629, 985630, 985631, 985632 };
+    static constexpr std::array<uint32, 1> GROVERS_TOUCH = { 985610 };
+    static constexpr uint32 AGILITY = 997563;
+    static constexpr uint32 STACKS = 997542;
+    static constexpr uint32 GROWING = 997562;
+    static constexpr uint32 NATURES_POWER = 276927;
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        if (SpellInfo const* agility = sSpellMgr->GetSpellInfo(AGILITY))
+            if (agility->Effects[EFFECT_1].ApplyAuraName == SPELL_AURA_MOD_SPELL_HEALING_OF_STAT_PERCENT &&
+                agility->Effects[EFFECT_1].MiscValue >= MAX_STATS)
+                const_cast<SpellInfo*>(agility)->Effects[EFFECT_1].MiscValue = STAT_AGILITY;
+        return true;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        active = active && WcmePrimaryStatMet(owner, 84867, STAT_SPIRIT);
+        WcmeSyncSwapRanked(owner, "Arcane Shot", SPELLFAMILY_HUNTER, BLOOMING_SHOT, active);
+        WcmeSyncSwapRanked(owner, "Serpent Sting", SPELLFAMILY_HUNTER, MEDICINAL_STING, active);
+        WcmeSyncTaughtRank(owner, GROVE_SHOT, active);
+        WcmeSyncTaughtRank(owner, GROVERS_TOUCH, active);
+        if (active && !owner->HasAura(AGILITY))
+            owner->AddAura(AGILITY, owner);
+        if (active && !owner->HasAura(GROWING) && !owner->HasAura(NATURES_POWER))
+            owner->CastSpell(owner, GROWING, true);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(AGILITY);
+            owner->RemoveAurasDueToSpell(STACKS);
+            owner->RemoveAurasDueToSpell(GROWING);
+            owner->RemoveAurasDueToSpell(NATURES_POWER);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !WcmePrimaryStatMet(GetTarget(), 84867, STAT_SPIRIT))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return (spell->SpellFamilyName == SPELLFAMILY_HUNTER && WcmeNamedAny(spell, { "Steady Shot", "Blooming Shot" })) ||
+                (spell->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamedAny(spell, { "Wild Growth", "Healing Touch", "Regrowth" }) &&
+                    GetTarget()->HasAura(STACKS));
+        return WcmeIsHunterShot(spell) && eventInfo.GetActionTarget() && eventInfo.GetActionTarget() != GetTarget();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST))
+        {
+            WcmeAddStackOn(owner, owner, STACKS);
+            return;
+        }
+        if (WcmeNamed(spell, "Blooming Shot"))
+        {
+            if (owner->HasAura(NATURES_POWER))
+                owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(NATURES_POWER); }, 1s);
+            owner->CastSpell(owner, GROWING, true);
+            return;
+        }
+        if (WcmeNamed(spell, "Steady Shot"))
+        {
+            if (roll_chance_i(20))
+            {
+                WcmeRestoreChargeByName(owner, "Blooming Shot");
+                WcmeRestoreChargeByName(owner, "Medicinal Sting");
+            }
+            return;
+        }
+        if (WcmeNamed(spell, "Wild Growth"))
+            owner->RemoveAurasDueToSpell(STACKS);
+        else if (Aura* stacks = owner->GetAura(STACKS))
+            stacks->ModStackAmount(-std::min<int32>(2, stacks->GetStackAmount()));
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_grove_ranger::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_grove_ranger::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_grove_ranger::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_grove_ranger::HandleProc);
+    }
