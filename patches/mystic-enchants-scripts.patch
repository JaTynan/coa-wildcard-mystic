+// Words of Healing (81470): effective direct heals add a stack of Premonition; at full stacks it becomes
+// Clairvoyant. (Its heal crit bonus while Borrowed Time is up is an aura link, sql/enchants/016.)
+class spell_wcme_words_of_healing : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_words_of_healing);
+
+    static constexpr uint32 PREMONITION = 985341;
+    static constexpr uint32 CLAIRVOYANT = 985342;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
