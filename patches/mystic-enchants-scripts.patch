+// Necromancer's Touch (983181, hidden): its data holds both values, 22% (effect 0) and 10% for players (effect 1);
+// only the one that fits the target counts.
+class spell_wcme_necromancers_touch : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_necromancers_touch);
+
+    void CalcCreature(AuraEffect const* /*aurEff*/, int32& amount, bool& /*canBeRecalculated*/)
+    {
+        if (GetUnitOwner() && GetUnitOwner()->IsControlledByPlayer())
+            amount = 0;
