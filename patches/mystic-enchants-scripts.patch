+// Evoker (953308): casting Arcane Missiles with Missile Barrage up (spending it) grants Arcane Evoked (better Brain
+// Freeze chance); casting Fireball with Brain Freeze up grants Fire Evoked (better Missile Barrage chance); either
+// grants Frost Evoked (faster Frostbolt, which then grants Evoker).
+class spell_wcme_evoker : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_evoker);
+
+    static constexpr uint32 ARCANE_EVOKED = 953309;
+    static constexpr uint32 FIRE_EVOKED = 953311;
+    static constexpr uint32 FROST_EVOKED = 953313;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) && eventInfo.GetSpellInfo();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        // Arcane Evoked is used up once Brain Freeze triggers, Fire Evoked once Missile Barrage triggers
+        if (WcmeHasAnyAura(owner, { 57761, 1157761, 1257761, 1579137, 1579163, 301119 }))
+            owner->RemoveAurasDueToSpell(ARCANE_EVOKED);
+        if (WcmeHasAnyAura(owner, { 44401, 1144401, 1244401, 274595, 983720, 1573780 }))
+            owner->RemoveAurasDueToSpell(FIRE_EVOKED);
+        if (WcmeNamed(spell, "Arcane Missiles") &&
+            WcmeHasAnyAura(owner, { 44401, 1144401, 1244401, 274595, 983720, 1573780 }))
+        {
+            owner->CastSpell(owner, ARCANE_EVOKED, true);
+            owner->CastSpell(owner, FROST_EVOKED, true);
+        }
+        else if (WcmeNamed(spell, "Fireball") && WcmeHasAnyAura(owner, { 57761, 1157761, 1257761, 1579137, 1579163, 301119 }))
+        {
+            owner->CastSpell(owner, FIRE_EVOKED, true);
+            owner->CastSpell(owner, FROST_EVOKED, true);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_evoker::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_evoker::HandleProc);
+    }
+};
