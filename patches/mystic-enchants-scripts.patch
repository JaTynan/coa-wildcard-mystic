+            return;
+        PreventDefaultAction();
+        Unit* target = GetTarget();
+        target->AddAura(FINAL_TICK, target);
+        target->CastSpell(target, aurEff->GetSpellInfo()->Effects[aurEff->GetEffIndex()].TriggerSpell, true, nullptr, aurEff,
+            GetCasterGUID());
+        target->RemoveAurasDueToSpell(FINAL_TICK);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_prayer_of_preservation_hot::HandleApply, EFFECT_1, SPELL_AURA_PERIODIC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_prayer_of_preservation_hot::Tick, EFFECT_1, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+    }
