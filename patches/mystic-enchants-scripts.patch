+// Spell-side parts (casts and critical strike chance):
+// - Moon's Wrath (1180590) and Critical Time (1575124) used to be here; review 2026-11-18 found the core's bonus table
+//   already gives both crit bonuses (and its lists cover every learnable Wrath, Starsurge, Moonfire and Living Bomb), so
+//   ours doubled them.
+// - Unstoppable Force (911167): Slam always crits on an incapacitated or immobilized target.
+// - Pyroclasmic Shadows (1577402): its crit bonus used to be here too; the core's bonus table gives it (every learnable
+//   Shadow Bolt and Pyroclasm buff), so ours doubled it (review 2026-11-18).
+// - Shooting Stars (81181): while your Starfall is up, +5% spell crit chance, and every non-channelled Arcane spell you
+//   cast adds half its cast time to Starfall.
+// - Swashbuckler: Shocktrooper (81415): Shaman Shocks cast while Swashbuckling come back 10.5 sec sooner.
+// - Esoteric Power (1556015): Arcane Blast's buff stacks to 5 (one more than normal).
+// - Raising Hell (81096 / 281336): when you start Hellfire, your summoned demon (not an Infernal) casts it too; it stops
+//   when yours ends (wcme_epic_batch3_hooks).
+// - Totem Master: Fire. 81445: your Fire totem gets health equal to 15% of yours (its mana cost and Searing / Magma
+//   cooldown changes are its data). 1581586: your Fire totem also gives Totem of Wrath's, or else Flametongue Totem's,
+//   aura if you know that totem (the aura comes from that totem's creature).
+// - Blood Drinker (965389): Bloodthirst spends your Taste for Blood to heal you for 3% of your maximum health plus 25% of
+//   your attack power (no amount in the data; based on Bloodthirst's own small heal).
+// - Deadly Follow-up (979080): damaging finishing moves give a charge of Poisoned Shiv (979082, up to 3), 10% per combo
+//   point (in spell_wcme_finisher_combo).
+class wcme_epic_batch3_spells : public AllSpellScript
+{
+public:
+    wcme_epic_batch3_spells() : AllSpellScript("wcme_epic_batch3_spells", { ALLSPELLHOOK_ON_CRIT_CHANCE, ALLSPELLHOOK_ON_CAST })
+    { }
+
+    void OnSpellCritChance(Spell* spell, Unit* target, float& chance) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        SpellInfo const* info = spell ? spell->GetSpellInfo() : nullptr;
+        if (!caster || !target || !info || caster == target)
+            return;
+        if (caster->HasAura(911167) && WcmeNamed(info, "Slam") && WcmeIncapacitatedOrImmobilized(target))
+            chance = 100.0f;
+        if (caster->HasAura(81181) && info->DmgClass == SPELL_DAMAGE_CLASS_MAGIC && WcmeHasAuraNamed(caster, "Starfall", SPELLFAMILY_DRUID))
+            chance += 5.0f;
+    }
+
+    static void TotemMaster(Player* player)
+    {
+        Creature* totem = player->GetMap()->GetCreature(player->m_SummonSlot[SUMMON_SLOT_TOTEM_FIRE]);
+        if (!totem)
+            return;
+        if (player->HasAura(81445))
+        {
+            uint32 const health = std::max<uint32>(1, player->GetMaxHealth() * 15 / 100);
+            totem->SetMaxHealth(health);
+            totem->SetHealth(health);
+        }
+        if (player->HasAura(1581586))
+            for (char const* name : { "Totem of Wrath", "Flametongue Totem" })
+            {
+                uint32 best = 0;
+                for (auto const& [id, known] : player->GetSpellMap())
+                    if (known->State != PLAYERSPELL_REMOVED)
+                        if (SpellInfo const* info = sSpellMgr->GetSpellInfo(id); info && WcmeNamed(info, name) &&
+                            info->Effects[EFFECT_0].Effect == SPELL_EFFECT_SUMMON && info->SpellLevel >= (best ?
+                            sSpellMgr->GetSpellInfo(best)->SpellLevel : 0))
+                            best = id;
+                if (!best)
+                    continue;
+                CreatureTemplate const* tmpl = sObjectMgr->GetCreatureTemplate(sSpellMgr->GetSpellInfo(best)->Effects[EFFECT_0].MiscValue);
+                if (tmpl && tmpl->spells[0] && totem->GetEntry() != tmpl->Entry)
+                    totem->CastSpell(totem, tmpl->spells[0], true);
+                break;
+            }
+    }
+
+    void OnSpellCast(Spell* spell, Unit* caster, SpellInfo const* info, bool /*skipCheck*/) override
+    {
+        if (!spell || !caster || !info)
+            return;
+        Player* player = caster->ToPlayer();
+        if (caster->HasAura(81181) && !spell->IsTriggered() && (info->SchoolMask & SPELL_SCHOOL_MASK_ARCANE) &&
+            !info->IsChanneled() && spell->GetCastTime() > 0)
+            for (auto const& [id, app] : caster->GetAppliedAuras())
+            {
+                Aura* aura = app->GetBase();
+                if (aura->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(aura->GetSpellInfo(), "Starfall") &&
+                    aura->GetCasterGUID() == caster->GetGUID())
+                {
+                    int32 const extra = spell->GetCastTime() / 2;
+                    aura->SetMaxDuration(aura->GetMaxDuration() + extra);
+                    aura->SetDuration(aura->GetDuration() + extra);
+                }
+            }
+        if (caster->HasAura(81415) && info->SpellFamilyName == SPELLFAMILY_SHAMAN && info->SpellName[0] &&
+            std::strstr(info->SpellName[0], "Shock") && WcmeSwashbuckling(caster) && player)
+        {
+            uint32 const id = info->Id;
+            caster->m_Events.AddEventAtOffset([player, id]() { player->ModifySpellCooldown(id, -10500); }, 1ms);
+        }
+        if (caster->HasAura(1556015) && WcmeNamed(info, "Arcane Blast") && !spell->IsTriggered())
+        {
+            uint8 const before = [caster]()
+            {
+                for (auto const& [id, app] : caster->GetAppliedAuras())
+                    if (WcmeNamed(app->GetBase()->GetSpellInfo(), "Arcane Blast") && app->GetBase()->GetSpellInfo()->StackAmount)
+                        return app->GetBase()->GetStackAmount();
+                return uint8(0);
+            }();
+            if (before >= 4)
+                caster->m_Events.AddEventAtOffset([caster]()
+                {
+                    for (auto const& [id, app] : caster->GetAppliedAuras())
+                    {
+                        Aura* aura = app->GetBase();
+                        if (WcmeNamed(aura->GetSpellInfo(), "Arcane Blast") && aura->GetSpellInfo()->StackAmount == 4 &&
+                            aura->GetStackAmount() == 4)
+                            aura->SetStackAmount(5);
+                    }
+                }, 1ms);
+        }
+        if (WcmeHasAnyAura(caster, { 81096, 281336 }) && info->SpellFamilyName == SPELLFAMILY_WARLOCK &&
+            WcmeNamed(info, "Hellfire") && !spell->IsTriggered() && player)
+            if (Pet* demon = player->GetPet(); demon && demon->IsAlive() && demon->GetName() != "Infernal")
+                demon->CastSpell(demon, info->Id, true);
+        if (WcmeHasAnyAura(caster, { 81445, 1581586 }) && info->SpellFamilyName == SPELLFAMILY_SHAMAN && player &&
+            info->Effects[EFFECT_0].Effect == SPELL_EFFECT_SUMMON && info->SpellName[0] && std::strstr(info->SpellName[0], "Totem"))
+            caster->m_Events.AddEventAtOffset([player]() { TotemMaster(player); }, 100ms);
+        if (caster->HasAura(965389) && WcmeNamed(info, "Bloodthirst") && !spell->IsTriggered())
+            for (auto const& [id, app] : caster->GetAppliedAuras())
+            {
+                Aura* aura = app->GetBase();
+                if (aura->GetSpellInfo()->SpellFamilyName != SPELLFAMILY_WARRIOR || !WcmeNamed(aura->GetSpellInfo(), "Taste for Blood") ||
+                    aura->GetSpellInfo()->IsPassive())
+                    continue;
+                int32 const heal = int32(caster->CountPctFromMaxHealth(3) + caster->GetTotalAttackPowerValue(BASE_ATTACK) * 0.25f);
+                aura->Remove();
+                caster->m_Events.AddEventAtOffset([caster, heal]()
+                {
+                    HealInfo healInfo(caster, caster, heal, nullptr, SPELL_SCHOOL_MASK_NORMAL);
+                    caster->HealBySpell(healInfo);
+                }, 1ms);
+                break;
+            }
+    }
+};
+
+// Unit-side parts:
+// - Esoteric Power (1556015): each Arcane Blast hit has a 10% chance per Arcane Blast stack to deal 15% more as Esoteric
+//   Power (1556016).
+// - Swashbuckler: Sweeping Swings (912326): while Sweeping Strikes is up you also have Critical Swings (912328, +2% melee
+//   crit); a melee ability hit takes 1 sec off Sweeping Strikes, at most once a second; with no other enemy within 8
+//   yards, your hits also strike the primary target again for the same damage (Sweeping Strikes' own spell 26654),
+//   spending a Sweeping Strikes charge; Sweeping Strikes deals 25% less against players.
+// - High Winds (954126): when your Cyclone ends on a target, it gets 954127 (-20% damage and healing, its own 4 sec).
+// - Timed Charge (954636): when your Alter Time ends (you return), 954637 bursts around you (Arcane damage, 3 sec stun).
+// - Fire and Ice (84382): your Deep Freeze leaves Frozen Flesh (944829, 3 charges) on the target; your Fire spells on it
+//   trigger Thawed Flesh (944831) and spend a charge.
+// - Eclipse Bomber (275014): gaining Eclipse (Solar) gives Solar Bomber (274981) and ends your Lunar Flames; gaining
+//   Eclipse (Lunar) gives Lunar Bomber (274982) and ends your Solar Flames. With Solar Bomber, Fireball and Pyroblast hits
+//   give Lunar Flames (274983, Starfire / Starsurge damage); with Lunar Bomber, Starfire and Starsurge hits give Solar
+//   Flames (275002, Fireball / Pyroblast damage), as the enchant's text says.
+// - Controlled Aggression (1181300): Shield Slam deals 25% of your attack power more (added before armour and crit).
+//   Sword and Board's chance is doubled: after each Devastate or Revenge hit, if your talent did not just proc, a second
+//   roll at chance p/(1-p) (p = 10% per rank) makes the total exactly 2p. A success does what the talent's own proc
+//   does: resets Shield Slam's cooldown (category 1209, as spell_warr_sword_and_board) and gives the talent's buff
+//   (50227, or 1150227 / 1250227 for the CoA versions). The enchant's helper 1181302 ("chance doubled" in its data) has
+//   no spell class mask, so it changes nothing by itself.
+// - Poison Bomb (979113): Envenom and Eviscerate have a 20% chance per combo point to take 4 sec off Poison Bomb (in
+//   spell_wcme_finisher_combo).
+// - Raising Hell: your demon's Hellfire stops when yours does.
+class wcme_epic_batch3_hooks : public UnitScript
+{
+public:
+    wcme_epic_batch3_hooks() : UnitScript("wcme_epic_batch3_hooks", true, { UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN,
+        UNITHOOK_MODIFY_MELEE_DAMAGE, UNITHOOK_ON_AURA_APPLY, UNITHOOK_ON_AURA_REMOVE }) { }
+
+    static bool IsSweeping(SpellInfo const* info)
+    {
+        return info->SpellFamilyName == SPELLFAMILY_WARRIOR && WcmeNamed(info, "Sweeping Strikes");
+    }
+
+    void OnAuraApply(Unit* unit, Aura* aura) override
+    {
+        if (!unit || !aura)
+            return;
+        SpellInfo const* info = aura->GetSpellInfo();
+        if (IsSweeping(info) && aura->GetDuration() > 0 && unit->HasAura(912326))
+            if (Aura* crit = unit->AddAura(912328, unit))
+            {
+                crit->SetMaxDuration(aura->GetMaxDuration());
+                crit->SetDuration(aura->GetDuration());
+            }
+        if (unit->HasAura(275014) && (info->Id == 48517 || info->Id == 1148517))
+        {
+            unit->RemoveAurasDueToSpell(274983);
+            unit->AddAura(274981, unit);
+        }
+        if (unit->HasAura(275014) && (info->Id == 48518 || info->Id == 1148518))
+        {
+            unit->RemoveAurasDueToSpell(275002);
+            unit->AddAura(274982, unit);
+        }
+        if (info->SpellFamilyName == SPELLFAMILY_MAGE && WcmeNamed(info, "Deep Freeze") && info->HasAura(SPELL_AURA_MOD_STUN))
+            if (Unit* caster = aura->GetCaster(); caster && caster->HasAura(84382))
+                if (Aura* flesh = caster->AddAura(944829, unit))
+                    flesh->SetCharges(3);
+    }
+
+    void OnAuraRemove(Unit* unit, AuraApplication* aurApp, AuraRemoveMode mode) override
+    {
+        if (!unit || !aurApp)
+            return;
+        Aura* aura = aurApp->GetBase();
+        SpellInfo const* info = aura->GetSpellInfo();
+        if (IsSweeping(info))
+            unit->RemoveAurasDueToSpell(912328);
+        if (info->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(info, "Cyclone") && mode != AURA_REMOVE_BY_DEATH)
+            if (Unit* caster = aura->GetCaster(); caster && caster->HasAura(954126) && caster != unit)
+            {
+                ObjectGuid const guid = unit->GetGUID();
+                caster->m_Events.AddEventAtOffset([caster, guid]()
+                {
+                    if (Unit* victim = ObjectAccessor::GetUnit(*caster, guid); victim && victim->IsAlive())
+                        caster->CastSpell(victim, 954127, true);
+                }, 1ms);
+            }
+        if (info->SpellFamilyName == SPELLFAMILY_MAGE && WcmeNamed(info, "Alter Time") && info->HasAura(SPELL_AURA_ASCENSION_OVERRIDE_SPELL) &&
+            mode != AURA_REMOVE_BY_DEATH && unit->HasAura(954636))
+            unit->m_Events.AddEventAtOffset([unit]() { if (unit->IsAlive()) unit->CastSpell(unit, 954637, true); }, 1ms);
+        if (info->SpellFamilyName == SPELLFAMILY_WARLOCK && WcmeNamed(info, "Hellfire") && WcmeHasAnyAura(unit, { 81096, 281336 }))
+            if (Player* player = unit->ToPlayer())
+                if (Pet* demon = player->GetPet())
+                    demon->RemoveAurasDueToSpell(info->Id);
+    }
+
+    void Sweep(Unit* target, Unit* attacker, int64 value, bool ability)
+    {
+        if (!attacker->HasAura(912326))
+            return;
+        Aura* sweeping = nullptr;
+        for (auto const& [id, app] : attacker->GetAppliedAuras())
+            if (IsSweeping(app->GetBase()->GetSpellInfo()) && app->GetBase()->GetDuration() > 0)
+                sweeping = app->GetBase();
+        if (ability)
+        {
+            TimePoint const now = GameTime::Now();
+            auto& next = _nextCut[attacker->GetGUID()];
+            if (now >= next)
+            {
+                next = now + 1s;
+                WcmeCutCooldownByName(attacker, "Sweeping Strikes", 1000);
+            }
+        }
+        if (!sweeping)
+            return;
+        for (Unit* enemy : WcmeEnemiesNear(attacker, target, 8.0f, 4))
+            if (enemy != target)
+                return;
+        SpellInfo const* strike = sSpellMgr->GetSpellInfo(26654);
+        if (!strike || value <= 0)
+            return;
+        if (sweeping->GetCharges() > 1)
+            sweeping->SetCharges(sweeping->GetCharges() - 1);
+        else if (sweeping->GetCharges() == 1)
+            sweeping->Remove();
+        ObjectGuid const guid = target->GetGUID();
+        attacker->m_Events.AddEventAtOffset([attacker, guid, value, strike]()
+        {
+            if (Unit* victim = ObjectAccessor::GetUnit(*attacker, guid))
+                WcmeExtraDamage(attacker, victim, strike, value);
+        }, 1ms);
+    }
+
+    void ModifyMeleeDamage(Unit* target, Unit* attacker, uint32& damage) override
+    {
+        if (target && attacker && damage && target != attacker)
+            Sweep(target, attacker, damage, false);
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0 || target == attacker)
+            return;
+        int64 value = damage;
+        if (IsSweeping(spellInfo))
+        {
+            if (attacker->HasAura(912326) && target->IsControlledByPlayer())
+                value = value * 75 / 100;
+        }
+        else if (spellInfo->DmgClass == SPELL_DAMAGE_CLASS_MELEE)
+            Sweep(target, attacker, value, true);
+        if (attacker->HasAura(1556015) && WcmeNamed(spellInfo, "Arcane Blast"))
+        {
+            uint8 stacks = 0;
+            for (auto const& [id, app] : attacker->GetAppliedAuras())
+                if (WcmeNamed(app->GetBase()->GetSpellInfo(), "Arcane Blast") && app->GetBase()->GetSpellInfo()->StackAmount)
+                    stacks = app->GetBase()->GetStackAmount();
+            if (stacks && roll_chance_i(10 * stacks))
+            {
+                int64 const bonus = value * 15 / 100;
+                ObjectGuid const guid = target->GetGUID();
+                attacker->m_Events.AddEventAtOffset([attacker, guid, bonus]()
+                {
+                    SpellInfo const* power = sSpellMgr->GetSpellInfo(1556016);
+                    if (Unit* victim = ObjectAccessor::GetUnit(*attacker, guid); victim && power)
+                        WcmeExtraDamage(attacker, victim, power, bonus);
+                }, 1ms);
+            }
+        }
+        if ((spellInfo->SchoolMask & SPELL_SCHOOL_MASK_FIRE) && spellInfo->Id != 944831)
+            if (Aura* flesh = target->GetAura(944829, attacker->GetGUID()))
+            {
+                ObjectGuid const guid = target->GetGUID();
+                attacker->m_Events.AddEventAtOffset([attacker, guid]()
+                {
+                    if (Unit* victim = ObjectAccessor::GetUnit(*attacker, guid))
+                        attacker->CastSpell(victim, 944831, true);
+                }, 1ms);
+                if (flesh->GetCharges() > 1)
+                    flesh->SetCharges(flesh->GetCharges() - 1);
+                else
+                    flesh->Remove();
+            }
+        if (attacker->HasAura(274981) && WcmeNamedAny(spellInfo, { "Fireball", "Pyroblast" }))
+            attacker->m_Events.AddEventAtOffset([attacker]() { attacker->CastSpell(attacker, 274983, true); }, 1ms);
+        if (attacker->HasAura(274982) && WcmeNamedAny(spellInfo, { "Starfire", "Starsurge" }))
+            attacker->m_Events.AddEventAtOffset([attacker]() { attacker->CastSpell(attacker, 275002, true); }, 1ms);
+        if (attacker->HasAura(1181300))
+        {
+            if (WcmeNamed(spellInfo, "Shield Slam"))
+                value += int64(attacker->GetTotalAttackPowerValue(BASE_ATTACK) * 0.25f);
+            if (WcmeNamedAny(spellInfo, { "Devastate", "Revenge" }) && attacker->ToPlayer())
+            {
+                uint32 talent = 0;
+                for (uint32 id : { 46953u, 46952u, 46951u, 1146953u, 1146952u, 1146951u, 1246953u, 1246952u, 1246951u })
+                    if (attacker->ToPlayer()->HasSpell(id) && (!talent || id % 10 > talent % 10))
+                        talent = id;
+                SpellInfo const* talentInfo = talent ? sSpellMgr->GetSpellInfo(talent) : nullptr;
+                if (talentInfo && talentInfo->Effects[EFFECT_0].TriggerSpell)
+                {
+                    uint32 const buff = talentInfo->Effects[EFFECT_0].TriggerSpell;
+                    float const p = 10.0f * float(talent % 10);
+                    attacker->m_Events.AddEventAtOffset([attacker, buff, p]()
+                    {
+                        // The talent's own proc has been handled by now; it just procced if its buff is fresh.
+                        if (Aura const* fresh = attacker->GetAura(buff))
+                            if (fresh->GetMaxDuration() > 0 && fresh->GetDuration() >= fresh->GetMaxDuration() - 250)
+                                return;
+                        if (!roll_chance_f(100.0f * p / (100.0f - p)))
+                            return;
+                        if (Player* player = attacker->ToPlayer())
+                            player->RemoveCategoryCooldown(1209);
+                        attacker->CastSpell(attacker, buff, true);
+                    }, 1ms);
+                }
+            }
+        }
+        damage = int32(std::min<int64>(INT32_MAX, value));
+    }
+
+private:
+    std::unordered_map<ObjectGuid, TimePoint> _nextCut;
+};
+
+// ===== Epic batch 4 =====
+
+static uint32 WcmeHighestKnownNamed(Player* player, char const* name, SpellFamilyNames family)
+{
+    uint32 best = 0;
+    uint32 bestLevel = 0;
+    for (auto const& [id, known] : player->GetSpellMap())
+    {
+        if (known->State == PLAYERSPELL_REMOVED || !known->Active)
+            continue;
+        SpellInfo const* info = sSpellMgr->GetSpellInfo(id);
+        if (info && info->SpellFamilyName == family && WcmeNamed(info, name) && !info->IsPassive() &&
+            (!best || info->SpellLevel >= bestLevel))
+        {
+            best = id;
+            bestLevel = info->SpellLevel;
+        }
+    }
+    return best;
+}
+
+static std::list<DynamicObject*> WcmeDynObjectsNamed(Player* player, char const* name, SpellFamilyNames family)
+{
+    std::list<DynamicObject*> found;
+    for (auto const& [id, known] : player->GetSpellMap())
+        if (known->State != PLAYERSPELL_REMOVED)
+            if (SpellInfo const* info = sSpellMgr->GetSpellInfo(id); info && info->SpellFamilyName == family && WcmeNamed(info, name))
+                if (DynamicObject* dyn = player->GetDynObject(id))
+                    found.push_back(dyn);
+    return found;
+}
+
+static std::list<Unit*> WcmeAlliesNear(Unit* caster, WorldObject* center, float range, uint32 limit)
+{
+    std::list<Unit*> allies;
+    Acore::AnyFriendlyUnitInObjectRangeCheck check(center, caster, range);
+    Acore::UnitListSearcher<Acore::AnyFriendlyUnitInObjectRangeCheck> searcher(center, allies, check);
+    Cell::VisitObjects(center, searcher, range);
+    allies.remove_if([](Unit* unit) { return !unit->IsAlive() || !unit->IsControlledByPlayer(); });
+    if (allies.size() > limit)
+        allies.resize(limit);
+    return allies;
+}
+
+static std::unordered_map<ObjectGuid, TimePoint> WcmeGarroteUnlocked;   // Blood-Soaked Mutilation, until
+static thread_local bool WcmeInLightningEcho = false;
+
+// Holy Ground (81315 / 281788): every second, allies standing in your Consecration get 983813 from you (your heals on
+// them +5%, its own value). Fire Walk With Me 1584166 used to keep its helper 1584168 on you here (Scorch while moving,
+// 10 yards less range); review 2026-11-18 found the core already does both in its own code (Unit.cpp, SpellInfo.cpp),
+// so Scorch lost 20 yards. Its Flamestrike speed field stays ours (wcme_epic_batch4_spells).
+class spell_wcme_area_keeper : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_area_keeper);
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Tick(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Player* player = GetTarget()->ToPlayer();
+        if (!player)
+            return;
+        for (DynamicObject* consecration : WcmeDynObjectsNamed(player, "Consecration", SPELLFAMILY_PALADIN))
+            for (Unit* ally : WcmeAlliesNear(player, consecration, consecration->GetRadius(), 40))
+                player->CastSpell(ally, 983813, true);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_area_keeper::CalcPeriod, EFFECT_0, SPELL_AURA_ANY);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_area_keeper::Tick, EFFECT_0, SPELL_AURA_ANY);
+    }
+};
+
+// Epic batch 4, spell side:
+// - Faerie Swarm (81402 / 281916): Faerie Fire (Feral) also applies your highest known Insect Swarm.
+// - Tempered by Chaos (299180): Incinerate or Chaos Bolt cast with Molten Core up gives Tempered Cleave (299181: Fel
+//   Cleave's cooldown reset and +30% on the next one, its own data).
+// - Shooting Stars (281485): while your Starfall is up, every non-channelled spell you cast adds half its cast time to it.
+// - Fire Walk With Me (952120 / 283296 / 1584166): Flamestrike also lays its speed field where it lands (411155, +50%
+//   for allies; 1584167, +40%, for 1584166).
+// - Blood-Soaked Mutilation (1590974): Crimson Tempest has a 20% chance per combo point to let you use Garrote outside
+//   Stealth once within 10 sec; that Garrote doesn't silence.
+// - Elemental Burst (278033): Elemental Blast damage gives you 278035 (your Searing Totem attacks 50% faster, its data).
+// - Savage Momentum (1556008): the core does most of it (its pet carries the listener 1556010, whose melee special
+//   crits cast 1556009 and 1556022: 2 sec off the CoA Aimed Shot 1119434 / 1469434, Multi-Shot 1102643, Arcane Shot
+//   1103044 and Quick Shot 1121004). Review 2026-11-18: ours cut every version again, so the CoA shots lost 4 sec; now
+//   ours only cuts the other versions of those four shots (the core's ids are one-rank chains, so it never reaches
+//   them), on the same event (a pet melee special crit). The Stampede part is fixed by spell_wcme_stampede_extension.
+// - Lightning Mastery (81140, 11%) / Overload Mastery (281411, 22%): Lightning Bolt and Chain Lightning hits (Lightning
+//   Overload included) may strike the same target again for half the damage; the echo can't echo again.
+// - Chilling Blows (81213): each Frostbrand hit adds 0.3 sec to your Deep Freeze on the target; when Deep Freeze deals
+//   damage instead of stunning (a stun-immune target), its cooldown comes back 10.5 sec sooner.
+// - Mending Hands (81297 / 281724): Lay on Hands also heals every other ally within 8 yards of the target for the same
+//   amount (its longer cast time is its data).
+class wcme_epic_batch4_spells : public AllSpellScript
+{
+public:
+    wcme_epic_batch4_spells() : AllSpellScript("wcme_epic_batch4_spells", { ALLSPELLHOOK_ON_CAST, ALLSPELLHOOK_ON_HIT_RESULT,
+        ALLSPELLHOOK_ON_SPELL_CHECK_CAST }) { }
+
+    void OnSpellCheckCast(Spell* spell, bool /*strict*/, SpellCastResult& res) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        if (!caster || res != SPELL_FAILED_ONLY_STEALTHED || !WcmeNamed(spell->GetSpellInfo(), "Garrote"))
+            return;
+        auto open = WcmeGarroteUnlocked.find(caster->GetGUID());
+        if (open != WcmeGarroteUnlocked.end() && GameTime::Now() <= open->second)
+            res = SPELL_CAST_OK;
+    }
+
+    void OnSpellCast(Spell* spell, Unit* caster, SpellInfo const* info, bool /*skipCheck*/) override
+    {
+        if (!spell || !caster || !info)
+            return;
+        if (caster->HasAura(299180) && WcmeNamedAny(info, { "Incinerate", "Chaos Bolt" }) &&
+            WcmeHasAuraNamed(caster, "Molten Core", SPELLFAMILY_WARLOCK))
+            caster->CastSpell(caster, 299181, true);
+        if (caster->HasAura(281485) && !spell->IsTriggered() && !info->IsChanneled() && spell->GetCastTime() > 0)
+            for (auto const& [id, app] : caster->GetAppliedAuras())
+            {
+                Aura* aura = app->GetBase();
+                if (aura->GetSpellInfo()->SpellFamilyName == SPELLFAMILY_DRUID && WcmeNamed(aura->GetSpellInfo(), "Starfall") &&
+                    aura->GetCasterGUID() == caster->GetGUID())
+                {
+                    aura->SetMaxDuration(aura->GetMaxDuration() + spell->GetCastTime() / 2);
+                    aura->SetDuration(aura->GetDuration() + spell->GetCastTime() / 2);
+                }
+            }
+        if (WcmeNamed(info, "Flamestrike") && info->SpellFamilyName == SPELLFAMILY_MAGE && spell->m_targets.HasDst())
+        {
+            uint32 const field = caster->HasAura(1584166) ? 1584167 : WcmeHasAnyAura(caster, { 952120, 283296 }) ? 411155 : 0;
+            if (field)
+            {
+                Position const pos = spell->m_targets.GetDstPos()->GetPosition();
+                caster->CastSpell(pos.GetPositionX(), pos.GetPositionY(), pos.GetPositionZ(), field, true);
+            }
+        }
+        if (caster->HasAura(1590974) && WcmeNamed(info, "Crimson Tempest") && roll_chance_i(20 * caster->GetComboPoints()))
+            WcmeGarroteUnlocked[caster->GetGUID()] = GameTime::Now() + 10s;
+        if (WcmeNamed(info, "Garrote") && !caster->HasStealthAura())
+        {
+            auto open = WcmeGarroteUnlocked.find(caster->GetGUID());
+            if (open != WcmeGarroteUnlocked.end())
+            {
+                WcmeGarroteUnlocked.erase(open);
+                _quietGarrote[caster->GetGUID()] = GameTime::Now() + 2s;
+            }
+        }
+    }
+
+    void OnSpellHitResult(Spell* spell, Unit* target, uint8 missInfo, uint32 damage, uint32 healing, bool critical) override
+    {
+        Unit* caster = spell ? spell->GetCaster() : nullptr;
+        SpellInfo const* info = spell ? spell->GetSpellInfo() : nullptr;
+        if (!caster || !target || !info || missInfo != SPELL_MISS_NONE)
+            return;
+        if (WcmeHasAnyAura(caster, { 81402, 281916 }) && WcmeNamed(info, "Faerie Fire (Feral)"))
+            if (Player* player = caster->ToPlayer())
+                if (uint32 swarm = WcmeHighestKnownNamed(player, "Insect Swarm", SPELLFAMILY_DRUID))
+                    player->CastSpell(target, swarm, true);
+        if (damage && caster->HasAura(278033) && WcmeNamed(info, "Elemental Blast"))
+            caster->CastSpell(caster, 278035, true);
+        if (critical && damage && caster->IsPet() && info->DmgClass == SPELL_DAMAGE_CLASS_MELEE)
+            if (Player* owner = caster->GetCharmerOrOwnerPlayerOrPlayerItself(); owner && owner != caster &&
+                owner->HasAura(1556008))
+                for (auto const& [spellId, known] : owner->GetSpellMap())
+                    if (known->State != PLAYERSPELL_REMOVED && owner->HasSpellCooldown(spellId) &&
+                        spellId != 1119434 && spellId != 1469434 && spellId != 1102643 && spellId != 1103044 &&
+                        spellId != 1121004 && WcmeNamedAny(sSpellMgr->GetSpellInfo(spellId),
+                            { "Quick Shot", "Arcane Shot", "Aimed Shot", "Multi-Shot" }))
+                        owner->ModifySpellCooldown(spellId, -2000);
+        if (damage && !WcmeInLightningEcho && WcmeNamedAny(info, { "Lightning Bolt", "Chain Lightning" }) &&
+            info->SpellFamilyName == SPELLFAMILY_SHAMAN)
+        {
+            int32 const chance = caster->HasAura(281411) ? 22 : caster->HasAura(81140) ? 11 : 0;
+            if (chance && roll_chance_i(chance))
+            {
+                int64 const half = damage / 2;
+                ObjectGuid const guid = target->GetGUID();
+                uint32 const id = info->Id;
+                caster->m_Events.AddEventAtOffset([caster, guid, half, id]()
+                {
+                    Unit* victim = ObjectAccessor::GetUnit(*caster, guid);
+                    SpellInfo const* echo = sSpellMgr->GetSpellInfo(id);
+                    if (!victim || !echo)
+                        return;
+                    WcmeInLightningEcho = true;
+                    WcmeExtraDamage(caster, victim, echo, half);
+                    WcmeInLightningEcho = false;
+                }, 1ms);
+            }
+        }
+        if (caster->HasAura(81213))
+        {
+            if (damage && WcmeNamed(info, "Frostbrand Attack"))
+                for (auto const& [id, app] : target->GetAppliedAuras())
+                {
+                    Aura* aura = app->GetBase();
+                    if (aura->GetCasterGUID() == caster->GetGUID() && WcmeNamed(aura->GetSpellInfo(), "Deep Freeze") &&
+                        aura->GetDuration() > 0)
+                    {
+                        aura->SetMaxDuration(aura->GetMaxDuration() + 300);
+                        aura->SetDuration(aura->GetDuration() + 300);
+                    }
+                }
+            if (damage && WcmeNamed(info, "Deep Freeze") && info->SpellFamilyName == SPELLFAMILY_MAGE)
+                WcmeCutCooldownByName(caster, "Deep Freeze", 10500);
+        }
+        if (healing && WcmeHasAnyAura(caster, { 81297, 281724 }) && WcmeNamed(info, "Lay on Hands") && !_inMending)
+        {
+            _inMending = true;
+            for (Unit* ally : WcmeAlliesNear(caster, target, 8.0f, 40))
+                if (ally != target)
+                {
+                    HealInfo healInfo(caster, ally, healing, info, info->GetSchoolMask());
+                    caster->HealBySpell(healInfo);
+                }
+            _inMending = false;
+        }
+    }
+
+    static bool QuietGarrote(Unit* caster)
+    {
+        auto quiet = _quietGarrote.find(caster->GetGUID());
+        return quiet != _quietGarrote.end() && GameTime::Now() <= quiet->second;
+    }
