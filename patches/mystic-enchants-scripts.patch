+// Companions (81418 Arcane, 81419 Fire, 81420 Frost, 81421 Nature, 81422 Shadow): your hunter pet's auto attacks deal
+// only that school (the enchant's own school value) and 10% less damage (wcme_epic_batch2_hooks); the pet shows the
+// Companion's visual (81424-81428). Kept in step every second; the pet's school is put back when the enchant goes.
+class spell_wcme_companion : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_companion);
+
+    Creature* HunterPet() const
+    {
+        Player* player = GetTarget()->ToPlayer();
+        ::Pet* pet = player ? player->GetPet() : nullptr;
+        return pet && pet->IsAlive() && pet->getPetType() == HUNTER_PET ? pet : nullptr;
