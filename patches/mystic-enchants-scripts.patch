+// Mind Mending Armor (1106118): healing power from 30% of Intellect is the data's own aura. While you are at 40% mana
+// or more, each of your effective heals (not Arcane Echo itself) triggers Arcane Echo (1106120) on the ally 1 sec later
+// for 10% of the effective healing at 40% mana, rising evenly to 25% at 90% mana or more, measured when the heal lands.
+// The echo drains 0.5 mana per point it heals (it heals less if you run short). While Arcane Power or Resonating Power
+// is up the echo is at full value and costs no mana. Arcane Reverberation (1100170) triples the echo and makes it cost
+// 25% less mana.
+class spell_wcme_mind_mending_armor : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_mind_mending_armor);
+
+    static constexpr uint32 ECHO = 1106120;
+    static constexpr uint32 REVERBERATION = 1100170;
+    static constexpr Milliseconds ECHO_DELAY{1000};
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        HealInfo const* heal = eventInfo.GetHealInfo();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return heal && heal->GetEffectiveHeal() && spell && spell->Id != ECHO && eventInfo.GetActionTarget() &&
+            GetTarget()->GetMaxPower(POWER_MANA) > 0;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        bool const empowered = WcmeHasAnyAura(owner, { 12042, 1112042, 1112044 });
+        float const manaPct = owner->GetPowerPct(POWER_MANA);
+        if (!empowered && manaPct < 40.0f)
+            return;
+        float const share = empowered ? 25.0f : 10.0f + 15.0f * std::min(1.0f, (manaPct - 40.0f) / 50.0f);
+        bool const reverberation = owner->HasAura(REVERBERATION);
+        uint32 const echo = uint32(eventInfo.GetHealInfo()->GetEffectiveHeal() * share / 100.0f * (reverberation ? 3 : 1));
+        if (!echo)
+            return;
+        float const manaPerPoint = empowered ? 0.0f : (reverberation ? 0.375f : 0.5f);
+        ObjectGuid const allyGuid = eventInfo.GetActionTarget()->GetGUID();
+        owner->m_Events.AddEventAtOffset([owner, allyGuid, echo, manaPerPoint]()
+        {
+            SpellInfo const* echoSpell = sSpellMgr->GetSpellInfo(ECHO);
+            Unit* ally = ObjectAccessor::GetUnit(*owner, allyGuid);
+            if (!echoSpell || !ally || !ally->IsAlive() || !owner->IsAlive() || !owner->IsInWorld())
+                return;
+            uint32 amount = echo;
+            if (manaPerPoint > 0.0f)
+            {
+                uint32 const affordable = uint32(owner->GetPower(POWER_MANA) / manaPerPoint);
+                amount = std::min(amount, affordable);
+                if (!amount)
+                    return;
+                owner->ModifyPower(POWER_MANA, -int32(amount * manaPerPoint));
+            }
+            HealInfo healInfo(owner, ally, amount, echoSpell, echoSpell->GetSchoolMask());
+            owner->HealBySpell(healInfo);
+        }, ECHO_DELAY);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_mind_mending_armor::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_mind_mending_armor::HandleProc);
+    }
+};
