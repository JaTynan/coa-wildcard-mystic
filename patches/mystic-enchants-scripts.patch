+class spell_wcme_time_warp_return : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_time_warp_return);
+
+    SpellCastResult CheckMark()
+    {
+        Unit* caster = GetCaster();
+        if (!caster->HasAura(848019) || !WcmeTimeWarpPoints.count(caster->GetGUID()))
+            return SPELL_FAILED_NOT_READY;
+        return SPELL_CAST_OK;
+    }
+
+    void Return()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        auto const point = WcmeTimeWarpPoints.find(GetCaster()->GetGUID());
+        if (!player || point == WcmeTimeWarpPoints.end())
+            return;
+        WorldLocation const destination = point->second;
+        WcmeTimeWarpPoints.erase(point);
+        if (destination.GetMapId() != player->GetMapId() || player->GetDistance(destination) > 100.0f)
+            return;
+        player->NearTeleportTo(destination.GetPositionX(), destination.GetPositionY(), destination.GetPositionZ(),
+            destination.GetOrientation());
+        WcmeExtendAura(player, 965246, 3000);
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_time_warp_return::CheckMark);
+        AfterCast += SpellCastFn(spell_wcme_time_warp_return::Return);
+    }
+};
