+// Damage hooks the kits above need, which no aura script can reach:
+// - Darkmaster (983180): Drain Soul's own bonus below 25% health (4 times, in the core) is cut to 3 times; Drain Life
+//   ticks can critically hit (the leech heal follows the bigger hit); your charmed demon's or undead's ability damage
+//   adds Necromancer's Touch (983181 and the visible 983190, up to 10) to its target.
+// - Disciple of Arugal (982980): each Unstable Affliction, Curse of Agony or Curse of Doom tick on a target you tainted
+//   (983007) spends one Tainted charge, after that tick has had its bonus.
+class wcme_kit_damage_hooks : public UnitScript
+{
+public:
+    wcme_kit_damage_hooks() : UnitScript("wcme_kit_damage_hooks", true, { UNITHOOK_ON_AFTER_AURA_EFFECT_CALCULATE_AMOUNT,
+        UNITHOOK_MODIFY_PERIODIC_DAMAGE_AURAS_TICK, UNITHOOK_MODIFY_SPELL_DAMAGE_TAKEN }) { }
+
+    void OnAfterAuraEffectCalculateAmount(AuraEffect const* effect, Unit* caster, int32& amount) override
+    {
+        if (!caster || effect->GetAuraType() != SPELL_AURA_PERIODIC_DAMAGE || !WcmeIsDrainSoul(effect->GetSpellInfo()) ||
+            !caster->HasAura(983180))
+            return;
+        Unit* target = effect->GetBase()->GetUnitOwner();
+        if (target && !target->HealthAbovePct(25))
+            amount = amount * 3 / 4;
+    }
+
+    void ModifyPeriodicDamageAurasTick(Unit* target, Unit* attacker, uint32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!attacker || !target || !spellInfo || spellInfo->SpellFamilyName != SPELLFAMILY_WARLOCK)
+            return;
+        if (WcmeIsDrainLife(spellInfo) && attacker->HasAura(983180))
+        {
+            SpellSchoolMask const school = spellInfo->GetSchoolMask();
+            float const done = attacker->SpellDoneCritChance(target, spellInfo, school, BASE_ATTACK, true);
+            if (roll_chance_f(target->SpellTakenCritChance(attacker, spellInfo, school, done, BASE_ATTACK, true)))
+                damage = Unit::SpellCriticalDamageBonus(attacker, spellInfo, damage, target);
+            return;
+        }
+        bool const tainting = (spellInfo->SpellFamilyFlags[0] & 0x400) || (spellInfo->SpellFamilyFlags[1] & (0x100 | 0x2));
+        if (tainting && target->HasAura(983007, attacker->GetGUID()))
+        {
+            ObjectGuid const casterGuid = attacker->GetGUID();
+            target->m_Events.AddEventAtOffset([target, casterGuid]()
+            {
+                if (Aura* tainted = target->GetAura(983007, casterGuid))
+                    tainted->DropCharge();
+            }, 1ms);
+        }
+    }
+
+    // A buff whose tooltip gives a smaller bonus against players: its data bonus (pve per stack or charge) is scaled down
+    // to the player value for that hit.
+    static void PvpValue(Unit* attacker, SpellInfo const* spellInfo, uint32 buff, int32 pve, int32 pvp, int32& damage)
+    {
+        AuraEffect const* effect = attacker->GetAuraEffect(buff, EFFECT_0);
+        if (!effect || !effect->IsAffectedOnSpell(spellInfo))
+            return;
+        int32 const stacks = std::max<int32>(1, effect->GetBase()->GetStackAmount());
+        damage = int32(int64(damage) * (100 + pvp * stacks) / (100 + pve * stacks));
+    }
+
+    void ModifySpellDamageTaken(Unit* target, Unit* attacker, int32& damage, SpellInfo const* spellInfo) override
+    {
+        if (!target || !attacker || !spellInfo || damage <= 0 || attacker == target)
+            return;
+        if (target->IsControlledByPlayer() && attacker->IsPlayer())
+        {
+            PvpValue(attacker, spellInfo, 997050, 30, 5, damage);    // Gunslinger's Strike: Mongoose Bite +5% vs players
+            PvpValue(attacker, spellInfo, 986138, 25, 15, damage);   // Titanic Power: +15% vs players
+            PvpValue(attacker, spellInfo, 997422, 30, 10, damage);   // Arugal's Fury: Shadow Missiles +10% vs players
+        }
+        if (!attacker->IsCharmed())
+            return;
+        Unit* master = attacker->GetCharmer();
+        if (!master || !master->HasAura(983180) || WcmeDarkmasterMinion(master) != attacker)
+            return;
+        WcmeAddStackOn(master, target, 983181);
+        WcmeAddStackOn(master, target, 983190);
+    }
+};
