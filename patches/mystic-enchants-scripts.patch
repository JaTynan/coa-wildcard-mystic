+        if (Aura const* heat = target->GetAura(OVERHEATING, owner->GetGUID()))
+            if (heat->GetStackAmount() >= std::max<uint32>(1, heat->GetSpellInfo()->StackAmount))
+                owner->CastSpell(target, HEAT_STROKE, true);
