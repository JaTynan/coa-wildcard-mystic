+namespace
+{
+bool WcmeNamed(SpellInfo const* spell, char const* name)
+{
+    return spell && spell->SpellName[0] && std::strcmp(spell->SpellName[0], name) == 0;
+}
+
+bool WcmeNamedAny(SpellInfo const* spell, std::initializer_list<char const*> names)
+{
+    for (char const* name : names)
+        if (WcmeNamed(spell, name))
+            return true;
+    return false;
+}
+
+bool WcmeHasAnyAura(Unit const* unit, std::initializer_list<uint32> auras)
+{
+    for (uint32 aura : auras)
+        if (unit->HasAura(aura))
+            return true;
+    return false;
+}
+
+uint32 WcmeFirstRank(SpellInfo const* spell)
+{
+    SpellInfo const* first = spell->GetFirstRankSpell();
+    return first ? first->Id : spell->Id;
+}
+
+bool WcmeDealtDamage(ProcEventInfo& eventInfo)
+{
+    DamageInfo const* damage = eventInfo.GetDamageInfo();
+    return damage && damage->GetDamage() + damage->GetAbsorb() > 0;
+}
+
+bool WcmeCostsPower(SpellInfo const* spell)
+{
+    return spell && (spell->ManaCost || spell->ManaCostPercentage || spell->ManaCostPerlevel);
+}
+}
