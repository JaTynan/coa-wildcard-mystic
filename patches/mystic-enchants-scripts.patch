+        WcmeSyncSwap(GetTarget(), "Intercept", SPELLFAMILY_WARRIOR, 954256, false);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_dragon_warrior::CheckProc);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_dragon_warrior::HandleApply, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_dragon_warrior::HandleRemove, EFFECT_1, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnProc += AuraProcFn(spell_wcme_dragon_warrior::HandleProc);
+    }
+};
