+// Apostle of Eredath (902185): teaches Beam of Hatred (902186, wcme_enchant_teach). Soul Fire cast during Decimation, or
+// Incinerate, adds a stack of Destructive Bargain (902189, up to 5). Your last Soul Fire, Chaos Bolt or Rain of Fire
+// decides what your next Conflagrate does: Soul Fire - it spends Destructive Bargain to restore 25% of your base mana
+// per stack (125% at 5); Chaos Bolt - 5 sec off Beam of Hatred (902198); Rain of Fire - its damage over time (17964)
+// is copied in full onto every enemy your Rain of Fire hit in the last 4 sec.
+class spell_wcme_apostle_of_eredath : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_apostle_of_eredath);
+
+    enum class Empower : uint8 { NONE, SOUL_FIRE, CHAOS_BOLT, RAIN_OF_FIRE };
+
+    static constexpr uint32 BARGAIN = 902189;
+    static constexpr uint32 BEAM_CDR = 902198;
+    static constexpr uint32 CONFLAGRATE_DOT = 17964;
+    static constexpr Seconds RAIN_MEMORY{4};
+    Empower _next = Empower::NONE;
+    bool _spread = false;
+    std::unordered_map<ObjectGuid, TimePoint> _rainTargets;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || spell->SpellFamilyName != SPELLFAMILY_WARLOCK)
+            return false;
+        if (WcmeNamed(spell, "Rain of Fire"))
+            return true;
+        if (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return WcmeNamedAny(spell, { "Soul Fire", "Incinerate", "Chaos Bolt", "Conflagrate" });
+        return _spread && WcmeNamed(spell, "Conflagrate") && eventInfo.GetActionTarget();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (WcmeNamed(spell, "Rain of Fire"))
+        {
+            if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+                _next = Empower::RAIN_OF_FIRE;
+            else if (Unit* target = eventInfo.GetActionTarget())
+                _rainTargets[target->GetGUID()] = GameTime::Now();
+            return;
+        }
+        if (!(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST))
+        {
+            _spread = false;
+            ObjectGuid const sourceGuid = eventInfo.GetActionTarget()->GetGUID();
+            std::vector<ObjectGuid> targets;
+            TimePoint const now = GameTime::Now();
+            for (auto const& [guid, when] : _rainTargets)
+                if (guid != sourceGuid && now - when <= RAIN_MEMORY)
+                    targets.push_back(guid);
+            _rainTargets.clear();
+            owner->m_Events.AddEventAtOffset([owner, sourceGuid, targets]()
+            {
+                Unit* source = ObjectAccessor::GetUnit(*owner, sourceGuid);
+                AuraEffect const* dot = source ? source->GetAuraEffect(CONFLAGRATE_DOT, EFFECT_0, owner->GetGUID()) : nullptr;
+                if (!dot)
+                    return;
+                for (ObjectGuid const& guid : targets)
+                    if (Unit* enemy = ObjectAccessor::GetUnit(*owner, guid))
+                        if (enemy->IsAlive() && owner->IsValidAttackTarget(enemy))
+                            if (Aura* copy = owner->AddAura(CONFLAGRATE_DOT, enemy))
+                                if (AuraEffect* tick = copy->GetEffect(EFFECT_0))
+                                    tick->ChangeAmount(dot->GetAmount());
+            }, 200ms);
+            return;
+        }
+        if (WcmeNamed(spell, "Conflagrate"))
+        {
+            Empower const empower = _next;
+            _next = Empower::NONE;
+            if (empower == Empower::SOUL_FIRE)
+            {
+                if (uint32 const stacks = owner->GetAuraCount(BARGAIN))
+                {
+                    owner->RemoveAurasDueToSpell(BARGAIN);
+                    owner->EnergizeBySpell(owner, spell->Id, owner->GetCreateMana() * 25 * stacks / 100, POWER_MANA);
+                }
+            }
+            else if (empower == Empower::CHAOS_BOLT)
+                owner->CastSpell(owner, BEAM_CDR, true);
+            else if (empower == Empower::RAIN_OF_FIRE)
+                _spread = true;
+            return;
+        }
+        if (WcmeNamed(spell, "Chaos Bolt"))
+        {
+            _next = Empower::CHAOS_BOLT;
+            return;
+        }
+        bool const soulFire = WcmeNamed(spell, "Soul Fire");
+        if (soulFire)
+            _next = Empower::SOUL_FIRE;
+        if (!soulFire || WcmeHasAnyAura(owner, { 63165, 63167, 1163165, 1163167, 1263165, 1263167 }))
+        {
+            if (Aura* bargain = owner->GetAura(BARGAIN))
+            {
+                if (bargain->GetStackAmount() < bargain->GetSpellInfo()->StackAmount)
+                    bargain->SetStackAmount(bargain->GetStackAmount() + 1);
+                bargain->RefreshDuration();
+            }
+            else
+                owner->AddAura(BARGAIN, owner);
+        }
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_apostle_of_eredath::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_apostle_of_eredath::HandleProc);
+    }
+};
