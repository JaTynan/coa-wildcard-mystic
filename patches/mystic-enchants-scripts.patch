+// Nether Portal (1180440 teaches the portal 1180441; its buff 1180443 lasts 30 sec): while the portal is open, each
+// Shadow Bolt, Soul Fire or Incinerate you cast summons a random demon (840096 to 840099, the core's Nether Portal
+// demons with their own AI) that fights for you until the portal closes, scaled to your level and carrying the
+// portal's scaling aura (1180447). During Decimation, Soul Fire summons an additional demon. Closing the portal
+// dismisses the demons and the portal.
+class spell_wcme_nether_portal : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_nether_portal);
+
+    static constexpr uint32 PORTAL_SPELL = 1180441;
+    static constexpr uint32 PORTAL_CREATURE = 840095;
+    static constexpr uint32 SUMMON_SPELL = 1180444;
+    static constexpr uint32 SCALING = 1180447;
+    static constexpr uint32 GUARDIAN_PROPERTIES = 61;
+    static constexpr uint32 GRACE_MS = 500;
+    static constexpr std::array<uint32, 4> DEMONS = { 840096, 840097, 840098, 840099 };
+    std::vector<ObjectGuid> _demons;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Spell const* spell = eventInfo.GetProcSpell();
+        SpellInfo const* info = eventInfo.GetSpellInfo();
+        return GetTarget()->IsPlayer() && eventInfo.GetActor() == GetTarget() && spell && !spell->IsTriggered() &&
+            info && info->SpellFamilyName == SPELLFAMILY_WARLOCK && WcmeNamedAny(info, { "Shadow Bolt", "Soul Fire", "Incinerate" });
+    }
+
+    static void ScaleToOwner(Creature* demon, Unit* owner)
+    {
+        CreatureTemplate const* info = demon->GetCreatureTemplate();
+        uint8 const level = owner->GetLevel();
+        CreatureBaseStats const* stats = sObjectMgr->GetCreatureBaseStats(level, info->unit_class);
+        demon->SetLevel(level);
+        uint32 const health = std::max<uint32>(1, stats->GenerateHealth(info));
+        demon->SetCreateHealth(health);
+        demon->SetStatFlatModifier(UNIT_MOD_HEALTH, BASE_VALUE, float(health));
+        float const damage = stats->GenerateBaseDamage(info);
+        for (WeaponAttackType attack : { BASE_ATTACK, OFF_ATTACK, RANGED_ATTACK })
+        {
+            demon->SetBaseWeaponDamage(attack, MINDAMAGE, damage);
+            demon->SetBaseWeaponDamage(attack, MAXDAMAGE, damage * 1.5f);
+        }
+        demon->SetStatFlatModifier(UNIT_MOD_ATTACK_POWER, BASE_VALUE, float(stats->AttackPower));
+        demon->SetStatFlatModifier(UNIT_MOD_ATTACK_POWER_RANGED, BASE_VALUE, float(stats->RangedAttackPower));
+        demon->UpdateAllStats();
+        demon->SetFullHealth();
+    }
+
+    void SummonDemon(Unit* owner, Unit* target)
+    {
+        SummonPropertiesEntry const* properties = sSummonPropertiesStore.LookupEntry(GUARDIAN_PROPERTIES);
+        int32 const remaining = GetDuration();
+        if (!properties || remaining <= 0)
+            return;
+        Position const spot = owner->GetNearPosition(PET_FOLLOW_DIST, frand(0.0f, 2.0f * float(M_PI)));
+        TempSummon* demon = owner->GetMap()->SummonCreature(Acore::Containers::SelectRandomContainerElement(DEMONS), spot,
+            properties, uint32(remaining) + GRACE_MS, owner, SUMMON_SPELL);
+        if (!demon)
+            return;
+        demon->SetTempSummonType(TEMPSUMMON_TIMED_DESPAWN);
+        ScaleToOwner(demon, owner);
+        demon->CastSpell(demon, SCALING, true);
+        _demons.push_back(demon->GetGUID());
+        if (target && demon->IsAIEnabled && demon->IsValidAttackTarget(target))
+            demon->AI()->AttackStart(target);
+    }
+
+    void HandleProc(AuraEffect const* /*aurEff*/, ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Spell const* spell = eventInfo.GetProcSpell();
+        Unit* target = spell ? spell->m_targets.GetUnitTarget() : nullptr;
+        SummonDemon(owner, target);
+        if (WcmeNamed(eventInfo.GetSpellInfo(), "Soul Fire") &&
+            WcmeHasAnyAura(owner, { 63165, 63167, 1163165, 1163167, 1263165, 1263167 }))
+            SummonDemon(owner, target);
+    }
+
+    void Close(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        for (ObjectGuid const& guid : _demons)
+            if (Creature* demon = ObjectAccessor::GetCreature(*owner, guid))
+                demon->DespawnOrUnsummon(Milliseconds(GRACE_MS));
+        _demons.clear();
+        std::list<Creature*> portals;
+        owner->GetCreatureListWithEntryInGrid(portals, PORTAL_CREATURE, 100.0f);
+        for (Creature* portal : portals)
+            if (TempSummon* summon = portal->ToTempSummon())
+                if (summon->GetSummonerGUID() == owner->GetGUID() && portal->GetUInt32Value(UNIT_CREATED_BY_SPELL) == PORTAL_SPELL)
+                    portal->DespawnOrUnsummon(Milliseconds(GRACE_MS));
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_nether_portal::CheckProc);
+        OnEffectProc += AuraEffectProcFn(spell_wcme_nether_portal::HandleProc, EFFECT_0, SPELL_AURA_PROC_TRIGGER_SPELL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_nether_portal::Close, EFFECT_0, SPELL_AURA_PROC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+    }
+};
