+// Son of Gruul (984200), with Strength as your primary stat (WcmePrimaryStatMet): Mortal Strike shows as Hateful Strike (984226 ranks), Sundering as Ground Slam (984201 ranks)
+// and Lava Lash as Upheaval (984202 ranks), each at your level's rank. Physical Warrior ability hits have a 25% chance to
+// add a Hate charge (984211, up to 6); Ground Slam and Upheaval add 2 per cast and, if you know Rockbiter Weapon, a
+// Petrification stack (984212) on each target hit. Each Hate charge adds Seething Growth (984215, up to 10; at 10 it is
+// no longer refreshed and Ground Slam's cooldown resets). The 5th Petrification stuns for 2 sec (984214), then
+// Shatters the target (984213) for 2 more Hate; a critical Shatter deals Lava Flows' extra critical damage.
+class spell_wcme_son_of_gruul : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_son_of_gruul);
+
+    static constexpr uint32 PETRIFICATION = 984212;
+    static constexpr uint32 PETRIFIED = 984214;
+    static constexpr uint32 SHATTER = 984213;
+    TimePoint _lastSlam{};
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        active = active && WcmePrimaryStatMet(owner, 84864, STAT_STRENGTH);
+        WcmeSyncSwapRanked(owner, "Mortal Strike", SPELLFAMILY_WARRIOR, HATEFUL_STRIKE_RANKS, active);
+        WcmeSyncSwapRanked(owner, "Sundering", SPELLFAMILY_SHAMAN, GROUND_SLAM_RANKS, active);
+        WcmeSyncSwapRanked(owner, "Lava Lash", SPELLFAMILY_SHAMAN, UPHEAVAL_RANKS, active);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(984211);
+            owner->RemoveAurasDueToSpell(984215);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+  public:
+    static void GainHate(Unit* owner, uint8 count)
+    {
+        for (uint8 i = 0; i < count; ++i)
+        {
+            Aura* hate = owner->GetAura(984211);
+            if (!hate)
+            {
+                hate = owner->AddAura(984211, owner);
+                if (!hate)
+                    return;
+                hate->SetCharges(1);
+            }
+            else if (hate->GetCharges() < 6)
+            {
+                hate->SetCharges(hate->GetCharges() + 1);
+                hate->RefreshDuration();
+            }
+            Aura* growth = owner->GetAura(984215);
+            if (!growth)
+                owner->AddAura(984215, owner);
+            else if (growth->GetStackAmount() < growth->GetSpellInfo()->StackAmount)
+            {
+                growth->ModStackAmount(1);
+                if (growth->GetStackAmount() >= growth->GetSpellInfo()->StackAmount)
+                    WcmeCutCooldownByName(owner, "Ground Slam", 3600000);
+            }
+        }
+    }
+
+  private:
+    static bool IsSlam(SpellInfo const* spell) { return WcmeNamedAny(spell, { "Ground Slam", "Upheaval" }) && spell->SpellFamilyName == SPELLFAMILY_SHAMAN; }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !eventInfo.GetActionTarget() || !WcmeDealtDamage(eventInfo) || !WcmePrimaryStatMet(GetTarget(), 84864, STAT_STRENGTH))
+            return false;
+        if (IsSlam(spell))
+            return true;
+        if (spell->Id == SHATTER)
+            return eventInfo.GetHitMask() & PROC_HIT_CRITICAL;
+        return spell->SpellFamilyName == SPELLFAMILY_WARRIOR && (spell->GetSchoolMask() & SPELL_SCHOOL_MASK_NORMAL) && roll_chance_i(25);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* target = eventInfo.GetActionTarget();
+        if (eventInfo.GetSpellInfo()->Id == SHATTER)
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            for (AuraEffect const* effect : owner->GetAuraEffectsByType(SPELL_AURA_ADD_PCT_MODIFIER))
+                if (WcmeNamed(effect->GetSpellInfo(), "Lava Flows") && effect->GetMiscValue() == SPELLMOD_CRIT_DAMAGE_BONUS)
+                {
+                    WcmeExtraDamage(owner, target, eventInfo.GetSpellInfo(), int64(damage->GetDamage() + damage->GetAbsorb()) * effect->GetAmount() / 200);
+                    return;
+                }
+            return;
+        }
+        if (!IsSlam(eventInfo.GetSpellInfo()))
+        {
+            GainHate(owner, 1);
+            return;
+        }
+        if (GameTime::Now() - _lastSlam > 200ms)
+        {
+            _lastSlam = GameTime::Now();
+            GainHate(owner, 2);
+        }
+        if (!WcmeKnowsPassive(owner, "Rockbiter Weapon", SPELLFAMILY_SHAMAN))
+            return;
+        WcmeAddStackOn(owner, target, PETRIFICATION);
+        if (target->GetAuraCount(PETRIFICATION) < 5)
+            return;
+        target->RemoveAurasDueToSpell(PETRIFICATION, owner->GetGUID());
+        owner->CastSpell(target, PETRIFIED, true);
+        ObjectGuid const targetGuid = target->GetGUID();
+        owner->m_Events.AddEventAtOffset([owner, targetGuid]()
+        {
+            if (Unit* victim = ObjectAccessor::GetUnit(*owner, targetGuid))
+                if (victim->IsAlive())
+                    owner->CastSpell(victim, SHATTER, true);
+        }, 2s);
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_son_of_gruul::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_son_of_gruul::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_son_of_gruul::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_son_of_gruul::HandleProc);
+    }
+};
