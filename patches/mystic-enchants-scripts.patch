+// Deadly Follow-up (979081, the ability): needs a charge of Poisoned Shiv (979082) and spends one; the hit applies the
+// poison on each of your weapons twice (its dummy effect).
+class spell_wcme_deadly_follow_up : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_deadly_follow_up);
+
+    SpellCastResult CheckCast()
+    {
+        return GetCaster()->HasAura(979082) ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void HandleCast()
+    {
+        if (Aura* charges = GetCaster()->GetAura(979082))
+        {
+            if (charges->GetCharges() > 1)
+                charges->SetCharges(charges->GetCharges() - 1);
+            else
+                charges->Remove();
+        }
+    }
+
+    void HandlePoisons(SpellEffIndex /*effIndex*/)
+    {
+        Player* player = GetCaster()->ToPlayer();
+        Unit* target = GetHitUnit();
+        if (!player || !target)
+            return;
+        for (uint8 slot : { EQUIPMENT_SLOT_MAINHAND, EQUIPMENT_SLOT_OFFHAND })
+        {
+            Item* weapon = player->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+            uint32 const enchantId = weapon ? weapon->GetEnchantmentId(TEMP_ENCHANTMENT_SLOT) : 0;
+            SpellItemEnchantmentEntry const* enchant = enchantId ? sSpellItemEnchantmentStore.LookupEntry(enchantId) : nullptr;
+            if (!enchant)
+                continue;
+            for (uint32 poison : enchant->spellid)
+                if (SpellInfo const* info = poison ? sSpellMgr->GetSpellInfo(poison) : nullptr; info &&
+                    info->Dispel == DISPEL_POISON)
+                    for (uint8 i = 0; i < 2; ++i)
+                        player->CastSpell(target, poison, true);
+        }
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_deadly_follow_up::CheckCast);
+        OnCast += SpellCastFn(spell_wcme_deadly_follow_up::HandleCast);
+        OnEffectHitTarget += SpellEffectFn(spell_wcme_deadly_follow_up::HandlePoisons, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
