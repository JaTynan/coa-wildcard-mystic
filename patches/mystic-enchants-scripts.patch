+// explodes for Fire damage around itself (990141) and empowers your summoned demon (990138: +20% damage against
+// creatures, up to 4 stacks, 20 sec). Every second your Wild Imps are given Demonic Persistence's pet aura (990131,
+// passive, from the client data): their critical strikes take 1 sec off Hand of Gul'dan's cooldown and restore 3% mana
+// to your summoned demon, at most once a second (spell_wcme_demonic_persistence_imp). The tooltip's "deteriorate over
+// time" is taken to be the imps' own summon duration; it gives no rate.
+class spell_wcme_demonic_persistence : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_demonic_persistence);
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void ChargeImps(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        for (Unit* minion : GetTarget()->m_Controlled)
+            if (minion && minion->IsAlive() && minion->GetTypeId() == TYPEID_UNIT && minion->GetName() == "Wild Imp" &&
+                !minion->HasAura(990131))
+                minion->AddAura(990131, minion);
+    }
+
+    Unit* WeakestImp() const
+    {
+        Unit* best = nullptr;
+        for (Unit* minion : GetTarget()->m_Controlled)
+            if (minion && minion->IsAlive() && minion->GetTypeId() == TYPEID_UNIT && minion->GetName() == "Wild Imp" &&
+                (!best || minion->GetHealth() < best->GetHealth()))
+                best = minion;
+        return best;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) && WcmeNamedAny(eventInfo.GetSpellInfo(), { "Incinerate", "Mind Blast" }) &&
+            WeakestImp();
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        Unit* imp = WeakestImp();
+        if (!imp)
+            return;
+        owner->CastSpell(imp->GetPositionX(), imp->GetPositionY(), imp->GetPositionZ(), 990141, true);
+        owner->CastSpell(owner, 990138, true);
+        Unit::Kill(owner, imp);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_demonic_persistence::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_demonic_persistence::HandleProc);
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_demonic_persistence::CalcPeriod, EFFECT_0,
+            SPELL_AURA_PROC_TRIGGER_SPELL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_demonic_persistence::ChargeImps, EFFECT_0,
+            SPELL_AURA_PROC_TRIGGER_SPELL);
+    }
