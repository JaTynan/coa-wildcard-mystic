+// Dark Surgeon (978209): teaches Hippocratic Oath (978430: healing power from 20% of attack power); the core's own
+// replacement turns Holy Nova into Dark Transfusion (978640, spell_wcme_dark_transfusion). Healing taken is 30% lower
+// (Dark Surgeon's Oath, 9990021). Mutilate damage gives a stack of Dark Surgeon (978429, up to 2, with its Circle of
+// Healing bonus 978856). Damaging Rogue finishing moves then have a 10% chance per stack per combo point to spend it on
+// a Lesser Circle of Healing (978855): up to 5 allies within 30 yards (6 with Glyph of Circle of Healing) are healed
+// for 3.575 x level + 9 + 15.6% SP + 7.8% AP, and 1.7875 x level + 9 + 7.8% SP + 3.9% AP more over 3 sec. Damaging
+// finishing moves also have a 20% chance per combo point to give a stack of Trauma Care (979021, up to 2): Flash Heal
+// keeps it, the next Greater Heal spends it.
+class spell_wcme_dark_surgeon : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_dark_surgeon);
+
+    static constexpr uint32 SURGEON = 978429;
+    static constexpr uint32 SURGEON_COH = 978856;
+    static constexpr uint32 LESSER_COH = 978855;
+    static constexpr uint32 TRAUMA_CARE = 979021;
+    static constexpr uint32 OATH_PENALTY = 9990021;
+    static constexpr std::array<uint32, 1> OATH = { 978430 };
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncTaughtRank(GetTarget(), OATH, true);
+        if (!GetTarget()->HasAura(OATH_PENALTY))
+            GetTarget()->AddAura(OATH_PENALTY, GetTarget());
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncTaughtRank(GetTarget(), OATH, false);
+        GetTarget()->RemoveAurasDueToSpell(OATH_PENALTY);
+    }
+
+    static void AddCappedStack(Unit* owner, uint32 spellId)
+    {
+        Aura* aura = owner->GetAura(spellId);
+        if (!aura)
+        {
+            aura = owner->AddAura(spellId, owner);
+            if (aura && spellId == TRAUMA_CARE)
+                aura->SetCharges(0);
+            return;
+        }
+        if (aura->GetStackAmount() < aura->GetSpellInfo()->StackAmount)
+            aura->SetStackAmount(aura->GetStackAmount() + 1);
+        aura->RefreshDuration();
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_FINISH)
+            return WcmeNamed(spell, "Greater Heal") && GetTarget()->HasAura(TRAUMA_CARE);
+        if (spell->SpellFamilyName != SPELLFAMILY_ROGUE)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->NeedsComboPoints() && WcmeDealsAnyDamage(spell);
+        return WcmeNamed(spell, "Mutilate") && WcmeDealtDamage(eventInfo);
+    }
+
+    static uint32 Healed(Unit* caster, Unit* ally, SpellInfo const* heal, uint32 base)
+    {
+        uint32 amount = caster->SpellHealingBonusDone(ally, heal, base, ::HEAL, EFFECT_0);
+        return ally->SpellHealingBonusTaken(caster, heal, amount, ::HEAL);
+    }
+
+    void LesserCircle(Unit* owner)
+    {
+        SpellInfo const* heal = sSpellMgr->GetSpellInfo(LESSER_COH);
+        if (!heal)
+            return;
+        float const level = float(owner->GetLevel());
+        float const sp = float(owner->SpellBaseHealingBonusDone(SPELL_SCHOOL_MASK_ALL));
+        float const ap = WcmeAttackPower(owner);
+        uint32 const direct = uint32(3.575f * level + 9 + 0.156f * sp + 0.078f * ap);
+        uint32 const overTime = uint32(1.7875f * level + 9 + 0.078f * sp + 0.039f * ap);
+        for (Unit* ally : WcmeAlliesNear(owner, owner, 30.0f, owner->HasAura(55675) ? 6 : 5))
+        {
+            uint32 amount = Healed(owner, ally, heal, direct);
+            float chance = owner->SpellDoneCritChance(ally, heal, heal->GetSchoolMask(), BASE_ATTACK, false);
+            chance = ally->SpellTakenCritChance(owner, heal, heal->GetSchoolMask(), chance, BASE_ATTACK, false);
+            bool const crit = roll_chance_f(chance);
+            if (crit)
+                amount = Unit::SpellCriticalHealingBonus(owner, heal, amount, ally);
+            HealInfo healInfo(owner, ally, amount, heal, heal->GetSchoolMask());
+            owner->HealBySpell(healInfo, crit);
+            ObjectGuid const allyGuid = ally->GetGUID();
+            for (uint32 tick = 1; tick <= 3; ++tick)
+                owner->m_Events.AddEventAtOffset([owner, allyGuid, overTime]()
+                {
+                    SpellInfo const* tickHeal = sSpellMgr->GetSpellInfo(LESSER_COH);
+                    Unit* target = ObjectAccessor::GetUnit(*owner, allyGuid);
+                    if (!tickHeal || !target || !target->IsAlive() || !owner->IsInWorld())
+                        return;
+                    HealInfo tickInfo(owner, target, Healed(owner, target, tickHeal, overTime / 3), tickHeal, tickHeal->GetSchoolMask());
+                    owner->HealBySpell(tickInfo);
+                }, Seconds(tick));
+        }
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_FINISH)
+        {
+            owner->RemoveAurasDueToSpell(TRAUMA_CARE);
+            return;
+        }
+        if (!(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST))
+        {
+            AddCappedStack(owner, SURGEON);
+            AddCappedStack(owner, SURGEON_COH);
+            return;
+        }
+        // combo points are still on the caster during the cast phase
+        uint8 const points = owner->GetComboPoints();
+        if (!points)
+            return;
+        if (roll_chance_i(std::min(100, 20 * points)))
+            AddCappedStack(owner, TRAUMA_CARE);
+        Aura* surgeon = owner->GetAura(SURGEON);
+        if (surgeon && roll_chance_i(std::min(100, 10 * surgeon->GetStackAmount() * points)))
+        {
+            owner->RemoveAurasDueToSpell(SURGEON);
+            owner->RemoveAurasDueToSpell(SURGEON_COH);
+            LesserCircle(owner);
+        }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_dark_surgeon::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_dark_surgeon::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_dark_surgeon::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_dark_surgeon::HandleProc);
+    }
+};
