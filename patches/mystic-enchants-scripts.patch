+// ===== Epic batches 6 and 7 =====
+
+static std::unordered_map<ObjectGuid, std::pair<uint32, TimePoint>> WcmeMarkedCast;    // caster: spell cast with a buff up
+static std::unordered_map<ObjectGuid, std::pair<ObjectGuid, TimePoint>> WcmeAmbushStealthed; // Double Agent: target, until
+static std::unordered_map<ObjectGuid, TimePoint> WcmeBloodsurgeReady;                 // Ol' Bloodsurge 4 sec cooldown
+static std::unordered_map<ObjectGuid, TimePoint> WcmeBloodsurgeBonus;                 // next direct ability +20%, until
+static std::unordered_map<ObjectGuid, ObjectGuid> WcmeSearingFlamesTarget;            // caster: the one Immolate target
+static std::unordered_map<ObjectGuid, std::pair<int64, TimePoint>> WcmeLingeringDeath; // target: heals still negated
+static std::map<std::pair<ObjectGuid, ObjectGuid>, int32> WcmeGoreBonus;              // (target, caster): bonus %
+static std::unordered_map<ObjectGuid, TimePoint> WcmeAegisReady;                      // avoidance trigger, 5 sec
+
+static void WcmeMarkCast(Unit* caster, uint32 spellId)
+{
+    WcmeMarkedCast[caster->GetGUID()] = { spellId, GameTime::Now() + 5s };
+}
+
+static bool WcmeTakeMark(Unit* caster, uint32 spellId)
+{
+    auto mark = WcmeMarkedCast.find(caster->GetGUID());
+    if (mark == WcmeMarkedCast.end() || mark->second.first != spellId || GameTime::Now() > mark->second.second)
+        return false;
+    WcmeMarkedCast.erase(mark);
+    return true;
+}
+
+static Unit* WcmeLowestAlly(Player* player, Unit* exclude, float range)
+{
+    Unit* best = nullptr;
+    for (Unit* ally : WcmeAlliesNear(player, player, range, 40))
+        if (ally != exclude && ally->GetHealth() < ally->GetMaxHealth() && (!best || ally->GetHealthPct() < best->GetHealthPct()))
+            best = ally;
+    return best;
+}
+
+// Void Shift (954522, the Priest spell; 2304522, the Artifact copy taught by 1398201): the spell is a plain dummy and the
+// core has no script for it. You and the targeted party or raid member swap health percentages, each raised to at least
+// 25% (10% for 2304522, its text). 954522 also puts Void Instability (956037, 1 min) on both of you, and neither can
+// cast it or be its target while that is up; 2304522's text has no lockout, so none is added for it.
+class spell_wcme_void_shift : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_void_shift);
+
+    uint32 Lockout()
+    {
+        return GetSpellInfo()->Id == 954522 ? 956037 : 0;
+    }
+
+    SpellCastResult CheckCast()
+    {
+        Unit* caster = GetCaster();
+        Unit* target = GetExplTargetUnit();
+        if (!target || target == caster)
+            return SPELL_FAILED_BAD_TARGETS;
+        if (uint32 lockout = Lockout())
+        {
+            if (caster->HasAura(lockout))
+                return SPELL_FAILED_CASTER_AURASTATE;
+            if (target->HasAura(lockout))
+                return SPELL_FAILED_TARGET_AURASTATE;
+        }
+        return SPELL_CAST_OK;
+    }
+
+    void HandleSwap(SpellEffIndex /*effIndex*/)
+    {
+        Unit* caster = GetCaster();
+        Unit* target = GetHitUnit();
+        if (!caster || !target || target == caster || !caster->IsAlive() || !target->IsAlive())
+            return;
+        float const floor = GetSpellInfo()->Id == 2304522 ? 10.0f : 25.0f;
+        float const mine = caster->GetHealthPct();
+        float const theirs = target->GetHealthPct();
+        auto setPct = [](Unit* unit, float pct)
+        {
+            uint32 const health = uint32(double(unit->GetMaxHealth()) * pct / 100.0);
+            unit->SetHealth(std::clamp<uint32>(health, 1, unit->GetMaxHealth()));
+        };
+        setPct(caster, std::max(theirs, floor));
+        setPct(target, std::max(mine, floor));
+        if (uint32 lockout = Lockout())
+            for (Unit* who : { caster, target })
+                if (!who->HasAura(lockout))
+                    caster->AddAura(lockout, who);
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_void_shift::CheckCast);
+        OnEffectHitTarget += SpellEffectFn(spell_wcme_void_shift::HandleSwap, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
