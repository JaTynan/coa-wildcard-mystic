+// Enemies of `caster` within `radius` yards of `center`, nearest first, at most `limit`.
+std::list<Unit*> WcmeEnemiesNear(Unit* caster, Unit* center, float radius, size_t limit)
+{
+    std::list<Unit*> enemies;
+    Acore::AnyUnfriendlyUnitInObjectRangeCheck check(center, caster, radius);
+    Acore::UnitListSearcher<Acore::AnyUnfriendlyUnitInObjectRangeCheck> searcher(center, enemies, check);
+    Cell::VisitObjects(center, searcher, radius);
+    enemies.remove_if([caster](Unit* enemy) { return !enemy->IsAlive() || !caster->IsValidAttackTarget(enemy); });
+    enemies.sort([center](Unit* first, Unit* second) { return center->GetDistance(first) < center->GetDistance(second); });
+    if (enemies.size() > limit)
+        enemies.resize(limit);
+    return enemies;
+}
