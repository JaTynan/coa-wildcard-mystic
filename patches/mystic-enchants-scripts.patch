+// Shadow Artillery (998204): needs 3 Shadow Shells (997539) and spends them.
+class spell_wcme_shadow_artillery : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_shadow_artillery);
+
+    static constexpr uint32 SHELLS = 997539;
+
+    SpellCastResult CheckCast()
+    {
+        return GetCaster()->GetAuraCount(SHELLS) >= 3 ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void HandleAfterCast()
