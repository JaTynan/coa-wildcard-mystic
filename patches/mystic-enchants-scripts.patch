+bool WcmeIsShamanDirectNatureHeal(SpellInfo const* spell)
+{
+    if (!spell || !(spell->GetSchoolMask() & SPELL_SCHOOL_MASK_NATURE))
+        return false;
+    for (SpellEffectInfo const& effect : spell->GetEffects())
+        if (effect.Effect == SPELL_EFFECT_HEAL)
+            return true;
+    return false;
+}
