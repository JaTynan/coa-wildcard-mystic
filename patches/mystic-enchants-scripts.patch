+// "Cast an additional random <class> spell for free" (Crazy Cultist, Deranged Druid, Eccentric Elementalist, Wacky
+// Wizardry, Zany Zealot; two versions each): an offensive spell of that class, cast at a target, has the enchant's
+// chance (25% or 15%, from its spell data) to also cast a random damaging spell of the same class that you know
+// (highest rank you have; not channeled, not ground-targeted, no cooldown of a minute or more) at that target, free.
+class spell_wcme_random_class_spell : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_random_class_spell);
+
+    uint32 Family() const
+    {
+        switch (GetId())
+        {
+            case 84529: case 1568195: return SPELLFAMILY_WARLOCK;
+            case 84531: case 1568216: return SPELLFAMILY_DRUID;
+            case 84533: case 1568237: return SPELLFAMILY_SHAMAN;
+            case 965442: case 1571306: return SPELLFAMILY_MAGE;
+            default: return SPELLFAMILY_PRIEST;   // 84527, 1568174
+        }
+    }
+
+    static Unit* CastTarget(ProcEventInfo& eventInfo)
+    {
+        Spell const* cast = eventInfo.GetProcSpell();
+        return cast ? cast->m_targets.GetUnitTarget() : nullptr;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = CastTarget(eventInfo);
+        return spell && (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST) && spell->SpellFamilyName == Family() &&
+            !spell->IsPositive() && WcmeDealsDamage(spell) && target && target != GetTarget() && target->IsAlive();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Player* player = GetTarget()->ToPlayer();
+        Unit* target = CastTarget(eventInfo);
+        if (!player || !target)
+            return;
+        std::vector<uint32> pool;
+        for (auto const& [spellId, known] : player->GetSpellMap())
+        {
+            if (known->State == PLAYERSPELL_REMOVED || !known->Active)
+                continue;
+            SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId);
+            if (!info || info->SpellFamilyName != Family() || info->IsPassive() || info->IsPositive() || !WcmeDealsDamage(info) ||
+                info->IsChanneled() || !info->NeedsExplicitUnitTarget() || info->RecoveryTime >= 60000 ||
+                info->CategoryRecoveryTime >= 60000)
+                continue;
+            if (SpellInfo const* next = info->GetNextRankSpell())
+                if (player->HasSpell(next->Id))
+                    continue;
+            pool.push_back(spellId);
+        }
+        if (!pool.empty())
+            player->CastSpell(target, Acore::Containers::SelectRandomContainerElement(pool), true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_random_class_spell::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_random_class_spell::HandleProc);
+    }
+};
