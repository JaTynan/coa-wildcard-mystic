+
+    static constexpr uint32 SWEEP = 417699;
+    static constexpr uint32 ERUPTION = 417707;
+    static constexpr uint32 SUNDERING = 417696;
+    static constexpr uint32 SWEEPER = 417705;
+    static constexpr uint32 DOOMHAMMERS_FURY = 417701;
+    static constexpr uint32 DOOMHAMMERS_FURY_SHOCKS = 417708;
+    static constexpr std::array<uint32, 1> TAUGHT = { SWEEP };
+
+    static bool Knows(Player* player, char const* name)
+    {
+        for (auto const& [spellId, known] : player->GetSpellMap())
+            if (known->State != PLAYERSPELL_REMOVED && spellId != SWEEP && WcmeNamed(sSpellMgr->GetSpellInfo(spellId), name))
+                return true;
+        return false;
+    }
+
+    void Sync(bool keep)
+    {
+        Player* player = GetTarget()->ToPlayer();
+        WcmeSyncTaughtRank(GetTarget(), TAUGHT, keep && player && Knows(player, "Lava Lash"));
