+class spell_wcme_abyssal_hunger : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_abyssal_hunger);
+
+    static constexpr uint32 FEED = 1154363;
+    int64 _stored = 0;
+
+    void CalcAmount(AuraEffect const* /*aurEff*/, int32& amount, bool& /*canBeRecalculated*/)
+    {
+        amount = -1;
+    }
+
+    void Absorb(AuraEffect* /*aurEff*/, DamageInfo& dmgInfo, uint32& absorbAmount)
+    {
+        Unit* owner = GetTarget();
+        float chance = 10.0f;
+        if (Player* player = owner->ToPlayer())
+            chance += player->GetFloatValue(uint16(PLAYER_SPELL_CRIT_PERCENTAGE1) + uint16(SPELL_SCHOOL_SHADOW));
+        if (!dmgInfo.GetDamage() || !roll_chance_f(chance))
+        {
+            absorbAmount = 0;
+            return;
+        }
+        absorbAmount = dmgInfo.GetDamage();
+        if (!_stored && !owner->HasAura(FEED))
+            owner->AddAura(FEED, owner);
+        _stored += absorbAmount;
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return _stored > 0 && !GetTarget()->HasAura(FEED) && WcmeNamed(eventInfo.GetSpellInfo(), "Life Tap") &&
+            (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST);
+    }
+
+    void HandleProc(ProcEventInfo& /*eventInfo*/)
+    {
+        Unit* owner = GetTarget();
+        SpellInfo const* feed = sSpellMgr->GetSpellInfo(FEED);
+        int64 const stored = _stored;
+        std::list<Unit*> enemies = WcmeEnemiesNear(owner, owner, 10.0f, 5);
+        if (!feed || enemies.empty())
+            return;
+        _stored = 0;
+        int64 dealt = 0;
+        int32 const share = int32(std::min<int64>(stored / int64(enemies.size()), INT32_MAX));
+        for (Unit* enemy : enemies)
+        {
+            SpellNonMeleeDamage log(owner, enemy, feed, feed->GetSchoolMask());
+            owner->CalculateSpellDamageTaken(&log, share, feed);
+            dealt += log.damage;
+            owner->SendSpellNonMeleeDamageLog(&log);
+            owner->DealSpellDamage(&log, false);
+        }
+        uint32 const heal = uint32(std::min<int64>(dealt / 2, INT32_MAX));
+        if (!heal)
+            return;
+        HealInfo self(owner, owner, heal, feed, feed->GetSchoolMask());
+        owner->HealBySpell(self);
+        if (Pet* pet = owner->ToPlayer() ? owner->ToPlayer()->GetPet() : nullptr)
+            if (pet->IsAlive())
+            {
+                HealInfo petHeal(owner, pet, heal, feed, feed->GetSchoolMask());
+                owner->HealBySpell(petHeal);
+            }
+    }
+
+    void Register() override
+    {
+        DoEffectCalcAmount += AuraEffectCalcAmountFn(spell_wcme_abyssal_hunger::CalcAmount, EFFECT_0, SPELL_AURA_SCHOOL_ABSORB);
+        OnEffectAbsorb += AuraEffectAbsorbFn(spell_wcme_abyssal_hunger::Absorb, EFFECT_0);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_abyssal_hunger::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_abyssal_hunger::HandleProc);
+    }
+};
