+// Master of Shadows (980046): Sinister Strike, Eviscerate, Garrote, Rupture, Crimson Tempest and Gloomblade's first hit
+// also deal 49 + 11.5% SP + 11.5% AP Shadow damage (Dark Intent, 980050). Sinister Strike and Gloomblade critical
+// strikes add a stack of Apprentice of Shadows (980048, up to 3); Eviscerate or Rupture at 3 stacks spends them for
+// Master of Shadows (980049: +30% Shadow damage, and 980065: +10% Shadow crit, 10 sec).
+class spell_wcme_master_of_shadows : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_master_of_shadows);
+
+    static constexpr uint32 SHADOW_HIT = 980050;
+    static constexpr uint32 APPRENTICE = 980048;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        Unit* target = eventInfo.GetActionTarget();
+        return spell && spell->Id != SHADOW_HIT && target && target != GetTarget() && !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
