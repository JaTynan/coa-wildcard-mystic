+// Stormbound Instinct (1181360): Shocks deal double threat (the data's own spell mod), give a stack of Maelstrom Weapon
+// (53817) if you have the talent, and Stormbound Reflexes (1181363: +20% dodge until the next attack against you).
+// 30% of the damage your Shocks deal also hits every other enemy within 10 yards of the target (1181365). Primal
+// Strike, Lightning Bolt and Chain Lightning make your next Shock trigger no cooldown (2414024, removed by that Shock).
+class spell_wcme_stormbound_instinct : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_stormbound_instinct);
+
+    static constexpr uint32 NO_COOLDOWN = 2414024;
+    static constexpr uint32 REFLEXES = 1181363;
+    static constexpr uint32 SPREAD = 1181365;
+    static constexpr uint32 MAELSTROM = 53817;
+
+    static bool IsShock(SpellInfo const* spell)
+    {
+        return WcmeNamedAny(spell, { "Earth Shock", "Flame Shock", "Frost Shock" });
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        if (eventInfo.GetTypeMask() & (PROC_FLAG_TAKEN_MELEE_AUTO_ATTACK | PROC_FLAG_TAKEN_SPELL_MELEE_DMG_CLASS))
+            return GetTarget()->HasAura(REFLEXES);
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || spell->Id == SPREAD)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return IsShock(spell) || WcmeNamedAny(spell, { "Primal Strike", "Lightning Bolt", "Chain Lightning" });
+        return IsShock(spell) && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (eventInfo.GetTypeMask() & (PROC_FLAG_TAKEN_MELEE_AUTO_ATTACK | PROC_FLAG_TAKEN_SPELL_MELEE_DMG_CLASS))
+        {
+            owner->RemoveAurasDueToSpell(REFLEXES);
+            return;
+        }
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (!IsShock(spell))
+            {
+                owner->AddAura(NO_COOLDOWN, owner);
+                return;
+            }
+            owner->RemoveAurasDueToSpell(NO_COOLDOWN);
+            owner->AddAura(REFLEXES, owner);
+            if (WcmeHasAnyAura(owner, { 51528, 51529, 51530, 51531, 51532 }))
+            {
+                Aura* maelstrom = owner->GetAura(MAELSTROM);
+                if (!maelstrom)
+                    owner->AddAura(MAELSTROM, owner);
+                else
+                {
+                    if (maelstrom->GetStackAmount() < maelstrom->GetSpellInfo()->StackAmount)
+                        maelstrom->SetStackAmount(maelstrom->GetStackAmount() + 1);
+                    maelstrom->RefreshDuration();
+                }
+            }
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        SpellInfo const* spread = sSpellMgr->GetSpellInfo(SPREAD);
+        if (!spread)
+            return;
+        DamageInfo const* damage = eventInfo.GetDamageInfo();
+        int64 const share = int64(damage->GetDamage() + damage->GetAbsorb()) * 30 / 100;
+        for (Unit* enemy : WcmeEnemiesNear(owner, target, 10.0f, 20))
+            if (enemy != target)
+                WcmeExtraDamage(owner, enemy, spread, share);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_stormbound_instinct::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_stormbound_instinct::HandleProc);
+    }
+};
