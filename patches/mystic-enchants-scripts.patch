+// Mending Tides (944823): each 2-sec pulse heals the ally and up to 5 allies within 8 yards for about 256 at level 60
+// (the tooltip's 251.64 to 260.64, scaled by the caster's level) plus healing bonuses, and can critically strike.
+class spell_wcme_mending_tide_pulse : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_mending_tide_pulse);
+
+    static constexpr uint32 HEAL = 944826;
+    static constexpr uint32 CHAINS = 944825;
+
+    void Pulse(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Unit* caster = GetCaster();
+        SpellInfo const* heal = sSpellMgr->GetSpellInfo(HEAL);
+        if (!caster || !heal)
+            return;
+        uint32 const base = 256 * caster->GetLevel() / 60;
+        for (Unit* ally : WcmeAlliesNear(caster, GetTarget(), 8.0f, 6))
+        {
+            uint32 amount = caster->SpellHealingBonusDone(ally, heal, base, ::HEAL, EFFECT_0);
+            amount = ally->SpellHealingBonusTaken(caster, heal, amount, ::HEAL);
+            float chance = caster->SpellDoneCritChance(ally, heal, heal->GetSchoolMask(), BASE_ATTACK, false);
+            chance = ally->SpellTakenCritChance(caster, heal, heal->GetSchoolMask(), chance, BASE_ATTACK, false);
+            bool const crit = roll_chance_f(chance);
+            if (crit)
+                amount = Unit::SpellCriticalHealingBonus(caster, heal, amount, ally);
+            HealInfo healInfo(caster, ally, amount, heal, heal->GetSchoolMask());
+            caster->HealBySpell(healInfo, crit);
