+// Resonating Power (1112044, Arcane Power for an Arcane Reverberation wearer): lasts until your mana drops below 30%.
+// Every 2 sec it adds a stack of Resonating Power (1112045: 2% haste and healing per stack, the data's own effect) and
+// borrows 3% of your maximum mana. When it ends, for any reason, the borrowed mana comes back over 3 sec. The data's
+// own drain and regen triggers (1112046, 1112048) are replaced by this.
+class spell_wcme_resonating_power : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_resonating_power);
+
+    int32 _borrowed = 0;
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        GetAura()->SetMaxDuration(-1);
+        GetAura()->SetDuration(-1);
+    }
+
+    void Borrow(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        int32 const amount = int32(owner->GetMaxPower(POWER_MANA) * 3 / 100);
+        int32 const taken = std::min<int32>(amount, owner->GetPower(POWER_MANA));
+        owner->ModifyPower(POWER_MANA, -taken);
+        _borrowed += taken;
+        if (owner->GetPowerPct(POWER_MANA) < 30.0f)
+            GetAura()->Remove(AURA_REMOVE_BY_EXPIRE);
+    }
+
+    void Skip(AuraEffect const* /*aurEff*/)
+    {
+        PreventDefaultAction();
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        int32 const perTick = _borrowed / 3;
+        _borrowed = 0;
+        if (perTick <= 0)
+            return;
+        for (uint32 tick = 1; tick <= 3; ++tick)
+            owner->m_Events.AddEventAtOffset([owner, perTick]()
+            {
+                if (owner->IsAlive() && owner->IsInWorld())
+                    owner->ModifyPower(POWER_MANA, perTick);
+            }, Seconds(tick));
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_resonating_power::HandleApply, EFFECT_0, SPELL_AURA_PERIODIC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_resonating_power::Borrow, EFFECT_1, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_resonating_power::Skip, EFFECT_2, SPELL_AURA_PERIODIC_TRIGGER_SPELL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_resonating_power::HandleRemove, EFFECT_0, SPELL_AURA_PERIODIC_TRIGGER_SPELL, AURA_EFFECT_HANDLE_REAL);
+    }
+};
