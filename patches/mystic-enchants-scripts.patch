+        isPeriodic = true;
+        amplitude = 500;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Slice and Dice", SPELLFAMILY_ROGUE, SLICE_AND_ICE, active);
+        WcmeSyncSwapRanked(owner, "Cone of Cold", SPELLFAMILY_MAGE, WINDS, active);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(CRIT_HELPER);
+            owner->RemoveAurasDueToSpell(WINTERS_FURY);
