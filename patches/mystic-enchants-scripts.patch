+class spell_wcme_time_warp : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_time_warp);
+
+    static constexpr uint32 DISTORTION = 965246;
+    static constexpr uint32 WARP_MARK = 848019;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || !(eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST))
+            return false;
+        if (WcmeNamed(spell, "Blink"))
+            return true;
+        Spell const* cast = eventInfo.GetProcSpell();
+        return cast && cast->GetCastTime() > 0 && WcmeDealsAnyDamage(spell);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        if (WcmeNamed(eventInfo.GetSpellInfo(), "Blink"))
+        {
+            WcmeTimeWarpPoints[owner->GetGUID()] = owner->GetWorldLocation();
+            owner->CastSpell(owner, DISTORTION, true);
+            owner->AddAura(WARP_MARK, owner);
+            return;
+        }
+        WcmeExtendAura(owner, DISTORTION, 1000);
+        WcmeCutCooldownByName(owner, "Blink", 2000);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_time_warp::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_time_warp::HandleProc);
+    }
+};
