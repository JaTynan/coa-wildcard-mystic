+class spell_wcme_champion_of_justice : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_champion_of_justice);
+
+    static constexpr uint32 RIGHTEOUS_JUSTICE = 985957;
+    static constexpr uint32 DIVINE_JUSTICE = 985976;
+    static constexpr uint32 DEBT = 985977;
+    static constexpr uint32 DEBT_PENALTY = 985978;
+    static constexpr uint32 STRIKE = 985973;
+    static constexpr uint32 BOND_HEAL = 985998;
+    static constexpr std::array<uint32, 1> PROMISE = { 985993 };
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncTaughtRank(GetTarget(), PROMISE, true);
+        Unit* owner = GetTarget();
+        WcmeSyncCrusadersJustice(owner);
+    }
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        WcmeSyncTaughtRank(GetTarget(), PROMISE, false);
+        GetTarget()->RemoveAurasDueToSpell(RIGHTEOUS_JUSTICE);
+        WcmeSyncCrusadersJustice(GetTarget());
+        WcmeJusticeBonds.erase(GetTarget()->GetGUID());
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return GetTarget()->HasAura(RIGHTEOUS_JUSTICE) &&
+                ((WcmeNamed(spell, "Divine Storm") && spell->SpellFamilyName == SPELLFAMILY_PALADIN) || spell->Id == PROMISE[0]);
+        return spell->Id == STRIKE && eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo);
+    }
+
+    static void AddStack(Unit* owner, uint32 spellId)
+    {
+        Aura* aura = owner->GetAura(spellId);
+        if (!aura)
+        {
+            owner->AddAura(spellId, owner);
+            return;
+        }
+        if (aura->GetStackAmount() < aura->GetSpellInfo()->StackAmount)
+            aura->SetStackAmount(aura->GetStackAmount() + 1);
+        aura->RefreshDuration();
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (spell->Id == STRIKE)
+        {
+            owner->ModifyPower(POWER_MANA, int32(owner->GetCreateMana() / 10));
+            auto bond = WcmeJusticeBonds.find(owner->GetGUID());
+            Unit* ally = bond == WcmeJusticeBonds.end() ? nullptr : ObjectAccessor::GetUnit(*owner, bond->second);
+            SpellInfo const* heal = sSpellMgr->GetSpellInfo(BOND_HEAL);
+            if (ally && heal && ally->IsAlive() && owner->IsWithinDistInMap(ally, 40.0f))
+            {
+                DamageInfo const* damage = eventInfo.GetDamageInfo();
+                HealInfo healInfo(owner, ally, WcmeSoloArenaHeal(owner, damage->GetDamage() + damage->GetAbsorb()), heal, heal->GetSchoolMask());
+                owner->HealBySpell(healInfo);
+            }
+            return;
+        }
+        if (spell->Id == PROMISE[0])
+        {
+            AddStack(owner, DEBT);
+            AddStack(owner, DEBT_PENALTY);
+            WcmeCutCooldownByName(owner, "Divine Storm", 1000);
+            return;
+        }
+        SpellInfo const* justice = sSpellMgr->GetSpellInfo(DIVINE_JUSTICE);
+        if (!justice)
+            return;
+        size_t const allies = 2 + owner->GetAuraCount(DEBT);
+        owner->RemoveAurasDueToSpell(DEBT);
+        owner->RemoveAurasDueToSpell(DEBT_PENALTY);
+        uint32 const base = uint32(1 + 0.04f * WcmeAttackPower(owner) + 0.03f * WcmeSpellPower(owner));
+        std::list<Unit*> wounded = WcmeAlliesNear(owner, owner, 40.0f, 40);
+        wounded.sort([](Unit* first, Unit* second) { return first->GetHealthPct() < second->GetHealthPct(); });
+        size_t healed = 0;
+        for (Unit* ally : wounded)
+        {
+            if (healed >= allies)
+                break;
+            if (!ally->IsInRaidWith(owner) && ally != owner)
+                continue;
+            if (Aura* hot = owner->AddAura(DIVINE_JUSTICE, ally))
+                if (AuraEffect* tick = hot->GetEffect(EFFECT_0))
+                    tick->ChangeAmount(int32(WcmeSoloArenaHeal(owner, owner->SpellHealingBonusDone(ally, justice, base, DOT, EFFECT_0))));
+            ++healed;
+        }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_champion_of_justice::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_champion_of_justice::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_champion_of_justice::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_champion_of_justice::HandleProc);
+    }
+};
