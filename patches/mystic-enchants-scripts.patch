+// ===== Epic batch 3 and the held-back epics =====
+
+static bool WcmeAuraFromNamed(Unit* target, Unit* caster, char const* name)
+{
+    for (auto const& [id, app] : target->GetAppliedAuras())
+        if (app->GetBase()->GetCasterGUID() == caster->GetGUID() && WcmeNamed(app->GetBase()->GetSpellInfo(), name))
+            return true;
+    return false;
+}
+
+static bool WcmeIncapacitatedOrImmobilized(Unit* unit)
+{
+    return unit->HasAuraType(SPELL_AURA_MOD_ROOT) || unit->HasAuraType(SPELL_AURA_MOD_STUN) ||
+        unit->HasAuraWithMechanic((1ULL << MECHANIC_SAPPED) | (1ULL << MECHANIC_POLYMORPH) | (1ULL << MECHANIC_KNOCKOUT) |
+            (1ULL << MECHANIC_SLEEP) | (1ULL << MECHANIC_ROOT) | (1ULL << MECHANIC_FREEZE) | (1ULL << MECHANIC_STUN) |
+            (1ULL << MECHANIC_HORROR) | (1ULL << MECHANIC_BANISH));
+}
