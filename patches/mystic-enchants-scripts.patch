+// Fel Meteor (101087) needs 5 stacks of Meteoric Impact and spends them; Unrelenting Wrath (965289) needs a charge of
+// Unrelenting Wrath and spends one.
+class spell_wcme_reactive_spell : public SpellScript
+{
+    PrepareSpellScript(spell_wcme_reactive_spell);
+
+    uint32 Requirement() { return GetSpellInfo()->Id == 101087 ? 300230 : 983873; }
+    uint8 Needed() { return GetSpellInfo()->Id == 101087 ? 5 : 1; }
+
+    SpellCastResult CheckCast()
+    {
+        Aura const* aura = GetCaster()->GetAura(Requirement());
+        return aura && aura->GetStackAmount() >= Needed() ? SPELL_CAST_OK : SPELL_FAILED_CASTER_AURASTATE;
+    }
+
+    void Spend()
+    {
+        if (Aura* aura = GetCaster()->GetAura(Requirement()))
+        {
+            if (Needed() == 1 && aura->GetStackAmount() > 1)
+                aura->SetStackAmount(aura->GetStackAmount() - 1);
+            else
+                aura->Remove();
+        }
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_wcme_reactive_spell::CheckCast);
+        AfterCast += SpellCastFn(spell_wcme_reactive_spell::Spend);
+    }
+};
