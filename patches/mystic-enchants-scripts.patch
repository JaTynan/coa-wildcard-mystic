+// Borrowed Time (the buff): with Words of Healing active, casting spells no longer uses it up; it lasts its
+// full duration instead.
+class spell_wcme_borrowed_time_kept : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_borrowed_time_kept);
+
+    static constexpr uint32 WORDS_OF_HEALING = 81470;
+
+    void PrepareProc(ProcEventInfo& /*eventInfo*/)
+    {
+        if (Unit* owner = GetUnitOwner())
+            if (owner->HasAura(WORDS_OF_HEALING))
+                PreventDefaultAction();   // the charge is not taken
+    }
+
+    void Register() override
+    {
+        DoPrepareProc += AuraProcFn(spell_wcme_borrowed_time_kept::PrepareProc);
+    }
+};
