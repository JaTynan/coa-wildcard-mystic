+// Steward of Eternity (986162): Moonfire shows as Align (986163), Renew as Time-bind (986164) and Arcane Missiles as
+// Synchronize (986165). Each of them drains energy (Align 5, Time-bind 30, Synchronize 70, the amounts in their data)
+// and triggers Borrowed Time if you know its final rank; Align and Time-bind add Temporal Distortion (986166, up to 20;
+// Align on a Time-bound target adds one more). Synchronize uses Missile Barrage through its data. When one of them empties your energy, the distortion is released: Eternity's healing wave
+// (986173, 13% stronger per stack released) and Eternity (986167), which lasts until your energy is full again.
+class spell_wcme_steward_of_eternity : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_steward_of_eternity);
+
+    static constexpr uint32 ALIGN = 986163;
+    static constexpr uint32 TIME_BIND = 986164;
+    static constexpr uint32 SYNCHRONIZE = 986165;
+    static constexpr uint32 DISTORTION = 986166;
+    static constexpr uint32 ETERNITY = 986167;
+    static constexpr uint32 ETERNITY_WAVE = 986173;
+
+    void CalcPeriod(AuraEffect const* /*aurEff*/, bool& isPeriodic, int32& amplitude)
+    {
+        isPeriodic = true;
+        amplitude = 1000;
+    }
+
+    void Sync(bool active)
+    {
+        Unit* owner = GetTarget();
+        WcmeSyncSwap(owner, "Moonfire", SPELLFAMILY_DRUID, ALIGN, active);
+        WcmeSyncSwap(owner, "Renew", SPELLFAMILY_PRIEST, TIME_BIND, active);
+        WcmeSyncSwap(owner, "Arcane Missiles", SPELLFAMILY_MAGE, SYNCHRONIZE, active);
+        if (!active)
+        {
+            owner->RemoveAurasDueToSpell(DISTORTION);
+            owner->RemoveAurasDueToSpell(ETERNITY);
+        }
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    void HandleTick(AuraEffect const* /*aurEff*/)
+    {
+        Unit* owner = GetTarget();
+        if (owner->HasAura(ETERNITY) && owner->GetPower(POWER_ENERGY) >= owner->GetMaxPower(POWER_ENERGY))
+            owner->RemoveAurasDueToSpell(ETERNITY);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        return spell && (spell->Id == ALIGN || spell->Id == TIME_BIND || spell->Id == SYNCHRONIZE);
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (Player* player = owner->ToPlayer())
+            if (player->HasSpell(52800))
+                owner->CastSpell(owner, 59891, true);
+        uint8 add = spell->Id == SYNCHRONIZE ? 0 : 1;
+        if (spell->Id == ALIGN)
+            if (Unit* target = eventInfo.GetActionTarget())
+                if (WcmeHasAnyAuraFrom(target, owner, { TIME_BIND, 986161 }))
+                    add = 2;
+        for (uint8 i = 0; i < add; ++i)
+            WcmeAddStackOn(owner, owner, DISTORTION);
+        if (owner->GetMaxPower(POWER_ENERGY) == 0)
+            return;
+        int32 const drain = spell->Id == ALIGN ? 5 : spell->Id == TIME_BIND ? 30 : 70;
+        owner->ModifyPower(POWER_ENERGY, -std::min<int32>(drain, int32(owner->GetPower(POWER_ENERGY))));
+        if (owner->GetPower(POWER_ENERGY) > 0)
+            return;
+        uint8 const released = owner->GetAuraCount(DISTORTION);
+        owner->RemoveAurasDueToSpell(DISTORTION);
+        if (SpellInfo const* wave = sSpellMgr->GetSpellInfo(ETERNITY_WAVE))
+            owner->CastCustomSpell(ETERNITY_WAVE, SPELLVALUE_BASE_POINT0, wave->Effects[EFFECT_0].CalcValue(owner) * (100 + 13 * released) / 100, owner, true);
+        owner->CastSpell(owner, ETERNITY, true);
+    }
+
+    void Register() override
+    {
+        DoEffectCalcPeriodic += AuraEffectCalcPeriodicFn(spell_wcme_steward_of_eternity::CalcPeriod, EFFECT_0, SPELL_AURA_DUMMY);
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_steward_of_eternity::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_steward_of_eternity::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        OnEffectPeriodic += AuraEffectPeriodicFn(spell_wcme_steward_of_eternity::HandleTick, EFFECT_0, SPELL_AURA_DUMMY);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_steward_of_eternity::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_steward_of_eternity::HandleProc);
+    }
+};
