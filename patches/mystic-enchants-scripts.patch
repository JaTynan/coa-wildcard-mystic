+        auto combo = WcmeFlurryCombo.find(caster->GetGUID());
+        int32 const points = combo == WcmeFlurryCombo.end() ? 1 : combo->second;
+        float const power = caster->GetTotalAttackPowerValue(BASE_ATTACK) + float(caster->SpellBaseDamageBonusDone(SPELL_SCHOOL_MASK_ALL));
+        int32 const base = std::max(0, (int32(caster->GetLevel()) - 40) * 3) + 80 * points;
+        SetEffectValue(base + int32(power * (0.07f + 0.017f * points * points)));
+    }
