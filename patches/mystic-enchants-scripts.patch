+// Primordial Fury (977717): during Shamanistic Rage, non-periodic spell and ability critical hits spend 50 rage
+// to deal Elemental damage and grant a stack of Elemental Rage. Nothing happens without the rage.
+class spell_wcme_primordial_fury : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_primordial_fury);
+
+    static constexpr uint32 ELEMENTAL_DAMAGE = 977718;
+    static constexpr uint32 ELEMENTAL_RAGE = 985349;
+    static constexpr int32 RAGE_COST = 500;   // 50 rage, stored as tenths
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        Unit* owner = GetTarget();
+        return eventInfo.GetSpellInfo() && (eventInfo.GetHitMask() & PROC_HIT_CRITICAL) &&
+            !(eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) &&
+            WcmeHasAnyAura(owner, { 30823, 1130823, 1230823 }) && int32(owner->GetPower(POWER_RAGE)) >= RAGE_COST;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        owner->ModifyPower(POWER_RAGE, -RAGE_COST);
+        if (Unit* target = eventInfo.GetActionTarget())
+            if (target != owner)
+                owner->CastSpell(target, ELEMENTAL_DAMAGE, true);
+        owner->CastSpell(owner, ELEMENTAL_RAGE, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_primordial_fury::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_primordial_fury::HandleProc);
+    }
+};
