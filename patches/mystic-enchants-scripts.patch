+// Twilight Paragon (977824): direct damage with Smite and Holy Fire, and with Penance against creatures, grants
+// Paragon of Light. Casting Exorcism spends every stack: one Twilight Torment on the target per stack, then
+// Paragon of Darkness for 1 sec per stack.
+class spell_wcme_twilight_paragon : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_twilight_paragon);
+
+    static constexpr uint32 LIGHT = 977825;
+    static constexpr uint32 DARKNESS = 977826;
+    static constexpr uint32 TORMENT = 977851;
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        return eventInfo.GetSpellInfo() != nullptr;
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (!WcmeNamed(spell, "Exorcism"))
+                return;
+            Aura const* light = owner->GetAura(LIGHT);
+            if (!light)
+                return;
+            uint8 const stacks = light->GetStackAmount();
+            owner->RemoveAurasDueToSpell(LIGHT);
+            if (Spell const* cast = eventInfo.GetProcSpell())
+                if (Unit* target = cast->m_targets.GetUnitTarget())
+                    for (uint8 i = 0; i < stacks; ++i)
+                        owner->CastSpell(target, TORMENT, true);
+            owner->CastSpell(owner, DARKNESS, true);
+            if (Aura* darkness = owner->GetAura(DARKNESS))
+                darkness->SetDuration(int32(stacks) * IN_MILLISECONDS);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (!target || target == owner || !WcmeDealtDamage(eventInfo) || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK))
+            return;
+        if (WcmeNamedAny(spell, { "Smite", "Holy Fire" }) || (WcmeNamed(spell, "Penance") && target->GetTypeId() == TYPEID_UNIT))
+            owner->CastSpell(owner, LIGHT, true);
+    }
+
+    void Register() override
+    {
+        DoCheckProc += AuraCheckProcFn(spell_wcme_twilight_paragon::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_twilight_paragon::HandleProc);
+    }
+};
