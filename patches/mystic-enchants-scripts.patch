+// Dark Ranger (997115): Drain Life shows as Blood Arrow (997517) and Corruption as Shadow Arrow (997526) (WcmeSyncSwap:
+// the core does not swap them, the names differ); Shadow Artillery (998204) is taught. Shadow Bolt and Seed of
+// Corruption casts give Dark Arrows (997412, 6 charges): your next 6 Hunter shots, Shadow Bolts, Blood Arrows or Shadow
+// Arrows (any ranged Hunter ability or Hunter "Shot") also deal Dark Arrows (997742: 65% weapon damage as Shadow) and
+// give a stack of Shadow Shells (997539, up to 10). Shadow Artillery needs 3 Shadow Shells and spends them
+// (spell_wcme_shadow_artillery), restores 35% of your base mana and adds a stack of Darkfall (984509: +20% Shadow
+// Artillery damage per stack, the data's own mod; a cast at 3 stacks spends them). Molten Core also empowers Shadow
+// Artillery: a cast with it spends a charge and its hits deal 12% more. Shadow Arrow casts trigger Nightfall's Shadow
+// Trance (17941) if you know Nightfall at its final rank.
+class spell_wcme_dark_ranger : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_dark_ranger);
+
+    static constexpr uint32 BLOOD_ARROW = 997517;
+    static constexpr uint32 SHADOW_ARROW = 997526;
+    static constexpr uint32 ARTILLERY = 998204;
+    static constexpr uint32 ARTILLERY_DOT = 984510;
+    static constexpr uint32 DARK_ARROWS = 997412;
+    static constexpr uint32 DARK_ARROWS_HIT = 997742;
+    static constexpr uint32 SHELLS = 997539;
+    static constexpr uint32 DARKFALL = 984509;
+    static constexpr uint32 MOLTEN_CORE = 71162;
+    static constexpr uint32 SHADOW_TRANCE = 17941;
+    static constexpr std::array<uint32, 1> TAUGHT = { ARTILLERY };
+    TimePoint _moltenUntil{};
+
+    void Sync(bool active)
+    {
+        WcmeSyncSwap(GetTarget(), "Drain Life", SPELLFAMILY_WARLOCK, BLOOD_ARROW, active);
+        WcmeSyncSwap(GetTarget(), "Corruption", SPELLFAMILY_WARLOCK, SHADOW_ARROW, active);
+        WcmeSyncTaughtRank(GetTarget(), TAUGHT, active);
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(true); }
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/) { Sync(false); }
+
+    static bool Empowered(SpellInfo const* spell)
+    {
+        return spell->Id == BLOOD_ARROW || spell->Id == SHADOW_ARROW ||
+            (spell->SpellFamilyName == SPELLFAMILY_HUNTER && (spell->DmgClass == SPELL_DAMAGE_CLASS_RANGED ||
+                (spell->SpellName[0] && std::strstr(spell->SpellName[0], "Shot")))) ||
+            (WcmeNamed(spell, "Shadow Bolt") && spell->SpellFamilyName == SPELLFAMILY_WARLOCK);
+    }
+
+    bool CheckProc(ProcEventInfo& eventInfo)
+    {
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (!spell || (eventInfo.GetTypeMask() & PERIODIC_PROC_FLAG_MASK) || spell->Id == DARK_ARROWS_HIT)
+            return false;
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+            return spell->Id == ARTILLERY || spell->Id == SHADOW_ARROW || Empowered(spell) ||
+                WcmeNamedAny(spell, { "Shadow Bolt", "Seed of Corruption" });
+        return eventInfo.GetActionTarget() && WcmeDealtDamage(eventInfo) &&
+            ((Empowered(spell) && GetTarget()->HasAura(DARK_ARROWS)) || ((spell->Id == ARTILLERY || spell->Id == ARTILLERY_DOT) && GameTime::Now() < _moltenUntil));
+    }
+
+    void HandleProc(ProcEventInfo& eventInfo)
+    {
+        PreventDefaultAction();
+        Unit* owner = GetTarget();
+        SpellInfo const* spell = eventInfo.GetSpellInfo();
+        if (eventInfo.GetSpellPhaseMask() & PROC_SPELL_PHASE_CAST)
+        {
+            if (spell->Id == ARTILLERY)
+            {
+                owner->EnergizeBySpell(owner, ARTILLERY, owner->GetCreateMana() * 35 / 100, POWER_MANA);
+                Aura* darkfall = owner->GetAura(DARKFALL);
+                if (darkfall && darkfall->GetStackAmount() >= darkfall->GetSpellInfo()->StackAmount)
+                    owner->m_Events.AddEventAtOffset([owner]() { owner->RemoveAurasDueToSpell(DARKFALL); }, 500ms);
+                else if (darkfall)
+                    darkfall->SetStackAmount(darkfall->GetStackAmount() + 1);
+                else
+                    owner->AddAura(DARKFALL, owner);
+                _moltenUntil = {};
+                if (Aura* molten = owner->GetAura(MOLTEN_CORE))
+                {
+                    _moltenUntil = GameTime::Now() + Seconds(10);
+                    molten->DropCharge();
+                }
+                return;
+            }
+            if (spell->Id == SHADOW_ARROW && WcmeHasAnyAura(owner, { 18095, 1118095, 1218095 }))
+                owner->CastSpell(owner, SHADOW_TRANCE, true);
+            if (WcmeNamedAny(spell, { "Shadow Bolt", "Seed of Corruption" }) && spell->SpellFamilyName == SPELLFAMILY_WARLOCK &&
+                !owner->HasAura(DARK_ARROWS))
+                owner->AddAura(DARK_ARROWS, owner);
+            return;
+        }
+        Unit* target = eventInfo.GetActionTarget();
+        if (spell->Id == ARTILLERY || spell->Id == ARTILLERY_DOT)
+        {
+            DamageInfo const* damage = eventInfo.GetDamageInfo();
+            WcmeExtraDamage(owner, target, spell, int64(damage->GetDamage() + damage->GetAbsorb()) * 12 / 100);
+            return;
+        }
+        owner->CastSpell(target, DARK_ARROWS_HIT, true);
+        if (Aura* shells = owner->GetAura(SHELLS))
+        {
+            if (shells->GetStackAmount() < shells->GetSpellInfo()->StackAmount)
+                shells->SetStackAmount(shells->GetStackAmount() + 1);
+            shells->RefreshDuration();
+        }
+        else
+            owner->AddAura(SHELLS, owner);
+        if (Aura* arrows = owner->GetAura(DARK_ARROWS))
+            arrows->DropCharge();
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_dark_ranger::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        AfterEffectRemove += AuraEffectRemoveFn(spell_wcme_dark_ranger::HandleRemove, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+        DoCheckProc += AuraCheckProcFn(spell_wcme_dark_ranger::CheckProc);
+        OnProc += AuraProcFn(spell_wcme_dark_ranger::HandleProc);
+    }
+};
