+// An enchant's "Primary Stat" requirement (worldserver.conf Wildcard.EnchantPrimaryStat, default on): with the
+// Wildcard stat paths (Path of Strength 84864 and the others), the chosen path must be the named one; without them,
+// the named stat must be the highest of Strength, Agility, Intellect and Spirit.
+bool WcmePrimaryStatMet(Unit const* unit, uint32 path, Stats stat)
+{
+    if (!sConfigMgr->GetOption<bool>("Wildcard.EnchantPrimaryStat", true))
+        return true;
+    Player const* player = unit->ToPlayer();
+    if (!player)
+        return true;
+    for (uint32 known : { 84864u, 84865u, 84866u, 84867u, 129243u })
+        if (player->HasSpell(known))
+            return player->HasSpell(path);
+    float const wanted = player->GetStat(stat);
+    for (Stats other : { STAT_STRENGTH, STAT_AGILITY, STAT_INTELLECT, STAT_SPIRIT })
+        if (player->GetStat(other) > wanted)
+            return false;
+    return true;
+}
