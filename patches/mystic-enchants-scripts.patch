+void WcmeCutCooldownByName(Unit* unit, char const* name, int32 ms)
+{
+    Player* player = unit->ToPlayer();
+    if (!player)
+        return;
+    for (auto const& [spellId, known] : player->GetSpellMap())
+        if (known->State != PLAYERSPELL_REMOVED && player->HasSpellCooldown(spellId))
+            if (WcmeNamed(sSpellMgr->GetSpellInfo(spellId), name))
+                player->ModifySpellCooldown(spellId, -ms);
+}
+
+// Gives back one charge of the named ability; an ability without charges has its cooldown finished instead.
+void WcmeRestoreChargeByName(Unit* unit, char const* name)
+{
+    Player* player = unit->ToPlayer();
+    if (!player)
+        return;
+    for (auto const& [spellId, known] : player->GetSpellMap())
+    {
+        SpellInfo const* info = sSpellMgr->GetSpellInfo(spellId);
+        if (known->State != PLAYERSPELL_REMOVED && known->Active && info && info->MaxCharges && WcmeNamed(info, name))
+        {
+            player->RestoreSpellCharge(spellId);
+            return;
+        }
+    }
+    WcmeCutCooldownByName(unit, name, 3600000);
+}
