+// Soul Harvest (1436395, taught by enchant 1398159): lasts 6 sec plus 3 sec for each enemy within 40 yards afflicted by
+// your Corruption, Curse of Agony or Immolate, up to 24 sec, and your pet gets the same damage bonus for as long.
+class spell_wcme_soul_harvest : public AuraScript
+{
+    PrepareAuraScript(spell_wcme_soul_harvest);
+
+    static bool Afflicted(Unit* enemy, Unit* warlock)
+    {
+        for (AuraEffect const* dot : enemy->GetAuraEffectsByType(SPELL_AURA_PERIODIC_DAMAGE))
+            if (dot->GetCasterGUID() == warlock->GetGUID() &&
+                WcmeNamedAny(dot->GetSpellInfo(), { "Corruption", "Curse of Agony", "Immolate" }))
+                return true;
+        return false;
+    }
+
+    void HandleApply(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        Unit* owner = GetTarget();
+        if (owner->IsPet())
+            return;
+        int32 duration = 6000;
+        for (Unit* enemy : WcmeEnemiesNear(owner, owner, 40.0f, 100))
+            if (Afflicted(enemy, owner))
+                duration += 3000;
+        duration = std::min(duration, 24000);
+        GetAura()->SetMaxDuration(duration);
+        GetAura()->SetDuration(duration);
+        if (Player* player = owner->ToPlayer())
+            if (Pet* pet = player->GetPet())
+                if (Aura* petAura = owner->AddAura(GetId(), pet))
+                {
+                    petAura->SetMaxDuration(duration);
+                    petAura->SetDuration(duration);
+                }
+    }
+
+    void Register() override
+    {
+        AfterEffectApply += AuraEffectApplyFn(spell_wcme_soul_harvest::HandleApply, EFFECT_0, SPELL_AURA_DUMMY, AURA_EFFECT_HANDLE_REAL);
+    }
+};
